@page "/login"
@model BatteryTestingSystem.Pages.LoginModel


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Battery Testing System - Login</title>
    <meta name="description" content="Professional battery testing and analysis system">
    <link rel="icon" type="image/png" href="images/adorflower-removebg-preview.png" />

    <!-- Link to your existing app.css -->
    <link rel="stylesheet" href="css/app.min.css" />

    
    <style>
        /* Additional animations for this page only */
        @@keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        @@keyframes spark {
            0%, 100% { opacity: 0; transform: scale(0.8); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        @@keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 20px hsl(var(--primary) / 0.3); }
            50% { box-shadow: 0 0 40px hsl(var(--primary) / 0.6); }
        }

        @@keyframes slide-up {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes electric-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .animate-float { animation: float 3s ease-in-out infinite; }
        .animate-spark { animation: spark 1.5s ease-in-out infinite; }
        .animate-pulse-glow { animation: pulse-glow 2s ease-in-out infinite; }
        .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }

        .bg-grid-pattern {
            background-image: 
                linear-gradient(hsl(var(--primary) / 0.03) 1px, transparent 1px),
                linear-gradient(90deg, hsl(var(--primary) / 0.03) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        .energy-gradient {
            background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
            background-size: 200% 200%;
            animation: electric-flow 3s ease infinite;
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glow-primary {
            box-shadow: 0 0 20px hsl(var(--primary) / 0.4), 0 0 40px hsl(var(--primary) / 0.2);
        }

        .input-energy:focus {
            outline: none;
            border-color: hsl(var(--primary));
            box-shadow: 0 0 0 3px hsl(var(--primary) / 0.2);
        }

        .btn-energy {
            background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
            transition: all 0.3s ease;
        }

        .btn-energy:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px hsl(var(--primary) / 0.4);
        }

        .delay-100 { animation-delay: 100ms; }
        .delay-200 { animation-delay: 200ms; }
        .delay-300 { animation-delay: 300ms; }
    </style>
</head>
<body class="min-h-screen overflow-x-hidden">
    <!-- Electric Background -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <!-- Grid pattern -->
        <div class="absolute inset-0 bg-grid-pattern opacity-50"></div>

        <!-- Animated gradient orbs -->
        <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-[hsl(var(--primary)/0.2)] rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-[hsl(var(--accent)/0.2)] rounded-full blur-3xl animate-pulse delay-300"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[hsl(var(--primary)/0.1)] rounded-full blur-3xl animate-pulse delay-200"></div>

        <!-- Electric lines SVG -->
        <svg class="absolute inset-0 w-full h-full opacity-30" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="electricLine1" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="transparent" />
                    <stop offset="50%" stop-color="hsl(var(--primary))" />
                    <stop offset="100%" stop-color="transparent" />
                </linearGradient>
                <linearGradient id="electricLine2" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="transparent" />
                    <stop offset="50%" stop-color="hsl(var(--accent))" />
                    <stop offset="100%" stop-color="transparent" />
                </linearGradient>
            </defs>
            <line x1="0" y1="20%" x2="100%" y2="20%" stroke="url(#electricLine1)" stroke-width="1" class="animate-pulse" />
            <line x1="0" y1="80%" x2="100%" y2="80%" stroke="url(#electricLine1)" stroke-width="1" class="animate-pulse delay-200" />
            <line x1="15%" y1="0" x2="15%" y2="100%" stroke="url(#electricLine2)" stroke-width="1" class="animate-pulse delay-100" />
            <line x1="85%" y1="0" x2="85%" y2="100%" stroke="url(#electricLine2)" stroke-width="1" class="animate-pulse delay-300" />
        </svg>

        <!-- Corner decorations -->
        <div class="absolute top-0 left-0 w-32 h-32 border-l-2 border-t-2 border-[hsl(var(--primary)/0.3)] rounded-tl-3xl"></div>
        <div class="absolute top-0 right-0 w-32 h-32 border-r-2 border-t-2 border-[hsl(var(--primary)/0.3)] rounded-tr-3xl"></div>
        <div class="absolute bottom-0 left-0 w-32 h-32 border-l-2 border-b-2 border-[hsl(var(--accent)/0.3)] rounded-bl-3xl"></div>
        <div class="absolute bottom-0 right-0 w-32 h-32 border-r-2 border-b-2 border-[hsl(var(--accent)/0.3)] rounded-br-3xl"></div>
    </div>

    <!-- Main Content -->
    <div class="relative min-h-screen flex flex-col lg:flex-row">
        
        <!-- Theme Toggle -->
        @* <button id="themeToggle" class="fixed top-4 right-4 z-50 p-3 rounded-full bg-card border border-border shadow-lg hover:scale-110 transition-transform glow-primary">
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="sunIcon" class="w-5 h-5 text-[hsl(var(--primary))] hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="moonIcon" class="w-5 h-5 text-primary block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
        </button> *@

        <!-- Left Section - Branding & Animation -->
        <div class="flex-1 flex flex-col items-center justify-center p-8 lg:p-12">
            <!-- Logo & Title -->
            <div class="text-center mb-8 animate-slide-up">
                <div class="inline-flex items-center gap-3 mb-4">
                    <div class="p-3 rounded-2xl bg-[hsl(var(--primary)/0.1)] border border-[hsl(var(--primary)/0.3)] glow-primary">
                        <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h1 class="text-3xl lg:text-4xl font-bold energy-gradient">Ador Power</h1>
                </div>
                <p class="text-muted-foreground text-lg">Advanced Battery Testing System</p>
            </div>

            <!-- Battery Animation -->
            <div class="relative animate-float mb-8">
                <!-- Electric sparks -->
                <div class="absolute -top-4 left-1/2 -translate-x-1/2">
                    <svg width="24" height="24" viewBox="0 0 24 24" class="animate-spark text-accent">
                        <path fill="currentColor" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                    </svg>
                </div>

                <!-- Main battery SVG -->
                <svg width="120" height="200" viewBox="0 0 120 200" class="drop-shadow-2xl">
                    <!-- Battery cap -->
                    <rect x="35" y="0" width="50" height="12" rx="4" fill="hsl(var(--primary))" />

                    <!-- Battery body outline -->
                    <rect x="10" y="12" width="100" height="180" rx="12" fill="hsl(var(--card))" stroke="hsl(var(--primary))" stroke-width="3" />

                    <!-- Battery inner background -->
                    <rect x="18" y="20" width="84" height="164" rx="8" fill="hsl(var(--muted))" />

                    <!-- Charge level - animated -->
                    <defs>
                        <linearGradient id="chargeGradient" x1="0%" y1="100%" x2="0%" y2="0%">
                            <stop offset="0%" stop-color="hsl(var(--primary))" />
                            <stop offset="50%" stop-color="hsl(var(--accent))" />
                            <stop offset="100%" stop-color="hsl(var(--secondary))" />
                        </linearGradient>
                        <filter id="glow">
                            <feGaussianBlur stdDeviation="3" result="coloredBlur" />
                            <feMerge>
                                <feMergeNode in="coloredBlur" />
                                <feMergeNode in="SourceGraphic" />
                            </feMerge>
                        </filter>
                    </defs>

                    <rect id="chargeLevel" x="18" y="118" width="84" height="66" rx="8" fill="url(#chargeGradient)" filter="url(#glow)" class="transition-all duration-300" />

                    <!-- Charge percentage text -->
                    <text id="chargeText" x="60" y="110" text-anchor="middle" fill="hsl(var(--card-foreground))" font-size="24" font-weight="bold">40%</text>

                    <!-- Electric bolt icon in center -->
                    <path d="M65 75 L55 100 L62 100 L55 125 L75 95 L68 95 L75 75 Z" fill="hsl(var(--card-foreground))" opacity="0.8" />
                </svg>

                <!-- Floating particles -->
                <div class="absolute -left-4 top-1/4 w-2 h-2 rounded-full bg-primary animate-pulse opacity-70"></div>
                <div class="absolute -right-4 top-1/2 w-3 h-3 rounded-full bg-accent animate-pulse delay-300 opacity-70"></div>
                <div class="absolute -left-6 bottom-1/4 w-2 h-2 rounded-full bg-secondary animate-pulse delay-200 opacity-70"></div>
            </div>

            <!-- Features -->
            <div class="grid grid-cols-2 gap-4 max-w-sm animate-slide-up" style="animation-delay: 0.2s;">
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Real-time Analysis
                </div>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    Detailed Reports
                </div>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                    Secure Data
                </div>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Fast Testing
                </div>
            </div>
        </div>

        <!-- Right Section - Login Form -->
        <div class="flex-1 flex items-center justify-center p-8 lg:p-12">
            <div class="w-full max-w-md animate-slide-up" style="animation-delay: 0.3s;">
                <!-- Card -->
                <div class="bg-card rounded-2xl border border-border p-8 shadow-2xl animate-pulse-glow">
                    <!-- Header -->
                    <div class="text-center mb-8">
                        <h2 class="text-2xl font-bold text-foreground mb-2">Welcome Back</h2>
                        <p class="text-muted-foreground">Sign in to access your dashboard</p>
                    </div>

                    <!-- Login Form -->
                    <form method="post" class="space-y-6">
                        @Html.AntiForgeryToken()
                        
                        <!-- Email Field -->
                        <div class="space-y-2">
                            <label for="email" class="block text-sm font-medium text-foreground">Email or Username</label>
                            <div class="relative">
                                <div class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                                    </svg>
                                </div>
                                <input 
                                    type="text" 
                                    id="email" 
                                    name="Email"
                                    placeholder="engineer@adorpower.com"
                                    class="input-energy w-full pl-10 pr-4 py-3 bg-muted border border-border rounded-xl text-foreground placeholder-muted-foreground transition-all duration-300"
                                />
                            </div>
                        </div>

                        <!-- Password Field -->
                        <div class="space-y-2">
                            <label for="password" class="block text-sm font-medium text-foreground">Password</label>
                            <div class="relative">
                                <div class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                    </svg>
                                </div>
                                <input 
                                    type="password" 
                                    id="password" 
                                    name="Password"
                                    placeholder="••••••••"
                                    class="input-energy w-full pl-10 pr-12 py-3 bg-muted border border-border rounded-xl text-foreground placeholder-muted-foreground transition-all duration-300"
                                />
                                <button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors">
                                    <svg id="eyeIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                    <svg id="eyeOffIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Remember Me & Forgot Password -->
                        <div class="flex items-center justify-between">
                            <label class="flex items-center gap-2 cursor-pointer group">
                                <input type="checkbox"
                                       id="remember"
                                       name="RememberMe"
                                       value="true"
                                       class="sr-only peer" />
                                <span class="h-4 w-4 shrink-0 rounded-sm border border-primary bg-background flex items-center justify-center peer-checked:bg-primary peer-checked:border-primary peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-disabled:cursor-not-allowed peer-disabled:opacity-50 transition-colors">
                                    <svg class="h-3 w-3 text-primary-foreground opacity-0 peer-checked:opacity-100 transition-opacity" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                </span>
                                <span class="text-sm text-muted-foreground">Remember me</span>
                            </label>
                           @*  <a href="#" class="text-sm text-primary hover:text-accent transition-colors font-medium">
                                Forgot password?
                            </a> *@
                        </div>

                        <!-- Submit Button -->
                        <button 
                            type="submit" 
                            class="btn-energy w-full py-3 px-6 rounded-xl text-primary-foreground font-semibold text-lg flex items-center justify-center gap-2"
                        >
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                            <span>Power On</span>
                        </button>

                        <!-- Error Display -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="mt-3 p-3 rounded-lg bg-red-500/10 border border-red-500/30">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div class="text-red-500 text-sm">@error.ErrorMessage</div>
                                }
                            </div>
                        }
                    </form>

@*                     <!-- Divider -->
                    <div class="relative my-6">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-border"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-4 bg-card text-muted-foreground">New to VoltTest?</span>
                        </div>
                    </div> *@

           @*          <!-- Register Link -->
                    <a href="#" class="block w-full py-3 px-6 rounded-xl border border-border text-center text-foreground font-medium hover:bg-muted hover:border-primary transition-all">
                        Create an account
                    </a> *@
                </div>

                <!-- Footer -->
                <p class="text-center text-muted-foreground text-sm mt-6">
                    © @DateTime.Now.ToString("yyyy") Ador Powertron ltd. All rights reserved.
                </p>
            </div>
        </div>
    </div>

    <script>
        // Theme Toggle
        const html = document.documentElement;

        // Load saved theme
        window.addEventListener('DOMContentLoaded', () => {
               const key = Object.keys(localStorage)
                    .find(k =>
                      k.toLowerCase().startsWith('app-theme-') &&
                      k.toLowerCase() !== 'app-theme-system'
                    );


            const value = key ? localStorage.getItem(key) : null;

            html.classList.remove(
                "dark",
                "theme-shieldos",
                "theme-ironman",
                "theme-tech",
                "theme-future"
            );

            // Apply the selected theme
            switch (value) {
                case "Light":
                    // Light = default, no class needed
                    break;
                case "Dark":
                    html.classList.add("dark");
                    break;
                case "System":
                    // Optional: you can detect system preference
                    if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
                        html.classList.add("dark");
                    }
                    break;
                case "ShieldOS":
                    html.classList.add("theme-shieldos");
                    break;
                case "IronMan":
                    html.classList.add("theme-ironman");
                    break;
                case "Tech":
                    html.classList.add("theme-tech");
                    break;
                case "Future":
                    html.classList.add("theme-future");
                    break;
                default:
                    console.warn("Unknown theme:", value);
            }

        });

        // Password Toggle
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        const eyeIcon = document.getElementById('eyeIcon');
        const eyeOffIcon = document.getElementById('eyeOffIcon');

        togglePassword.addEventListener('click', () => {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            eyeIcon.classList.toggle('hidden');
            eyeOffIcon.classList.toggle('hidden');
        });

        // Battery Animation
        let chargeLevel = 20;
        const chargeLevelRect = document.getElementById('chargeLevel');
        const chargeText = document.getElementById('chargeText');

        setInterval(() => {
            chargeLevel += 10;
            if (chargeLevel > 100) chargeLevel = 20;
            
            const height = (164 * chargeLevel) / 100;
            const y = 20 + (164 - height);
            
            chargeLevelRect.setAttribute('height', height);
            chargeLevelRect.setAttribute('y', y);
            chargeText.textContent = chargeLevel + '%';
        }, 400);
    </script>
</body>
</html>
