{
  "server": {
    "host": "localhost",
    "command_port": 9999,
    "data_view_port": 10000,
    "data_store_port": 10001
  },
  "simulation": {
    "device_count": 10,
    "channels_per_device": 8,
    "secondary_board_base": 1,
    "packet_interval_ms": 1000,
    "enable_random_data": true,
    "enable_error_simulation": false,
    "error_rate_percent": 0.1
  },
  "device_defaults": {
    "device_name_prefix": "SIM_DEVICE_",
    "ip_address": "192.168.1.100"
  },
  "data_ranges": {
    "current_min": 0.5,
    "current_max": 50.0,
    "voltage_min": 2.0,
    "voltage_max": 15.0,
    "temperature_min": 20.0,
    "temperature_max": 80.0
  },
  "logging": {
    "level": "INFO",
    "log_file": "simulator.log",
    "console_output": true
  }
}
