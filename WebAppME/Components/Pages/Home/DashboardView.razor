    #region Event

    // CM.HardwareManagerChanged is raised from hardware threads. This must NOT be async void:
    // DCService is circuit-scoped, so every circuit-scoped service here shares one AppDbContext,
    // and overlapping reloads made EF Core throw "A second operation was started on this context
    // instance". The runner serialises them, and InvokeAsync puts the query back on the circuit's
    // synchronization context - the only place a circuit-scoped DbContext may be touched.
    private readonly CoalescingRunner _syncRunner = new();

    public void HandleDeviceChange() =>
        _syncRunner.Request(
            () => InvokeAsync(async () =>
            {
                await SyncDevicesWithDatabase();
                StateHasChanged();
            }),
            ex => Console.Error.WriteLine($"HandleDeviceChange error: {ex}"));
    #endregion


    #region Action State Helpers

    /// <summary>
    /// Derives the effective action bar state from selected circuits.
    /// Uses the first selected circuit as the anchor.
    /// Returns null if states are mixed (incompatible).
    /// </summary>
    private ChannelActionBar.ActionBarState? EffectiveActionState
    {
        get
        {
            if (selectedCircuits.Count == 0) return null;

            var selected = circuits
                .Where(c => selectedCircuits.Contains((c.Channel.DeviceID, c.Channel.SecondaryBoardNumber, c.Channel.ChannelNumber)))
                .ToList();

            if (!selected.Any()) return null;

            var anchor = selected.First();
            var anchorCS = anchor.RealTime.RealTimeRecord.CircuitStatus;
            var anchorPS = anchor.RealTime.RealTimeRecord.ProgramStatus;

            bool allMatch = selected.All(c =>
                c.RealTime.RealTimeRecord.CircuitStatus == anchorCS &&
                c.RealTime.RealTimeRecord.ProgramStatus == anchorPS);

            if (!allMatch) return null;

            bool allConnected = selected.All(c => c.IsConnected);

            return new ChannelActionBar.ActionBarState
            {
                CircuitStatus  = anchorCS,
                ProgramStatus  = anchorPS,
                IsTcpConnected = allConnected
            };
        }
    }

    /// <summary>
    /// Count of selected circuits that do not match the anchor state.
    /// Shown as "(N incompatible)" in the action bar.
    /// </summary>
    private int IncompatibleCircuitCount
    {
        get
        {
            if (selectedCircuits.Count == 0) return 0;

            var selected = circuits
                .Where(c => selectedCircuits.Contains((c.Channel.DeviceID, c.Channel.SecondaryBoardNumber, c.Channel.ChannelNumber)))
                .ToList();

            if (!selected.Any()) return 0;

            var anchor = selected.First();
            var anchorCS = anchor.RealTime.RealTimeRecord.CircuitStatus;
            var anchorPS = anchor.RealTime.RealTimeRecord.ProgramStatus;

            return selected.Count(c =>
                c.RealTime.RealTimeRecord.CircuitStatus != anchorCS ||
                c.RealTime.RealTimeRecord.ProgramStatus != anchorPS);
        }
    }

    /// <summary>
    /// Used by ContextMenu Disabled= parameter.
    /// Single-circuit check — same logic as ActionBar IsEnabled but per-card.
    /// </summary>
    private bool CanContextAction(IChannelCommandHandler dev, string actionId)
    {
        var cs  = dev.RealTime.RealTimeRecord.CircuitStatus;
        var ps = (ProgramRunningStatus)dev.RealTime.RealTimeRecord.ProgramStatus;
        var tcp = dev.IsConnected;

        if (cs == CircuitStatus.Offline) return false;

        return actionId switch
        {
            "start"       => ps == ProgramRunningStatus.Stop && tcp,
            "stop" => tcp,
            "pause"       => ps == ProgramRunningStatus.Running && tcp,
            "continue"    => ps == ProgramRunningStatus.Running
                             && (cs == CircuitStatus.Pause
                                 || cs == CircuitStatus.Interrupt
                                 || cs == CircuitStatus.Countinue
                                 || cs == CircuitStatus.Error
                                 || cs == CircuitStatus.Msg) && tcp,
            // Q9 accepts a paused program too (unlike Q10/jump), so Pause is included here -
            // bm_program_v3.2.md: "A paused program is accepted as well as a running one."
            "liveEdit"    => ps == ProgramRunningStatus.Running
                             && (cs == CircuitStatus.Charge || cs == CircuitStatus.Discharging || cs == CircuitStatus.Pause)
                             && tcp,
            "transfer"    => cs == CircuitStatus.Idle && ps == ProgramRunningStatus.Stop && tcp,
            "calibration" => cs == CircuitStatus.Idle && ps == ProgramRunningStatus.Stop && tcp,
            // Jump (bm_program_v3.2 Q10) is only accepted while genuinely executing - a paused,
            // interrupted, or message-wait circuit is rejected by the hardware (2026-09-15 protocol
            // correction), so Charge/Discharging are the only statuses worth offering it for.
            "jump"        => ps == ProgramRunningStatus.Running
                             && (cs == CircuitStatus.Charge || cs == CircuitStatus.Discharging) && tcp,
            _             => false
        };
    }

    #endregion

    public void Dispose()
    {
        try
        {
            CM.HardwareManagerChanged -= HandleDeviceChange;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }

        try
        {
            _ = JS.InvokeVoidAsync("ElementSize.dispose", GridContainerElementId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }

        _sizeDotNetRef?.Dispose();
    }
