@page "/settings/CardConfiguration"
@namespace BatteryTestingSystem.Components.Pages.Settings
@inject IJSRuntime JS
@inject ServerSessionStorageService sessionStorage
@using BatteryTestingSystem.Models.Enums
@using BatteryTestingSystem.Components.UI.Dashboard
@implements IDisposable

<div class="p-6 max-w-5xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-foreground">Card Configuration</h2>
        <Button variant="ButtonVariant.Ghost" size="ButtonSize.Small" @onclick="ResetConfigAsync" class="h-8 px-3 gap-1">
            <Blazicon Svg="Lucide.RotateCcw" class="h-3.5 w-3.5" />
            Reset to Defaults
        </Button>
    </div>

    @if (!IsReady)
    {
        <div class="text-sm text-muted-foreground">Loading settings...</div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="space-y-5">
                <!-- Card Size -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-foreground">Card Size</label>
                        <span class="text-xs text-muted-foreground font-mono">@Config.CardSize px</span>
                    </div>
                    <input type="range" min="150" max="500" step="10" value="@Config.CardSize"
                           @onchange="@(e => UpdateCardSize(double.Parse(e.Value?.ToString() ?? "150")))"
                           class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                </div>

                <!-- Font Size -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-foreground">Font Size</label>
                        <span class="text-xs text-muted-foreground font-mono">@Config.FontSize px</span>
                    </div>
                    <input type="range" min="8" max="25" step="0.5" value="@Config.FontSize"
                           @onchange="@(e => UpdateFontSize(double.Parse(e.Value?.ToString() ?? "12")))"
                           class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                </div>

                <!-- Refresh Rate -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-foreground">Refresh Rate</label>
                        <span class="text-xs text-muted-foreground font-mono">@Config.RefreshRate ms</span>
                    </div>
                    <input type="range" min="0" max="5000" step="100" value="@Config.RefreshRate"
                           @onchange="@(e => UpdateRefreshRate(int.Parse(e.Value?.ToString() ?? "200")))"
                           class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                </div>

                <!-- Decimal Places -->
                <div class="space-y-2">
                    <label class="text-sm font-medium text-foreground">Decimal Places</label>
                    <div class="flex gap-2">
                        @for (int i = 0; i <= 6; i++)
                        {
                            var value = i;
                            <button type="button" @onclick="@(() => UpdateShowDecimal(value))" class="@GetDecimalButtonClass(value)">@value</button>
                        }
                    </div>
                </div>

                <!-- Display Mode -->
                <div class="space-y-2">
                    <label class="text-sm font-medium text-foreground">Display Mode</label>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (DisplayMode mode in Enum.GetValues(typeof(DisplayMode)))
                        {
                            <button type="button"
                                    @onclick="@(() => UpdateDisplayMode(mode))"
                                    class="@GetDisplayModeButtonClass(mode)">
                                <Blazicon Svg="@GetModeIcon(mode)" class="h-3.5 w-3.5" />
                                @mode
                            </button>
                        }
                    </div>
                </div>

                <!-- Visible Properties (full 3-section checklist) -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-foreground">Visible Properties</label>
                        <span class="text-xs text-muted-foreground">@Config.VisibleProperties.Count selected</span>
                    </div>
                    <div class="max-h-80 overflow-y-auto border border-border rounded-md">
                        <!-- RealTime Properties Section -->
                        <div class="border-b border-border">
                            <button type="button" @onclick="@(() => ToggleSection("realtime"))" class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                <span class="text-xs font-semibold text-foreground">RealTime Data</span>
                                <Blazicon Svg="@(expandedSection == "realtime" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                            </button>
                            @if (expandedSection == "realtime")
                            {
                                <div class="p-2 space-y-1">
                                    @foreach (var prop in RealTimeProperties)
                                    {
                                        <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer">
                                            <input type="checkbox" checked="@IsPropertyVisible(prop.Key)"
                                                   @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                   class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                            <div class="flex items-center gap-2 flex-1">
                                                <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                <span class="text-sm text-foreground">@prop.Value.Label</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Config Properties Section -->
                        <div class="border-b border-border">
                            <button type="button" @onclick="@(() => ToggleSection("config"))" class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                <span class="text-xs font-semibold text-foreground">Configuration</span>
                                <Blazicon Svg="@(expandedSection == "config" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                            </button>
                            @if (expandedSection == "config")
                            {
                                <div class="p-2 space-y-1">
                                    @foreach (var prop in ConfigProperties)
                                    {
                                        <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer">
                                            <input type="checkbox" checked="@IsPropertyVisible(prop.Key)"
                                                   @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                   class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                            <div class="flex items-center gap-2 flex-1">
                                                <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                <span class="text-sm text-foreground">@prop.Value.Label</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Program Properties Section -->
                        <div>
                            <button type="button" @onclick="@(() => ToggleSection("program"))" class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                <span class="text-xs font-semibold text-foreground">Program Data</span>
                                <Blazicon Svg="@(expandedSection == "program" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                            </button>
                            @if (expandedSection == "program")
                            {
                                <div class="p-2 space-y-1">
                                    @foreach (var prop in ProgramProperties)
                                    {
                                        <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer">
                                            <input type="checkbox" checked="@IsPropertyVisible(prop.Key)"
                                                   @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                   class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                            <div class="flex items-center gap-2 flex-1">
                                                <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                <span class="text-sm text-foreground">@prop.Value.Label</span>
                                            </div>
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <Button variant="ButtonVariant.Outline" size="ButtonSize.Small" @onclick="SelectAllProperties" Class="flex-1 h-8 text-xs">Select All</Button>
                        <Button variant="ButtonVariant.Outline" size="ButtonSize.Small" @onclick="ClearAllProperties" Class="flex-1 h-8 text-xs">Clear All</Button>
                    </div>
                </div>
            </div>

            <div class="space-y-2">
                <label class="text-sm font-medium text-foreground">Preview</label>
                <div class="border border-border rounded-lg p-6 bg-muted/30 flex items-center justify-center sticky top-6" style="min-height: 300px;">
                    <div style="width: @(Config.CardSize)px;">
                        <DeviceChannel
                            Channel="_previewChannel"
                            Selected="false"
                            MaxDigit="Config.ShowDecimal"
                            ChartMaxDataPoints="100"
                            Mode="Config.DisplayMode"
                            FontSize="Config.FontSize"
                            RefreshRate="Config.RefreshRate"
                            VisibleProperties="Config.VisibleProperties" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code
{
    private CardConfig Config { get; set; } = new();

    private bool IsReady { get; set; } = false;
    private bool _isInitialized = false;
    private string? expandedSection = null; // null means all closed

    // Property metadata, sample values and defaults all come from CardPreviewData — the
    // same source the quick CardSettings dialog uses, so the two surfaces can't diverge.
    private static readonly List<string> DefaultVisibleProperties = CardPreviewData.DefaultVisibleProperties;
    private static readonly Dictionary<string, CardPreviewData.PropertyMetadata> RealTimeProperties = CardPreviewData.RealTimeProperties;
    private static readonly Dictionary<string, CardPreviewData.PropertyMetadata> ConfigProperties = CardPreviewData.ConfigProperties;
    private static readonly Dictionary<string, CardPreviewData.PropertyMetadata> ProgramProperties = CardPreviewData.ProgramProperties;
    private static readonly Dictionary<string, double> NumericPreviewValues = CardPreviewData.NumericPreviewValues;
    private static readonly Dictionary<string, string> TextPreviewValues = CardPreviewData.TextPreviewValues;
    private static readonly CardConfig DefaultConfig = CardPreviewData.DefaultConfig;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            try
            {
                await Task.Delay(100);
                await LoadConfigFromLocalStorage();
                IsReady = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing config: {ex.Message}");
                Config = new CardConfig
                    {
                        CardSize = DefaultConfig.CardSize,
                        FontSize = DefaultConfig.FontSize,
                        RefreshRate = DefaultConfig.RefreshRate,
                        ShowDecimal = DefaultConfig.ShowDecimal,
                        DisplayMode = DefaultConfig.DisplayMode,
                        VisibleProperties = new List<string>(DefaultConfig.VisibleProperties)
                    };
                IsReady = true;
                StateHasChanged();
            }
        }
    }

    private void ToggleSection(string section)
    {
        expandedSection = expandedSection == section ? null : section;
    }

    private bool IsPropertyVisible(string propertyName)
    {
        return Config.VisibleProperties.Contains(propertyName);
    }

    private async Task ToggleProperty(string propertyName, bool isChecked)
    {
        if (isChecked && !Config.VisibleProperties.Contains(propertyName))
        {
            Config.VisibleProperties.Add(propertyName);
        }
        else if (!isChecked && Config.VisibleProperties.Contains(propertyName))
        {
            Config.VisibleProperties.Remove(propertyName);
        }

        await NotifyConfigChanged();
    }

    private async Task SelectAllProperties()
    {
        Config.VisibleProperties.Clear();
        Config.VisibleProperties.AddRange(RealTimeProperties.Keys);
        Config.VisibleProperties.AddRange(ConfigProperties.Keys);
        Config.VisibleProperties.AddRange(ProgramProperties.Keys);
        await NotifyConfigChanged();
    }

    private async Task ClearAllProperties()
    {
        Config.VisibleProperties.Clear();
        await NotifyConfigChanged();
    }

    private async Task UpdateCardSize(double value)
    {
        Config.CardSize = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateFontSize(double value)
    {
        Config.FontSize = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateRefreshRate(int value)
    {
        Config.RefreshRate = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateShowDecimal(int value)
    {
        Config.ShowDecimal = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateDisplayMode(DisplayMode mode)
    {
        Config.DisplayMode = mode;
        await NotifyConfigChanged();
    }

    private async Task ResetConfigAsync()
    {
        if (!IsReady) return;

        try
        {
            Config.CardSize = DefaultConfig.CardSize;
            Config.FontSize = DefaultConfig.FontSize;
            Config.RefreshRate = DefaultConfig.RefreshRate;
            Config.ShowDecimal = DefaultConfig.ShowDecimal;
            Config.DisplayMode = DefaultConfig.DisplayMode;
            Config.VisibleProperties = new List<string>(DefaultConfig.VisibleProperties);

            await ClearConfigFromLocalStorage();
            await NotifyConfigChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting config: {ex.Message}");
        }
    }

    private async Task NotifyConfigChanged()
    {
        await SaveConfigToLocalStorage();
        StateHasChanged();
    }

    private string GetDecimalButtonClass(int value)
    {
        var baseClass = "flex-1 px-3 py-2 text-sm font-medium rounded-md transition-colors";
        return Config.ShowDecimal == value
            ? $"{baseClass} bg-primary text-primary-foreground"
            : $"{baseClass} bg-muted text-muted-foreground hover:bg-muted/80";
    }

    private string GetDisplayModeButtonClass(DisplayMode mode)
    {
        var baseClass = "flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border transition-colors";
        return Config.DisplayMode == mode
            ? $"{baseClass} bg-primary text-primary-foreground border-primary"
            : $"{baseClass} bg-muted text-muted-foreground border-border hover:bg-muted/80";
    }

    private SvgIcon GetModeIcon(DisplayMode mode)
    {
        return mode switch
        {
            DisplayMode.Mini => Lucide.Minimize2,
            DisplayMode.Compact => Lucide.Square,
            DisplayMode.Normal => Lucide.Maximize2,
            DisplayMode.Chart => Lucide.ChartBar,
            DisplayMode.List => Lucide.List,
            _ => Lucide.LayoutGrid
        };
    }

    private CardPreviewData.PropertyMetadata? FindPropertyMetadata(string key) => CardPreviewData.FindPropertyMetadata(key);

    // Real DeviceChannel component instance driven by a static, no-op IChannelCommandHandler
    // (PreviewChannelCommandHandler) - so the preview is pixel-identical to a real dashboard
    // card instead of a hand-built approximation of it. Created once; VisibleProperties/etc.
    // are read live off Config by the DeviceChannel instance, not copied into the handler.
    private readonly PreviewChannelCommandHandler _previewChannel = new();

    #region LocalStorage Operations

    private async Task SaveConfigToLocalStorage()
    {
        if (!IsReady) return;

        try
        {
            string key = $"{CurrentUser.UserName}_card_config";
            if (CurrentUser.User != null)
            {
                sessionStorage.SetComponentState(key, Config, true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving config to localStorage: {ex.Message}");
        }
    }

    private async Task LoadConfigFromLocalStorage()
    {
        try
        {
            var key = $"{CurrentUser.UserName}_card_config";
            CardConfig storedConfig = new();

            if (CurrentUser.User != null)
            {
                storedConfig = sessionStorage.GetComponentState<CardConfig>(key);
            }

            if (storedConfig != null)
            {
                Config.CardSize = storedConfig.CardSize;
                Config.FontSize = storedConfig.FontSize;
                Config.RefreshRate = storedConfig.RefreshRate;
                Config.ShowDecimal = storedConfig.ShowDecimal;
                Config.DisplayMode = storedConfig.DisplayMode;
                Config.VisibleProperties = storedConfig.VisibleProperties?.Any() == true
                    ? storedConfig.VisibleProperties
                    : new List<string>(DefaultVisibleProperties);
            }
            else
            {
                Config.CardSize = DefaultConfig.CardSize;
                Config.FontSize = DefaultConfig.FontSize;
                Config.RefreshRate = DefaultConfig.RefreshRate;
                Config.ShowDecimal = DefaultConfig.ShowDecimal;
                Config.DisplayMode = DefaultConfig.DisplayMode;
                Config.VisibleProperties = new List<string>(DefaultConfig.VisibleProperties);
                await SaveConfigToLocalStorage();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading config from localStorage: {ex.Message}");
            Config = new CardConfig
                {
                    CardSize = DefaultConfig.CardSize,
                    FontSize = DefaultConfig.FontSize,
                    RefreshRate = DefaultConfig.RefreshRate,
                    ShowDecimal = DefaultConfig.ShowDecimal,
                    DisplayMode = DefaultConfig.DisplayMode,
                    VisibleProperties = new List<string>(DefaultVisibleProperties)
                };
        }
    }

    private async Task ClearConfigFromLocalStorage()
    {
        if (!IsReady) return;

        try
        {
            var key = $"{CurrentUser.UserName}_card_config";
            if (CurrentUser.User != null)
            {
                sessionStorage.RemoveComponentState(key);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing localStorage: {ex.Message}");
        }
    }

    #endregion

    public void Dispose()
    {
        // Cleanup if needed
    }
}
