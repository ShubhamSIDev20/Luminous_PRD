    private void ValidateStep(StepModel step)
    {
        var config = NominalConfig.Configs.TryGetValue(step.OperatorCode, out var cfg)
            ? cfg
            : null;

        /* -----------------------------
         * 1️⃣ Nominal presence rules
         * ----------------------------- */
        if (config != null && !config.Disabled && !config.AllowCustom && config.Fields.Any())
        {
            if (step.NominalValues.Count < config.Fields.Count)
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = "NominalValues",
                        Message = "Missing required nominal values"
                    });
            }
        }

        /* -----------------------------
         * 2️⃣ Nominal value validation
         * ----------------------------- */
        foreach (var (nominal, index) in step.NominalValues.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateNominal(
                nominal,
                index,
                step.OperatorCode,
                allLabels,
                globalVariables,
                allStepNumbers
            );

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = $"NominalValues[{index}]",
                        Message = result.Error
                    });
            }
        }

        /* -----------------------------
         * 3️⃣ Limit presence rules
         * ----------------------------- */
        if (OperatorConstants.LimitActionAllowed.TryGetValue(step.OperatorCode, out var allowed) &&
            allowed &&
            step.Limits.Count == 0 &&
            step.OperatorCode != OperatorConstants.PAU)
        {
            errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = "Limits",
                    Message = "At least one limit-action pair required"
                });
        }

        // PAU operator need on limit of time 
        if (step.OperatorCode == OperatorConstants.PAU)
        {
            if (step.Limits.Count == 0)
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = "Limits",
                    Message = "At least one limit-action pair required"
                });
        }

        /* -----------------------------
         * 4️⃣ Limit value validation
         * ----------------------------- */
        foreach (var (limit, index) in step.Limits.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateLimit(
                limit,
                step.OperatorCode,
                globalVariables
            );

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = $"Limits[{index}]",
                    Message = result.Error
                });
            }
        }

        /* -----------------------------
         * 5️⃣ Action validation
         * ----------------------------- */
        foreach (var (action, index) in step.Actions.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateAction(action, allLabels, allStepNumbers);

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = $"Actions[{index}]",
                        Message = result.Error
                    });
            }
        }

        /* -----------------------------
         * 6️⃣ Registration validation
         * ----------------------------- */
        foreach (var (reg, index) in step.Registrations.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateRegistration(reg, step.OperatorCode, globalVariables);

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = $"Registrations[{index}]",
                    Message = result.Error
                });
            }
        }


        /* -----------------------------
         * PRODUCER reference validation
         * ----------------------------- */
        if (step.OperatorCode == OperatorConstants.PRODUCER)
        {
            var referencedName = step.NominalValues.FirstOrDefault() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(referencedName))
            {
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = "NominalValues",
                    Message = "PRODUCER: a program must be selected"
                });
            }
            else if (!allPrograms.Any(p => p.ProgramName == referencedName))
            {
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = "NominalValues",
                    Message = $"PRODUCER: program '{referencedName}' not found"
                });
            }
        }

        var begStack = new Stack<StepModel>();

        foreach (var s in steps.OrderBy(s => s.StepNumber))
        {
            // BEG → open loop
            if (s.OperatorCode == OperatorConstants.BEG)
            {
                begStack.Push(s);
            }

            // CYC → close loop
            else if (s.OperatorCode == OperatorConstants.CYC)
            {
                if (!begStack.Any())
                {
                    // ❌ CYC without BEG
                    errors.Add(new ValidationError
                        {
                            StepId = s.Id,
                            StepNumber = s.StepNumber,
                            Field = "Operator",
                            Message = "CYC requires a BEG before it"
                        });
                }
                else
                {
                    // ✅ valid pair
                    begStack.Pop();
                }
            }
        }

        // After processing all steps
        while (begStack.Any())
        {
            var unclosedBeg = begStack.Pop();

            errors.Add(new ValidationError
            {
                StepId = unclosedBeg.Id,
                StepNumber = unclosedBeg.StepNumber,
                Field = "Operator",
                Message = "BEG requires a matching CYC after it"
            });
        }

    }

