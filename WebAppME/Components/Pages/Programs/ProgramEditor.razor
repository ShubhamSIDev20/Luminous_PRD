    private void HandleDeleteSelected()
    {
        foreach (var id in selectedStepIds.ToList())
        {
            RemoveStep(id);
        }
        selectedStepIds.Clear();
    }

    private void HandleSave()
    {
        isDirty = false;
        showSaveDialog = true;
        StateHasChanged();
    }

    private async Task DownloadHexPackets()
    {
        // Battery-relative tokens (ACNx, VN, CNom) can't be resolved to wire values without a
        // battery — prompt for one before generating packets. Programs that don't use any of
        // these are unaffected and download exactly as before.
        if (BatteryUnitResolver.ProgramUsesBatteryRelativeTokens(steps))
        {
            if (downloadBatteries.Count == 0)
            {
                var resp = await BatteryService.GetBatteries();
                if (resp.Success && resp.Data != null)
                    downloadBatteries = resp.Data;
            }

            if (downloadBatteries.Count == 0)
            {
                Toast.Error("This program uses battery-relative units (ACNx/VN/CNom), but no batteries are configured. Add one under Battery Management first.");
                return;
            }

            selectedDownloadBatteryId = null;
            showDownloadBatteryDialog = true;
            return;
        }

        await PerformDownloadHexPackets(null);
    }

    private async Task ConfirmDownloadBattery()
    {
        var battery = downloadBatteries.FirstOrDefault(b => b.Id.ToString() == selectedDownloadBatteryId);
        if (battery == null)
        {
            Toast.Error("Select a battery to continue.");
            return;
        }

        showDownloadBatteryDialog = false;
        await PerformDownloadHexPackets(battery);
    }

    private async Task PerformDownloadHexPackets(BatteryDTO? battery)
    {
        // 1️⃣ Resolve PRODUCER sub-programs so the hex is fully expanded
        var producerNames = steps
            .Where(s => s.OperatorCode == OperatorConstants.PRODUCER && s.NominalValues.Count > 0)
            .Select(s => s.NominalValues[0])
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var resolvedDict = new Dictionary<string, List<StepModel>>(StringComparer.OrdinalIgnoreCase);
        foreach (var name in producerNames)
        {
            var prog = allPrograms.FirstOrDefault(p => p.ProgramName == name);
            if (prog == null)
            {
                var resp = await ProgramService.GetProgramByNameAsync(name);
                if (resp.Success && resp.Data != null)
                    prog = resp.Data;
            }
            if (prog?.ProgramStepModel != null)
                resolvedDict[name] = prog.ProgramStepModel;
        }

        // 2️⃣ Generate packets (with PRODUCER steps expanded when present)
        List<byte[]> packets;
        try
        {
            packets = DecoderService.ConvertProgramIntoBytesPackets(steps, resolvedDict, battery);
        }
        catch (BatteryUnitResolutionException ex)
        {
            Toast.Error(ex.Message);
            return;
        }

        // 3️⃣ Get expanded step list so the analysis report lines up with the packets
        var expandedSteps = resolvedDict.Count > 0
            ? ProgramBuilder.ExpandProducerSteps(steps, resolvedDict)
            : steps;

        // 4️⃣ Analyze packets against expanded steps
        var analyses = PacketAnalyzer.AnalyzePackets(packets, expandedSteps);

        // 5️⃣ Generate hex file content
        var hexSb = new StringBuilder();
        foreach (var packet in packets)
        {
            foreach (byte b in packet)
                hexSb.AppendFormat("\\x{0:X2}", b);
            hexSb.AppendLine(); // new line after each packet
        }
        string hexContent = hexSb.ToString();

        // 6️⃣ Generate analysis report content
        string analysisContent = PacketAnalyzer.GenerateAnalysisReport(analyses);

        // 7️⃣ Convert both to bytes
        byte[] hexFileBytes = Encoding.UTF8.GetBytes(hexContent);
        byte[] analysisFileBytes = Encoding.UTF8.GetBytes(analysisContent);

        // 8️⃣ Create unique filename base
        string timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        string baseFileName = $"Program_{timestamp}";

        // 9️⃣ Download hex file
        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            $"{baseFileName}_packets.txt",
            "text/plain",
            hexFileBytes
        );

        // 🔟 Download analysis file (slight delay to ensure both downloads trigger)
        await Task.Delay(100);
        await JS.InvokeVoidAsync(
            "BlazorDownloadFile",
            $"{baseFileName}_analysis.txt",
            "text/plain",
            analysisFileBytes
        );
    }

    private async Task HandleDownload()
    {
        var exportSteps = steps.Select(s => new
        {
            s.StepNumber,
            s.OperatorCode,
            s.Label,
            s.Comment,
            s.NominalValues,
            s.Limits,
            Action = s.Actions,
            s.Registrations
        }).ToList();

        var options = new JsonSerializerOptions 
        { 
            WriteIndented = true,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        };
        var json = JsonSerializer.Serialize(exportSteps, options);
        await JS.InvokeVoidAsync("downloadFile", $"{programName.Replace(" ", "_")}.json", json);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();

                var importedSteps = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(content);
                if (importedSteps != null && importedSteps.Count > 0)
                {
                    steps.Clear();
                    foreach (var stepData in importedSteps)
                    {
                        var step = new StepModel
                        {
                            StepNumber = stepData["StepNumber"].GetInt32(),
                            OperatorCode = stepData["OperatorCode"].GetByte(),
                            Label = stepData.ContainsKey("Label") ? stepData["Label"].GetString() ?? "" : "",
                            Comment = stepData.ContainsKey("Comment") ? stepData["Comment"].GetString() ?? "" : "",
                            NominalValues = stepData.ContainsKey("NominalValues") ? 
                                stepData["NominalValues"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Limits = stepData.ContainsKey("Limits") ? 
                                stepData["Limits"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Actions = stepData.ContainsKey("Action") ? 
                                stepData["Action"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Registrations = stepData.ContainsKey("Registrations") ? 
                                stepData["Registrations"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new()
                        };
                        steps.Add(step);
                    }
                    RenumberSteps();
                    ValidateProgram();
                    isDirty = false;
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error importing file: {ex.Message}");
        }
    }

    private async Task HandleSaveDialogSave()
    {
        try
        {
            long programId;

            if (id == null || id == 0)
            {
                var createResponse = await ProgramService.CreateProgramAsync(
                new CreateProgramRequest
                {
                    Name = programName,
                    Description = programName,
                    MaxAh = 0,
                    ProgramTimeTicks = 0
                });

                if (!createResponse.Success)
                {
                    Toast.Error(createResponse.Message);
                    return;
                }

                programId = createResponse.Data.ProgramId;
                id = programId; // keep local state in sync
            }
            else
            {
                programId = id;
            }

            var updateResponse = await ProgramService.UpdateProgramAsync(
            new ProgramDTO
            {
                ProgramId = programId,
                ProgramName = programName,
                ProgramSteps = steps.Count,
                ProgramStepModel = steps,
                IsVaild = errors.Count == 0
            });

            if (!updateResponse.Success)
            {
                Toast.Error(updateResponse.Message);
                return;
            }

            BeforeSaveSteps = steps;
            showSaveDialog = false;
            pendingAction?.Invoke();
            pendingAction = null;

            SessionStorage.RemoveComponentState(programName);

            Toast.Success(updateResponse.Message);
        }
        catch (Exception ex)
        {
            // TODO: Log exception + show toaster
        }
    }
    
    private async Task HandleViewProducer(string programName)
    {
        var prog = allPrograms.FirstOrDefault(p => p.ProgramName == programName);
        if (prog == null)
        {
            // Try fetching from DB (in case allPrograms is stale)
            var resp = await ProgramService.GetProgramByNameAsync(programName);
            if (resp.Success && resp.Data != null)
                prog = resp.Data;
        }

        if (prog == null)
        {
            Toast.Error($"Program '{programName}' not found.");
            return;
        }

        producerViewerSteps = prog.ProgramStepModel ?? new();
        producerViewerName = programName;
        showProducerDialog = true;
        StateHasChanged();
    }

    private void HandleViewTable(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
            return;

        var result = FileManagerService.ReadFileContent(fileName);
        if (!result.Success)
        {
            Toast.Error(result.Message);
            return;
        }

        tableViewerFileName = fileName;
        tableViewerContent = result.Data ?? string.Empty;
        showTableViewerDialog = true;
        StateHasChanged();
    }

    private void HandleSaveDialogDiscard()
    {
        // Reset Set In UnsaveStage
        steps = BeforeSaveSteps;
        showSaveDialog = false;
        pendingAction?.Invoke();
        pendingAction = null;
        SessionStorage.RemoveComponentState(programName);
    }

   
