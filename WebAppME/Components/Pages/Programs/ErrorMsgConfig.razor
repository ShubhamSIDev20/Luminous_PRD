@page "/program/ErrorMessages"
@inject ICodeMessageService CodeMessageService

@using BatteryTestingSystem.Components.UI.PageHeader
@using BatteryTestingSystem.Components.UI.Card

<div class="flex flex-col h-full overflow-hidden">

    <!-- ── Header ── -->
    <div class="shrink-0 px-6 pt-6">
        <PageHeader Title="Error & Message Configuration"
                    Description="Configure and maintain error codes and system messages"
                    Icon="Lucide.SlidersVertical">
            <Actions>
                @if (ReadOnly)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full
                                 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400
                                 text-xs font-semibold border border-amber-200 dark:border-amber-700">
                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                        Read-Only
                    </span>
                }
            </Actions>
        </PageHeader>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center flex-1 gap-3 text-muted-foreground">
            <svg class="animate-spin h-8 w-8 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <p class="text-sm">Loading configuration…</p>
        </div>
    }
    else
    {
        <div class="flex-1 overflow-auto px-6 pb-6">
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mt-2">

                <!-- ══════════════════════════════════
                     ERROR CONFIGURATION
                ══════════════════════════════════ -->
                <div class="rounded-xl border border-border overflow-hidden bg-card shadow-sm">

                    <!-- Card Header -->
                    <div class="flex items-center justify-between px-5 py-3.5
                                bg-destructive/5 border-b border-destructive/20">
                        <div class="flex items-center gap-2.5">
                            <div class="flex h-7 w-7 items-center justify-center rounded-md
                                        bg-destructive/15 text-destructive">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-foreground leading-none">Error Configuration</p>
                                <p class="text-xs text-muted-foreground mt-0.5">10 error codes  ·  index 0 – 9</p>
                            </div>
                        </div>
                        <span class="text-xs font-mono font-medium text-destructive/70 bg-destructive/10
                                     px-2 py-0.5 rounded-md border border-destructive/20">ERR</span>
                    </div>

                    <!-- Column Labels -->
                    <div class="grid grid-cols-[3rem_1fr] border-b border-border
                                bg-muted/40 px-4 py-1.5">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground text-center">#</span>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground pl-2">Message</span>
                    </div>

                    <!-- 10 Rows -->
                    <div class="divide-y divide-border/60">
                        @for (int i = 0; i <= 9; i++)
                        {
                            int index = i;
                            bool isEven = index % 2 == 0;
                            <div class="grid grid-cols-[3rem_1fr] items-center
                                        @(isEven ? "bg-background" : "bg-muted/20")
                                        hover:bg-destructive/5 transition-colors duration-75 group">
                                <!-- Index Badge -->
                                <div class="flex items-center justify-center py-2">
                                    <span class="inline-flex items-center justify-center h-6 w-6 rounded
                                                 text-[11px] font-bold
                                                 text-destructive bg-destructive/10 border border-destructive/20
                                                 group-focus-within:bg-destructive group-focus-within:text-destructive-foreground
                                                 group-focus-within:border-destructive transition-colors">
                                        @i
                                    </span>
                                </div>
                                <!-- Input -->
                                <div class="pr-3 py-1.5">
                                    <input type="text"
                                           class="w-full h-8 px-2.5 text-sm rounded-md
                                                  bg-transparent border border-transparent
                                                  text-foreground placeholder:text-muted-foreground/40
                                                  focus:outline-none focus:bg-background focus:border-input focus:ring-1 focus:ring-destructive/30
                                                  disabled:cursor-not-allowed disabled:text-muted-foreground/50
                                                  transition-all"
                                           @bind="errorList[index].Message"
                                           disabled="@ReadOnly"
                                           placeholder="Error message @i…" />
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer / Save -->
                    <div class="px-4 py-3 border-t border-border bg-muted/20 flex items-center gap-3">
                        <button class="inline-flex items-center justify-center gap-1.5 h-8 px-4 rounded-md
                                       text-xs font-semibold bg-destructive text-destructive-foreground
                                       hover:bg-destructive/90 disabled:opacity-50 disabled:cursor-not-allowed
                                       transition-colors"
                                @onclick="SaveErrors"
                                disabled="@(ReadOnly || isSavingErrors)">
                            @if (isSavingErrors)
                            {
                                <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Saving…</span>
                            }
                            else
                            {
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                                </svg>
                                <span>Save Errors</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(errorSaveMessage))
                        {
                            <div class="flex items-center gap-1.5 text-xs font-medium
                                        @(errorSaveSuccess ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                @if (errorSaveSuccess)
                                {
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                }
                                @errorSaveMessage
                            </div>
                        }
                    </div>
                </div>

                <!-- ══════════════════════════════════
                     MESSAGE CONFIGURATION
                ══════════════════════════════════ -->
                <div class="rounded-xl border border-border overflow-hidden bg-card shadow-sm">

                    <!-- Card Header -->
                    <div class="flex items-center justify-between px-5 py-3.5
                                bg-primary/5 border-b border-primary/20">
                        <div class="flex items-center gap-2.5">
                            <div class="flex h-7 w-7 items-center justify-center rounded-md
                                        bg-primary/15 text-primary">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-foreground leading-none">Message Configuration</p>
                                <p class="text-xs text-muted-foreground mt-0.5">10 message codes  ·  index 0 – 9</p>
                            </div>
                        </div>
                        <span class="text-xs font-mono font-medium text-primary/70 bg-primary/10
                                     px-2 py-0.5 rounded-md border border-primary/20">MSG</span>
                    </div>

                    <!-- Column Labels -->
                    <div class="grid grid-cols-[3rem_1fr] border-b border-border
                                bg-muted/40 px-4 py-1.5">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground text-center">#</span>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground pl-2">Message</span>
                    </div>

                    <!-- 10 Rows -->
                    <div class="divide-y divide-border/60">
                        @for (int i = 0; i <= 9; i++)
                        {
                            int index = i;
                            bool isEven = index % 2 == 0;
                            <div class="grid grid-cols-[3rem_1fr] items-center
                                        @(isEven ? "bg-background" : "bg-muted/20")
                                        hover:bg-primary/5 transition-colors duration-75 group">
                                <!-- Index Badge -->
                                <div class="flex items-center justify-center py-2">
                                    <span class="inline-flex items-center justify-center h-6 w-6 rounded
                                                 text-[11px] font-bold
                                                 text-primary bg-primary/10 border border-primary/20
                                                 group-focus-within:bg-primary group-focus-within:text-primary-foreground
                                                 group-focus-within:border-primary transition-colors">
                                        @i
                                    </span>
                                </div>
                                <!-- Input -->
                                <div class="pr-3 py-1.5">
                                    <input type="text"
                                           class="w-full h-8 px-2.5 text-sm rounded-md
                                                  bg-transparent border border-transparent
                                                  text-foreground placeholder:text-muted-foreground/40
                                                  focus:outline-none focus:bg-background focus:border-input focus:ring-1 focus:ring-primary/30
                                                  disabled:cursor-not-allowed disabled:text-muted-foreground/50
                                                  transition-all"
                                           @bind="messageList[index].Message"
                                           disabled="@ReadOnly"
                                           placeholder="Message @i…" />
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Footer / Save -->
                    <div class="px-4 py-3 border-t border-border bg-muted/20 flex items-center gap-3">
                        <button class="inline-flex items-center justify-center gap-1.5 h-8 px-4 rounded-md
                                       text-xs font-semibold bg-primary text-primary-foreground
                                       hover:bg-primary/90 disabled:opacity-50 disabled:cursor-not-allowed
                                       transition-colors"
                                @onclick="SaveMessages"
                                disabled="@(ReadOnly || isSavingMessages)">
                            @if (isSavingMessages)
                            {
                                <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Saving…</span>
                            }
                            else
                            {
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                                </svg>
                                <span>Save Messages</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(messageSaveMessage))
                        {
                            <div class="flex items-center gap-1.5 text-xs font-medium
                                        @(messageSaveSuccess ? "text-green-600 dark:text-green-400" : "text-red-600 dark:text-red-400")">
                                @if (messageSaveSuccess)
                                {
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                }
                                @messageSaveMessage
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool ReadOnly { get; set; }

    private List<CodeMessageDto> errorList = new();
    private List<CodeMessageDto> messageList = new();
    private bool isLoading = true;
    private bool isSavingErrors = false;
    private bool isSavingMessages = false;
    private string errorSaveMessage = "";
    private string messageSaveMessage = "";
    private bool errorSaveSuccess = false;
    private bool messageSaveSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataFromDatabase();
        isLoading = false;
    }

    private async Task LoadDataFromDatabase()
    {
        var errorsResponse = await CodeMessageService.GetErrorsAsync();
        if (errorsResponse.Success && errorsResponse.Data != null)
            errorList = errorsResponse.Data;
        else
            InitializeEmptyErrorList();

        var messagesResponse = await CodeMessageService.GetMessagesAsync();
        if (messagesResponse.Success && messagesResponse.Data != null)
            messageList = messagesResponse.Data;
        else
            InitializeEmptyMessageList();
    }

    private void InitializeEmptyErrorList()
    {
        errorList = new List<CodeMessageDto>();
        for (int i = 0; i <= 9; i++)
            errorList.Add(new CodeMessageDto { Index = i, Type = 1, Message = "" });
    }

    private void InitializeEmptyMessageList()
    {
        messageList = new List<CodeMessageDto>();
        for (int i = 0; i <= 9; i++)
            messageList.Add(new CodeMessageDto { Index = i, Type = 2, Message = "" });
    }

    private async Task SaveErrors()
    {
        if (ReadOnly) return;
        isSavingErrors = true;
        errorSaveMessage = "";
        errorSaveSuccess = false;
        StateHasChanged();

        var response = await CodeMessageService.SaveErrorsAsync(errorList);
        errorSaveSuccess = response.Success;
        errorSaveMessage = response.Message;

        if (response.Success)
        {
            await LoadDataFromDatabase();
            await ErrorMessages.GetErrors(true);
        }

        isSavingErrors = false;
        StateHasChanged();
        await Task.Delay(3000);
        errorSaveMessage = "";
        StateHasChanged();
    }

    private async Task SaveMessages()
    {
        if (ReadOnly) return;
        isSavingMessages = true;
        messageSaveMessage = "";
        messageSaveSuccess = false;
        StateHasChanged();

        var response = await CodeMessageService.SaveMessagesAsync(messageList);
        messageSaveSuccess = response.Success;
        messageSaveMessage = response.Message;

        if (response.Success)
        {
            await LoadDataFromDatabase();
            await ErrorMessages.GetMessages(true);
        }

        isSavingMessages = false;
        StateHasChanged();
        await Task.Delay(3000);
        messageSaveMessage = "";
        StateHasChanged();
    }
}
