    private void SelectSection(string id)
    {
        _activeSectionId = id;
    }

    private string GetTocItemClass(string id)
        => id == _activeSectionId
            ? "manual-toc-item manual-toc-item-active"
            : "manual-toc-item";

    private static string GetScreenshotCaption(string filename)
    {
        var name = filename.EndsWith(".png") ? filename[..^4] : filename;
        var words = name.Split('-', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(' ', words.Select(w => char.ToUpperInvariant(w[0]) + w[1..]));
    }

    private async Task ExportToPdf()
    {
        var html = BuildPrintableHtml();
        await JS.InvokeVoidAsync("printManual", html);
    }

    private string BuildPrintableHtml()
    {
        var baseUri = Nav.BaseUri.TrimEnd('/');
        var sb = new StringBuilder();

        sb.Append("<html><head><title>BMS Monitor - User Manual</title><meta charset=\"utf-8\">");
        sb.Append(@"<style>
            body { font-family: Segoe UI, Arial, sans-serif; color: #1a1a1a; margin: 0; padding: 2rem; }
            h1 { font-size: 1.6rem; margin-bottom: 0.25rem; }
            h2 { font-size: 1.3rem; margin-top: 0; page-break-before: always; }
            article:first-of-type h2 { page-break-before: avoid; }
            .purpose { color: #555; margin-bottom: 1rem; }
            .topic { border: 1px solid #ddd; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1rem; page-break-inside: avoid; }
            .topic h3 { font-size: 1rem; margin: 0 0 0.5rem 0; }
            .topic ol { margin: 0 0 1rem 0; padding-left: 1.25rem; }
            .topic li { margin-bottom: 0.35rem; }
            figure { margin: 0 0 1rem 0; max-width: 700px; page-break-inside: avoid; }
            figure img { display: block; width: 100%; height: auto; border: 1px solid #ccc; border-radius: 4px; }
            figcaption { font-size: 0.8rem; color: #666; margin-top: 0.25rem; }
            .roles { font-size: 0.8rem; color: #666; margin-bottom: 1rem; }
            .cover { text-align: center; margin-bottom: 2rem; }
            .cover h1 { font-size: 2rem; }
            .toc { page-break-after: always; }
            .toc ol { padding-left: 1.25rem; }
        </style>");
        sb.Append("</head><body>");

        sb.Append("<div class=\"cover\"><h1>BMS Monitor</h1><p>User Manual</p></div>");

        sb.Append("<div class=\"toc\"><h2>Contents</h2><ol>");
        foreach (var section in _sections)
        {
            sb.Append($"<li>{HtmlEncoder.Default.Encode(section.Title)}</li>");
        }
        sb.Append("</ol></div>");

        foreach (var section in _sections)
        {
            sb.Append("<article>");
            sb.Append($"<h2>{HtmlEncoder.Default.Encode(section.Title)}</h2>");
            sb.Append($"<p class=\"purpose\">{HtmlEncoder.Default.Encode(section.Purpose)}</p>");

            if (section.RestrictedToRoles.Any())
            {
                sb.Append($"<p class=\"roles\">Visible to: {HtmlEncoder.Default.Encode(string.Join(", ", section.RestrictedToRoles))}</p>");
            }

            foreach (var topic in section.Topics)
            {
                sb.Append("<div class=\"topic\">");
                sb.Append($"<h3>{HtmlEncoder.Default.Encode(topic.Title)}</h3>");

                if (topic.Steps.Any())
                {
                    sb.Append("<ol>");
                    foreach (var step in topic.Steps)
                    {
                        sb.Append($"<li>{HtmlEncoder.Default.Encode(step)}</li>");
                    }
                    sb.Append("</ol>");
                }

                foreach (var shot in topic.Screenshots)
                {
                    if (!_availableScreenshots.Contains(shot)) continue;
                    var url = $"{baseUri}/images/manual/{shot}";
                    var caption = HtmlEncoder.Default.Encode(GetScreenshotCaption(shot));
                    sb.Append($"<figure><img src=\"{url}\" alt=\"{caption}\"><figcaption>{caption}</figcaption></figure>");
                }

                sb.Append("</div>");
            }

            sb.Append("</article>");
        }

        sb.Append("</body></html>");
        return sb.ToString();
    }
}
