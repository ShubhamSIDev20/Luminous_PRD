@namespace BatteryTestingSystem.Components.UI.DropdownMenu

@if (ParentDropdown?.Open == true)
{
    <div class="@GetClasses()" 
         style="@GetPositionStyle()"
         @onclick:stopPropagation="true"
         @attributes="AdditionalAttributes">
        <CascadingValue Value="ParentDropdown">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    [CascadingParameter]
    private DropdownMenu? ParentDropdown { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public DropdownAlign Align { get; set; } = DropdownAlign.Start;

    [Parameter]
    public int SideOffset { get; set; } = 4;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetClasses()
    {
        var baseClasses = "absolute z-50 min-w-[8rem] rounded-md border bg-popover p-1 text-popover-foreground shadow-md animate-in fade-in-0 zoom-in-95";
        return string.IsNullOrWhiteSpace(Class) ? baseClasses : $"{baseClasses} {Class}";
    }

    private string GetPositionStyle()
    {
        var alignStyle = Align switch
        {
            DropdownAlign.Start => "left: 0;",
            DropdownAlign.Center => "left: 50%; transform: translateX(-50%);",
            DropdownAlign.End => "right: 0;",
            _ => "left: 0;"
        };
        return $"top: 100%; margin-top: {SideOffset}px; {alignStyle}";
    }
}
