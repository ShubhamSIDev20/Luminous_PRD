@namespace BatteryTestingSystem.Components.UI.DropdownMenu

<div class="relative" @onmouseenter="() => _isOpen = true" @onmouseleave="() => _isOpen = false">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    internal bool _isOpen { get; set; }
}
