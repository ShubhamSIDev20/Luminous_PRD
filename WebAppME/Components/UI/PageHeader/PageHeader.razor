@* 
  PageHeader Component
  Usage: <PageHeader Title="Dashboard" Description="Overview of your activity" Icon="grid" Breadcrumbs="@breadcrumbs" />

  Possible things to display in page header:
  1. Page Title + Description
  2. Breadcrumb navigation
  3. Action buttons (Add, Export, Filter)
  4. Status badge / Tags
  5. Last updated timestamp
  6. Search bar
  7. Tab/segment switcher
  8. Avatar + user context (e.g. "Viewing as Admin")
  9. Page icon / emoji
  10. Stats summary row (e.g. "42 items · 3 pending")
*@
@namespace BatteryTestingSystem.Components.UI.PageHeader

@using Microsoft.AspNetCore.Components

<div class="shrink-0 mb-6 border-b border-border pb-5">

    @* ── Top Row: Breadcrumbs ── *@
    @if (Breadcrumbs != null && Breadcrumbs.Any())
    {
        <nav class="mb-2 flex items-center gap-1 text-xs text-muted-foreground" aria-label="Breadcrumb">
            @foreach (var (crumb, index) in Breadcrumbs.Select((c, i) => (c, i)))
            {
                if (index > 0)
                {
                    <span class="text-muted-foreground/50">/</span>
                }

                @if (index == Breadcrumbs.Count - 1)
                {
                    <span class="font-medium text-foreground">@crumb.Label</span>
                }
                else
                {
                    <a href="@crumb.Href" class="hover:text-foreground transition-colors">@crumb.Label</a>
                }
            }
        </nav>
    }

    @* ── Main Row: Icon + Title + Actions ── *@
    <div class="flex items-start justify-between gap-4">

        <div class="flex items-start gap-3 min-w-0">

            @* Optional Icon *@
            @if (Icon != null)
            {
                <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <Blazicon Svg="@Icon" class="h-4 w-4" />
                </div>
            }

            <div class="min-w-0">
                @* Title + optional badge *@
                <div class="flex flex-wrap items-center gap-2">
                    <h1 class="truncate text-xl font-semibold tracking-tight text-foreground">
                        @Title
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(BadgeText))
                    {
                        <span class="@GetBadgeClass() inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium">
                            @BadgeText
                        </span>
                    }
                </div>

                @* Description *@
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="mt-0.5 text-sm text-muted-foreground leading-relaxed">
                        @Description
                    </p>
                }

                @* Meta info row *@
                @if (ShowMeta)
                {
                    <div class="mt-1.5 flex flex-wrap items-center gap-3 text-xs text-muted-foreground">
                        @if (!string.IsNullOrWhiteSpace(LastUpdated))
                        {
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-rounded text-[14px]">schedule</span>
                                Updated @LastUpdated
                            </span>
                        }
                        @if (ItemCount.HasValue)
                        {
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-rounded text-[14px]">data_array</span>
                                @ItemCount items
                            </span>
                        }
                        @MetaContent
                    </div>
                }
            </div>
        </div>

        @* Actions slot *@
        @if (Actions != null)
        {
            <div class="flex shrink-0 items-center gap-2">
                @Actions
            </div>
        }
    </div>

    @* Optional Tab Strip *@
    @if (Tabs != null && Tabs.Any())
    {
        <div class="mt-4 flex gap-0 border-b border-transparent -mb-5">
            @foreach (var tab in Tabs)
            {
                <button
                    type="button"
                    @onclick="() => OnTabChanged.InvokeAsync(tab.Key)"
                    class="@GetTabClass(tab.Key) relative px-3 pb-3 pt-1 text-sm font-medium transition-colors">
                    @tab.Label
                    @if (tab.Count.HasValue)
                    {
                        <span class="ml-1.5 rounded-full bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                            @tab.Count
                        </span>
                    }
                    @if (ActiveTab == tab.Key)
                    {
                        <span class="absolute bottom-0 left-0 right-0 h-0.5 rounded-full bg-primary"></span>
                    }
                </button>
            }
        </div>
    }

</div>

@code {
    /// <summary>Main page title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Supporting description shown below the title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Material Symbols icon name (e.g. "dashboard", "grid_view", "people").</summary>
    [Parameter] public SvgIcon? Icon { get; set; }

    /// <summary>Optional badge label next to the title.</summary>
    [Parameter] public string? BadgeText { get; set; }

    /// <summary>Badge color variant: default | success | warning | destructive | info.</summary>
    [Parameter] public string BadgeVariant { get; set; } = "default";

    /// <summary>Breadcrumb trail items.</summary>
    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    /// <summary>Render fragment for action buttons (top-right area).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Show the meta info row (timestamp, count, etc.).</summary>
    [Parameter] public bool ShowMeta { get; set; }

    /// <summary>Last updated text.</summary>
    [Parameter] public string? LastUpdated { get; set; }

    /// <summary>Item count shown in meta row.</summary>
    [Parameter] public int? ItemCount { get; set; }

    /// <summary>Extra meta content slot.</summary>
    [Parameter] public RenderFragment? MetaContent { get; set; }

    /// <summary>Tab definitions.</summary>
    [Parameter] public List<TabItem>? Tabs { get; set; }

    /// <summary>Currently active tab key.</summary>
    [Parameter] public string? ActiveTab { get; set; }

    /// <summary>Fired when a tab is clicked.</summary>
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }

    private string GetBadgeClass() => BadgeVariant switch
    {
        "success"     => "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400",
        "warning"     => "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400",
        "destructive" => "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400",
        "info"        => "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400",
        _             => "bg-muted text-muted-foreground",
    };

    private string GetTabClass(string key) => key == ActiveTab
        ? "text-foreground"
        : "text-muted-foreground hover:text-foreground";

    // ── Supporting models ──────────────────────────────────────────────────────

    public class BreadcrumbItem
    {
        public string Label { get; set; } = string.Empty;
        public string Href  { get; set; } = "#";
    }

    public class TabItem
    {
        public string  Key   { get; set; } = string.Empty;
        public string  Label { get; set; } = string.Empty;
        public int?    Count { get; set; }
    }
}
