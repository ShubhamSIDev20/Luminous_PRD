@namespace BatteryTestingSystem.Components.UI

@using System.Text.Json
@using BatteryTestingSystem.Components.UI
@using BatteryTestingSystem.Utils
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS

<div class="flex flex-col bg-background">
    <div class="flex items-center justify-between px-4 py-3 bg-card border-b border-border">
        <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
                <Blazicon Svg="Lucide.FileText" class="w-5 h-5 text-primary" />
                <span class="text-sm font-medium">@programName</span>
                <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded">Read Only</span>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (errors.Count == 0)
            {
                <div class="flex items-center gap-1.5 text-green-500 text-sm">
                    <div class="w-2 h-2 rounded-full bg-green-500"></div>
                    Valid
                </div>
            }
            else
            {
                <div class="flex items-center gap-1.5 text-red-500 text-sm">
                    <Blazicon Svg="Lucide.TriangleAlert" class="w-4 h-4" />
                    @errors.Count @(errors.Count == 1 ? "error" : "errors")
                </div>
            }
        </div>

        <div class="flex items-center gap-1">
         @*    <button @onclick="HandleDownload" class="flex items-center gap-1.5 px-3 py-1.5 rounded text-sm font-medium hover:bg-secondary transition-colors">
                <Blazicon Svg="Lucide.Download" class="w-4 h-4" />
                Download
            </button>

            <button @onclick="@(() => JS.InvokeVoidAsync("selectFile", "fileInput"))" class="flex items-center gap-1.5 px-3 py-1.5 rounded text-sm font-medium hover:bg-secondary transition-colors">
                <Blazicon Svg="Lucide.Upload" class="w-4 h-4" />
                Load Program
            </button>

            @if (OnEdit.HasDelegate)
            {
                <div class="w-px h-6 bg-border mx-2"></div>
                <button @onclick="@(() => OnEdit.InvokeAsync())" class="flex items-center gap-1.5 px-3 py-1.5 rounded text-sm font-medium bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
                    <Blazicon Svg="Lucide.Pencil" class="w-4 h-4" />
                    Edit Mode
                </button>
            } *@
        </div>
    </div>

    <ScrollArea class="flex-1 max-h-[60vh]">
        <table class="w-full border-collapse">
            <thead class="sticky top-0 z-10">
                <tr>
                    <th class="grid-header-cell w-12">#</th>
                    <th class="grid-header-cell w-8"></th>
                    <th class="grid-header-cell w-24">Label</th>
                    <th class="grid-header-cell w-32">Operator</th>
                    <th class="grid-header-cell min-w-[160px]">Nominal Values</th>
                    <th class="grid-header-cell min-w-[280px]" colspan="2">Limits → Actions</th>
                    <th class="grid-header-cell min-w-[140px]">Registrations</th>
                    <th class="grid-header-cell min-w-[120px]">Comment</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < steps.Count; i++)
                {
                    var step = steps[i];
                    var index = i;
                    var hasErrors = GetStepErrors(step.Id).Any() || GetInlineErrors(step).Any();

                    <tr class="border-b border-grid-border @(step.StepNumber % 2 == 0 ? "bg-grid-row-alt" : "bg-grid-row") @(IsStepRunning == step.StepNumber ? "bg-grid-row-selected" : "")">
                        <td class="grid-cell w-12 text-center text-muted-foreground">
                            @step.StepNumber
                        </td>

                        <td class="grid-cell w-8 text-center">
                            @if (hasErrors)
                            {
                                <div class="relative group/error">
                                    <Blazicon Svg="Lucide.CircleAlert" class="w-4 h-4 text-red-500" />
                                    <div class="absolute left-full top-0 ml-2 z-50 hidden group-hover/error:block">
                                        <div class="bg-card border border-border rounded-md p-2 shadow-lg text-xs max-w-[200px] whitespace-nowrap">
                                            @foreach (var error in GetStepErrors(step.Id))
                                            {
                                                <div class="text-red-500">@error.Message</div>
                                            }
                                            @foreach (var error in GetInlineErrors(step))
                                            {
                                                <div class="text-red-500">@error</div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="validation-dot valid mx-auto"></div>
                            }
                        </td>

                        <td class="grid-cell w-24">
                            <span class="text-sm font-mono primary @(!string.IsNullOrEmpty(step.Label) ? "bg-primary/10 text-foreground" : "")">@(string.IsNullOrEmpty(step.Label) ? "-" : step.Label)</span>
                        </td>

                        <td class="grid-cell w-32">
                            <OperatorBadge OperatorCode="@step.OperatorCode" />
                        </td>

                        <td class="grid-cell min-w-[160px]">
                            @if (step.NominalValues.Any())
                            {
                                @if (step.OperatorCode == OperatorConstants.PRODUCER && step.NominalValues.Count > 0)
                                {
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-mono bg-violet-500/10 text-violet-600 dark:text-violet-400 border border-violet-500/20">
                                            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                            </svg>
                                            @step.NominalValues[0]
                                        </span>
                                    </div>
                                }
                                else if (step.OperatorCode == OperatorConstants.TABLE && step.NominalValues.Count > 0)
                                {
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-xs font-mono bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                                            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                            @step.NominalValues[0]
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var value in step.NominalValues)
                                        {
                                            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-mono bg-primary/10 text-foreground border border-primary/20">
                                                @value
                                            </span>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-muted-foreground/50 text-xs">-</span>
                            }
                        </td>

                        <td class="grid-cell min-w-[280px]" colspan="2">
                            @if (step.Limits.Any())
                            {
                                <div class="space-y-1">
                                    @for (int j = 0; j < step.Limits.Count; j++)
                                    {
                                        var limit = step.Limits[j];
                                        var action = j < step.Actions.Count ? step.Actions[j] : "";
                                        <div class="flex items-center gap-1 p-1 rounded bg-secondary/30 border border-border/50">
                                            <div class="flex-1 px-1.5 py-0.5 rounded text-xs font-mono bg-primary/10 text-foreground">
                                                @limit
                                            </div>
                                            <span class="text-muted-foreground/50">→</span>
                                            <div class="flex-1 px-1.5 py-0.5 rounded text-xs font-mono bg-accent/10 text-foreground">
                                                @(string.IsNullOrEmpty(action) ? "" : action)
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted-foreground/50 text-xs">-</span>
                            }
                        </td>

                        <td class="grid-cell min-w-[140px]">
                            @if (step.Registrations.Any())
                            {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var value in step.Registrations)
                                    {
                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-mono bg-primary/10 text-foreground border border-primary/20">
                                            @value
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted-foreground/50 text-xs">-</span>
                            }
                        </td>

                        <td class="grid-cell min-w-[120px]">
                            <span class="text-sm @(!string.IsNullOrEmpty(step.Label) ? "bg-primary/10 text-foreground" : "text-muted-foreground")">@(string.IsNullOrEmpty(step.Comment) ? "-" : step.Comment)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </ScrollArea>

    <div class="px-4 py-2 bg-card border-t border-border flex items-center justify-between text-xs text-muted-foreground">
        <div class="flex items-center gap-4">
            <span>Total Steps: @steps.Count</span>
            <span>Global Variables: @globalVariables.Count</span>
        </div>
        <span class="text-xs bg-muted px-2 py-1 rounded">Read-Only Mode</span>
    </div>

    <InputFile id="fileInput" OnChange="@HandleFileUpload" accept=".json" style="display: none;" />
</div>

@code {
    [Parameter] public List<StepModel>? InitialSteps { get; set; }
    [Parameter] public string InitialProgramName { get; set; } = "Program";
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public int? IsStepRunning { get; set; }

    private List<StepModel> steps = new();
    private List<ValidationError> errors = new();
    private List<GlobalVariable> globalVariables = new();
    private HashSet<string> allLabels = new();
    private string programName = "Program";

    protected override void OnInitialized()
    {
        programName = InitialProgramName;
        
        if (InitialSteps != null && InitialSteps.Any())
        {
            steps = InitialSteps;
        }
        else
        {
            InitializeProgram();
        }
        
        ValidateProgram();
    }

    private void InitializeProgram()
    {
        steps = new()
        {
            new StepModel { StepNumber = 1, OperatorCode = OperatorConstants.SET, Registrations = new() { "STANDARD" } },
            new StepModel { StepNumber = 2, OperatorCode = OperatorConstants.CC_CHG },
            new StepModel { StepNumber = 3, OperatorCode = OperatorConstants.STO }
        };
    }

    private void ValidateProgram()
    {
        errors.Clear();
        globalVariables.Clear();
        allLabels.Clear();

        foreach (var step in steps)
        {
            if (!string.IsNullOrWhiteSpace(step.Label))
                allLabels.Add(step.Label);

            if (step.OperatorCode == OperatorConstants.SET)
            {
                foreach (var nomVal in step.NominalValues)
                {
                    ParseSetVariable(nomVal, step.Id);
                }
            }
        }

        // "Ah"/"Wh" are protocol global-parameter resets, not exclusive user-named variables - a
        // program legitimately declares "SET Ah = 0" more than once (OperatorConstants.SetGlobalParameterNames).
        var duplicateVars = globalVariables.GroupBy(v => v.Name)
            .Where(g => g.Count() > 1 && !OperatorConstants.SetGlobalParameterNames.Contains(g.Key))
            .Select(g => g.Key).ToList();
        if (duplicateVars.Any())
        {
            foreach (var dupVar in duplicateVars)
            {
                var setSteps = globalVariables.Where(v => v.Name == dupVar).Select(v => v.StepId).Distinct();
                foreach (var stepId in setSteps)
                {
                    var step = steps.FirstOrDefault(s => s.Id == stepId);
                    if (step != null)
                    {
                        errors.Add(new ValidationError
                        {
                            StepId = stepId,
                            StepNumber = step.StepNumber,
                            Field = "NominalValues",
                            Message = $"Duplicate variable: {dupVar}"
                        });
                    }
                }
            }
        }

        foreach (var placeholder in BatteryUnitResolver.GetPlaceholderGlobalVariables())
        {
            if (!globalVariables.Any(v => string.Equals(v.Name, placeholder.Name, StringComparison.OrdinalIgnoreCase)))
                globalVariables.Add(placeholder);
        }

        foreach (var step in steps)
        {
            ValidateStep(step);
        }
    }

    private void ParseSetVariable(string value, string stepId)
    {
        if (string.IsNullOrWhiteSpace(value)) return;

        value = value.Trim().Trim('(', ')');
        var parts = value.Split('=', StringSplitOptions.TrimEntries);
        if (parts.Length == 2)
        {
            var varName = parts[0];
            var valueParts = parts[1].Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (valueParts.Length > 0)
            {
                var unit = valueParts.Length > 1 ? ValidationHelper.AutoCorrectUnit(valueParts[1]) : null;
                globalVariables.Add(new GlobalVariable
                {
                    Name = varName,
                    Value = valueParts[0],
                    Unit = unit,
                    StepId = stepId
                });
            }
        }
    }


    private void ValidateStep(StepModel step)
    {
        var config = NominalConfig.Configs.TryGetValue(step.OperatorCode, out var cfg)
            ? cfg
            : null;

        /* -----------------------------
         * 1️⃣ Nominal presence rules
         * ----------------------------- */
        if (config != null && !config.Disabled && !config.AllowCustom && config.Fields.Any())
        {
            if (step.NominalValues.Count < config.Fields.Count)
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = "NominalValues",
                        Message = "Missing required nominal values"
                    });
            }
        }

        /* -----------------------------
         * 2️⃣ Nominal value validation
         * ----------------------------- */
        foreach (var (nominal, index) in step.NominalValues.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateNominal(
                nominal,
                index,
                step.OperatorCode,
                allLabels, 
                globalVariables
            );

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = $"NominalValues[{index}]",
                        Message = result.Error
                    });
            }
        }

        /* -----------------------------
         * 3️⃣ Limit presence rules
         * ----------------------------- */
        if (OperatorConstants.LimitActionAllowed.TryGetValue(step.OperatorCode, out var allowed) &&
            allowed &&
            step.Limits.Count == 0 &&
            step.OperatorCode != OperatorConstants.PAU)
        {
            errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = "Limits",
                    Message = "At least one limit-action pair required"
                });
        }

        /* -----------------------------
         * 4️⃣ Limit value validation
         * ----------------------------- */
        foreach (var (limit, index) in step.Limits.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateLimit(
                limit,
                step.OperatorCode,
                globalVariables
            );

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = $"Limits[{index}]",
                        Message = result.Error
                    });
            }
        }

        /* -----------------------------
         * 5️⃣ Action validation
         * ----------------------------- */
        foreach (var (action, index) in step.Actions.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateAction(action, allLabels);

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = $"Actions[{index}]",
                        Message = result.Error
                    });
            }
        }

        /* -----------------------------
         * 6️⃣ Registration validation
         * ----------------------------- */
        foreach (var (reg, index) in step.Registrations.Select((v, i) => (v, i)))
        {
            var result = ValidationHelper.ValidateRegistration(reg, step.OperatorCode, globalVariables);

            if (!result.IsValid && !string.IsNullOrEmpty(result.Error))
            {
                errors.Add(new ValidationError
                {
                    StepId = step.Id,
                    StepNumber = step.StepNumber,
                    Field = $"Registrations[{index}]",
                    Message = result.Error
                });
            }
        }

        /* -----------------------------
         * 7️⃣ Cross-step rule (CYC → BEG)
         * ----------------------------- */
        if (step.OperatorCode == OperatorConstants.CYC)
        {
            var hasBegBefore = steps
                .Take(step.StepNumber - 1)
                .Any(s => s.OperatorCode == OperatorConstants.BEG);

            if (!hasBegBefore)
            {
                errors.Add(new ValidationError
                    {
                        StepId = step.Id,
                        StepNumber = step.StepNumber,
                        Field = "Operator",
                        Message = "CYC requires BEG step before it"
                    });
            }
        }
    }

    private List<ValidationError> GetStepErrors(string stepId)
    {
        return errors.Where(e => e.StepId == stepId).ToList();
    }

    private List<string> GetInlineErrors(StepModel step)
    {
        var stepErrors = new List<string>();

        foreach (var limit in step.Limits)
        {
            var validation = ValidationHelper.ValidateLimit(limit, step.OperatorCode, globalVariables);
            if (!validation.IsValid && !string.IsNullOrEmpty(validation.Error))
                stepErrors.Add($"Limit: {validation.Error}");
        }

        foreach (var action in step.Actions)
        {
            var validation = ValidationHelper.ValidateAction(action, allLabels);
            if (!validation.IsValid && !string.IsNullOrEmpty(validation.Error))
                stepErrors.Add($"Action: {validation.Error}");
        }

        foreach (var reg in step.Registrations)
        {
            var validation = ValidationHelper.ValidateRegistration(reg, step.OperatorCode, globalVariables);
            if (!validation.IsValid && !string.IsNullOrEmpty(validation.Error))
                stepErrors.Add($"Registration: {validation.Error}");
        }

        return stepErrors;
    }

    private async Task HandleDownload()
    {
        var exportSteps = steps.Select(s => new
        {
            s.StepNumber,
            s.OperatorCode,
            s.Label,
            s.Comment,
            s.NominalValues,
            s.Limits,
            Action = s.Actions,
            s.Registrations
        }).ToList();

        var options = new JsonSerializerOptions 
        { 
            WriteIndented = true,
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        };
        var json = JsonSerializer.Serialize(exportSteps, options);
        await JS.InvokeVoidAsync("downloadFile", $"{programName.Replace(" ", "_")}.json", json);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();
                
                var importedSteps = JsonSerializer.Deserialize<List<Dictionary<string, JsonElement>>>(content);
                if (importedSteps != null && importedSteps.Count > 0)
                {
                    steps.Clear();
                    foreach (var stepData in importedSteps)
                    {
                        var step = new StepModel
                        {
                            StepNumber = stepData["StepNumber"].GetInt32(),
                            OperatorCode = stepData["OperatorCode"].GetByte(),
                            Label = stepData.ContainsKey("Label") ? stepData["Label"].GetString() ?? "" : "",
                            Comment = stepData.ContainsKey("Comment") ? stepData["Comment"].GetString() ?? "" : "",
                            NominalValues = stepData.ContainsKey("NominalValues") ? 
                                stepData["NominalValues"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Limits = stepData.ContainsKey("Limits") ? 
                                stepData["Limits"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Actions = stepData.ContainsKey("Action") ? 
                                stepData["Action"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new(),
                            Registrations = stepData.ContainsKey("Registrations") ? 
                                stepData["Registrations"].EnumerateArray().Select(x => x.GetString() ?? "").ToList() : new()
                        };
                        steps.Add(step);
                    }
                    ValidateProgram();
                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error importing file: {ex.Message}");
        }
    }
}
