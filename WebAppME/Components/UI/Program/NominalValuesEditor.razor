    private int? editingIndex = null;
    private string editValue = string.Empty;


    private void UpdateFieldValue(int index, string value)
    {
        while (Values.Count <= index)
        {
            Values.Add("");
        }
        Values[index] = value;
        OnUpdate.InvokeAsync((index, value));
    }

    private void AutoCorrect(int index, string value)
    {
        if (Config == null || index >= Config.Fields.Count || string.IsNullOrEmpty(value))
            return;

        var field = Config.Fields[index];

        value = Regex.Replace(value, @"(?<=\d)(?=[a-zA-Z])", " ");

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        var val = parts.Length > 0 ? parts[0] : string.Empty; ;
        var unit = parts.Length > 1 ? parts[1] : null;

        var match = GlobalVariables.FirstOrDefault(gv => gv.Name.Equals(parts[0], StringComparison.OrdinalIgnoreCase));

        if (match != null)
        {
            val = match.Name;

            // A matched variable's unit is intrinsic to its definition (a SET-defined var, or a
            // §12.3 battery-parameter placeholder like INom/CNom) — never append a suffix here.
            // This used to force-overwrite to field.Unit unconditionally, which for a variable
            // whose real unit doesn't match this field (e.g. "CNom" — Ah — typed into a Current
            // field) displayed a misleading "CNom A" after blur. ValidateNominal already rejects
            // that combination regardless of what's displayed, so there's nothing to preserve by
            // appending it; for a correctly-matching variable (e.g. "INom" in a Current field)
            // ProcessNominalValues always resolves via the variable's own stored Unit anyway, so
            // dropping the appended suffix here changes nothing at encode time — see
            // Utils/BatteryUnitResolver.cs / docs/Battery-Parameters-Intern-Table-Plan.md.
            unit = null;
        }
        else
        {
            // A field can accept more than one unit (e.g. Current also accepts the ACNx
            // family, Voltage also accepts VN) — only fall back to the field's default unit
            // when the typed unit isn't one of those; otherwise keep it (normalized to the
            // canonical casing), or this would silently rewrite "10 ACn5" into "10 A".
            var accepted = field.AcceptedUnits.FirstOrDefault(u => string.Equals(u, unit, StringComparison.OrdinalIgnoreCase));

            // ACN<n> accepts any positive-integer hour divisor (ACN3, ACN7, ...), not just the
            // fixed set literally listed in AcceptedUnits — but only on a field that accepts the
            // ACN family at all (a Current field). Without this, blurring "10 ACN7" here would
            // silently rewrite it to "10 A" before ValidateNominal ever runs, same bug class as
            // the "10 ACn5" case above. Marker is a shape check (StartsWith "ACN"), not a literal
            // Contains("ACN") — bare "ACN" is deliberately not in AcceptedUnits any more (the
            // editor now requires an explicit divisor), so a literal-equality marker would always
            // be false. Deliberately uses the broad IsAcnUnit (not IsValidAcnUnit) here too — even
            // a bare "ACN" or "ACN0" must be preserved as typed, not collapsed to "A", so
            // ValidateNominal can reject it with a clear error instead of the field silently
            // showing a different, valid-looking value.
            if (accepted == null && unit != null &&
                BatteryUnitResolver.IsAcnUnit(unit) &&
                field.ExtraUnits.Any(u => u.StartsWith("ACN", StringComparison.OrdinalIgnoreCase)))
            {
                accepted = unit.Trim().ToUpperInvariant();
            }

            unit = accepted ?? field.Unit;
        }

        // if (!string.IsNullOrEmpty(unit))
        // {
        //     unit = OperatorConstants.ValidUnits.FirstOrDefault(e => e.StartsWith(unit));
        // }   

        Values[index] = string.IsNullOrEmpty(unit) ? val : $"{val} {unit}";

    }

