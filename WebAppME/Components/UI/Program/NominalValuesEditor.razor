@namespace BatteryTestingSystem.Components.UI
@using System.Text.RegularExpressions


@if (Disabled)
{
    <span class="text-muted-foreground/50 text-xs italic"></span>
}
else if (Config?.AllowCustom == true)
{
    <div class="space-y-1">
        @foreach (var (value, index) in Values.Select((v, i) => (v, i)))
        {

            var validation = ValidationHelper.ValidateNominal(value, index, OperatorCode, AllLabels, GlobalVariables, AllStepNumbers);
            <div class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-xs font-mono mr-1 mb-1 animate-scale-in group @(validation.IsValid ? "bg-primary/10 text-foreground border border-primary/20" : "bg-red-500/20 text-red-500 border border-red-500/30")" title="@validation.Error">
                @if (editingIndex == index)
                {
                    <input type="text" 
                    @bind="editValue" 
                    @onkeydown="@((e) => HandleEditKeyDown(e, index))"
                    @onfocus="@(() => StartEditing(index, value))"
                    @onblur="@(() => ConfirmEdit(index))" 
                    @onclick:stopPropagation="true" class="bg-transparent outline-none text-xs min-w-[80px]" />
                }
                else
                {
                    <span @ondblclick="@(() => StartEditing(index, value))" class="cursor-pointer">@value</span>
                    <button @onclick="@(() => StartEditing(index, value))" class="p-0.5 rounded hover:bg-foreground/10 transition-colors opacity-0 group-hover:opacity-100">
                        <Blazicon Svg="Lucide.Pencil" class="w-2.5 h-2.5" />
                    </button>
                    <button @onclick="@(() => OnRemove.InvokeAsync(index))" class="p-0.5 rounded hover:bg-red-500/20 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100">
                        <Blazicon Svg="Lucide.X" class="w-2.5 h-2.5" />
                    </button>
                }
            </div>
        }

        <div class="inline-flex items-center gap-1 px-1 py-0.5 rounded border border-dashed border-border/50 hover:border-primary/30 transition-colors">
            <input type="text"
            @bind="input"
            @bind:event="oninput"
            @onkeydown="HandleKeyDown" 
            placeholder="" class="min-w-[100px] bg-transparent outline-none text-xs font-mono placeholder:text-muted-foreground/40" />
            <button @onclick="HandleAdd" disabled="@string.IsNullOrWhiteSpace(input)" class="p-0.5 rounded hover:bg-primary/20 text-primary transition-colors disabled:opacity-30">
                <Blazicon Svg="Lucide.Plus" class="w-3 h-3" />
            </button>
        </div>
    </div>
}
else if (OperatorCode == OperatorConstants.TABLE)
{
    <div class="flex items-center gap-2">
        <select @onchange="@((e) => UpdateFieldValue(0, e.Value?.ToString() ?? ""))" class="px-2 py-1 rounded text-xs font-mono border border-border bg-background focus:outline-none focus:ring-1 focus:ring-primary">
            <option value="">Select Table</option>
            @foreach (var table in FileManagerService.GetAllFiles())
            {
                <option value="@table.FileName" selected="@(Values.FirstOrDefault() == table.FileName)">@table.FileNameWithoutExt</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(Values.FirstOrDefault()))
        {
            <button @onclick="@(() => OnViewTable.InvokeAsync(Values.FirstOrDefault()))" class="p-1 rounded hover:bg-secondary transition-colors" title="View table">
                <Blazicon Svg="Lucide.Eye" class="w-4 h-4 text-primary" />
            </button>
        }
    </div>
}
else if (OperatorCode == OperatorConstants.PRODUCER)
{
    <div class="flex items-center gap-2">
        <select @onchange="@((e) => UpdateFieldValue(0, e.Value?.ToString() ?? ""))" class="px-2 py-1 rounded text-xs font-mono border border-border bg-background focus:outline-none focus:ring-1 focus:ring-primary">
            <option value="">Select Program</option>
            @foreach (var prog in AllPrograms)
            {
                <option value="@prog.ProgramName" selected="@(Values.FirstOrDefault() == prog.ProgramName)">@prog.ProgramName</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(Values.FirstOrDefault()))
        {
            <button @onclick="@(() => OnViewProducer.InvokeAsync(Values.FirstOrDefault()))" class="p-1 rounded hover:bg-secondary transition-colors" title="View program">
                <Blazicon Svg="Lucide.Eye" class="w-4 h-4 text-primary" />
            </button>
        }
    </div>
}
else if (Config?.Fields?.Any() == true)
{
    <div class="flex gap-2">
        @for (int i = 0; i < Config.Fields.Count; i++)
        {
            var field = Config.Fields[i];
            var fieldIndex = i;
            var currentValue = fieldIndex < Values.Count ? Values[fieldIndex] : "";
            var validation = ValidationHelper.ValidateNominal(currentValue, fieldIndex, OperatorCode, AllLabels, GlobalVariables, AllStepNumbers);

            <div class="flex items-center gap-1">
                <input 
                type="text"
                value="@currentValue"
                @oninput="@((e) => UpdateFieldValue(fieldIndex, e.Value?.ToString() ?? ""))"
                @onblur="@((e) => AutoCorrect(fieldIndex, currentValue ?? ""))"
                placeholder="@field.Placeholder"
                class="w-24 px-2 py-1 rounded text-xs font-mono border @(validation.IsValid ? "bg-primary/10 text-foreground border border-primary/20 border-border" : "bg-red-500/20 text-red-500 border-red-500") focus:outline-none focus:ring-1 @(validation.IsValid ? "focus:ring-primary" : "focus:ring-red-500")"
                title="@validation.Error" />
                @*   @if (!string.IsNullOrEmpty(field.Unit))s
                {
                    <span class="text-xs text-muted-foreground">@field.Unit</span>
                } *@
            </div>
        }
    </div>
}

