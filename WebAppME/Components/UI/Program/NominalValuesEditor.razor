    private void HandleAdd()
    {
        if (!string.IsNullOrWhiteSpace(input))
        {
            OnAdd.InvokeAsync(input.Trim());
            input = string.Empty;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Tab") HandleAdd();
        else if (e.Key == "Escape") input = string.Empty;
    }

    private void StartEditing(int index, string value)
    {
        editingIndex = index;
        editValue = value;
    }

    private void ConfirmEdit(int index)
    {

        AutoCorrect(index, editValue);

        if (!string.IsNullOrWhiteSpace(editValue))
        {
            OnUpdate.InvokeAsync((index, editValue.Trim()));
        }
        editingIndex = null;
        editValue = string.Empty;
    }

    private void HandleEditKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Enter") ConfirmEdit(index);
        else if (e.Key == "Escape") { editingIndex = null; editValue = string.Empty; }
    }
}
