    [Parameter] public HashSet<string> AllLabels { get; set; } = new();
    [Parameter] public HashSet<int> AllStepNumbers { get; set; } = new();
    [Parameter] public EventCallback<string> OnViewTable { get; set; }
    [Parameter] public List<ProgramDTO> AllPrograms { get; set; } = new();
    [Parameter] public EventCallback<string> OnViewProducer { get; set; }

