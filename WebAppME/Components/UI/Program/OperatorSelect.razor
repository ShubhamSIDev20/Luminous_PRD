@namespace BatteryTestingSystem.Components.UI
@inject IJSRuntime JS

<div class="relative">
    <button @ref="buttonRef"
    @onclick="ToggleDropdown" 
    disabled="@Disabled"
    @onkeydown:preventDefault
    @onkeydown:stopPropagation
    @onkeydown="HandleButtonKey"
    class="flex items-center gap-2 px-2 py-1 rounded border border-transparent hover:border-border transition-colors @(Disabled ? "opacity-50 cursor-not-allowed" : "")">
        <OperatorBadge OperatorCode="@Value" />
        @if (!Disabled)
        {
            <Blazicon Svg="Lucide.ChevronDown" class="w-3 h-3 text-muted-foreground" />
        }
    </button>

    @if (isOpen && !Disabled)
    {
        <div class="fixed inset-0 z-40" @onclick="@(() => isOpen = false)"></div>

        <div class="fixed z-[1000] min-w-[200px] bg-card border border-border rounded-lg shadow-xl animate-scale-in overflow-hidden"
             style="@dropdownStyle">

            <!-- Search box -->
            <input @ref="searchRef"
                class="w-full px-3 py-2 text-sm border-b border-border outline-none bg-background"
                placeholder="Type operator..."
                @bind="search"
                @bind:event="oninput"
                @onkeydown="HandleInputKey" />

            <div class="max-h-[300px] overflow-y-auto editor-scrollbar">
                @{
                    var index = 0;
                }
                @foreach (var category in GetGroupedOperators())
                {
                    var filteredOps = category.Value
                        .Where(o =>
                            string.IsNullOrWhiteSpace(search) ||
                            o.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
                        .ToList();

                    if (!filteredOps.Any())
                        continue;

                    <div class="px-3 py-1.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider bg-secondary/50">
                        @GetCategoryLabel(category.Key)
                    </div>

                    @foreach (var op in filteredOps)
                    {
                        <button class="w-full px-3 py-2 flex items-center gap-2 text-left
                           @(highlightIndex == index ? "bg-secondary" : "hover:bg-secondary")"
                                @onclick="() => SelectOperator(op.Code)">
                            <OperatorBadge OperatorCode="@op.Code" />
                        </button>

                        index++;
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public byte Value { get; set; }
    [Parameter] public EventCallback<byte> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public List<byte> ExcludeCodes { get; set; } = new();

    private int highlightIndex = 0;
    private string search = "";
    private bool _focusSearch;
    private bool isOpen = false;
    private string dropdownStyle = "";

    private ElementReference searchRef;
    private ElementReference buttonRef;

    private async Task ToggleDropdown()
    {
        if (isOpen)
        {
            isOpen = false;
            return;
        }

        await PositionDropdown();

        isOpen = true;
        search = "";
        highlightIndex = 0;
        _focusSearch = true;
    }

    /// <summary>
    /// Calculates button position via JS and sets inline style so the dropdown
    /// always stays inside the viewport — opening upward when near the bottom.
    /// </summary>
    private async Task PositionDropdown()
    {
        try
        {
            var rect = await JS.InvokeAsync<BoundingRect>(
                "eval",
                @"(() => {
                    const el = document.activeElement.closest('div.relative')?.querySelector('button');
                    if (!el) return null;
                    const r = el.getBoundingClientRect();
                    return { top: r.top, bottom: r.bottom, left: r.left, width: r.width, viewportHeight: window.innerHeight };
                })()");

            if (rect == null)
            {
                dropdownStyle = "top: 0; left: 0;";
                return;
            }

            const int dropdownHeight = 340; // max-h-[300px] list + ~40px search
            const int dropdownWidth = 200;
            const int margin = 6;

            bool openUpward = (rect.Bottom + dropdownHeight + margin) > rect.ViewportHeight;

            double top = openUpward
                ? rect.Top - dropdownHeight - margin
                : rect.Bottom + margin;

            // Clamp top so it never goes off-screen at the top
            if (top < 4) top = 4;

            double left = rect.Left;
            // Clamp left so it never overflows right edge
            if (left + dropdownWidth > rect.Left + rect.ViewportHeight) // crude guard
                left = Math.Max(4, rect.Left);

            dropdownStyle = $"top: {top:F1}px; left: {left:F1}px;";
        }
        catch
        {
            // Fallback — use CSS below-button positioning
            dropdownStyle = "top: 0; left: 0;";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearch && isOpen && !Disabled)
        {
            _focusSearch = false;
            await searchRef.FocusAsync();
        }
    }

    private void SelectOperator(byte code)
    {
        OnChange.InvokeAsync(code);
        Close();
    }

    private async Task Open()
    {
        if (Disabled) return;

        await PositionDropdown();

        isOpen = true;
        search = "";
        highlightIndex = 0;

        await Task.Yield();
        await searchRef.FocusAsync();
    }

    private void Close()
    {
        isOpen = false;
    }

    private Dictionary<string, List<Operator>> GetGroupedOperators()
    {
        var categories = new[] { "set", "sto", "charge", "discharge", "pause", "goto", "control", "loop" };
        var grouped = new Dictionary<string, List<Operator>>();

        foreach (var cat in categories)
        {
            var ops = OperatorConstants.Operators
                .Where(o => o.Category == cat && !ExcludeCodes.Contains(o.Code))
                .ToList();
            if (ops.Any()) grouped[cat] = ops;
        }

        return grouped;
    }

    private string GetCategoryLabel(string category) => category switch
    {
        "set" => "Setup",
        "sto" => "Stop",
        "charge" => "Charging",
        "discharge" => "Discharging",
        "pause" => "Control Flow",
        "goto" => "Jump",
        "loop" => "Loop",
        "control" => "Other",
        _ => category
    };

    private List<Operator> FilteredOperators =>
        OperatorConstants.Operators
            .Where(o =>
                !ExcludeCodes.Contains(o.Code) &&
                (string.IsNullOrWhiteSpace(search) ||
                 o.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    private async Task HandleButtonKey(KeyboardEventArgs e)
    {
        if (Disabled) return;

        if (e.Key is "Enter" or " ")
        {
            await Open();
        }
        else if (e.Key == "Tab")
        {
            bool shift = e.ShiftKey;
            await JS.InvokeVoidAsync("window.BlazorFocusNext", shift);
        }
        else if (e.Key == "Escape")
        {
            Close();
        }
    }

    private void HandleInputKey(KeyboardEventArgs e)
    {
        if (!FilteredOperators.Any()) return;

        switch (e.Key)
        {
            case "ArrowDown":
                highlightIndex = Math.Min(highlightIndex + 1, FilteredOperators.Count - 1);
                break;

            case "ArrowUp":
                highlightIndex = Math.Max(highlightIndex - 1, 0);
                break;

            case "Enter":
                SelectOperator(FilteredOperators[highlightIndex].Code);
                break;

            case "Escape":
                Close();
                buttonRef.FocusAsync();
                break;
        }
    }

    // JS interop DTO for getBoundingClientRect
    private class BoundingRect
    {
        public double Top { get; set; }
        public double Bottom { get; set; }
        public double Left { get; set; }
        public double Width { get; set; }
        public double ViewportHeight { get; set; }
    }
}
