@namespace BatteryTestingSystem.Components.UI.DynamicTable

@typeparam TItem where TItem : class

<!-- Main Container -->
<div class="@ContainerClass">

    <!-- Title Section (Optional Slot) -->
    @if (TitleContent != null)
    {
        <div class="flex items-center justify-between mb-6">
            @TitleContent
        </div>
    }

    <!-- Header Actions (Optional Slot) -->
    @if (HeaderActions != null)
    {
        <div class="mb-4">
            @HeaderActions
        </div>
    }

    <!-- Search Section (Optional) -->
    @if (ShowSearch && SearchEnabled)
    {
        <div class="@SearchContainerClass mb-4">
            <div class="relative">
                <Blazicon Svg="Lucide.Search" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                <input type="text"
                class="w-full pl-10 pr-10 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-ring focus:border-input placeholder:text-muted-foreground"
                placeholder="@SearchPlaceholder"
                value="@searchTerm"
                @oninput="@OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <button @onclick="ClearSearch"
                    class="absolute right-3 top-1/2 -translate-y-1/2 hover:bg-accent rounded p-1 transition-colors">
                        <Blazicon Svg="Lucide.X" class="h-4 w-4 text-muted-foreground" />
                    </button>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(searchTerm) && ShowSearchSummary)
            {
                <div class="flex items-center gap-2 mt-2">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 dark:bg-primary/20 text-primary rounded-full text-sm">
                        <Blazicon Svg="Lucide.ListFilter" class="h-3 w-3" />
                        <span>Filtered: "@searchTerm"</span>
                        <button @onclick="ClearSearch" class="hover:bg-primary/20 dark:hover:bg-primary/30 rounded-full p-0.5 transition-colors">
                            <Blazicon Svg="Lucide.X" class="h-3 w-3" />
                        </button>
                    </div>
                    @if (!ServerSideProcessing)
                    {
                        <span class="text-sm text-muted-foreground">
                            Showing @DisplayedItems.Count() of @TotalRecords items
                        </span>
                    }
                </div>
            }
        </div>
    }

    <ScrollArea Class="flex-1 max-h-[calc(100vh-24rem)]" Orientation="both">
        @* max-w-[calc(100vw-10rem)] sm:max-w-[calc(100vw-10rem)] max-h-[calc(100vh-26rem)] sm:max-h-[calc(100vh-26rem)] *@
        <Table>
            <TableHeader>
                <TableRow class="sticky top-0 z-10 bg-muted/95 backdrop-blur supports-[backdrop-filter]:bg-muted/60">
                    @TableHeader
                </TableRow>
            </TableHeader>
            <TableBody>
                @if (IsLoading)
                {
                    <TableRow>
                        <TableCell colspan="@ColumnCount" class="text-center py-8">
                            <div class="flex flex-col items-center gap-2">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
                                <p class="text-muted-foreground">@LoadingMessage</p>
                            </div>
                        </TableCell>
                    </TableRow>
                }
                else if (DisplayedItems == null || !DisplayedItems.Any())
                {
                    <TableRow>
                        <TableCell colspan="@ColumnCount" class="text-center py-8">
                            @if (NoDataContent != null)
                            {
                                @NoDataContent
                            }
                            else
                            {
                                <div class="flex flex-col items-center gap-2">
                                    <Blazicon Svg="@(string.IsNullOrWhiteSpace(searchTerm) ? Lucide.FileX : Lucide.SearchX)"
                                    class="h-12 w-12 text-muted-foreground/50" />
                                    <p class="text-muted-foreground">
                                        @(string.IsNullOrWhiteSpace(searchTerm) ? EmptyMessage : $"No results found for {searchTerm}")
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                                    {
                                        <Button Variant="ButtonVariant.Link" OnClick="ClearSearch">
                                            Clear search
                                        </Button>
                                    }
                                </div>
                            }
                        </TableCell>
                    </TableRow>
                }
                else
                {
                    @foreach (var item in DisplayedItems)
                    {
                        <TableRow>
                            @RowContent(item)
                        </TableRow>
                    }
                }
            </TableBody>
        </Table> 
    </ScrollArea>

    <!-- Pagination Section (Optional) -->
    @if (ShowPagination && TotalRecords > 0)
    {
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-4">
            <div class="flex items-center gap-2">
                <span class="text-sm text-muted-foreground whitespace-nowrap">Rows per page:</span>

                <Select Value="@PageSize.ToString()" ValueChanged="HandlePageSizeChange">
                    <SelectTrigger class="w-[70px]">
                        <SelectValue />
                    </SelectTrigger>
                    <SelectContent>
                        @foreach (var size in PageSizeOptions)
                        {
                            <SelectItem value="@size.ToString()">@size</SelectItem>
                        }
                    </SelectContent>
                </Select>

                <span class="text-sm text-muted-foreground whitespace-nowrap">
                    @if (ServerSideProcessing)
                    {
                        <text>Page @CurrentPage of @TotalPages (@TotalRecords total)</text>
                    }
                    else
                    {
                        <text>Showing @StartRow-@EndRow of @TotalRecords</text>
                    }
                </span>
            </div>

            <Pagination>
                <PaginationItem>
                    <PaginationLink Disabled="@(CurrentPage == 1)"
                    OnClick="@(() => GoToPage(CurrentPage - 1))">
                        <Blazicon Svg="Lucide.ChevronLeft" class="h-4 w-4" />
                    </PaginationLink>
                </PaginationItem>

                @if (TotalPages <= 7)
                {
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        int pageNum = i;
                        <PaginationItem>
                            <PaginationLink IsActive="@(CurrentPage == pageNum)"
                            OnClick="@(() => GoToPage(pageNum))">
                                @pageNum
                            </PaginationLink>
                        </PaginationItem>
                    }
                }
                else
                {
                    <PaginationItem>
                        <PaginationLink IsActive="@(CurrentPage == 1)"
                        OnClick="@(() => GoToPage(1))">
                            1
                        </PaginationLink>
                    </PaginationItem>

                    @if (CurrentPage > 3)
                    {
                        <PaginationItem>
                            <span class="px-2 text-muted-foreground">...</span>
                        </PaginationItem>
                    }

                    @for (int i = Math.Max(2, CurrentPage - 1); i <= Math.Min(TotalPages - 1, CurrentPage + 1); i++)
                    {
                        int pageNum = i;
                        <PaginationItem>
                            <PaginationLink IsActive="@(CurrentPage == pageNum)"
                            OnClick="@(() => GoToPage(pageNum))">
                                @pageNum
                            </PaginationLink>
                        </PaginationItem>
                    }

                    @if (CurrentPage < TotalPages - 2)
                    {
                        <PaginationItem>
                            <span class="px-2 text-muted-foreground">...</span>
                        </PaginationItem>
                    }

                    <PaginationItem>
                        <PaginationLink IsActive="@(CurrentPage == TotalPages)"
                        OnClick="@(() => GoToPage(TotalPages))">
                            @TotalPages
                        </PaginationLink>
                    </PaginationItem>
                }

                <PaginationItem>
                    <PaginationLink Disabled="@(CurrentPage == TotalPages)"
                    OnClick="@(() => GoToPage(CurrentPage + 1))">
                        <Blazicon Svg="Lucide.ChevronRight" class="h-4 w-4" />
                    </PaginationLink>
                </PaginationItem>
            </Pagination>
        </div>
    }

    <!-- Footer Section (Optional Slot) -->
    @if (FooterContent != null)
    {
        <div class="mt-4">
            @FooterContent
        </div>
    }

</div>

@code {
    // Data Source Parameters
    [Parameter] public IEnumerable<TItem>? DataSource { get; set; }
    [Parameter] public Func<TableRequest, Task<TableResponse<TItem>>>? OnServerLoad { get; set; }

    // Render Fragment Parameters (Slots)
    [Parameter] public RenderFragment? TitleContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public RenderFragment<TItem>? RowContent { get; set; }
    [Parameter] public RenderFragment? NoDataContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    // Search Parameters
    [Parameter] public bool ShowSearch { get; set; } = false;
    [Parameter] public string SearchPlaceholder { get; set; } = "Search...";
    [Parameter] public bool ShowSearchSummary { get; set; } = true;
    [Parameter] public Func<TItem, string, bool>? SearchFilter { get; set; }
    [Parameter] public int SearchDebounceMs { get; set; } = 300;

    // Pagination Parameters
    [Parameter] public bool ShowPagination { get; set; } = true;
    [Parameter] public bool ServerSideProcessing { get; set; } = false;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int[] PageSizeOptions { get; set; } = { 10, 25, 50, 100 };

    // Display Parameters
    [Parameter] public int ColumnCount { get; set; } = 1;
    [Parameter] public string EmptyMessage { get; set; } = "No data available";
    [Parameter] public string LoadingMessage { get; set; } = "Loading...";
    [Parameter] public int? P { get; set; }
    // CSS Parameters
    [Parameter] public string ContainerClass { get; set; } = "h-full min-h-0 p-6";
    [Parameter] public string SearchContainerClass { get; set; } = "w-full max-w-2xl";


    // Events
    [Parameter] public EventCallback<TableRequest> OnPageChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }

    // State
    private int CurrentPage { get; set; } = 1;
    private string searchTerm = string.Empty;
    private System.Threading.Timer? searchDebounceTimer;
    private bool IsLoading { get; set; } = false;
    private int TotalRecords { get; set; }
    private IEnumerable<TItem> ServerData { get; set; } = Enumerable.Empty<TItem>();

    // Computed Properties
    private bool SearchEnabled => SearchFilter != null || ServerSideProcessing;

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (ServerSideProcessing) return ServerData;

            var items = DataSource ?? Enumerable.Empty<TItem>();

            if (string.IsNullOrWhiteSpace(searchTerm) || SearchFilter == null)
                return items;

            return items.Where(item => SearchFilter(item, searchTerm));
        }
    }

    private IEnumerable<TItem> DisplayedItems
    {
        get
        {
            if (ServerSideProcessing)
                return ServerData;

            if (!ShowPagination)
                return FilteredItems;

            return FilteredItems
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize);
        }
    }

    private int TotalPages => TotalRecords == 0 ? 1 : (int)Math.Ceiling(TotalRecords / (double)PageSize);
    private int StartRow => TotalRecords == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndRow => Math.Min(CurrentPage * PageSize, TotalRecords);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!ServerSideProcessing && DataSource != null)
        {
            TotalRecords = DataSource.Count();
        }
    }

    private async Task LoadData()
    {
        if (ServerSideProcessing && OnServerLoad != null)
        {
            IsLoading = true;
            StateHasChanged();

            try
            {
                var request = new TableRequest
                    {
                        Page = CurrentPage,
                        PageSize = PageSize,
                        SearchTerm = searchTerm
                    };

                var response = await OnServerLoad(request);
                ServerData = response.Data ?? Enumerable.Empty<TItem>();
                TotalRecords = response.TotalRecords;
            }
            finally
            {
                IsLoading = false;
                StateHasChanged();
            }
        }
        else if (DataSource != null)
        {
            TotalRecords = FilteredItems.Count();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        var newSearchTerm = e.Value?.ToString() ?? string.Empty;

        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            searchTerm = newSearchTerm;
            CurrentPage = 1;
            await InvokeAsync(async () =>
            {
                await LoadData();
                await OnSearchChanged.InvokeAsync(searchTerm);
                StateHasChanged();
            });
        }, null, SearchDebounceMs, System.Threading.Timeout.Infinite);
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        CurrentPage = 1;
        await LoadData();
        await OnSearchChanged.InvokeAsync(searchTerm);
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;

        CurrentPage = page;
        await LoadData();
        await OnPageChanged.InvokeAsync(new TableRequest
            {
                Page = CurrentPage,
                PageSize = PageSize,
                SearchTerm = searchTerm
            });
    }

    private async Task HandlePageSizeChange(string value)
    {
        PageSize = int.Parse(value);
        CurrentPage = 1;
        await LoadData();
    }

    // Public Methods
    public async Task Refresh()
    {
        await LoadData();
        StateHasChanged();
    }

    public async Task ResetPagination()
    {
        CurrentPage = 1;
        await LoadData();
        StateHasChanged();
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}