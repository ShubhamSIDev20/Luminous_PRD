@namespace BatteryTestingSystem.Components.UI.TabViewer

@using BatteryTestingSystem.Components.Pages.Home
@using Blazicons
@attribute [StreamRendering]
@inject TabService TabService
@inject IJSRuntime JSRuntime
@implements IDisposable

<style>
    /* Animation for tab content appearing from taskbar */
    .tab-content-enter {
        animation: slideUpFromTaskbar 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slideUpFromTaskbar {
        from {
            opacity: 0;
            transform: translateY(100%);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Animation variants for different dock positions */
    .tab-content-enter-top {
        animation: slideDownFromTop 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slideDownFromTop {
        from {
            opacity: 0;
            transform: translateY(-100%);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tab-content-enter-left {
        animation: slideRightFromLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes slideRightFromLeft {
        from {
            opacity: 0;
            transform: translateX(-100%);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    /* Fade out animation for inactive tabs */
    .tab-content-exit {
        animation: fadeOut 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
        }

        to {
            opacity: 0;
        }
    }

    /* Window control buttons styling */
    .window-controls {
        display: flex;
        align-items: center;
        gap: 1px;
        height: 32px;
        background: transparent;
        position: relative;
        z-index: 20;
    }

    .window-control-button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 32px;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: background-color 0.15s ease;
        padding: 0;
        position: relative;
        z-index: 21;
    }

    .window-control-button:hover {
        background-color: rgba(0, 0, 0, 0.05);
    }

    .dark .window-control-button:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .window-control-button.close:hover {
        background-color: #e81123;
        color: white;
    }

    .window-control-button svg {
        width: 10px;
        height: 10px;
    }

    /* Tab content header styling */
    .tab-content-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 32px;
        background: var(--card);
        border-bottom: 1px solid var(--border);
        padding-left: 12px;
        flex-shrink: 0;
        position: relative;
        z-index: 10;
    }

    .tab-content-title {
        font-size: 13px;
        font-weight: 500;
        color: var(--foreground);
        user-select: none;
    }

    /* Maximize animation */
    .maximizing {
        animation: maximize 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes maximize {
        from {
            transform: scale(0.95);
        }
        to {
            transform: scale(1);
        }
    }

    /* Restore animation */
    .restoring {
        animation: restore 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes restore {
        from {
            transform: scale(1.05);
        }
        to {
            transform: scale(1);
        }
    }
</style>

<div class="@GetContainerClass()">
    <!-- Tab Bar -->
    <div class="@GetTabBarClass()">
        <!-- Tabs Container -->
        <div class="@GetTabsContainerClass()">
            @foreach (var tab in TabService.Tabs)
            {
                <div class="@GetTabClass(tab)"
                @onclick="async () => await HandleTabClick(tab.Id)"
                @oncontextmenu="(e) => ShowContextMenu(e, tab)"
                @oncontextmenu:preventDefault="true"
                title="@GetTabTooltip(tab)">

                    <!-- Pin Indicator -->
                    @if (_currentDockPosition == DockPosition.Left)
                    {
                        <Tooltip>
                            <TooltipTrigger>
                                @if (tab.IsPinned)
                                {
                                    <Blazicon Svg="Lucide.Pin" class="w-3 h-3 text-primary" />
                                }
                                else
                                {
                                    <Blazicon Svg="@tab.Icon" class="w-4 h-4" />
                                }
                            </TooltipTrigger>
                            <TooltipContent Side="TooltipSide.Right">
                                <span>@tab.Title</span>
                            </TooltipContent>
                        </Tooltip>                        
                    }
                    else
                    {

                        @if (tab.IsPinned)
                        {
                            <Blazicon Svg="Lucide.Pin" class="w-3 h-3 text-primary" />
                        }
                        else
                        {
                            <Blazicon Svg="@tab.Icon" class="w-4 h-4" />
                        }
                    }


                    <!-- Tab Title - Only show for horizontal docking -->
                    @if (!tab.IsPinned && (_currentDockPosition == DockPosition.Top || _currentDockPosition == DockPosition.Bottom))
                    {
                        <span class="text-sm font-medium truncate max-w-[150px] flex items-center gap-1">
                            @tab.Title
                            @if (tab.HasUnsavedChanges)
                            {
                                <span class="text-destructive text-xl leading-none">•</span>
                            }
                        </span>
                    }

                    <!-- Close Button -->
                    @if (tab.IsClosable && !tab.IsPinned && (_currentDockPosition == DockPosition.Top || _currentDockPosition == DockPosition.Bottom))
                    {
                        <button @onclick="async (e) => await HandleCloseClick(e, tab.Id)"
                                @onclick:stopPropagation="true"
                                class="ml-auto p-1 rounded hover:bg-destructive/10 hover:text-destructive transition-colors">
                            <Blazicon Svg="Lucide.X" class="w-3 h-3" />
                        </button>
                    }
                </div>
            }
        </div>

        <!-- Dock Position Selector - Single Button -->
        <div class="@GetDockSelectorClass()">
            <button @onclick="ToggleDockMenu"
                    class="p-2 rounded transition-colors hover:bg-accent relative"
                    title="Change Dock Position">
                <Blazicon Svg="@GetCurrentDockIcon()" class="w-4 h-4" />
            </button>

            <!-- Dock Menu -->
            @if (_showDockMenu)
            {
                <div class="@GetDockMenuClass()"
                     @onclick:stopPropagation="true">
                    <button @onclick="() => ChangeDockPosition(DockPosition.Top)"
                            class="@GetDockMenuItemClass(DockPosition.Top)">
                        <Blazicon Svg="Lucide.PanelTop" class="w-4 h-4" />
                        <span>Top</span>
                    </button>
                    <button @onclick="() => ChangeDockPosition(DockPosition.Bottom)"
                            class="@GetDockMenuItemClass(DockPosition.Bottom)">
                        <Blazicon Svg="Lucide.PanelBottom" class="w-4 h-4" />
                        <span>Bottom</span>
                    </button>
                    <button @onclick="() => ChangeDockPosition(DockPosition.Left)"
                            class="@GetDockMenuItemClass(DockPosition.Left)">
                        <Blazicon Svg="Lucide.PanelLeft" class="w-4 h-4" />
                        <span>Left</span>
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Tab Content -->
    <div class="flex-1 relative overflow-hidden bg-background" style="isolation: isolate;">
        @foreach (var tab in TabService.Tabs)
        {
            var isActive = TabService.ActiveTab?.Id == tab.Id;
            var animationClass = GetAnimationClass(tab);
            var isMaximized = TabService.IsTabMaximized(tab.Id);
            var contentClass = isMaximized ? "maximizing" : (TabService.WasTabMaximized(tab.Id) ? "restoring" : "");

            @if (tab.KeepAlive)
            {
                <div class="@GetContentClass(tab) @contentClass @animationClass" @key="tab.Id">
                    <!-- Content Area (no right-click menu) -->
                    <div class="@GetContentAreaClass(isMaximized)">
                        @if (tab.ComponentType != null)
                        {
                            <CascadingValue Value="tab" Name="CurrentTab">
                                <DynamicComponent Type="@tab.ComponentType"
                                                  Parameters="@(tab.Parameters ?? new Dictionary<string, dynamic>())"
                                                  @key="@($"component-{tab.Id}")" />
                            </CascadingValue>
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full text-muted-foreground">
                                <div class="text-center">
                                    <Blazicon Svg="@tab.Icon" class="w-16 h-16 mx-auto mb-4 opacity-50" />
                                    <p class="text-lg font-medium">@tab.Title</p>
                                    <p class="text-sm mt-2">No content loaded</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (isActive)
            {
                <div class="@GetContentClass(tab) @contentClass @animationClass" @key="tab.Id">
                    <!-- Content Area (no right-click menu) -->
                    <div class="@GetContentAreaClass(isMaximized)">
                        @if (tab.ComponentType != null)
                        {
                            <CascadingValue Value="tab" Name="CurrentTab">
                                <DynamicComponent Type="@tab.ComponentType"
                                                  Parameters="@(tab.Parameters ?? new Dictionary<string, dynamic>())"
                                                  @key="@($"component-{tab.Id}")" />
                            </CascadingValue>
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full text-muted-foreground">
                                <div class="text-center">
                                    <Blazicon Svg="@tab.Icon" class="w-16 h-16 mx-auto mb-4 opacity-50" />
                                    <p class="text-lg font-medium">@tab.Title</p>
                                    <p class="text-sm mt-2">No content loaded</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Context Menu -->
@if (_showContextMenu && _contextMenuTab != null)
{
    <div class="fixed bg-card border border-border rounded-lg shadow-lg py-1 min-w-[180px] z-[10001]"
         style="left: @(_contextMenuX)px; top: @(_contextMenuY)px;"
         @onclick:stopPropagation="true"
    @ref="_contextMenuRef">

        <!-- Window Control Options (always shown from tab header) -->
        @if (TabService.IsTabMaximized(_contextMenuTab.Id))
        {
            <button @onclick="() => HandleContextAction(ContextAction.Restore)"
                    class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
                <Blazicon Svg="Lucide.Minimize2" class="w-4 h-4" />
                <span>Restore Down</span>
            </button>
        }
        else
        {
            <button @onclick="() => HandleContextAction(ContextAction.Maximize)"
                    class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
                <Blazicon Svg="Lucide.Maximize2" class="w-4 h-4" />
                <span>Maximize</span>
            </button>
        }

        <div class="border-t border-border my-1"></div>

        <!-- Tab Context Menu Options -->
        <button @onclick="() => HandleContextAction(ContextAction.Reload)"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
            <Blazicon Svg="Lucide.RotateCw" class="w-4 h-4" />
            <span>Reload</span>
        </button>

        <button @onclick="() => HandleContextAction(ContextAction.Pin)"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
            <Blazicon Svg="@(_contextMenuTab.IsPinned ? Lucide.PinOff : Lucide.Pin)" class="w-4 h-4" />
            <span>@(_contextMenuTab.IsPinned ? "Unpin" : "Pin")</span>
        </button>

        <div class="border-t border-border my-1"></div>

        @if (_contextMenuTab.IsClosable)
        {
            <button @onclick="() => HandleContextAction(ContextAction.Close)"
                    class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
                <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                <span>Close</span>
            </button>
        }

        <button @onclick="() => HandleContextAction(ContextAction.CloseOthers)"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
            <Blazicon Svg="Lucide.CircleX" class="w-4 h-4" />
            <span>Close Others</span>
        </button>

        <button @onclick="() => HandleContextAction(ContextAction.CloseToRight)"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
            <Blazicon Svg="Lucide.ArrowRight" class="w-4 h-4" />
            <span>Close to Right</span>
        </button>

        <button @onclick="() => HandleContextAction(ContextAction.CloseAll)"
                class="w-full flex items-center gap-3 px-4 py-2 text-sm hover:bg-accent transition-colors text-left">
            <Blazicon Svg="Lucide.SquareX" class="w-4 h-4" />
            <span>Close All</span>
        </button>
    </div>
}

<!-- Click outside to close context menu -->
@if (_showContextMenu)
{
    <div class="fixed inset-0 z-[10000]" @onclick="CloseContextMenu"></div>
}

<!-- Click outside to close dock menu -->
@if (_showDockMenu)
{
    <div class="fixed inset-0 z-40" @onclick="ToggleDockMenu"></div>
}

@code {
    private DockPosition _currentDockPosition = DockPosition.Bottom;
    private bool _showContextMenu = false;
    private Tab? _contextMenuTab;
    private double _contextMenuX;
    private double _contextMenuY;
    private ElementReference _contextMenuRef;
    private bool _needsPositionAdjustment = false;
    private bool _showDockMenu = false;
    private string? _lastActiveTabId;
    private string? _currentActiveTabId;

    private enum DockPosition
    {
        Top,
        Bottom,
        Left
    }

    private enum ContextAction
    {
        Reload,
        Pin,
        Close,
        CloseOthers,
        CloseToRight,
        CloseAll,
        Maximize,
        Restore
    }

    protected override void OnInitialized()
    {
        TabService.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsPositionAdjustment && _showContextMenu)
        {
            await AdjustMenuPosition();
            _needsPositionAdjustment = false;
        }

        // Reset after render so animation classes only apply for one render cycle
        if (_lastActiveTabId != null)
        {
            _lastActiveTabId = null;
            _currentActiveTabId = TabService.ActiveTab?.Id;
        }
    }

    private string GetAnimationClass(Tab tab)
    {
        var isActive = TabService.ActiveTab?.Id == tab.Id;
        var wasActive = _lastActiveTabId == tab.Id;

        if (!isActive && wasActive)
        {
            return "tab-content-exit";
        }

        if (isActive && _currentActiveTabId == tab.Id && _lastActiveTabId != tab.Id)
        {
            return _currentDockPosition switch
            {
                DockPosition.Top => "tab-content-enter-top",
                DockPosition.Left => "tab-content-enter-left",
                _ => "tab-content-enter"
            };
        }

        return string.Empty;
    }

    private void ToggleDockMenu()
    {
        _showDockMenu = !_showDockMenu;
        StateHasChanged();
    }

    private void ChangeDockPosition(DockPosition position)
    {
        _currentDockPosition = position;
        _showDockMenu = false;
        StateHasChanged();
    }

    private SvgIcon GetCurrentDockIcon()
    {
        return _currentDockPosition switch
        {
            DockPosition.Left => Lucide.PanelLeft,
            DockPosition.Top => Lucide.PanelTop,
            _ => Lucide.PanelBottom
        };
    }

    private string GetDockMenuClass()
    {
        var baseClass = "absolute bg-card border border-border rounded-lg shadow-lg py-1 min-w-[140px] z-50";

        return _currentDockPosition switch
        {
            DockPosition.Left => $"{baseClass} bottom-full mb-2",
            DockPosition.Bottom => $"{baseClass} bottom-full mb-2 right-0",
            _ => $"{baseClass} top-full mt-2 right-0"
        };
    }

    private string GetDockMenuItemClass(DockPosition position)
    {
        var baseClass = "w-full flex items-center gap-3 px-4 py-2 text-sm transition-colors";
        var isActive = _currentDockPosition == position;

        return isActive
            ? $"{baseClass} bg-primary text-primary-foreground"
            : $"{baseClass} hover:bg-accent";
    }

    private string GetTabTooltip(Tab tab)
    {
        if (_currentDockPosition == DockPosition.Left)
        {
            var tooltip = tab.Title;
            if (tab.HasUnsavedChanges)
            {
                tooltip += " (unsaved changes)";
            }
            return tooltip;
        }
        return string.Empty;
    }

    private string GetContainerClass()
    {
        return _currentDockPosition switch
        {
            DockPosition.Left => "flex flex-row h-full bg-background",
            DockPosition.Bottom => "flex flex-col h-full bg-background",
            _ => "flex flex-col h-full bg-background"
        };
    }

    private string GetTabBarClass()
    {
        var baseClass = "bg-card border-border shadow-sm relative z-49"; // Added z-index to stay above maximized content
        return _currentDockPosition switch
        {
            DockPosition.Left => $"{baseClass} flex flex-col border-r",
            DockPosition.Bottom => $"{baseClass} flex items-center border-t order-last",
            _ => $"{baseClass} flex items-center border-b"
        };
    }

    private string GetTabsContainerClass()
    {
        var scrollbarClass = "[&::-webkit-scrollbar]:h-1.5 [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-muted-foreground/30 [&::-webkit-scrollbar-thumb]:rounded [&::-webkit-scrollbar-thumb:hover]:bg-muted-foreground/50";

        return _currentDockPosition switch
        {
            DockPosition.Left => $"flex-1 flex flex-col overflow-y-auto {scrollbarClass}",
            _ => $"flex-1 flex items-center overflow-x-auto {scrollbarClass}"
        };
    }

    private string GetDockSelectorClass()
    {
        return _currentDockPosition switch
        {
            DockPosition.Left => "relative flex flex-col gap-1 p-2 border-t border-border",
            _ => "relative flex gap-1 p-2 border-l border-border"
        };
    }

    private string GetTabClass(Tab tab)
    {
        var isActive = TabService.ActiveTab?.Id == tab.Id;
        var baseClass = "flex items-center gap-2 cursor-pointer transition-all select-none";

        // For left: show only icon, make it square-ish
        if (_currentDockPosition == DockPosition.Left)
        {
            baseClass += " w-full justify-center py-3 px-3 border-b border-border";
        }
        else
        {
            // For top/bottom: show full tab with title
            baseClass += tab.IsPinned
                ? " min-w-[48px] justify-center px-4 py-2.5 border-r border-border"
                : " min-w-[180px] px-4 py-2.5 border-r border-border";
        }

        if (isActive)
        {
            baseClass += _currentDockPosition switch
            {
                DockPosition.Left => " bg-background text-foreground border-r-2 border-r-primary",
                DockPosition.Bottom => " bg-background text-foreground border-t-2 border-t-primary",
                _ => " bg-background text-foreground border-b-2 border-b-primary"
            };
        }
        else
        {
            baseClass += " bg-card/50 text-muted-foreground hover:bg-accent hover:text-accent-foreground";
        }

        return baseClass;
    }

    private string GetContentClass(Tab tab)
    {
        var isActive = TabService.ActiveTab?.Id == tab.Id;
        var isMaximized = TabService.IsTabMaximized(tab.Id);
        
        if (isMaximized && isActive)
        {
            // Fixed positioning but leave space for tab bar
            var topPosition = _currentDockPosition switch
            {
                DockPosition.Top => "top-[48px]", // Adjust based on your tab bar height
                DockPosition.Left => "left-[60px]", // Adjust based on your tab bar width
                _ => "bottom-[48px]" // Bottom position
            };
            
            var positionClasses = _currentDockPosition switch
            {
                DockPosition.Top => "fixed inset-x-0 top-[48px] bottom-0",
                DockPosition.Left => "fixed inset-y-0 left-[60px] right-0",
                _ => "fixed inset-x-0 top-0 bottom-[48px]"
            };
            
            return $"{positionClasses} z-[9999] bg-background";
        }
        
        return $"absolute inset-0 h-full w-full {(isActive ? "block" : "hidden")}";
    }

    private string GetContentAreaClass(bool isMaximized)
    {
        return isMaximized 
            ? "h-full w-full overflow-auto p-4" 
            : "h-full w-full overflow-auto p-4";
    }

    private void MaximizeTab(string tabId)
    {
        CloseContextMenu();
        _showDockMenu = false;
        TabService.MaximizeTab(tabId);
    }

    private void RestoreTab(string tabId)
    {
        CloseContextMenu();
        _showDockMenu = false;
        TabService.RestoreTab(tabId);
    }

    private async Task HandleContentCloseClick(string tabId)
    {
        var tab = TabService.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab == null) return;

        var canClose = await TabService.CanCloseTab(tab);
        if (canClose)
        {
            TabService.CloseTab(tabId);
        }
    }

    private async Task HandleTabClick(string tabId)
    {
        var canSwitch = await TabService.CanSwitchFromActiveTab();
        if (canSwitch)
        {
            _lastActiveTabId = TabService.ActiveTab?.Id;
            TabService.SetActiveTab(tabId);
            _currentActiveTabId = tabId;
        }
    }

    private async Task HandleCloseClick(MouseEventArgs e, string tabId)
    {
        var tab = TabService.Tabs.FirstOrDefault(t => t.Id == tabId);
        if (tab == null) return;

        var canClose = await TabService.CanCloseTab(tab);
        if (canClose)
        {
            TabService.CloseTab(tabId);
        }
    }

    private void ShowContextMenu(MouseEventArgs e, Tab tab)
    {
        _contextMenuTab = tab;
        _contextMenuX = e.ClientX;
        _contextMenuY = e.ClientY;
        _showContextMenu = true;
        _needsPositionAdjustment = true;
        StateHasChanged();
    }

    private async Task AdjustMenuPosition()
    {
        if (_contextMenuRef.Id is not null)
        {
            var rect = await JSRuntime.InvokeAsync<BoundingRect>("getElementRect", _contextMenuRef);

            var viewportWidth = await JSRuntime.InvokeAsync<int>("getViewportWidth");
            var viewportHeight = await JSRuntime.InvokeAsync<int>("getViewportHeight");

            if (_contextMenuX + rect.Width > viewportWidth)
                _contextMenuX = viewportWidth - rect.Width - 10;

            if (_contextMenuY + rect.Height > viewportHeight)
                _contextMenuY = viewportHeight - rect.Height - 10;

            StateHasChanged();
        }
    }

    private void CloseContextMenu()
    {
        _showContextMenu = false;
        _contextMenuTab = null;
        StateHasChanged();
    }

    private async Task HandleContextAction(ContextAction action)
    {
        if (_contextMenuTab == null) return;

        switch (action)
        {
            case ContextAction.Reload:
                // Implement reload logic
                break;
            case ContextAction.Pin:
                TabService.TogglePinTab(_contextMenuTab.Id);
                break;
            case ContextAction.Close:
                var canClose = await TabService.CanCloseTab(_contextMenuTab);
                if (canClose)
                {
                    TabService.CloseTab(_contextMenuTab.Id);
                }
                break;
            case ContextAction.CloseOthers:
                await TabService.CloseOtherTabsAsync(_contextMenuTab.Id);
                break;
            case ContextAction.CloseToRight:
                await TabService.CloseTabsToRightAsync(_contextMenuTab.Id);
                break;
            case ContextAction.CloseAll:
                await TabService.CloseAllTabsAsync(exceptPinned: true);
                break;
            case ContextAction.Maximize:
                MaximizeTab(_contextMenuTab.Id);
                break;
            case ContextAction.Restore:
                RestoreTab(_contextMenuTab.Id);
                break;
        }

        CloseContextMenu();
    }

    public void Dispose()
    {
        TabService.OnChange -= StateHasChanged;
    }
}
