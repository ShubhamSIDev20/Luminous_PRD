@* InfiniteScrollComponent.razor - FIXED VERSION *@
@typeparam TItem

<div class="infinite-scroll-wrapper w-full">

    @* Top Action Bar *@
    @if (ShowActionBar && ActionBarPosition is ActionBarPlacement.Top or ActionBarPlacement.Both)
    {
        <div class="action-bar bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mb-4 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4">

                @* Left Actions *@
                <div class="flex items-center gap-4 flex-wrap">
                    @if (ShowViewToggle)
                    {
                        <div class="flex items-center gap-2 bg-gray-100 dark:bg-gray-700 rounded-lg p-1">
                            <button @onclick="() => SetViewMode(ViewMode.Grid)"
                                    class="@GetViewButtonClass(ViewMode.Grid)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                                </svg>
                            </button>
                            <button @onclick="() => SetViewMode(ViewMode.List)"
                                    class="@GetViewButtonClass(ViewMode.List)">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                                </svg>
                            </button>
                        </div>
                    }

                    @if (ShowItemsPerPageSelector)
                    {
                        <div class="flex items-center gap-2">
                            <label class="text-sm font-medium text-gray-700 dark:text-gray-300">Show:</label>
                            <select @bind="SelectedItemsPerPage"
                                    @bind:after="OnItemsPerPageChangedHandler"
                                    class="px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                @foreach (var option in ItemsPerPageOptions)
                                {
                                    <option value="@option">@option</option>
                                }
                            </select>
                        </div>
                    }

                    @if (TopActionBarContent != null)
                    {
                        <div class="flex items-center gap-2">
                            @TopActionBarContent
                        </div>
                    }
                </div>

                @* Right Info *@
                <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
                    @if (ShowItemCount)
                    {
                        <span>
                            Showing <strong class="text-gray-900 dark:text-gray-100">@LoadedItemsCount</strong>
                            of <strong class="text-gray-900 dark:text-gray-100">@TotalItemsCount</strong> items
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    @* Scroll Container *@
    <div class="scroll-container border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-800 shadow-sm"
         style="height: @Height; overflow-y: auto; overflow-x: hidden;">

        @if (CurrentViewMode == ViewMode.Grid)
        {
            @* Grid View - Wrapper around all items *@
            <div class="@GetGridContainerClass()">
                <Virtualize @ref="virtualizeComponent" ItemsProvider="LoadItems" Context="model" OverscanCount="OverscanCount">
                    <ItemContent>
                        @if (GridItem != null)
                        {
                            @GridItem(model)
                        }
                        else if (ScrollItem != null)
                        {
                            @ScrollItem(model)
                        }
                    </ItemContent>
                    <Placeholder>
                        <div class="loading-placeholder p-8 text-center col-span-full">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">@LoadingText</p>
                        </div>
                    </Placeholder>
                </Virtualize>
            </div>
        }
        else
        {
            @* List View - No grid wrapper needed *@
            <div class="flex flex-col">
                <Virtualize @ref="virtualizeComponent" ItemsProvider="LoadItems" Context="model" OverscanCount="OverscanCount">
                    <ItemContent>
                        @if (ListItem != null)
                        {
                            @ListItem(model)
                        }
                        else if (ScrollItem != null)
                        {
                            @ScrollItem(model)
                        }
                    </ItemContent>
                    <Placeholder>
                        <div class="loading-placeholder p-8 text-center">
                            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
                            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">@LoadingText</p>
                        </div>
                    </Placeholder>
                </Virtualize>
            </div>
        }

        @if (IsLoading && ShowLoadingIndicator)
        {
            <div class="loading-more border-t border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 p-4 text-center">
                <div class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                    <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-blue-600"></div>
                    <span>@LoadingMoreText</span>
                </div>
            </div>
        }

        @if (LoadedItemsCount == 0 && !IsLoading && EmptyContent != null)
        {
            <div class="empty-state p-8">
                @EmptyContent
            </div>
        }
    </div>

    @* Bottom Action Bar *@
    @if (ShowActionBar && ActionBarPosition is ActionBarPlacement.Bottom or ActionBarPlacement.Both)
    {
        <div class="action-bar bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4 mt-4 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-4">
                @if (BottomActionBarContent != null)
                {
                    @BottomActionBarContent
                }
                else if (ShowItemCount)
                {
                    <div class="text-sm text-gray-600 dark:text-gray-400">
                        Showing <strong class="text-gray-900 dark:text-gray-100">@LoadedItemsCount</strong>
                        of <strong class="text-gray-900 dark:text-gray-100">@TotalItemsCount</strong> items
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    // Data Source
    [Parameter, EditorRequired]
    public required Func<InfiniteScrollRequest, Task<InfiniteScrollResponse<TItem>>> DataSource { get; set; }

    // Item Templates
    [Parameter]
    public RenderFragment<TItem>? ScrollItem { get; set; }

    [Parameter]
    public RenderFragment<TItem>? GridItem { get; set; }

    [Parameter]
    public RenderFragment<TItem>? ListItem { get; set; }

    // Action Bars
    [Parameter]
    public RenderFragment? TopActionBarContent { get; set; }

    [Parameter]
    public RenderFragment? BottomActionBarContent { get; set; }

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    // Configuration
    [Parameter]
    public string Height { get; set; } = "600px";

    [Parameter]
    public int InitialItemsPerPage { get; set; } = 25;

    [Parameter]
    public List<int> ItemsPerPageOptions { get; set; } = new() { 10, 25, 50, 100 };

    [Parameter]
    public ViewMode InitialViewMode { get; set; } = ViewMode.Grid;

    [Parameter]
    public string GridColumnsBase { get; set; } = "1";

    [Parameter]
    public string GridColumnsSm { get; set; } = "2";

    [Parameter]
    public string GridColumnsMd { get; set; } = "2";

    [Parameter]
    public string GridColumnsLg { get; set; } = "3";

    [Parameter]
    public string GridColumnsXl { get; set; } = "4";

    [Parameter]
    public string GridColumns2xl { get; set; } = "5";

    [Parameter]
    public string GridGap { get; set; } = "4";

    [Parameter]
    public string GridPadding { get; set; } = "4";

    [Parameter]
    public int OverscanCount { get; set; } = 5;

    // UI Options
    [Parameter]
    public bool ShowActionBar { get; set; } = true;

    [Parameter]
    public bool ShowViewToggle { get; set; } = true;

    [Parameter]
    public bool ShowItemsPerPageSelector { get; set; } = true;

    [Parameter]
    public bool ShowItemCount { get; set; } = true;

    [Parameter]
    public bool ShowLoadingIndicator { get; set; } = true;

    [Parameter]
    public ActionBarPlacement ActionBarPosition { get; set; } = ActionBarPlacement.Top;

    [Parameter]
    public string LoadingText { get; set; } = "Loading...";

    [Parameter]
    public string LoadingMoreText { get; set; } = "Loading more items...";

    // Events
    [Parameter]
    public EventCallback<ViewMode> OnViewModeChanged { get; set; }

    [Parameter]
    public EventCallback<int> OnItemsPerPageChanged { get; set; }

    // State
    private Virtualize<TItem>? virtualizeComponent;
    private bool IsLoading = false;
    private int LoadedItemsCount = 0;
    private int TotalItemsCount = 0;
    private ViewMode CurrentViewMode;
    private int SelectedItemsPerPage;

    protected override void OnInitialized()
    {
        CurrentViewMode = InitialViewMode;
        SelectedItemsPerPage = InitialItemsPerPage;
    }

    private async ValueTask<ItemsProviderResult<TItem>> LoadItems(ItemsProviderRequest request)
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            var scrollRequest = new InfiniteScrollRequest
                {
                    StartIndex = request.StartIndex,
                    Count = request.Count > 0 ? request.Count : SelectedItemsPerPage,
                    CancellationToken = request.CancellationToken
                };

            var response = await DataSource(scrollRequest);

            LoadedItemsCount = request.StartIndex + response.Items.Count;
            TotalItemsCount = response.TotalCount;

            return new ItemsProviderResult<TItem>(response.Items, response.TotalCount);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task SetViewMode(ViewMode mode)
    {
        if (CurrentViewMode != mode)
        {
            CurrentViewMode = mode;
            await OnViewModeChanged.InvokeAsync(mode);
            StateHasChanged();
        }
    }

    private async Task OnItemsPerPageChangedHandler()
    {
        await OnItemsPerPageChanged.InvokeAsync(SelectedItemsPerPage);
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        if (virtualizeComponent != null)
        {
            LoadedItemsCount = 0;
            await virtualizeComponent.RefreshDataAsync();
        }
    }

    private string GetViewButtonClass(ViewMode mode)
    {
        var baseClass = "p-2 rounded-md transition-colors";
        return mode == CurrentViewMode
            ? $"{baseClass} bg-white dark:bg-gray-600 text-blue-600 dark:text-blue-400 shadow-sm"
            : $"{baseClass} text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200";
    }

    private string GetGridContainerClass()
    {
        var classes = new List<string>
        {
            "grid",
            $"grid-cols-{GridColumnsBase}",
            $"gap-{GridGap}",
            $"p-{GridPadding}"
        };

        if (!string.IsNullOrEmpty(GridColumnsSm))
            classes.Add($"sm:grid-cols-{GridColumnsSm}");

        if (!string.IsNullOrEmpty(GridColumnsMd))
            classes.Add($"md:grid-cols-{GridColumnsMd}");

        if (!string.IsNullOrEmpty(GridColumnsLg))
            classes.Add($"lg:grid-cols-{GridColumnsLg}");

        if (!string.IsNullOrEmpty(GridColumnsXl))
            classes.Add($"xl:grid-cols-{GridColumnsXl}");

        if (!string.IsNullOrEmpty(GridColumns2xl))
            classes.Add($"2xl:grid-cols-{GridColumns2xl}");

        return string.Join(" ", classes);
    }

    // Models and Enums
    public enum ViewMode
    {
        Grid,
        List
    }

    public enum ActionBarPlacement
    {
        Top,
        Bottom,
        Both,
        None
    }

    public class InfiniteScrollRequest
    {
        public int StartIndex { get; set; }
        public int Count { get; set; }
        public CancellationToken CancellationToken { get; set; }
    }

    public class InfiniteScrollResponse<T>
    {
        public required List<T> Items { get; set; }
        public int TotalCount { get; set; }
    }
}