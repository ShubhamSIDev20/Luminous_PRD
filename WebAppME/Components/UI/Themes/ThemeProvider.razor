@namespace BatteryTestingSystem.Components.UI.Themes

<CascadingValue Value="this">
    <div class="h-screen flex flex-col min-h-0 w-full bg-background" tabindex="0" @onkeydown="HandleKeyDown" @onclick="HandleKeyDown" @oncontextmenu="HandleKeyDown">
        @ChildContent
    </div>

</CascadingValue>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public ThemeMode Mode { get; set; } = ThemeMode.Light;

    [Parameter]
    public EventCallback<ThemeMode> ModeChanged { get; set; }

    [Parameter]
    public string? CustomThemeClass { get; set; }

    public bool IsDark => Mode == ThemeMode.Dark;
    public bool IsLight => Mode == ThemeMode.Light;

    [Inject] private PopupService PopupService { get; set; } = default!;

    public async Task ToggleTheme()
    {
        Mode = Mode == ThemeMode.Light ? ThemeMode.Dark : ThemeMode.Light;
        await ModeChanged.InvokeAsync(Mode);
    }

    public async Task SetTheme(ThemeMode mode)
    {
        if (Mode != mode)
        {
            Mode = mode;
            await ModeChanged.InvokeAsync(mode);
        }
    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            PopupService?.CloseAll();
        }
    }

    private void HandleKeyDown(MouseEventArgs e)
    {
        PopupService?.CloseAll();
    }
  
}
