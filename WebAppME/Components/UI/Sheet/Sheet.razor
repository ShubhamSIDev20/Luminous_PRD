@namespace BatteryTestingSystem.Components.UI.Sheet
@inject PopupService PopupService

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>

@code {
    private string _popupId = $"sheet-{Guid.NewGuid():N}";
    private PopupInstance? _instance;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }

    // protected override void OnParametersSet()
    // {
    //     if (Open && !IsOpen)
    //         OpenSheet();

    //     if (!Open && IsOpen)
    //         CloseSheet();
    // }

    private void OpenSheet()
    {
        IsOpen = true;

        // Register popup
        if (_instance == null)
        {
            _instance = PopupService.RegisterPopup(_popupId, PopupType.Sheet);

            // Assign close callback
            _instance.RequestClose = async () => await Close();
        }

        StateHasChanged();
    }

    private async Task CloseSheet()
    {
        IsOpen = false;

        // Unregister popup
        if (_instance != null)
        {
            PopupService.UnregisterPopup(_popupId);
            _instance = null;
        }

        await OpenChanged.InvokeAsync(false);
        StateHasChanged();
    }

    internal async Task SetOpen(bool state)
    {
        if (state)
            OpenSheet();
        else
            await CloseSheet();
    }

    internal async Task Close() => await SetOpen(false);

    internal async Task Toggle() => await SetOpen(!IsOpen);

    public async Task CloseAsync() => await Close();

    public async ValueTask DisposeAsync()
    {
        if (_instance != null)
        {
            PopupService.UnregisterPopup(_popupId);
            _instance = null;
        }
    }
}
