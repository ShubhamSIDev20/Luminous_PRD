@namespace BatteryTestingSystem.Components.UI.Select
@implements IAsyncDisposable
@inject PopupService PopupService

<div id="@_elementId" class="@CN.Merge("relative", Class)" @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private string _elementId = $"select-{Guid.NewGuid():N}";
    private PopupInstance? _popup;
    private int _zIndex = 1000;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    public bool IsOpen { get; private set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (IsOpen && _popup == null)
            RegisterPopup();
        else if (!IsOpen && _popup != null)
            UnregisterPopup();
    }

    private void RegisterPopup()
    {
        _popup = PopupService.RegisterPopup(_elementId, PopupType.Popover);
        _popup.CanCloseWithEsc = true;

        // When PopupService requests closing this popup
        _popup.RequestClose = async () =>
        {
            await CloseAsync();
        };

        _zIndex = _popup.ZIndex;
    }

    private void UnregisterPopup()
    {
        PopupService.UnregisterPopup(_elementId);
        _popup = null;
    }

    public async Task ToggleOpen()
    {
        if (Disabled) return;

        if (IsOpen)
        {
            await CloseAsync();
        }
        else
        {
            // Close all other popups first
            PopupService.CloseAllExcept(_elementId);

            IsOpen = true;
            StateHasChanged();
        }
    }

    public async Task SelectValue(string value)
    {
        await ValueChanged.InvokeAsync(value);

        await CloseAsync();
    }

    // IPopupComponent implementation
    public async Task CloseAsync()
    {
        if (!IsOpen) return;

        IsOpen = false;

        UnregisterPopup();

        StateHasChanged();
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        UnregisterPopup();
        await Task.CompletedTask;
    }
}
