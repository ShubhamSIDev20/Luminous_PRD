@namespace BatteryTestingSystem.Components.UI.Modal

@if (ParentModal?.Open == true)
{
    <!-- Backdrop -->
    <div class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm"
         @onclick="HandleBackdropClick">
    </div>

    <!-- Modal Content -->
    <div class="fixed left-[50%] top-[50%] z-50 translate-x-[-50%] translate-y-[-50%]">
        <div class="@GetClasses()" @attributes="AdditionalAttributes" @onclick:stopPropagation="true">
            @ChildContent
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Modal? ParentModal { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick && ParentModal != null)
        {
            await ParentModal.Close();
        }
    }

    private string GetClasses()
    {
        var baseClasses = "w-full max-w-lg bg-background p-6 shadow-lg duration-200 sm:rounded-lg border";
        return string.IsNullOrWhiteSpace(Class) ? baseClasses : $"{baseClasses} {Class}";
    }
}
