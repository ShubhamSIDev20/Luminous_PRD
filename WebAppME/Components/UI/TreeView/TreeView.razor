@namespace BatteryTestingSystem.Components.UI.TreeView
@typeparam TItem

<div class="bg-background rounded-lg border border-border p-2">
    @if (IsLoading)
    {
        <div class="flex flex-col items-center gap-2 py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
            <p class="text-muted-foreground">@LoadingMessage</p>
        </div>
    }
    else if (Items == null || !Items.Any())
    {
        <div class="flex flex-col items-center gap-2 py-8">
            @if (EmptyContent != null)
            {
                @EmptyContent
            }
            else
            {
                <Blazicon Svg="Lucide.FolderX" class="h-12 w-12 text-muted-foreground/50" />
                <p class="text-muted-foreground">@EmptyMessage</p>
            }
        </div>
    }
    else
    {
        @foreach (var item in Items)
        {
            <TreeNode TItem="TItem"
                      Item="@item"
                      Level="0"
                      SelectedNodeId="@SelectedNodeId"
                      OnNodeClick="@HandleNodeClick"
                      OnNodeDoubleClick="@HandleNodeDoubleClick"
                      NodeContent="@NodeContent"
                      NodeActions="@NodeActions"
                      ContextMenuItems="@ContextMenuItems"
                      OnContextMenuAction="@OnContextMenuAction" />
        }
    }
</div>

@code {
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = "Loading...";
    [Parameter] public string EmptyMessage { get; set; } = "No items available";
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    // Node rendering
    [Parameter] public RenderFragment<TItem>? NodeContent { get; set; }
    [Parameter] public RenderFragment<TItem>? NodeActions { get; set; }
    [Parameter] public RenderFragment<TItem>? ContextMenuItems { get; set; }

    // Events
    [Parameter] public EventCallback<TItem> OnNodeClick { get; set; }
    [Parameter] public EventCallback<TItem> OnNodeDoubleClick { get; set; }
    [Parameter] public EventCallback<(string ActionId, TItem Item)> OnContextMenuAction { get; set; }

    // Selection
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public EventCallback<string?> SelectedNodeIdChanged { get; set; }

    private async Task HandleNodeClick(TItem item)
    {
        var node = item as TreeNodeModel;
        if (node != null)
        {
            SelectedNodeId = node.Id;
            await SelectedNodeIdChanged.InvokeAsync(SelectedNodeId);
        }
        await OnNodeClick.InvokeAsync(item);
    }

    private async Task HandleNodeDoubleClick(TItem item)
    {
        await OnNodeDoubleClick.InvokeAsync(item);
    }
}
