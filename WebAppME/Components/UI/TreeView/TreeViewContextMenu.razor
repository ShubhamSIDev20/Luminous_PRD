@namespace BatteryTestingSystem.Components.UI.TreeView
@typeparam TItem

@implements IDisposable
@inject IJSRuntime JS

<div class="fixed inset-0 z-40" @onclick="HandleClose"></div>
<div class="fixed bg-background rounded-lg shadow-lg border border-border py-1 z-50 min-w-[160px]"
     style="left: @(Position.X)px; top: @(Position.Y)px">
    @ContextMenuItems(Item)
</div>

@code {
    [Parameter] public (double X, double Y) Position { get; set; }
    [Parameter] public TItem Item { get; set; }
    [Parameter] public RenderFragment<TItem> ContextMenuItems { get; set; }
    [Parameter] public EventCallback<(string ActionId, TItem Item)> OnAction { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }

    public void Dispose() { }
}
