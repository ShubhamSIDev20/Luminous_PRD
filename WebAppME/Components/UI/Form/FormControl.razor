@namespace BatteryTestingSystem.Components.UI.Form

<div class="@CssClass">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private FormFieldContext? Context { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => $"{Class ?? ""}".Trim();
}
