@namespace BatteryTestingSystem.Components.UI.Dashboard

<div class="grid-layout" style="@GridStyle">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment ChildContent { get; set; }
    [Parameter] public string MinColumnWidth { get; set; } = "150px";
    [Parameter] public string MaxColumnWidth { get; set; } = "1fr";
    [Parameter] public string Gap { get; set; } = "0.5rem";

    // Use auto-fill instead of auto-fit
    private string GridStyle => $"display: grid; grid-template-columns: repeat(auto-fill, minmax({MinColumnWidth}, {MaxColumnWidth})); gap: {Gap}; width: 100%;";
}
