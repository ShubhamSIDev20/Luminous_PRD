                    </span>
                    <span class="font-medium">@Channel?.RealTime?.RealTimeRecord?.StepNumber</span>
                </div>
            }

            @if (ShouldRenderProperty("OperatorCode"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.ChevronRight" class="w-[0.25em] h-[0.25em]" />
                        Operator:
                    </span>
                    <span class="font-medium">@OperatorConstants.ToName(
                        (Channel?.ExpandedProgramSteps?.Count > 0
                            ? Channel.ExpandedProgramSteps
                            : Channel?.Program?.ProgramStepModel)
                        ?.FirstOrDefault(e => e.StepNumber == Channel?.RealTime?.RealTimeRecord?.StepNumber)
                        ?.OperatorCode)</span>
                </div>
            }

            @if (ShouldRenderProperty("StepRunningTime"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.Clock" class="w-[0.25em] h-[0.25em]" />
                        Step Time:
                    </span>
                    <span class="font-medium">@FormatTimeSpan(Channel?.RealTime?.RealTimeRecord?.StepRunningTime)</span>
                </div>
            }

            @if (ShouldRenderProperty("RunningTime"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.Timer" class="w-[0.25em] h-[0.25em]" />
                        Total:
                    </span>
                    <span class="font-medium">@FormatTimeSpan(Channel?.RealTime?.RealTimeRecord?.RunningTime)</span>
                </div>
            }

            @if (ShouldRenderProperty("Storerecordcount"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.Download" class="w-[0.25em] h-[0.25em]" />
                        Save:
                    </span>
                    <span class="font-medium">@Channel?.Session?.Storerecordcount</span>
                </div>
            }

            @if (ShouldRenderProperty("Unstorerecordcount"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.SaveOff" class="w-[0.25em] h-[0.25em]" />
                        UnSave:
                    </span>
                    <span class="font-medium">@Channel?.Session?.Unstorerecordcount</span>
                </div>
            }

            @if (ShouldRenderProperty("Error"))
            {
                <div class="flex items-center gap-2">

                    @if (Channel?.RealTime?.RealTimeRecord?.ErrorId > 0
                        && Channel?.RealTime?.RealTimeRecord?.CircuitStatus == CircuitStatus.Error)
                    {
                        <span class="text-muted-foreground flex items-center gap-1 shrink-0">
                            <Blazicon Svg="Lucide.TriangleAlert" class="w-3 h-3 text-red-500" />
                            Error :
                        </span>

                        <div class="flex-1 overflow-hidden">
                            <span class="inline-block whitespace-nowrap animate-marquee font-medium">
                                @ErrorMessages.Errors.FirstOrDefault(x => x.Index == Channel.RealTime.RealTimeRecord.ErrorId)?.Message
                            </span>
                        </div>
                    }
                    else if (Channel?.RealTime?.RealTimeRecord?.ErrorId > 0)
                    {
                        <span class="text-muted-foreground flex items-center gap-1 shrink-0">
                            <Blazicon Svg="Lucide.Info" class="w-3 h-3 text-blue-500" />
                            Message :
                        </span>

                        <div class="flex-1 overflow-hidden">
                            <span class="inline-block whitespace-nowrap animate-marquee font-medium">
                                @ErrorMessages.Messages.FirstOrDefault(x => x.Index == Channel.RealTime.RealTimeRecord.ErrorId)?.Message
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted-foreground flex items-center gap-1 shrink-0">
                            <Blazicon Svg="Lucide.Info" class="w-3 h-3" />
                            Error / Message :
                        </span>

                        <span class="font-medium">-</span>
                    }

                </div>
            }

            @if (ShouldRenderProperty("SystemError"))
            {
                <div class="flex items-center gap-2">

                    <span class="text-muted-foreground flex items-center gap-1 shrink-0">
                        <Blazicon Svg="Lucide.Cpu" class="w-3 h-3 text-orange-500" />
                        System Error :
                    </span>

                    @if (Channel?.RealTime?.RealTimeRecord?.SystemErrorId > 0)
                    {
                        <div class="flex-1 overflow-hidden">
                            <span class="inline-block whitespace-nowrap animate-marquee font-medium">
                                @if (Channel?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Running && Channel?.IsConnected == false)
                                {
                                    var err = (int)(Channel?.RealTime?.RealTimeRecord?.SystemErrorId ?? 0)
                                    | (int)SystemError.en_ERR_NETWORK_CONN_FAIL;
                                    @GetErrorText(err)
                                }
                                else
                                {
                                    @GetErrorText(Channel?.RealTime?.RealTimeRecord?.SystemErrorId ?? 0)
                                }
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="font-medium">-</span>
                    }

                </div>
            }

        </div>
    };

