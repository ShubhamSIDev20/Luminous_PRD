             data-card-id="@CardDataId"
             class="@GetCardClasses() flex flex-col h-full group">
            @RenderHeader()
            @RenderFooter()

            <div class="@HoverPopoverPositionClass">
                <div class="bg-popover border-2 border-primary/40 rounded-md shadow-xl p-3 w-64 relative"
                     style="background-color: hsl(var(--popover)); opacity: 1;">
                    <div style="@HoverPopoverArrowStyle"></div>
                    <div class="space-y-3">
                        <div>
                            <div class="text-[1.2em] font-semibold mb-1.5 flex items-center gap-1">
                                <Blazicon Svg=Lucide.Gauge class="w-[0.3em] h-[0.3em]" />
                                Primary Data
                            </div>
                            @RenderPrimaryDataCompact()
                        </div>
                        <div>
                            <div class="text-[1.2em] font-semibold mb-1.5 flex items-center gap-1">
                                <Blazicon Svg=Lucide.Settings class="w-[0.3em] h-[0.3em]" />
                                Configuration
                            </div>
                            @RenderConfigDataCompact()
                        </div>
                        <div>
                            <div class="text-[1.2em] font-semibold mb-1.5 flex items-center gap-1">
                                <Blazicon Svg=Lucide.Cpu class="w-[0.3em] h-[0.3em]" />
                                Program Running
                            </div>
                            @RenderProgramDataCompact()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderCompact() => __builder =>
