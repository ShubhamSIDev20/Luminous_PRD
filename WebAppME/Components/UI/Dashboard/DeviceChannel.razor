    private RenderFragment RenderMiniChart() => __builder =>
    {
        var voltageValues = chartData.Select(d => (double)d.Voltage).ToList();
        var currentValues = chartData.Select(d => (double)d.Current).ToList();
        var latest = chartData[^1];

        // Both lines share one Y-axis scale instead of each being normalized to its own
        // min/max - independent scaling made two unrelated wiggles look the same size,
        // so equal vertical movement now means equal magnitude change for either series.
        double axisMin = 0, axisMax = 1;
        if (chartData.Count > 1)
        {
            axisMin = Math.Min(voltageValues.Min(), currentValues.Min());
            axisMax = Math.Max(voltageValues.Max(), currentValues.Max());
        }

        <div class="w-full h-full flex flex-col">
            <div class="relative flex-1 min-h-0">
                <svg class="w-full h-full" viewBox="0 0 150 80" preserveAspectRatio="none">
                    @if (chartData.Count > 1)
                    {
                        var voltagePoints = GetChartPoints(voltageValues, 80, axisMin, axisMax);
                        <polyline points="@voltagePoints" fill="none" stroke="hsl(var(--chart-1))" stroke-width="1.5" opacity="0.9" />

                        var currentPoints = GetChartPoints(currentValues, 80, axisMin, axisMax);
                        <polyline points="@currentPoints" fill="none" stroke="hsl(var(--chart-2))" stroke-width="1.5" opacity="0.7" />
                    }
                </svg>
                @if (chartData.Count > 1)
                {
                    <span class="absolute left-0 top-0 text-[0.6em] leading-none text-muted-foreground">@FormatValue((float)axisMax)</span>
                    <span class="absolute left-0 bottom-0 text-[0.6em] leading-none text-muted-foreground">@FormatValue((float)axisMin)</span>
                }
            </div>
            <div class="flex justify-around text-[0.8em] text-muted-foreground mt-1">
                <div class="flex items-center gap-0.5">
                    <Blazicon Svg="Lucide.Zap" class="w-[0.2em] h-[0.2em] text-chart-1" />
                    <span class="text-chart-1 font-semibold">@FormatValue(latest.Voltage)</span>
                    <span>V</span>
                </div>
                <div class="flex items-center gap-0.5">
                    <Blazicon Svg="Lucide.Activity" class="w-[0.2em] h-[0.2em] text-chart-2" />
                    <span class="text-chart-2 font-semibold">@FormatValue(latest.Current)</span>
                    <span>A</span>
                </div>
            </div>
        </div>
    };

    #endregion

    #region Helper Methods

    private CircuitStatus GetCircuitStatus()
    {
        CircuitStatus? circuitStatus = Channel.IsConnected ? Channel?.RealTime?.RealTimeRecord?.CircuitStatus : (Channel?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Running ? CircuitStatus.Error : CircuitStatus.Offline);

       return circuitStatus ??= CircuitStatus.Offline;
    }
    private string GetCardClasses()
    {
        var bg = GetStatusBackgroundClass();
        var border = GetStatusBorderClass();
        var selectedRing = Selected ? "ring-2 ring-primary ring-offset-1 ring-offset-background" : "";

        // No filter/opacity/transform utility here: any of those create a new CSS stacking
        // context on the card, which traps the hover popover's z-50 inside it instead of
        // letting it escape above sibling cards - the popover then loses to whichever card
        // comes later in DOM order and appears to render "behind" its translucent background.
        return $"p-2 rounded-lg border transition-all cursor-pointer {bg} {border} {selectedRing} relative";
    }

