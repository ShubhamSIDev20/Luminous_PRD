                        <Blazicon Svg="Lucide.CircleDot" class="w-[0.25em] h-[0.25em]" />
                        Cycle Status:
                    </span>
                    @{
                        var cycleStatus = Channel?.RealTime?.RealTimeRecord?.CycleStatus;
                    }
                    <span class="font-medium @(cycleStatus == 1 ? "text-green-500" : "text-muted-foreground")">
