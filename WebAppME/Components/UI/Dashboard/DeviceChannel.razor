@code {
    #region Parameters
    [Parameter, EditorRequired] public IChannelCommandHandler Channel { get; set; } = null!;
    [Parameter] public DisplayMode Mode { get; set; } = DisplayMode.Normal;
    [Parameter] public EventCallback<(int DeviceId, int BoardNumber, int ChannelId, bool Selected)> OnSelected { get; set; }

    [Parameter] public bool Selected { get; set; } = false;
    [Parameter] public int MaxDigit { get; set; } = 2;
    [Parameter] public int ChartMaxDataPoints { get; set; } = 100;
    [Parameter] public int RefreshRate { get; set; }
    [Parameter] public double FontSize { get; set; } = 10.0; // Base font size in pixels
    [Parameter] public EventCallback OnChanged { get; set; }
    private IChannelCommandHandler? _previousChannel;

    [Parameter]
    public List<string> VisibleProperties { get; set; } = new();

    #endregion

    #region Private Fields

    private DateTime _lastUiUpdate = DateTime.MinValue;

    private List<ChartDataPoint> chartData = new();

    private bool dialogOpen = false;
    private bool triggerPopover = false;
    private bool _isInitialized { get; set; } = false;
    private bool isLoading = true;

    private ManufacturingDetailDTO manufacturingDetailDTO = new();
    private FactoryConfigDetailDTO factoryDetailDTO = new();
    private BatteryDTO batteryDto = new();

    private bool _fetchingManufacturing = false;
    private bool _fetchingFactory = false;

    #endregion

    #region ClickEvents
    // private bool dialogRealTimeDataOpen = false;


    private void OnDoubleClick()
    {
        // dialogRealTimeDataOpen = true;
        tbService.AddTab(new NavMenuItem
        {
            Title = $"Realtime: {Channel?.Channel?.DeviceID}-{Channel?.Channel?.SecondaryBoardNumber}-{Channel?.Channel?.ChannelNumber}",
            Icon = Lucide.ChartLine,
            // ComponentType = typeof(RegisteredDataView),
            ComponentType = typeof(BmsDashboard),
            Parameters = new Dictionary<string, object?>
            {
                ["SQLFilePath"] = Channel?.Session?.SessionFilePath ?? string.Empty,
                ["Key"] = $"{Channel?.Channel?.DeviceID}-{Channel?.Channel?.SecondaryBoardNumber}-{Channel?.Channel?.ChannelNumber}"
            },
            Unique = true,
            keepAlive = true
        });

        // Console.WriteLine("Div double-clicked");
    }
    #endregion

    #region Tabs


    #endregion

    #region Lifecycle Methods
    protected override Task OnInitializedAsync()
    {
        Channel.RealTime.OnDataChanged += OnRealTimeChanged;
        Channel.OnChannelChanged += OnChannelChanged;

        // Manufacturing/Factory/Program detail is only shown in the "..." detail
        // dialog, not on the card face - loading it eagerly here for every card
        // means every one of up to 64 channels/device hits the DB at mount time.
        // LoadData() now runs lazily, only when the dialog is actually opened
        // (see OpenDialog).
        isLoading = false;
        return Task.CompletedTask;
    }

    private bool _detailsLoaded = false;

    private async Task LoadData()
    {
        var M = await DcServices.GetManufacturingAsync(Channel.Channel);
        if (M.Success)
            manufacturingDetailDTO = M.Data!;
        var f = await DcServices.GetFactoryAsync(Channel.Channel);
        if (f.Success)
            factoryDetailDTO = f.Data!;

        var b = await PgServices.GetProgramAsync(Channel.Program.ProgramId);
        if (b.Success)
            Channel.Program = b.Data!;

        _detailsLoaded = true;
    }

    /// <summary>Same gating the removed "Download Details" context-menu item used - only let a
    /// live device fetch happen when the circuit is idle and reachable.</summary>
    private bool CanFetchFromDevice =>
        Channel?.RealTime?.RealTimeRecord?.CircuitStatus == CircuitStatus.Idle &&
        Channel?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Stop &&
        Channel?.IsConnected == true;

    private async Task FetchManufacturingFromDevice()
    {
        if (_fetchingManufacturing) return;
        _fetchingManufacturing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Channel.GetManufacturingDetails();
            if (!result.Success)
            {
                Toast.Error(result.Message ?? "Failed to fetch manufacturing details from device.");
                return;
            }

            // GetManufacturingDetails() already persisted the fresh values (incl. LastSyncedAt) to
            // the DB - reload from there so the dialog reflects exactly what was saved.
            var refreshed = await DcServices.GetManufacturingAsync(Channel.Channel);
            if (refreshed.Success)
                manufacturingDetailDTO = refreshed.Data!;
            Toast.Success("Manufacturing details fetched from device.");
        }
        finally
        {
            _fetchingManufacturing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task FetchFactoryFromDevice()
    {
        if (_fetchingFactory) return;
        _fetchingFactory = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Channel.GetFactoryConfigDetails();
            if (!result.Success)
            {
                Toast.Error(result.Message ?? "Failed to fetch factory configuration from device.");
                return;
            }

            var refreshed = await DcServices.GetFactoryAsync(Channel.Channel);
            if (refreshed.Success)
                factoryDetailDTO = refreshed.Data!;
            Toast.Success("Factory configuration fetched from device.");
        }
        finally
        {
            _fetchingFactory = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>A value box with no text content collapses to just its padding height (no
    /// line-height contribution), making it visibly shorter than a sibling box that has text -
    /// a non-breaking space keeps the box's height consistent regardless of whether the field is populated.</summary>
    private static string Val(string? s) => string.IsNullOrWhiteSpace(s) ? " " : s;


    protected override void OnParametersSet()
    {
        if (_previousChannel == Channel)
            return;

        // unsubscribe old
        if (_previousChannel != null)
        {
            Channel.RealTime.OnDataChanged -= OnRealTimeChanged;
            Channel.OnChannelChanged -= OnChannelChanged;
        }

        // subscribe new
        Channel.RealTime.OnDataChanged += OnRealTimeChanged;
        Channel.OnChannelChanged += OnChannelChanged;

        _previousChannel = Channel;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

        }

    }

    public void Dispose()
    {
        Channel.RealTime.OnDataChanged -= OnRealTimeChanged;
        Channel.OnChannelChanged -= OnChannelChanged;
    }

    #endregion

    #region Event Handlers
    private void OnChannelChanged()
    {
        // Routed through the shared batcher instead of InvokeAsync(StateHasChanged)
        // directly - with up to 64 cards on screen, each dispatching its own render
        // independently is what causes the dashboard to feel like it's freezing.
        Batcher.RequestRender(StateHasChanged);
    }

    private void OnRealTimeChanged()
    {
        var record = Channel?.RealTime?.RealTimeRecord;
        if (record == null)
            return;

        if (Mode == DisplayMode.Chart)
        {
            chartData.Add(new ChartDataPoint
            {
                TimeStamp = record.TimeStamp,
                Voltage = record.Voltage,
                Current = record.Current,
                Temperature = record.Temperature
            });

            if (chartData.Count > ChartMaxDataPoints)
                chartData.RemoveAt(0);
        }

        var now = DateTime.Now;

        if (_lastUiUpdate == DateTime.MinValue || (now - _lastUiUpdate).TotalMilliseconds >= RefreshRate)
        {
            _lastUiUpdate = now;
            Batcher.RequestRender(StateHasChanged); // 🔥 UI refresh, batched with every other dirty card
        }
    }


    private async Task ToggleSelected()
    {
        Selected = !Selected;
        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync((Channel.Channel.DeviceID, Channel.Channel.SecondaryBoardNumber, Channel.Channel.ChannelNumber, Selected));
        }
    }

    private async void OpenDialog(bool value)
    {
        dialogOpen = value;

        if (value && !_detailsLoaded)
        {
            isLoading = true;
            await InvokeAsync(StateHasChanged);
            await LoadData();
            isLoading = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetSystem()
    {
        var r = await Channel?.ResetSystem();

        var title = r.Success ? "System Reset" : "Reset Error";

        if (r.Success)
            Toast.Success(title, r.Message);
        else
            Toast.Error(title, r.Message);
    }

    private string GetErrorText(int errorId)
    {
        List<string> errorList = new List<string>();

        foreach (SystemError error in Enum.GetValues(typeof(SystemError)))
        {
            if ((errorId & (int)error) != 0)
            {
                errorList.Add(error.ToString());
            }
        }

        return string.Join(", ", errorList);
    }

    #endregion

    #region Render Methods
    private bool ShouldRenderProperty(string propertyName)
    {
        return VisibleProperties == null ||
               VisibleProperties.Count == 0 ||
               VisibleProperties.Contains(propertyName);
    }

    // Mini/Compact hover-detail popover: flips upward when the card sits near the
    // bottom of the viewport/scroll container so the popover never bleeds into the
    // next virtualized row.
    private bool _flipPopoverUp = false;

    private class BoundingRect
    {
        public double Bottom { get; set; }
        public double ViewportHeight { get; set; }
    }

    private string CardDataId => $"{Channel?.Channel?.DeviceID}-{Channel?.Channel?.SecondaryBoardNumber}-{Channel?.Channel?.ChannelNumber}";

    private async Task OnCardMouseEnter()
    {
        try
        {
            var rect = await JS.InvokeAsync<BoundingRect>("eval", $@"
                (function() {{
                    var el = document.querySelector('[data-card-id=""{CardDataId}""]');
                    if (!el) return {{ bottom: 0, viewportHeight: window.innerHeight }};
                    var r = el.getBoundingClientRect();
                    return {{ bottom: r.bottom, viewportHeight: window.innerHeight }};
                }})()
            ");
            _flipPopoverUp = rect.Bottom > rect.ViewportHeight - 260; // 260px ~= popover height + margin
        }
        catch
        {
            _flipPopoverUp = false; // fail safe: default to opening downward as before
        }
    }

    private string HoverPopoverPositionClass => _flipPopoverUp
        ? "absolute left-0 bottom-full mb-1 z-50 hidden group-hover:block"
        : "absolute left-0 top-full mt-1 z-50 hidden group-hover:block";

    // Inline styles here (not Tailwind utility classes) because wwwroot/css/app.min.css is a
    // pre-built static file with no rebuild step wired into `dotnet build` - any brand-new
    // Tailwind class referenced only from .razor markup never gets compiled in and silently
    // fails to render (this bit the border-t-8/border-x-8/border-x-transparent/w-0/h-0
    // classes previously used here for this arrow).
    private string HoverPopoverArrowStyle => _flipPopoverUp
        ? "position:absolute; left:1rem; top:100%; width:0; height:0; border-left:8px solid transparent; border-right:8px solid transparent; border-top:8px solid hsl(var(--primary) / 0.4);"
        : "position:absolute; left:1rem; bottom:100%; width:0; height:0; border-left:8px solid transparent; border-right:8px solid transparent; border-bottom:8px solid hsl(var(--primary) / 0.4);";


    private RenderFragment RenderMini() => __builder =>
    {
