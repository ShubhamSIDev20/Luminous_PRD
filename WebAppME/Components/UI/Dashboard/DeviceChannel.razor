                    <span class="font-medium">@Channel?.RealTime?.RealTimeRecord?.TableTotalRowNumber</span>
                </div>
            }

            @if (ShouldRenderProperty("StepNumber"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.ListOrdered" class="w-[0.25em] h-[0.25em]" />
