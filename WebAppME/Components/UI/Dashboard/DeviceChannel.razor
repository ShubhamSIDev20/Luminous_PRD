                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
                        <Blazicon Svg="Lucide.RefreshCw" class="w-[0.25em] h-[0.25em]" />
                        Iteration:
                    </span>
                    <span class="font-medium">@Channel?.RealTime?.RealTimeRecord?.CycleRunIteration</span>
                </div>
            }

            @if (ShouldRenderProperty("TableStepNumber"))
            {
                <div class="flex justify-between items-center">
                    <span class="text-muted-foreground flex items-center gap-0.5">
