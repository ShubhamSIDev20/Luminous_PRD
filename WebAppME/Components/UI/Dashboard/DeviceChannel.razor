                        </div>
                        <div>
                            <div class="text-[1.2em] font-semibold mb-1 flex items-center gap-1">
                                <Blazicon Svg=Lucide.Cpu class="w-[0.3em] h-[0.3em]" />
                                Program Running
                            </div>
                            @RenderProgramDataCompact()
                        </div>
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderList() => __builder =>
    {
        <div @onclick="ToggleSelected" class="@GetCardClasses() flex flex-col h-full">
            @RenderHeader()
            <ScrollArea Class="flex-1">
                <div class="py-2 space-y-2">
                    @RenderPrimaryDataCompact()
                    @RenderConfigDataCompact()
                    @RenderProgramDataCompact()
                </div>
            </ScrollArea>
            @RenderFooter()
        </div>
    };
  
    #endregion

    #region Component Fragments
    private RenderFragment RenderHeader() => __builder =>
    {
        <div class="@GetBackground50Class() px-2 py-1.5 -mx-2 -mt-2 mb-0 rounded-t-lg">
            <div class="flex items-center justify-between gap-1">
                <div class="flex items-center gap-1 min-w-0 flex-1">
                    @if (Selected)
                    {
                        <Blazicon Svg=Lucide.CircleCheck class="w-[0.25em] h-[0.25em] flex-shrink-0" />
                    }
                    <span class="font-bold text-[1em] truncate">
                        @Channel.Channel.DeviceID-@Channel.Channel.SecondaryBoardNumber-@Channel.Channel.ChannelNumber
                    </span>

                    <Tooltip>
                        <TooltipTrigger>
                            <span class="@(
                                (Channel.IsConnected)
                                ? "flex inline-block w-[0.50em] h-[0.50em] rounded-full bg-green-500 animate-pulse"
                                : "flex inline-block w-[0.50em] h-[0.50em] rounded-full bg-red-500 animate-pulse"
                                )"></span>
                        </TooltipTrigger>
                        <TooltipContent Side="TooltipSide.Top">
                            <span>TCP Status</span>
                        </TooltipContent>
                    </Tooltip>

                </div>

                <div class="flex items-center gap-1 mt-1">
                    <Blazicon Svg="@GetCircuitStatusIcon()" class="w-[0.25em] h-[0.25em] flex-shrink-0" />
                    <span class="text-[0.9em] truncate">@GetCircuitStatusText()</span>
                </div>

                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Auto" StopPropagation="true"
                    Class="p-0 hover:bg-primary-foreground/20 flex-shrink-0"
                    OnClick="@(() => OpenDialog(true))">
                    <Blazicon Svg=Lucide.Ellipsis class="w-[0.3em] h-[0.3em]" />
                </Button>
            </div>           
        </div>
    };

    private RenderFragment RenderFooter() => __builder =>
    {
        var errorId = Channel?.RealTime?.RealTimeRecord?.SystemErrorId ?? 0;

        <div class="@GetBackground50Class() px-2 py-1 -mx-2 -mb-2 mt-0 rounded-b-lg flex items-center justify-between gap-1">
            <div class="text-[0.9em] font-medium text-center flex items-center justify-center gap-1">
                <Blazicon Svg="Lucide.Clock" class="w-[0.25em] h-[0.25em]" />
                @Channel?.RealTime?.RealTimeRecord?.TimeStamp.ToString("HH:mm:ss")
            </div>

            <div class="flex items-center gap-1 mt-0.5">
                <div class="w-[0.15em] h-[0.15em] rounded-full @GetProgramStatusColor() flex-shrink-0"></div>
                <Blazicon Svg="@GetProgramStatusIcon()" class="w-[0.25em] h-[0.25em] flex-shrink-0" />
                <span class="text-[0.9em] truncate">@GetProgramStatusText()</span>
            </div>
            <!-- RIGHT: Reset Button (only if error) -->
            @if (errorId > 0)
            {
                <div class="flex items-center gap-1 mt-0.5">
                    <button class="p-1 rounded bg-red-500 text-white hover:bg-red-600 flex items-center justify-center animate-pulse"
                            style="width: 1.5em; height: 1.5em;"
                            title="@GetErrorText(errorId)"
                            @onclick="ResetSystem">
                        <Blazicon Svg="Lucide.RotateCcw" class="w-[0.8em] h-[0.8em]" />
                    </button>
                </div>
            }
        </div>

       

    };

