@page "/window-manager-example"
@using BatteryTestingSystem.Components.UI.WindowManager
@using BatteryTestingSystem.Components.UI.TreeView

<WindowManager>

    @* Window 1: Calibration *@
    <Window Id="calibration"
            Title="Calibration Panel"
            Icon="Lucide.Settings"
            X="150" Y="100"
            Width="900" Height="600">

        <TitleBarActions>
            <button class="p-1 hover:bg-muted rounded" title="Refresh">
                <Blazicon Svg="Lucide.RefreshCw" class="w-4 h-4" />
            </button>
        </TitleBarActions>

        <ChildContent>
            <div class="p-6">
                <h2 class="text-2xl font-bold mb-4 text-foreground">Calibration Settings</h2>
                <div class="space-y-4">
                    <div class="p-4 bg-muted rounded-lg">
                        <h3 class="font-semibold mb-2">Device Configuration</h3>
                        <p class="text-sm text-muted-foreground">Configure your calibration parameters here.</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="p-4 border border-border rounded">
                            <label class="block text-sm font-medium mb-2">Voltage Range</label>
                            <input type="text" class="w-full px-3 py-2 border border-border rounded bg-background" placeholder="0-100V" />
                        </div>
                        <div class="p-4 border border-border rounded">
                            <label class="block text-sm font-medium mb-2">Current Range</label>
                            <input type="text" class="w-full px-3 py-2 border border-border rounded bg-background" placeholder="0-50A" />
                        </div>
                    </div>
                    <div class="flex gap-2 justify-end">
                        <Button>
                            <Blazicon Svg="Lucide.Save" class="w-4 h-4 mr-2" />
                            Save Configuration
                        </Button>
                        <Button Variant="ButtonVariant.Outline">Cancel</Button>
                    </div>
                </div>
            </div>
        </ChildContent>
    </Window>

    @* Window 2: Device Tree *@
    <Window Id="device-tree"
            Title="Device Explorer"
            Icon="Lucide.FolderTree"
            X="250" Y="150"
            Width="600" Height="700">

        <div class="h-full flex flex-col">
            <div class="p-4 border-b border-border bg-muted/30">
                <h3 class="font-semibold text-foreground">Connected Devices</h3>
                <p class="text-sm text-muted-foreground">Select a device to view details</p>
            </div>

            <div class="flex-1 overflow-auto p-4">
                <TreeView TItem="TreeNodeModel"
                          Items="@treeData"
                          @bind-SelectedNodeId="@selectedNodeId"
                          OnNodeClick="@HandleNodeClick">
                    <NodeContent Context="node">
                        <Blazicon Svg="@node.Icon" class="w-4 h-4 text-primary" />
                        <span class="flex-1 text-sm text-foreground">@node.Label</span>
                    </NodeContent>
                    <NodeActions Context="node">
                        <button class="p-1 hover:bg-muted rounded" title="Edit">
                            <Blazicon Svg="Lucide.Pencil" class="w-3 h-3 text-muted-foreground" />
                        </button>
                    </NodeActions>
                </TreeView>
            </div>

            @if (!string.IsNullOrEmpty(selectedNodeId))
            {
                <div class="p-4 border-t border-border bg-card">
                    <p class="text-sm text-muted-foreground">Selected: <strong class="text-foreground">@selectedNodeId</strong></p>
                </div>
            }
        </div>
    </Window>

    @* Window 3: Data Chart *@
    <Window Id="data-chart"
            Title="Real-time Data"
            Icon="Lucide.ChartBar"
            X="350" Y="200"
            Width="1000" Height="650"
            ShowMinimize="true">

        <div class="p-6 h-full flex flex-col">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-2xl font-bold text-foreground">Live Monitoring</h2>
                <div class="flex gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                        <Blazicon Svg="Lucide.Play" class="w-4 h-4 mr-2" />
                        Start
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small">
                        <Blazicon Svg="Lucide.Pause" class="w-4 h-4 mr-2" />
                        Pause
                    </Button>
                </div>
            </div>

            <div class="flex-1 bg-muted rounded-lg flex items-center justify-center">
                <div class="text-center">
                    <Blazicon Svg="Lucide.ChartLine" class="w-16 h-16 text-muted-foreground mb-2 mx-auto" />
                    <p class="text-muted-foreground">Chart visualization area</p>
                </div>
            </div>
        </div>
    </Window>

    @* Window 4: Settings - Minimal controls *@
    <Window Id="settings"
            Title="Settings"
            Icon="Lucide.Settings2"
            X="450" Y="250"
            Width="500" Height="400"
            ShowMaximize="false"
            Resizable="false">

        <div class="p-6">
            <h2 class="text-xl font-bold mb-4 text-foreground">Application Settings</h2>
            <div class="space-y-3">
                <div class="flex items-center justify-between p-3 border border-border rounded hover:bg-muted/50">
                    <div>
                        <p class="font-medium text-foreground">Dark Mode</p>
                        <p class="text-xs text-muted-foreground">Toggle theme appearance</p>
                    </div>
                    <input type="checkbox" class="w-5 h-5" />
                </div>
                <div class="flex items-center justify-between p-3 border border-border rounded hover:bg-muted/50">
                    <div>
                        <p class="font-medium text-foreground">Notifications</p>
                        <p class="text-xs text-muted-foreground">Enable system notifications</p>
                    </div>
                    <input type="checkbox" class="w-5 h-5" checked />
                </div>
                <div class="flex items-center justify-between p-3 border border-border rounded hover:bg-muted/50">
                    <div>
                        <p class="font-medium text-foreground">Auto-save</p>
                        <p class="text-xs text-muted-foreground">Automatically save changes</p>
                    </div>
                    <input type="checkbox" class="w-5 h-5" checked />
                </div>
            </div>
        </div>
    </Window>

</WindowManager>

@code {
    private List<TreeNodeModel> treeData = new();
    private string? selectedNodeId;

    protected override void OnInitialized()
    {
        treeData = new List<TreeNodeModel>
        {
            new TreeNodeModel
            {
                Id = "1",
                Label = "192.168.1.2",
                Icon = Lucide.Wifi,
                Children = new List<TreeNodeModel>
                {
                    new TreeNodeModel
                    {
                        Id = "1-1",
                        Label = "Module 1-1",
                        Icon = Lucide.CircuitBoard,
                        Children = new List<TreeNodeModel>
                        {
                            new TreeNodeModel { Id = "1-1-1", Label = "Current", Icon = Lucide.PlugZap },
                            new TreeNodeModel { Id = "1-1-2", Label = "Voltage", Icon = Lucide.PlugZap }
                        }
                    },
                    new TreeNodeModel { Id = "1-2", Label = "Module 1-2", Icon = Lucide.CircuitBoard }
                }
            },
            new TreeNodeModel
            {
                Id = "2",
                Label = "192.168.1.3",
                Icon = Lucide.Wifi,
                Children = new List<TreeNodeModel>
                {
                    new TreeNodeModel { Id = "2-1", Label = "Module 2-1", Icon = Lucide.CircuitBoard }
                }
            }
        };
    }

    private void HandleNodeClick(TreeNodeModel node)
    {
        Console.WriteLine($"Node clicked: {node.Label}");
    }
}