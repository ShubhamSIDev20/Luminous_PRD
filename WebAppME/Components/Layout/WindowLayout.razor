@inherits LayoutComponentBase

<div class="h-screen flex flex-col min-h-0">

    <!-- Navbar -->
    <header class="h-16 shrink-0 bg-blue-600 text-white flex items-center px-4 z-50">
        <div class="flex items-center gap-4 flex-1">
            <Blazicon Svg="Lucide.Layers" class="w-6 h-6" />
            <span class="font-semibold text-lg">Battery Testing System</span>

            <nav class="flex gap-2 ml-8">
                <button @onclick="@(() => OpenPage("/device/list", "Dashboard", "Lucide.LayoutDashboard"))"
                        class="px-3 py-1.5 rounded hover:bg-blue-700 transition-colors">
                    Dashboard
                </button>

                <button @onclick="@(() => OpenPage("/battery/list", "Calibration", "Lucide.Settings"))"
                        class="px-3 py-1.5 rounded hover:bg-blue-700 transition-colors">
                    Calibration
                </button>

                <button @onclick="@(() => OpenPage("program/list", "Devices", "Lucide.Cpu"))"
                        class="px-3 py-1.5 rounded hover:bg-blue-700 transition-colors">
                    Devices
                </button>

                <button @onclick="@(() => OpenPage("reports", "Reports", "Lucide.FileText"))"
                        class="px-3 py-1.5 rounded hover:bg-blue-700 transition-colors">
                    Reports
                </button>
            </nav>
        </div>

        <div class="flex items-center gap-2">
            <button @onclick="OpenTaskManager"
                    class="p-2 rounded hover:bg-blue-700 transition-colors"
                    title="Task Manager">
                <Blazicon Svg="Lucide.Activity" class="w-5 h-5" />
            </button>

            <button class="p-2 rounded hover:bg-blue-700 transition-colors">
                <Blazicon Svg="Lucide.User" class="w-5 h-5" />
            </button>
        </div>
    </header>


    <!-- Page View - WindowManager Container -->
    <main class="flex-1 min-h-0 bg-gray-100 relative">
        <WindowManager @ref="windowManager"
                        ContainerStyle="width: 100%; height: 100%;"
                        LocalStorageKey="@($"windowManagerState")"
                        InitialTaskbarPosition="TaskbarPosition.Bottom"
                        OnWindowCreated="HandleWindowCreated"
                        OnWindowClosed="HandleWindowClosed">
            @Body
        </WindowManager>
    </main>

    <!-- Footer -->
    <footer class="h-12 shrink-0 bg-gray-800 text-white flex items-center justify-between px-4 z-50">
        <span class="text-sm">© 2026 Battery Testing System</span>
        <span class="text-sm">Connected: <span class="text-green-400">●</span> Online</span>
    </footer>

</div>
    
<!-- Task Manager Modal -->
@if (showTaskManager)
{
    <TaskManager Windows="@GetAllWindows()"
                OnClose="() => showTaskManager = false"
                OnEndTask="HandleEndTask"
                OnSwitchTo="HandleSwitchToWindow" />
}

@code {
    private WindowManager windowManager;
    private bool showTaskManager = false;

    private async Task OpenPage(string url, string title, string iconName)
    {
        if (windowManager != null)
        {
            await windowManager.OpenPage(url, title, iconName);
        }
    }

    private void OpenTaskManager()
    {
        showTaskManager = true;
    }

    private void HandleWindowCreated(string windowId)
    {
        Console.WriteLine($"Window created: {windowId}");
    }

    private void HandleWindowClosed(string windowId)
    {
        Console.WriteLine($"Window closed: {windowId}");
    }

    private List<WindowModel> GetAllWindows()
    {
        // This will be implemented to get windows from WindowManager
        return new List<WindowModel>();
    }

    private void HandleEndTask(string windowId)
    {
        windowManager?.CloseWindow(windowId);
    }

    private void HandleSwitchToWindow(string windowId)
    {
        windowManager?.RestoreWindow(windowId);
        showTaskManager = false;
    }
}