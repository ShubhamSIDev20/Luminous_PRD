{
  "AllowedHosts": "*",
  "Features": {
    "WorkflowCanvas": false,
    "LegacyDashboard": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=F:\\MEWebApp\\BtsAppdb.db"
  },
  "JwtSettings": {
    "Issuer": "https://bts.adortraffictech.com",
    "Audience": "https://api.adortraffictech.com",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30,
    "IdTokenExpirationMinutes": 60,
    "ClockSkewMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "https://yourdomain.com",
      "https://localhost:45341"
    ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Authorization", "Content-Type", "X-Requested-With" ],
    "AllowCredentials": true,
    "MaxAgeSeconds": 3600
  },
  "AppSettings": {
    "Data": "F:\\MEWebApp",
    "DbEncryption": "abcdefghijklmnopqrstuvwxyz",
    "Password": "Admin@123"
  },
  "Alarms": {
    "RetentionDays": 30,
    "EscalationCooldownSec": 60,
    "StormThreshold": 20,
    "StormWindowMinutes": 5,
    "StormCooloffMinutes": 15,
    "FlushIntervalSeconds": 5,
    "BellActiveTake": 50
  }
}
