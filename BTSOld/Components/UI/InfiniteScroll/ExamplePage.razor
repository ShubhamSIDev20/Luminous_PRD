@* 
    Pages/ExamplePage.razor
    ─────────────────────────────────────────────────────────────
    FULL USAGE EXAMPLE: InfiniteScrollList with all features shown
    This is a demo page — adapt to your real data service.
    ─────────────────────────────────────────────────────────────
*@

@page "/InfiniteScrollList"
@using BatteryTestingSystem.Components.UI.InfiniteScroll @* adjust namespace *@

<PageTitle>Infinite Scroll Example</PageTitle>

@* 
    The component needs height to scroll. 
    Wrap it in a container with a fixed or flex height.
*@
<div class="h-full flex flex-col">

    <InfiniteScrollList TItem="VideoItem"
                        LoadPageAsync="FetchVideosAsync"
                        Title="All Videos"
                        ShowSearch="true"
                        SearchPlaceholder="Search videos…"
                        ShowViewToggle="true"
                        DefaultView="InfiniteScrollList<VideoItem>.ViewMode.Grid"
                        ShowResultCount="true"
                        GridContainerClass="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
                        ListContainerClass="flex flex-col divide-y divide-border"
                        SkeletonCount="8"
                        EmptyMessage="No videos found">

        @* ── ACTION BUTTONS (top-right) ── *@
        <ActionButtons>
            <button class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <line x1="12" y1="5" x2="12" y2="19" stroke-width="2" stroke-linecap="round"/>
                    <line x1="5" y1="12" x2="19" y2="12" stroke-width="2" stroke-linecap="round"/>
                </svg>
                Upload
            </button>
        </ActionButtons>

        @* ── FILTER BUTTONS (below search bar) ── *@
        <FilterButtons>
            @foreach (var filter in _filters)
            {
                <button @onclick="() => SetFilter(filter)"
                        class="@GetFilterClass(filter) px-3 py-1 text-xs font-medium rounded-full border transition-colors">
                    @filter
                </button>
            }
        </FilterButtons>

        @* ── GRID CARD TEMPLATE ── *@
        <GridItemTemplate Context="video">
            <div class="group rounded-lg border border-border bg-card hover:shadow-md transition-all overflow-hidden cursor-pointer"
                 @onclick="() => OpenVideo(video)">
                @* Thumbnail *@
                <div class="relative bg-muted aspect-video overflow-hidden">
                    <img src="@video.ThumbnailUrl" alt="@video.Title"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    <span class="absolute bottom-1.5 right-1.5 bg-black/80 text-white text-xs px-1.5 py-0.5 rounded font-mono">
                        @video.Duration
                    </span>
                </div>
                @* Info *@
                <div class="p-3 flex gap-2">
                    <div class="w-8 h-8 rounded-full bg-primary/20 flex items-center justify-center text-xs font-bold text-primary shrink-0">
                        @video.Channel[0]
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-foreground line-clamp-2 leading-snug">@video.Title</p>
                        <p class="text-xs text-muted-foreground mt-0.5">@video.Channel</p>
                        <p class="text-xs text-muted-foreground">@video.Views views · @video.Age</p>
                    </div>
                </div>
            </div>
        </GridItemTemplate>

        @* ── LIST ITEM TEMPLATE ── *@
        <ListItemTemplate Context="video">
            <div class="flex gap-3 p-3 hover:bg-muted/40 transition-colors cursor-pointer"
                 @onclick="() => OpenVideo(video)">
                @* Thumbnail *@
                <div class="relative bg-muted rounded-lg overflow-hidden shrink-0 w-40 aspect-video">
                    <img src="@video.ThumbnailUrl" alt="@video.Title"
                         class="w-full h-full object-cover" />
                    <span class="absolute bottom-1 right-1 bg-black/80 text-white text-xs px-1 py-0.5 rounded font-mono">
                        @video.Duration
                    </span>
                </div>
                @* Info *@
                <div class="flex-1 min-w-0 py-0.5">
                    <p class="text-sm font-medium text-foreground line-clamp-2">@video.Title</p>
                    <p class="text-xs text-muted-foreground mt-1">@video.Channel</p>
                    <p class="text-xs text-muted-foreground">@video.Views views · @video.Age</p>
                    @if (!string.IsNullOrEmpty(video.Description))
                    {
                        <p class="text-xs text-muted-foreground mt-1 line-clamp-2 hidden sm:block">@video.Description</p>
                    }
                </div>
            </div>
        </ListItemTemplate>

    </InfiniteScrollList>
</div>

@code {
    private string _activeFilter = "All";
    private readonly string[] _filters = ["All", "Today", "This Week", "Music", "Gaming", "News"];

    // ── Data fetching ──────────────────────────────────────────────────────────
    // Replace this with your actual service call.
    // The component passes: (page, searchText, cancellationToken)
    // Return: (IEnumerable<TItem> items, bool hasMore)

    private async Task<(IEnumerable<VideoItem>, bool)> FetchVideosAsync(int page, string search, CancellationToken ct)
    {
        await Task.Delay(600, ct); // simulate network

        const int pageSize = 12;

        var allItems = Enumerable.Range(1, 120).Select(i => new VideoItem
        {
            Id = i,
            Title = $"Sample Video #{i} — {(string.IsNullOrEmpty(search) ? "Trending" : search)}",
            Channel = $"Channel {(i % 10) + 1}",
            Views = $"{new Random(i).Next(1, 9999):N0}",
            Duration = $"{new Random(i).Next(1, 30)}:{new Random(i + 1).Next(0, 59):D2}",
            Age = $"{new Random(i).Next(1, 365)} days ago",
            Description = "A short description of the video content goes here.",
            ThumbnailUrl = $"https://picsum.photos/seed/{i}/320/180",
        });

        if (!string.IsNullOrWhiteSpace(search))
            allItems = allItems.Where(v => v.Title.Contains(search, StringComparison.OrdinalIgnoreCase));

        var paged = allItems.Skip((page - 1) * pageSize).Take(pageSize).ToList();
        return (paged, paged.Count == pageSize);
    }

    // ── Filter logic ───────────────────────────────────────────────────────────
    private string GetFilterClass(string filter) =>
        _activeFilter == filter
            ? "bg-primary text-primary-foreground border-primary"
            : "bg-background text-muted-foreground border-border hover:border-primary hover:text-primary";

    private void SetFilter(string filter) => _activeFilter = filter;

    // ── Navigation ─────────────────────────────────────────────────────────────
    private void OpenVideo(VideoItem video) => Console.WriteLine($"Open video {video.Id}");

    // ── Model ──────────────────────────────────────────────────────────────────
    public class VideoItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Channel { get; set; } = "";
        public string Views { get; set; } = "";
        public string Duration { get; set; } = "";
        public string Age { get; set; } = "";
        public string Description { get; set; } = "";
        public string ThumbnailUrl { get; set; } = "";
    }
}
