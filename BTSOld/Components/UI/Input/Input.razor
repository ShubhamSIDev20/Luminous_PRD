@namespace BatteryTestingSystem.Components.UI.Input

<input id="@Id"
       type="@Type"
       class="@GetInputClasses()"
       disabled="@Disabled"
       placeholder="@Placeholder"
       value="@Value"
       min="@GetMin()"
       max="@GetMax()"
       step="@GetStep()"
       @oninput="OnInputHandler"
       @onchange="OnChangeHandler"
       @attributes="AdditionalAttributes" />

@code {
    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public int? Min { get; set; }

    [Parameter]
    public int? Max { get; set; }


    [Parameter]
    public string? Step { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task OnInputHandler(ChangeEventArgs e)
    {
        var newValue = e.Value?.ToString() ?? "";

        // For number inputs, validate the value
        if (Type == "number" && !string.IsNullOrWhiteSpace(newValue))
        {
            // Allow negative sign, decimal point, and digits
            if (!IsValidNumberInput(newValue))
            {
                return; // Don't update if invalid
            }
        }

        Value = newValue;

        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private async Task OnChangeHandler(ChangeEventArgs e)
    {
        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync(e);
        }
    }

    private bool IsValidNumberInput(string input)
    {
        // Allow empty, negative sign, decimal point, and valid numbers
        if (string.IsNullOrWhiteSpace(input)) return true;
        if (input == "-") return true;
        if (input == ".") return true;
        if (input == "-.") return true;

        // Try to parse as double to validate
        return double.TryParse(input, out _);
    }

    private string GetInputClasses()
    {
        var baseClasses = "flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-base ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium file:text-foreground placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm";
        return string.IsNullOrWhiteSpace(Class) ? baseClasses : $"{baseClasses} {Class}";
    }

    private string? GetMin()
        => Type == "number" && Min.HasValue ? Min.Value.ToString() : null;

    private string? GetMax()
        => Type == "number" && Max.HasValue ? Max.Value.ToString() : null;

    private string GetStep()
        => Type == "number" ? (Step ?? "any") : "any";
}
