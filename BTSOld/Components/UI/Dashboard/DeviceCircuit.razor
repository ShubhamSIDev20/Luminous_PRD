@namespace BatteryTestingSystem.Components.UI.Dashboard
@implements IDisposable
@inject IDeviceCircuitServices DcServices
@inject IProgramServices PgServices
@inject TabService tbService
@inject ToastService Toast

@using BatteryTestingSystem.Components.UI.DataViewer
@using BatteryTestingSystem.Models.Enums
@using BatteryTestingSystem.Services.Interfaces
@using Blazicons

<div class="h-full flex flex-col" style="font-size: @(FontSize)px;" 
@ondblclick="OnDoubleClick">
    @switch (Mode)
    {
        case DisplayMode.Mini:
            @RenderMini()
            break;
        case DisplayMode.Compact:
            @RenderCompact()
            break;
        case DisplayMode.Normal:
            @RenderNormal()
            break;
        case DisplayMode.Chart:
            @RenderChart()
            break;
        case DisplayMode.List:
            @RenderList()
            break;
    }
</div>

<Dialog @bind-Open="@dialogOpen">
    <DialogContent Size="DialogSize.Full">
        <section class="space-y-4" @oncontextmenu:stopPropagation>
            <h2 class="text-xl font-semibold">@Circuit.Circuit.DeviceName : @Circuit.Circuit.DeviceID - @Circuit.Circuit.CircuitID</h2>
            <Tabs DefaultValue="Overview">
                <TabsList>
                    <TabsTrigger Value="Overview">Overview</TabsTrigger>
                    <TabsTrigger Value="DigitalSignals">DigitalSignals</TabsTrigger>
                    <TabsTrigger Value="Manufacturing">Manufacturing</TabsTrigger>
                    <TabsTrigger Value="Factory">Factory</TabsTrigger>
                    <TabsTrigger Value="Battery">Battery</TabsTrigger>
                </TabsList>
                <TabsContent Value="Overview">
                    <Card>
                        <CardHeader>
                            <CardTitle>
                                @Circuit.Circuit.DeviceName :
                                @Circuit.Circuit.DeviceID - @Circuit.Circuit.CircuitID
                            </CardTitle>
                            <CardDescription>
                                Circuit Type: @Circuit.Circuit.CircuitType
                            </CardDescription>
                        </CardHeader>
                        <CardContent Class="space-y-6">
                            <!-- Row 1: Program + Battery -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                                <!-- Program Information -->
                                <div>
                                    <div class="flex items-center gap-2 mb-2">
                                        <Blazicon Svg="Lucide.FileCode" class="w-[1.2em] h-[1.2em]" />
                                        <h4 class="font-semibold">Program</h4>
                                    </div>

                                    <div class="space-y-1 text-sm pl-6">
                                        <p>
                                            <span class="text-muted-foreground">Name:</span>
                                            <span class="font-medium">@Circuit.Program.ProgramName</span>
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Steps:</span>
                                            <span class="font-medium">@Circuit.Program.ProgramSteps</span>
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Created:</span>
                                            @Circuit.Program.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                            by @(Circuit.Program.CreatedBy ?? "N/A")
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Updated:</span>
                                            @Circuit.Program.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                            by @(Circuit.Program.UpdatedBy ?? "N/A")
                                        </p>
                                    </div>
                                </div>

                                <!-- Battery Information -->
                                <div>
                                    <div class="flex items-center gap-2 mb-2">
                                        <Blazicon Svg="Lucide.Battery" class="w-[1.2em] h-[1.2em]" />
                                        <h4 class="font-semibold">Battery</h4>
                                    </div>

                                    <div class="space-y-1 text-sm pl-6">
                                        <p>
                                            <span class="text-muted-foreground">Name:</span>
                                            <span class="font-medium">@Circuit.Battery.Name</span>
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Producer:</span>
                                            <span class="font-medium">@Circuit.Battery.Producer</span>
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Capacity:</span>
                                            <span class="font-medium">@Circuit.Battery.NominalCapacity Ah</span>
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Created:</span>
                                            @Circuit.Battery.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                            by @(Circuit.Battery.CreatedBy ?? "N/A")
                                        </p>
                                        <p>
                                            <span class="text-muted-foreground">Updated:</span>
                                            @Circuit.Battery.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                            by @(Circuit.Battery.UpdatedBy ?? "N/A")
                                        </p>
                                    </div>
                                </div>

                            </div>

                            <Separator Orientation="SeparatorOrientation.Horizontal" />

                            <!-- Row 2: Session (Full width) -->
                            <div>
                                <div class="flex items-center gap-2 mb-2">
                                    <Blazicon Svg="Lucide.Activity" class="w-[1.2em] h-[1.2em]" />
                                    <h4 class="font-semibold">Session</h4>
                                </div>

                                <div class="space-y-1 text-sm pl-6">
                                    <p>
                                        <span class="text-muted-foreground">Name:</span>
                                        <span class="font-medium">
                                            @(Circuit.Session.SessionName ?? "N/A")
                                        </span>
                                    </p>

                                    <p>
                                        <span class="text-muted-foreground">Duration:</span>
                                        <span class="font-medium">@(Circuit?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Running ? "in Process" : Circuit?.Session?.Duration)</span>
                                    </p>

                                    <p>
                                        <span class="text-muted-foreground">Started:</span>
                                        @Circuit?.Session?.StartTime.ToString("MMM dd, yyyy HH:mm")
                                    </p>

                                    @if (Circuit?.Session?.EndTime != null)
                                    {
                                        <p>
                                            <span class="text-muted-foreground">Ended:</span>
                                            @Circuit?.Session?.EndTime.Value.ToString("MMM dd, yyyy HH:mm")
                                        </p>
                                    }

                                    <p>
                                        <span class="text-muted-foreground">Created:</span>
                                        @Circuit?.Session?.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                        by @(Circuit?.Session?.CreatedBy ?? "N/A")
                                    </p>
                                </div>
                            </div>

                        </CardContent>

                    </Card>
                </TabsContent>
                <TabsContent Value="DigitalSignals">
                    <div class="mt-3">
                        @if (!_isInitialized && isLoading)
                        {
                            <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                                Loading...
                            </div>                            
                        }
                        else
                        {
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                @foreach (var board in Circuit?.RealTime?.IOStatus?.Select(s => s.Board).Distinct())
                                {
                                    <Card Class="@(board == "Primary" ? "md:col-span-1" : "md:col-span-2")">
                                        <CardHeader Class="py-3">
                                            <CardTitle Class="text-sm">@board Board</CardTitle>
                                        </CardHeader>
                                        <CardContent Class="space-y-3">
                                            @foreach (var type in new[] { "DI", "DO" })
                                            {
                                                var signals = Circuit.RealTime?.IOStatus?.Where(s => s.Board == board && s.Type == type).ToList();

                                                if (signals.Any())
                                                {
                                                    <div>
                                                        <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-1.5">
                                                            Digital @(type == "DI" ? "Input" : "Output")
                                                        </div>
                                                        <div class="grid grid-cols-4 sm:grid-cols-6 gap-2">
                                                            @foreach (var s in signals)
                                                            {
                                                                <div class="flex flex-col items-center gap-1 p-1.5 rounded-md border border-border bg-muted/30">
                                                                    <div class="w-3 h-3 rounded-full @(s.Value == 1 ? "bg-green-500" : "bg-muted-foreground/30")"></div>
                                                                    <div class="text-[10px] font-mono text-muted-foreground">@($"{s.Type}-{s.Id}")</div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </CardContent>
                                    </Card>
                                }
                            </div>
                        }

                    </div>
                </TabsContent>
                <TabsContent Value="Manufacturing">
                    @if (!_isInitialized && isLoading)
                    {
                        <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                            <Blazicon Svg="Lucide.Loader" class="w-[1.5em] h-[1.5em] animate-spin mr-2" />
                            Loading...
                        </div>
                    }
                    else if (manufacturingDetailDTO != null)
                    {
                        <div class="space-y-4 p-4">
                            @* Software Versions *@
                            <div class="space-y-3">
                                <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                    <Blazicon Svg="Lucide.Code" class="w-[0.7em] h-[0.7em]" />
                                    <span>Software Versions</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pl-6">
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Master SW</div>
                                        <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.MasterSWVersion
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Communication SW</div>
                                        <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.ComSWVersion
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Secondary SW</div>
                                        <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.SecondarySWVersion
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <Separator Orientation="SeparatorOrientation.Horizontal" />

                            @* Serial Numbers *@
                            <div class="space-y-3">
                                <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                    <Blazicon Svg="Lucide.Hash" class="w-[0.7em] h-[0.7em]" />
                                    <span>Serial Numbers</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6">
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Primary Serial</div>
                                        <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.PrimarySerialNumber
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Secondary Serial</div>
                                        <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.SecondarySerialNumber
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <Separator Orientation="SeparatorOrientation.Horizontal" />

                            @* Date & Time Information *@
                            <div class="space-y-3">
                                <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                    <Blazicon Svg="Lucide.Calendar" class="w-[0.7em] h-[0.7em]" />
                                    <span>Timestamps</span>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6">
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Manufacture Date</div>
                                        <div class="text-[1em] bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.ManufactureDateTime.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Commissioning Date</div>
                                        <div class="text-[1em] bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.CommissioningDateTime.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Primary PCB Assembly</div>
                                        <div class="text-[1em] bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.PrimaryPCBAssemblyDateTime.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="text-[0.9em] text-muted-foreground">Secondary PCB Assembly</div>
                                        <div class="text-[1em] bg-muted px-3 py-1.5 rounded">
                                            @manufacturingDetailDTO.SecondaryPCBAssemblyDateTime.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                            <div class="text-center space-y-2">
                                <Blazicon Svg="Lucide.CircleAlert" class="w-[2em] h-[2em] mx-auto" />
                                <p>No manufacturing data available</p>
                            </div>
                        </div>
                    }
                </TabsContent>
                <TabsContent Value="Factory">
                    @if (!_isInitialized && isLoading)
                    {
                        <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                            <Blazicon Svg="Lucide.Loader" class="w-[1.5em] h-[1.5em] animate-spin mr-2" />
                            Loading...
                        </div>
                    }
                    else if (factoryDetailDTO != null)
                    {

                        <div class="p-4 max-w-7xl mx-auto">
                            <div class="flex gap-6">

                                <!-- LEFT SIDE -->
                                <div class="flex-1 space-y-4 flex flex-col">
                                    @* Network Configuration *@
                                    <div class="space-y-3 flex-1">
                                        <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                            <Blazicon Svg="Lucide.Network" class="w-[0.7em] h-[0.7em]" />
                                            <span>Network Settings</span>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pl-6">
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">MAC Address</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.MacID
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Device IP Address</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.DeviceIPAddress
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">TCP Port</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.TcpClientRemotePort
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">UDP Port</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.UdpClientRemotePort
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground flex items-center gap-1">
                                                    DHCP Status
                                                    @if (factoryDetailDTO.DhcpEnabled)
                                                    {
                                                        <Blazicon Svg="Lucide.CircleCheck" class="w-[0.6em] h-[0.6em] text-green-600" />
                                                    }
                                                </div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded">
                                                    @(factoryDetailDTO.DhcpEnabled ? "Enabled" : "Disabled")
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <Separator Orientation="SeparatorOrientation.Horizontal" />

                                    @* Circuit Configuration *@
                                    <div class="space-y-3">
                                        <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                            <Blazicon Svg="Lucide.Zap" class="w-[0.7em] h-[0.7em]" />
                                            <span>Circuit Parameters</span>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6">
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Circuit Type</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.CircuitType
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Circuit Number</div>
                                                <div class="text-[1em] font-mono bg-muted px-3 py-1.5 rounded">
                                                    @factoryDetailDTO.CircuitNumber
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- VERTICAL SEPARATOR -->
                                <Separator Orientation="SeparatorOrientation.Vertical" />

                                <!-- RIGHT SIDE -->
                                <div class="flex-1 space-y-4 flex flex-col">
                                    @* Voltage Specifications *@

                                    <div class="space-y-3 flex-1">
                                        <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                            <Blazicon Svg="Lucide.Gauge" class="w-[0.7em] h-[0.7em]" />
                                            <span>Voltage Specifications</span>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6">
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">ZNT Max Voltage</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.ZntMaxVoltage.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">V</span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">LNT Max Voltage</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.LntMaxVoltage.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">V</span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Circuit Max Voltage</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.CircuitMaxVoltage.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">V</span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Circuit Min Voltage</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.CircuitMinVoltage.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">V</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <Separator Orientation="SeparatorOrientation.Horizontal" />

                                    @* Current Specifications *@
                                    <div class="space-y-3">
                                        <div class="flex items-center gap-2 text-[1.1em] font-medium text-muted-foreground">
                                            <Blazicon Svg="Lucide.Activity" class="w-[0.7em] h-[0.7em]" />
                                            <span>Current Specifications</span>
                                        </div>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pl-6">
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Max Discharge Current</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.CircuitMaxDischargeCurrent.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">A</span>
                                                </div>
                                            </div>
                                            <div class="space-y-1">
                                                <div class="text-[0.9em] text-muted-foreground">Max Charge Current</div>
                                                <div class="text-[1em] bg-muted px-3 py-1.5 rounded flex items-center justify-between">
                                                    <span>@factoryDetailDTO.CircuitMaxChargeCurrent.ToString("F2")</span>
                                                    <span class="text-[0.85em] text-muted-foreground">A</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                            <div class="text-center space-y-2">
                                <Blazicon Svg="Lucide.CircleAlert" class="w-[2em] h-[2em] mx-auto" />
                                <p>No factory configuration data available</p>
                            </div>
                        </div>
                    }
                </TabsContent>
                <TabsContent Value="Battery">
                    @if (!_isInitialized && isLoading)
                    {
                        <div class="w-full h-48 flex items-center justify-center text-[1em] text-muted-foreground">
                            Loading...
                        </div>
                    }
                    else
                    {
                        <!-- Battery Information -->
                        <div>
                            <div class="flex items-center gap-2 mb-3">
                                <Blazicon Svg="Lucide.Battery" class="w-[1.3em] h-[1.3em]" />
                                <h3 class="font-semibold text-lg">Battery Details</h3>
                            </div>

                            <!-- Battery Basic Info -->
                            <div class="border rounded-lg p-3 mb-3">
                                <div class="grid grid-cols-2 gap-3 text-sm">
                                    <div>
                                        <p class="text-muted-foreground text-xs">Name</p>
                                        <p class="font-semibold">@Circuit.Battery.Name</p>
                                    </div>
                                    <div>
                                        <p class="text-muted-foreground text-xs">Producer</p>
                                        <p class="font-semibold">@Circuit.Battery.Producer</p>
                                    </div>
                                    <div>
                                        <p class="text-muted-foreground text-xs">Quantity</p>
                                        <p class="font-semibold">@Circuit.Battery.Quantity</p>
                                    </div>
                                    <div>
                                        <p class="text-muted-foreground text-xs">Number of Cells</p>
                                        <p class="font-semibold">@Circuit.Battery.NumberOfCells</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Battery Specifications Grid -->
                            <div class="grid grid-cols-2 gap-3">
                                <!-- Voltage Specs -->
                                <div class="border rounded-lg p-3">
                                    <div class="flex items-center gap-2 mb-2">
                                        <Blazicon Svg="Lucide.Zap" class="w-[1em] h-[1em]" />
                                        <h5 class="font-semibold text-sm">Voltage</h5>
                                    </div>
                                    <div class="space-y-1.5 text-xs">
                                        <div class="flex justify-between">
                                            <span class="text-muted-foreground">Nominal</span>
                                            <span class="font-medium">@Circuit.Battery.NominalVoltage V</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-muted-foreground">Maximum</span>
                                            <span class="font-medium">@Circuit.Battery.MaximumVoltage V</span>
                                        </div>
                                        <div class="flex justify-between">
                                            <span class="text-muted-foreground">Gassing</span>
                                            <span class="font-medium">@Circuit.Battery.GassingVoltage V</span>
