                    </span>

                    @if (Circuit?.RealTime?.RealTimeRecord?.SystemErrorId > 0)
                    {
                        <div class="flex-1 overflow-hidden">
                            <span class="inline-block whitespace-nowrap animate-marquee font-medium">
                                @if (Circuit?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Running && Circuit?.IsConnected == false)
                                {
                                    var err = (int)(Circuit?.RealTime?.RealTimeRecord?.SystemErrorId ?? 0)
                                    | (int)SystemError.en_ERR_NETWORK_CONN_FAIL;
                                    @GetErrorText(err)
                                }
                                else
                                {
                                    @GetErrorText(Circuit?.RealTime?.RealTimeRecord?.SystemErrorId ?? 0)
                                }
                            </span>
                        </div>
                    }
                    else
                    {
                        <span class="font-medium">-</span>
                    }

                </div>
            }

        </div>
    };

