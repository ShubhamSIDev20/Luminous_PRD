@code {
    #region Parameters
    [Parameter, EditorRequired] public ICircuitCommandHandler Circuit { get; set; } = null!;
    [Parameter] public DisplayMode Mode { get; set; } = DisplayMode.Normal;
    [Parameter] public EventCallback<(int DeviceId, int CircuitId, bool Selected)> OnSelected { get; set; }

    [Parameter] public bool Selected { get; set; } = false;
    [Parameter] public int MaxDigit { get; set; } = 2;
    [Parameter] public int ChartMaxDataPoints { get; set; } = 100;
    [Parameter] public int RefreshRate { get; set; }
    [Parameter] public double FontSize { get; set; } = 10.0; // Base font size in pixels
    [Parameter] public EventCallback OnChanged { get; set; }
    private ICircuitCommandHandler? _previousCircuit;

    [Parameter]
    public List<string> VisibleProperties { get; set; } = new();

    #endregion

    #region Private Fields

    private DateTime _lastUiUpdate = DateTime.MinValue;

    private List<ChartDataPoint> chartData = new();

    private bool dialogOpen = false;
    private bool triggerPopover = false;
    private bool _isInitialized { get; set; } = false;
    private bool isLoading = true;

    private ManufacturingDetailDTO manufacturingDetailDTO = new();
    private FactoryConfigDetailDTO factoryDetailDTO = new();
    private BatteryDTO batteryDto = new();

    #endregion

    #region ClickEvents
    // private bool dialogRealTimeDataOpen = false;


    private void OnDoubleClick()
    {
        // dialogRealTimeDataOpen = true;
        tbService.AddTab(new NavMenuItem
        {
            Title = $"Realtime: {Circuit?.Circuit?.DeviceID}-{Circuit?.Circuit?.CircuitID}",
            Icon = Lucide.ChartLine,
            // ComponentType = typeof(RegisteredDataView),
            ComponentType = typeof(BmsDashboard),
            Parameters = new Dictionary<string, object?>
            {
                ["SQLFilePath"] = Circuit?.Session?.SessionFilePath ?? string.Empty,
                ["Key"] = $"{Circuit?.Circuit?.DeviceID}-{Circuit?.Circuit?.CircuitID}"
            },
            Unique = true,
            keepAlive = true
        });

        // Console.WriteLine("Div double-clicked");
    }
    #endregion

    #region Tabs


    #endregion

    #region Lifecycle Methods
    protected override async Task OnInitializedAsync()
    {
        Circuit.RealTime.OnDataChanged += OnRealTimeChanged;
        Circuit.OnCircuitChanged += OnCircuitChanged;

        await LoadData();

        isLoading = false;
    }

    private async Task LoadData()
    {
        var M = await DcServices.GetManufacturingAsync(Circuit.Circuit);
        if (M.Success)
            manufacturingDetailDTO = M.Data!;
        var f = await DcServices.GetFactoryAsync(Circuit.Circuit);
        if (f.Success)
            factoryDetailDTO = f.Data!;

        var b = await PgServices.GetProgramAsync(Circuit.Program.ProgramId);
        if (b.Success)
            Circuit.Program = b.Data!;
    }


    protected override void OnParametersSet()
    {
        if (_previousCircuit == Circuit)
            return;

        // unsubscribe old
        if (_previousCircuit != null)
        {
            Circuit.RealTime.OnDataChanged -= OnRealTimeChanged;
            Circuit.OnCircuitChanged -= OnCircuitChanged;
        }

        // subscribe new
        Circuit.RealTime.OnDataChanged += OnRealTimeChanged;
        Circuit.OnCircuitChanged += OnCircuitChanged;

        _previousCircuit = Circuit;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

        }

    }

    public void Dispose()
    {
        Circuit.RealTime.OnDataChanged -= OnRealTimeChanged;
        Circuit.OnCircuitChanged -= OnCircuitChanged;
    }

    #endregion

    #region Event Handlers
    private async void OnCircuitChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async void OnRealTimeChanged()
    {
        var record = Circuit?.RealTime?.RealTimeRecord;
        if (record == null)
            return;

        if (Mode == DisplayMode.Chart)
        {
            chartData.Add(new ChartDataPoint
            {
                TimeStamp = record.TimeStamp,
                Voltage = record.Voltage,
                Current = record.Current,
                Temperature = record.Temperature
            });

            if (chartData.Count > ChartMaxDataPoints)
                chartData.RemoveAt(0);
        }

        var now = DateTime.Now;

        if (_lastUiUpdate == DateTime.MinValue || (now - _lastUiUpdate).TotalMilliseconds >= RefreshRate)
        {
            _lastUiUpdate = now;
            await InvokeAsync(StateHasChanged); // 🔥 UI refresh
        }
    }


    private async Task ToggleSelected()
    {
        Selected = !Selected;
        if (OnSelected.HasDelegate)
        {
            await OnSelected.InvokeAsync((Circuit.Circuit.DeviceID, Circuit.Circuit.CircuitID, Selected));
        }
    }

    private async void OpenDialog(bool value)
    {
        await LoadData();
        dialogOpen = value;
    }

    private async Task ResetSystem()
    {
        var r = await Circuit?.ResetSystem();

        var title = r.Success ? "System Reset" : "Reset Error";

        if (r.Success)
            Toast.Success(title, r.Message);
        else
            Toast.Error(title, r.Message);
    }

    private string GetErrorText(int errorId)
    {
        List<string> errorList = new List<string>();

        foreach (SystemError error in Enum.GetValues(typeof(SystemError)))
        {
            if ((errorId & (int)error) != 0)
            {
                errorList.Add(error.ToString());
            }
        }

        return string.Join(", ", errorList);
    }

    #endregion

    #region Render Methods
    private bool ShouldRenderProperty(string propertyName)
    {
        return VisibleProperties == null ||
               VisibleProperties.Count == 0 ||
               VisibleProperties.Contains(propertyName);
    }


