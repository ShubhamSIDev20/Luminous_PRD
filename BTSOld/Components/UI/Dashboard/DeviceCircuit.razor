                    }

                </div>
            }

            @if (ShouldRenderProperty("SystemError"))
            {
                <div class="flex items-center gap-2">

                    <span class="text-muted-foreground flex items-center gap-1 shrink-0">
                        <Blazicon Svg="Lucide.Cpu" class="w-3 h-3 text-orange-500" />
