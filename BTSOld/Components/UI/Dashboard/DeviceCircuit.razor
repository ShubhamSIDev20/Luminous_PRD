    private CircuitStatus GetCircuitStatus()
    {
        CircuitStatus? circuitStatus = Circuit.IsConnected ? Circuit?.RealTime?.RealTimeRecord?.CircuitStatus : (Circuit?.RealTime?.RealTimeRecord?.ProgramStatus == ProgramRunningStatus.Running ? CircuitStatus.Error : CircuitStatus.Offline);

       return circuitStatus ??= CircuitStatus.Offline;
    }
