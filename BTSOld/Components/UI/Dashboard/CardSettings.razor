@namespace BatteryTestingSystem.Components.UI.Dashboard
@inject IJSRuntime JS
@inject ServerSessionStorageService sessionStorage
@implements IDisposable

<Popover ElementId="@elementId">
    <PopoverTrigger AsChild>
        <Button variant="ButtonVariant.Outline" size="ButtonSize.Icon" Class="gap-2">
            <Blazicon Svg="Lucide.Settings" class="h-4 w-4" />
            @* <span class="hidden sm:inline">Card Settings</span> *@
        </Button>
    </PopoverTrigger>

    <PopoverContent Class="w-96 bg-popover border border-border z-50" Align="PopoverAlign.End">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h4 class="font-medium text-sm text-foreground">Card Configuration</h4>
                <Button variant="ButtonVariant.Ghost" size="ButtonSize.Small"
                @onclick="ResetConfigAsync"
                StopPropagation="true"
                class="h-7 px-2 gap-1">
                    <Blazicon Svg="Lucide.RotateCcw" class="h-3 w-3" />
                    Reset
                </Button>
            </div>

            @if (!IsReady)
            {
                <div class="text-sm text-muted-foreground">Loading settings...</div>
            }
            else
            {
                <div class="space-y-4">
                    <!-- Card Size -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-foreground">Card Size</label>
                            <span class="text-xs text-muted-foreground font-mono">@Config.CardSize px</span>
                        </div>
                        <input type="range"
                        min="150"
                        max="500"
                        step="10"
                        value="@Config.CardSize"
                        @onchange="@(e => UpdateCardSize(double.Parse(e.Value?.ToString() ?? "150")))"
                        @onclick:stopPropagation="true"
                        class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>150</span>
                            <span>500</span>
                        </div>
                    </div>

                    <!-- Font Size -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-foreground">Font Size</label>
                            <span class="text-xs text-muted-foreground font-mono">@Config.FontSize px</span>
                        </div>
                        <input type="range"
                        min="8"
                        max="25"
                        step="0.5"
                        value="@Config.FontSize"
                        @onchange="@(e => UpdateFontSize(double.Parse(e.Value?.ToString() ?? "12")))"
                        @onclick:stopPropagation="true"
                        class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>10</span>
                            <span>25</span>
                        </div>
                    </div>

                    <!-- Refresh Rate -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-foreground">Refresh Rate</label>
                            <span class="text-xs text-muted-foreground font-mono">@Config.RefreshRate ms</span>
                        </div>
                        <input type="range"
                        min="0"
                        max="5000"
                        step="100"
                        value="@Config.RefreshRate"
                        @onchange="@(e => UpdateRefreshRate(int.Parse(e.Value?.ToString() ?? "200")))"
                        @onclick:stopPropagation="true"
                        class="w-full h-2 bg-muted rounded-lg appearance-none cursor-pointer accent-primary" />
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>0ms</span>
                            <span>5s</span>
                        </div>
                    </div>

                    <!-- Decimal Places -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-foreground">Decimal Places</label>
                            <span class="text-xs text-muted-foreground font-mono">@Config.ShowDecimal</span>
                        </div>
                        <div class="flex gap-2">
                            @for (int i = 0; i <= 6; i++)
                            {
                                var value = i;
                                <button type="button"
                                @onclick="@(() => UpdateShowDecimal(value))"
                                @onclick:stopPropagation="true"
                                class="@GetDecimalButtonClass(value)">
                                    @value
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Display Mode -->
                    <div class="space-y-2">
                        <DropdownMenu ParentId="@elementId" @bind-Open="dropdownOpen" class="w-full">
                            <DropdownMenuTrigger>
                                <label class="text-sm font-medium text-foreground mb-2">Display Mode</label>
                                <Button Variant="ButtonVariant.Outline" Class="w-full justify-between" StopPropagation="true" OnClick="@(() => dropdownOpen = !dropdownOpen)">
                                    <div class="flex items-center gap-2">
                                        <Blazicon Svg="@GetDisplayModeIcon()" class="h-4 w-4" />
                                        <span>@Config.DisplayMode</span>
                                    </div>
                                    <Blazicon Svg="Lucide.ChevronDown" class="h-3 w-3 ml-2 opacity-50" />
                                </Button>
                            </DropdownMenuTrigger>
                            <DropdownMenuContent Class="w-full">
                                @foreach (DisplayMode mode in Enum.GetValues(typeof(DisplayMode)))
                                {
                                    <DropdownMenuItem OnClick="@(() => UpdateDisplayMode(mode))">
                                        <div class="flex items-center gap-2">
                                            <Blazicon Svg="@GetModeIcon(mode)" class="h-4 w-4" />
                                            <span>@mode</span>
                                        </div>
                                    </DropdownMenuItem>
                                }
                            </DropdownMenuContent>
                        </DropdownMenu>
                    </div>

                    <!-- Visible Properties Selection -->
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <label class="text-sm font-medium text-foreground">Visible Properties</label>
                            <span class="text-xs text-muted-foreground">@Config.VisibleProperties.Count selected</span>
                        </div>

                        <div class="max-h-64 overflow-y-auto border border-border rounded-md">
                            <!-- RealTime Properties Section -->
                            <div class="border-b border-border">
                                <button type="button"
                                @onclick="@(() => ToggleSection("realtime"))"
                                @onclick:stopPropagation="true"
                                class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                    <span class="text-xs font-semibold text-foreground">RealTime Data</span>
                                    <Blazicon Svg="@(expandedSection == "realtime" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                                </button>
                                @if (expandedSection == "realtime")
                                {
                                    <div class="p-2 space-y-1">
                                        @foreach (var prop in RealTimeProperties)
                                        {
                                            <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer"
                                            @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                checked="@IsPropertyVisible(prop.Key)"
                                                @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                @onclick:stopPropagation="true"
                                                class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                                <div class="flex items-center gap-2 flex-1">
                                                    <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                    <span class="text-sm text-foreground">@prop.Value.Label</span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Config Properties Section -->
                            <div class="border-b border-border">
                                <button type="button"
                                @onclick="@(() => ToggleSection("config"))"
                                @onclick:stopPropagation="true"
                                class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                    <span class="text-xs font-semibold text-foreground">Configuration</span>
                                    <Blazicon Svg="@(expandedSection == "config" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                                </button>
                                @if (expandedSection == "config")
                                {
                                    <div class="p-2 space-y-1">
                                        @foreach (var prop in ConfigProperties)
                                        {
                                            <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer"
                                            @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                checked="@IsPropertyVisible(prop.Key)"
                                                @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                @onclick:stopPropagation="true"
                                                class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                                <div class="flex items-center gap-2 flex-1">
                                                    <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                    <span class="text-sm text-foreground">@prop.Value.Label</span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Program Properties Section -->
                            <div>
                                <button type="button"
                                @onclick="@(() => ToggleSection("program"))"
                                @onclick:stopPropagation="true"
                                class="w-full flex items-center justify-between px-3 py-2 bg-muted/50 hover:bg-muted transition-colors">
                                    <span class="text-xs font-semibold text-foreground">Program Data</span>
                                    <Blazicon Svg="@(expandedSection == "program" ? Lucide.ChevronDown : Lucide.ChevronRight)" class="h-3 w-3" />
                                </button>
                                @if (expandedSection == "program")
                                {
                                    <div class="p-2 space-y-1">
                                        @foreach (var prop in ProgramProperties)
                                        {
                                            <label class="flex items-center gap-2 px-2 py-1.5 hover:bg-muted/50 rounded cursor-pointer"
                                            @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                checked="@IsPropertyVisible(prop.Key)"
                                                @onchange="@(e => ToggleProperty(prop.Key, (bool)(e.Value ?? false)))"
                                                @onclick:stopPropagation="true"
                                                class="w-4 h-4 rounded border-border accent-primary cursor-pointer" />
                                                <div class="flex items-center gap-2 flex-1">
                                                    <Blazicon Svg="@prop.Value.Icon" class="h-3 w-3 text-muted-foreground" />
                                                    <span class="text-sm text-foreground">@prop.Value.Label</span>
                                                </div>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Quick Actions -->
                        <div class="flex gap-2">
                            <Button variant="ButtonVariant.Outline" size="ButtonSize.Small"
                            @onclick="SelectAllProperties"
                            StopPropagation="true"
                            Class="flex-1 h-8 text-xs">
                                Select All
                            </Button>
                            <Button variant="ButtonVariant.Outline" size="ButtonSize.Small"
                            @onclick="ClearAllProperties"
                            StopPropagation="true"
                            Class="flex-1 h-8 text-xs">
                                Clear All
                            </Button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </PopoverContent>
</Popover>

@code
{
    [Parameter]
    public CardConfig Config { get; set; } = new();

    [Parameter]
    public EventCallback<CardConfig> ConfigChanged { get; set; }

    private string elementId = $"card-settings-{Guid.NewGuid():N}";
    private bool IsReady { get; set; } = false;
    private bool _isInitialized = false;
    private bool dropdownOpen = false;
    private string? expandedSection = null; // Changed to nullable string - null means all closed

    // Property metadata
    private record PropertyMetadata(string Label, SvgIcon Icon);

    // Default visible properties
    private static readonly List<string> DefaultVisibleProperties = new()
    {
        "Voltage", "Current", "Power", "Temperature",
        "BatteryID", "ProgramID", "SessionID", "StepNumber", "OperatorCode", "StepRunningTime", "RunningTime", "Storerecordcount"
    };

    // RealTime Properties
    private static readonly Dictionary<string, PropertyMetadata> RealTimeProperties = new()
        {
            ["Current"] = new("Current (A)", Lucide.Activity),
            ["Voltage"] = new("Voltage (V)", Lucide.Zap),
            ["Power"] = new("Power (W)", Lucide.Battery),
            ["Temperature"] = new("Temperature (°C)", Lucide.Thermometer),
            ["AccumulatedCapacity"] = new("Accumulated Capacity (Ah)", Lucide.Gauge),
            ["ChargeCapacity"] = new("Charge Capacity (Ah)", Lucide.BatteryCharging),
            ["DischargeCapacity"] = new("Discharge Capacity (Ah)", Lucide.BatteryLow),
            ["StepCapacity"] = new("Step Capacity (Ah)", Lucide.ArrowRight),
            ["AccumulatedEnergy"] = new("Accumulated Energy (Wh)", Lucide.Gauge),
            ["ChargeEnergy"] = new("Charge Energy (Wh)", Lucide.BatteryCharging),
            ["DischargeEnergy"] = new("Discharge Energy (Wh)", Lucide.BatteryLow),
            ["StepEnergy"] = new("Step Energy (Wh)", Lucide.ArrowRight)
        };

    // Config Properties
    private static readonly Dictionary<string, PropertyMetadata> ConfigProperties = new()
        {
            ["BatteryID"] = new("Battery ID", Lucide.BatteryCharging),
            ["ProgramID"] = new("Program ID", Lucide.FileCode),
            ["SessionID"] = new("Session ID", Lucide.Hash)
        };

    // Program Properties
    private static readonly Dictionary<string, PropertyMetadata> ProgramProperties = new()
        {
            ["CycleNumber"] = new("Cycle Number", Lucide.Repeat),
            ["CycleStatus"] = new("Cycle Status", Lucide.CircleDot),
            ["CycleRunIteration"] = new("Cycle Run Iteration", Lucide.RefreshCw),
            ["TableStepNumber"] = new("Table Step", Lucide.Table),
            ["TableTotalRowNumber"] = new("Table Total Rows", Lucide.Rows4),
            ["StepNumber"] = new("Step Number", Lucide.ListOrdered),
            ["OperatorCode"] = new("Operator", Lucide.ChevronRight),
            ["StepRunningTime"] = new("Step Time", Lucide.Clock),
            ["RunningTime"] = new("Total Time", Lucide.Timer),
            ["Storerecordcount"] = new("Saved Records", Lucide.Download),
            ["Unstorerecordcount"] = new("Unsaved Records", Lucide.SaveOff),
            ["Error"] = new("Error Messages", Lucide.CircleAlert),
            ["SystemError"] = new("System Error", Lucide.ShieldAlert)
        };

    // Default configuration
    private static readonly CardConfig DefaultConfig = new()
        {
            CardSize = 210,
            FontSize = 12,
            RefreshRate = 200,
            ShowDecimal = 2,
            DisplayMode = DisplayMode.Normal,
            VisibleProperties = new List<string>(DefaultVisibleProperties)
        };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            try
            {
                await Task.Delay(100);
                await LoadConfigFromLocalStorage();
                IsReady = true;
                await NotifyConfigChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing config: {ex.Message}");
                Config = new CardConfig
                    {
                        CardSize = DefaultConfig.CardSize,
                        FontSize = DefaultConfig.FontSize,
                        RefreshRate = DefaultConfig.RefreshRate,
                        ShowDecimal = DefaultConfig.ShowDecimal,
                        DisplayMode = DefaultConfig.DisplayMode,
                        VisibleProperties = new List<string>(DefaultConfig.VisibleProperties)
                    };
                IsReady = true;
                await NotifyConfigChanged();
            }
        }
    }

    private void ToggleSection(string section)
    {
        // If clicking the same section, close it. Otherwise, open the new section
        expandedSection = expandedSection == section ? null : section;
    }

    private bool IsPropertyVisible(string propertyName)
    {
        return Config.VisibleProperties.Contains(propertyName);
    }

    private async Task ToggleProperty(string propertyName, bool isChecked)
    {
        if (isChecked && !Config.VisibleProperties.Contains(propertyName))
        {
            Config.VisibleProperties.Add(propertyName);
        }
        else if (!isChecked && Config.VisibleProperties.Contains(propertyName))
        {
            Config.VisibleProperties.Remove(propertyName);
        }

        await NotifyConfigChanged();
    }

    private async Task SelectAllProperties()
    {
        Config.VisibleProperties.Clear();
        Config.VisibleProperties.AddRange(RealTimeProperties.Keys);
        Config.VisibleProperties.AddRange(ConfigProperties.Keys);
        Config.VisibleProperties.AddRange(ProgramProperties.Keys);
        await NotifyConfigChanged();
    }

    private async Task ClearAllProperties()
    {
        Config.VisibleProperties.Clear();
        await NotifyConfigChanged();
    }

    private async Task UpdateCardSize(double value)
    {
        Config.CardSize = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateFontSize(double value)
    {
        Config.FontSize = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateRefreshRate(int value)
    {
        Config.RefreshRate = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateShowDecimal(int value)
    {
        Config.ShowDecimal = value;
        await NotifyConfigChanged();
    }

    private async Task UpdateDisplayMode(DisplayMode mode)
    {
        Config.DisplayMode = mode;
        await NotifyConfigChanged();
    }

    private async Task ResetConfigAsync()
    {
        if (!IsReady) return;

        try
        {
            Config.CardSize = DefaultConfig.CardSize;
            Config.FontSize = DefaultConfig.FontSize;
            Config.RefreshRate = DefaultConfig.RefreshRate;
            Config.ShowDecimal = DefaultConfig.ShowDecimal;
            Config.DisplayMode = DefaultConfig.DisplayMode;
            Config.VisibleProperties = new List<string>(DefaultConfig.VisibleProperties);

            await ClearConfigFromLocalStorage();
            await NotifyConfigChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting config: {ex.Message}");
        }
    }

    private async Task NotifyConfigChanged()
    {
        await SaveConfigToLocalStorage();
        await ConfigChanged.InvokeAsync(Config);
        StateHasChanged();
    }

    private string GetDecimalButtonClass(int value)
    {
        var baseClass = "flex-1 px-3 py-2 text-sm font-medium rounded-md transition-colors";
        return Config.ShowDecimal == value
            ? $"{baseClass} bg-primary text-primary-foreground"
            : $"{baseClass} bg-muted text-muted-foreground hover:bg-muted/80";
    }

    private SvgIcon GetDisplayModeIcon()
    {
        return Config.DisplayMode switch
        {
            DisplayMode.Mini => Lucide.Minimize2,
            DisplayMode.Compact => Lucide.Square,
            DisplayMode.Normal => Lucide.Maximize2,
            DisplayMode.Chart => Lucide.ChartBar,
            DisplayMode.List => Lucide.List,
            _ => Lucide.LayoutGrid
        };
    }

    private SvgIcon GetModeIcon(DisplayMode mode)
    {
        return mode switch
        {
            DisplayMode.Mini => Lucide.Minimize2,
            DisplayMode.Compact => Lucide.Square,
            DisplayMode.Normal => Lucide.Maximize2,
            DisplayMode.Chart => Lucide.ChartBar,
            DisplayMode.List => Lucide.List,
            _ => Lucide.LayoutGrid
        };
    }

    #region LocalStorage Operations

    private async Task SaveConfigToLocalStorage()
    {
        if (!IsReady) return;

        try
        {
             string key = $"{CurrentUser.UserName}_card_config";
            // await JS.InvokeVoidAsync("localStorageHelper.set", key, Config);

            if (CurrentUser.User != null)
            {
                sessionStorage.SetComponentState(key, Config, true);
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving config to localStorage: {ex.Message}");
        }
    }

    private async Task LoadConfigFromLocalStorage()
    {
        try
        {
            var key = $"{CurrentUser.UserName}_card_config";
            // var storedConfig = await JS.InvokeAsync<CardConfig?>("localStorageHelper.get", key);
            CardConfig storedConfig = new();

            if (CurrentUser.User != null)
            {
                storedConfig = sessionStorage.GetComponentState<CardConfig>(key);
            }

            if (storedConfig != null)
            {
                Config.CardSize = storedConfig.CardSize;
                Config.FontSize = storedConfig.FontSize;
                Config.RefreshRate = storedConfig.RefreshRate;
                Config.ShowDecimal = storedConfig.ShowDecimal;
                Config.DisplayMode = storedConfig.DisplayMode;
                Config.VisibleProperties = storedConfig.VisibleProperties?.Any() == true
                    ? storedConfig.VisibleProperties
                    : new List<string>(DefaultVisibleProperties);
            }
            else
            {
                Config.CardSize = DefaultConfig.CardSize;
                Config.FontSize = DefaultConfig.FontSize;
                Config.RefreshRate = DefaultConfig.RefreshRate;
                Config.ShowDecimal = DefaultConfig.ShowDecimal;
                Config.DisplayMode = DefaultConfig.DisplayMode;
                Config.VisibleProperties = new List<string>(DefaultConfig.VisibleProperties);
                await SaveConfigToLocalStorage();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading config from localStorage: {ex.Message}");
            Config = new CardConfig
                {
                    CardSize = DefaultConfig.CardSize,
                    FontSize = DefaultConfig.FontSize,
                    RefreshRate = DefaultConfig.RefreshRate,
                    ShowDecimal = DefaultConfig.ShowDecimal,
                    DisplayMode = DefaultConfig.DisplayMode,
                    VisibleProperties = new List<string>(DefaultVisibleProperties)
                };
        }
    }

    private async Task ClearConfigFromLocalStorage()
    {
        if (!IsReady) return;

        try
        {
            var key = $"{CurrentUser.UserName}_card_config";
            // await JS.InvokeVoidAsync("localStorageHelper.remove", key);
            if (CurrentUser.User != null)
            {
                sessionStorage.RemoveComponentState(key);
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing localStorage: {ex.Message}");
        }
    }

    #endregion

    public void Dispose()
    {
        // Cleanup if needed
    }
}