@namespace BatteryTestingSystem.Components.UI.Dashboard
@inject IJSRuntime JS

@implements IDisposable

<Popover>
    <PopoverTrigger AsChild>
        <Button variant="ButtonVariant.Outline" size="ButtonSize.Icon" Class="gap-2">
            <Blazicon Svg="Lucide.Package" class="h-4 w-4" />
            @* <span class="hidden sm:inline">Status Colors</span> *@
        </Button>
    </PopoverTrigger>

    <PopoverContent Class="w-80 bg-popover border border-border z-50" Align="PopoverAlign.End">
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h4 class="font-medium text-sm text-foreground">Circuit Status Colors</h4>
                <Button variant="ButtonVariant.Ghost" size="ButtonSize.Small"
                        @onclick="ResetColorsAsync"
                        StopPropagation="true"
                        class="h-7 px-2 gap-1">
                    <Blazicon Svg="Lucide.RotateCcw" class="h-3 w-3" />
                    Reset
                </Button>
            </div>

            @if (!IsReady)
            {
                <div class="text-sm text-muted-foreground">Loading colors...</div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var status in StatusKeys)
                    {
                        <div class="flex items-center gap-3">
                            <input type="color"
                                   value="@Colors[status]"
                                   @onchange="@(e => UpdateColorAsync(status, e.Value?.ToString()!))"
                                   @onclick:stopPropagation="true"
                                   @onchange:stopPropagation="true"
                                   class="w-8 h-8 rounded cursor-pointer border border-border" />

                            <div class="flex-1">
                                <div class="text-sm font-medium capitalize text-foreground">@status</div>
                                <div class="text-xs text-muted-foreground">@StatusDescriptions[status]</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </PopoverContent>
</Popover>

@code
{
    private bool IsReady { get; set; } = false;
    private bool _isInitialized = false;

    private static readonly string[] StatusKeys =
    {
        "idle", "charge", "discharging", "pause", "continue", "interrupt", "error", "msg", "offline"
    };

    // Default colors - used for reset
    private static readonly Dictionary<string, string> DefaultColors = new()
    {
        { "idle", "#9E9E9E" },
        { "charge", "#FFD600" },
        { "discharging", "#FF9800" },
        { "pause", "#2196F3" },
        { "continue", "#4CAF50" },
        { "interrupt", "#9B6616" },
        { "error", "#F44336" },
        { "msg", "#00BCD4" },
        { "offline", "#f7caca" }
    };

    // Current colors dictionary
    public Dictionary<string, string> Colors { get; set; } = new(DefaultColors);

    // Descriptions
    public Dictionary<string, string> StatusDescriptions = new()
    {
        { "idle", "Idle or waiting" },
        { "charge", "Charging in progress" },
        { "discharging", "Discharging mode" },
        { "pause", "Process paused" },
        { "continue", "Continuing process" },
        { "interrupt", "Interrupted temporarily" },
        { "error", "Error or fault condition" },
        { "msg", "Message or system notification" },
        { "offline", "Circuit is offline" }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;

            try
            {
                // Small delay to ensure DOM is fully ready
                await Task.Delay(100);

                // Load colors from localStorage first
                await LoadColorsFromLocalStorage();

                // Mark as ready and trigger re-render to show loaded colors
                IsReady = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error initializing colors: {ex.Message}");
                // On error, apply defaults
                await ApplyDefaultColors();
                IsReady = true;
                StateHasChanged();
            }
        }
    }

    public async Task UpdateColorAsync(string status, string color)
    {
        if (!IsReady || string.IsNullOrWhiteSpace(color))
            return;

        try
        {
            // Update the color in dictionary
            Colors[status] = color;

            // Apply to CSS variable
            await ApplyCssVariable($"--status-{status}", color);

            // Save to localStorage
            await SaveColorsToLocalStorage();

            // Update UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating color for {status}: {ex.Message}");
        }
    }

    private async Task ResetColorsAsync()
    {
        if (!IsReady)
            return;

        try
        {
            // Reset to default colors
            Colors = new Dictionary<string, string>(DefaultColors);

            // Apply defaults to CSS variables
            await ApplyDefaultColors();

            // Clear localStorage
            await ClearColorsFromLocalStorage();

            // Update UI
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resetting colors: {ex.Message}");
        }
    }

    private async Task ApplyDefaultColors()
    {
        foreach (var kvp in DefaultColors)
        {
            await ApplyCssVariable($"--status-{kvp.Key}", kvp.Value);
        }
    }

    private async Task ApplyCssVariable(string variable, string hexColor)
    {
        try
        {
            var hslColor = HexToHsl(hexColor);
            await JS.InvokeVoidAsync("cssVars.set", variable, hslColor);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting CSS variable {variable}: {ex.Message}");
        }
    }

    private string HexToHsl(string hex)
    {
        hex = hex.TrimStart('#');

        if (hex.Length != 6)
            return "0 0% 50%";

        try
        {
            var r = Convert.ToInt32(hex.Substring(0, 2), 16) / 255.0;
            var g = Convert.ToInt32(hex.Substring(2, 2), 16) / 255.0;
            var b = Convert.ToInt32(hex.Substring(4, 2), 16) / 255.0;

            var max = Math.Max(Math.Max(r, g), b);
            var min = Math.Min(Math.Min(r, g), b);
            var delta = max - min;

            var h = 0.0;
            var s = 0.0;
            var l = (max + min) / 2.0;

            if (delta != 0)
            {
                s = l > 0.5 ? delta / (2.0 - max - min) : delta / (max + min);

                if (max == r)
                    h = ((g - b) / delta + (g < b ? 6 : 0)) / 6.0;
                else if (max == g)
                    h = ((b - r) / delta + 2) / 6.0;
                else
                    h = ((r - g) / delta + 4) / 6.0;
            }

            var hDeg = Math.Round(h * 360);
            var sPercent = Math.Round(s * 100);
            var lPercent = Math.Round(l * 100);

            return $"{hDeg} {sPercent}% {lPercent}%";
        }
        catch
        {
            return "0 0% 50%";
        }
    }

    #region LocalStorage Operations

    private async Task SaveColorsToLocalStorage()
    {
        if (!IsReady)
            return;

        try
        {
            var key = $"{CurrentUser.UserName}_status_colors";
            await JS.InvokeVoidAsync("localStorageHelper.set", key, Colors);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving to localStorage: {ex.Message}");
        }
    }

    private async Task LoadColorsFromLocalStorage()
    {
        try
        {
            var key = $"{CurrentUser.UserName}_status_colors";

            var storedColors = await JS.InvokeAsync<Dictionary<string, string>?>(
                "localStorageHelper.get",
                key
            );

            if (storedColors != null && storedColors.Count > 0)
            {
                // Load stored colors
                Colors = storedColors;

                // Apply each stored color to CSS
                foreach (var kvp in storedColors)
                {
                    if (StatusKeys.Contains(kvp.Key))
                    {
                        await ApplyCssVariable($"--status-{kvp.Key}", kvp.Value);
                    }
                }
            }
            else
            {
                // No saved colors, use defaults
                Colors = new Dictionary<string, string>(DefaultColors);
                await ApplyDefaultColors();

                // Save defaults to localStorage for next time
                await SaveColorsToLocalStorage();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading from localStorage: {ex.Message}");
            // Fallback to defaults
            Colors = new Dictionary<string, string>(DefaultColors);
            await ApplyDefaultColors();
        }
    }

    private async Task ClearColorsFromLocalStorage()
    {
        if (!IsReady)
            return;

        try
        {
            var key = $"{CurrentUser.UserName}_status_colors";
            await JS.InvokeVoidAsync("localStorageHelper.remove", key);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error clearing localStorage: {ex.Message}");
        }
    }

    #endregion

    public void Dispose()
    {
        // Cleanup if needed
    }
}