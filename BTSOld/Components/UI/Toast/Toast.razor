@namespace BatteryTestingSystem.Components.UI

<div class="@GetClasses()"
     role="alert"
     @attributes="AdditionalAttributes">
    <div class="flex items-center justify-between space-x-4">

    <div class="flex items-start gap-3 flex-1">
        @if (ShowIcon)
        {
            <div class="shrink-0 mt-0.5">
                @GetVariantIcon()
            </div>
        }
        <div class="flex-1 grid gap-1">
                @ChildContent
        </div>
            @if (ShowClose)
            {
                <button type="button"
                        class="absolute right-2 top-2 rounded-md p-1 text-foreground/50 opacity-0 transition-opacity group-hover:opacity-100 group-[.destructive]:text-red-300 group-[.success]:text-green-300 group-[.warning]:text-yellow-300 hover:text-foreground group-[.destructive]:hover:text-red-50 group-[.success]:hover:text-green-50 group-[.warning]:hover:text-yellow-50 focus:opacity-100 focus:outline-none focus:ring-2 group-[.destructive]:focus:ring-red-400 group-[.destructive]:focus:ring-offset-red-600 group-[.success]:focus:ring-green-400 group-[.success]:focus:ring-offset-green-600 group-[.warning]:focus:ring-yellow-400 group-[.warning]:focus:ring-offset-yellow-600"
                        @onclick="HandleClose"
                        aria-label="Close">
                    <Blazicon Svg="Lucide.X" class="w-4 h-4" />
                </button>
            }
    </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;

    [Parameter] public string? Class { get; set; }
    [Parameter] public ToastVariant Variant { get; set; } = ToastVariant.Default; // "default" | "destructive" | "success" | "warning"
    [Parameter] public bool ShowClose { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }


    private RenderFragment GetVariantIcon()
    {
        return Variant switch
        {
            ToastVariant.Success => RenderSuccess,
            ToastVariant.Warning => RenderWarning,
            ToastVariant.Destructive => RenderDestructive,
            _ => RenderInfo
        };
    }

    private void RenderSuccess(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        <Blazicon Svg="Lucide.CircleCheck" class="w-5 h-5 text-green-600 dark:text-green-400" />
    }

    private void RenderWarning(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        <Blazicon Svg="Lucide.TriangleAlert" class="w-5 h-5 text-yellow-600 dark:text-yellow-400" />
    }

    private void RenderDestructive(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        <Blazicon Svg="Lucide.CircleX" class="w-5 h-5 text-red-600 dark:text-red-400" />
    }

    private void RenderInfo(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        <Blazicon Svg="Lucide.Info" class="w-5 h-5 text-blue-600 dark:text-blue-400" />
    }

    private string GetClasses()
    {
        var baseClasses = "group pointer-events-auto relative flex w-full items-center justify-between space-x-4 overflow-hidden rounded-md border p-2 pr-8 shadow-lg transition-all data-[swipe=cancel]:translate-x-0 data-[swipe=end]:translate-x-[var(--radix-toast-swipe-end-x)] data-[swipe=move]:translate-x-[var(--radix-toast-swipe-move-x)] data-[swipe=move]:transition-none data-[state=open]:animate-in data-[state=closed]:animate-out data-[swipe=end]:animate-out data-[state=closed]:fade-out-80 data-[state=closed]:slide-out-to-right-full data-[state=open]:slide-in-from-top-full data-[state=open]:sm:slide-in-from-bottom-full";

        var variantClasses = Variant switch
        {
            ToastVariant.Destructive => "destructive border-red-200 bg-red-50 text-red-900 dark:border-red-800 dark:bg-red-950 dark:text-red-50",
            ToastVariant.Success => "success border-green-200 bg-green-50 text-green-900 dark:border-green-800 dark:bg-green-950 dark:text-green-50",
            ToastVariant.Warning => "warning border-yellow-200 bg-yellow-50 text-yellow-900 dark:border-yellow-800 dark:bg-yellow-950 dark:text-yellow-50",
            _ => "border bg-background text-foreground"
        };

        return CN.Merge(baseClasses, variantClasses, Class);
    }
}
