@namespace BatteryTestingSystem.Components.UI.Popover

@if (AsChild)
{
    <div @onclick="HandleClick" class="@Class" @onclick:stopPropagation="true" @attributes="AdditionalAttributes">
        @ChildContent
    </div>

}
else
{
    <button @onclick="HandleClick" class="@Class" @onclick:stopPropagation="true" @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}


@code {
    [CascadingParameter]
    private Popover? ParentPopover { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool AsChild { get; set; } = true;

    [Parameter] public string Class { get; set; } = string.Empty;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task HandleClick()
    {
        if (ParentPopover != null)
        {
            await ParentPopover.Toggle();
        }
    }
}
