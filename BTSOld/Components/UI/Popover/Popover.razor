@namespace BatteryTestingSystem.Components.UI.Popover
@implements IAsyncDisposable
@inject PopupService PopupService

<div id="@ElementId" class="relative inline-block">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {

    [Parameter]
    public string ElementId { get; set; } = $"popover-{Guid.NewGuid():N}";
    private PopupInstance? _popup;
    private int _zIndex = 1000;

    [Parameter] public RenderFragment? ChildContent { get; set; }
    // [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    internal bool IsOpen { get; private set; }

    protected override void OnParametersSet()
    {
        // IsOpen = Open;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (IsOpen && _popup == null)
            RegisterPopup();
        else if (!IsOpen && _popup != null)
            UnregisterPopup();
    }

    private void RegisterPopup()
    {
        _popup = PopupService.RegisterPopup(ElementId, PopupType.Popover);
        _popup.CanCloseWithEsc = true;
        _popup.CanCloseWithOverlay = false;   // 🔥 IMPORTANT FIX

        _popup.RequestClose = async () =>
        {
            await Close();
        };

        _zIndex = _popup.ZIndex;
    }

    private void UnregisterPopup()
    {
        PopupService.UnregisterPopup(ElementId);
        _popup = null;
    }

    internal async Task Toggle()
    {
        if (IsOpen)
        {
            await Close();
        }
        else
        {
            // Close any other open popups
            PopupService.CloseAllExcept(ElementId);

            IsOpen = true;
            await OpenChanged.InvokeAsync(true);
            StateHasChanged();
        }
    }

    internal async Task Close()
    {
        if (!IsOpen) return;

        IsOpen = false;
        await OpenChanged.InvokeAsync(false);

        UnregisterPopup();
        StateHasChanged();
    }

    // Required by IPopupComponent
    public async Task CloseAsync() => await Close();

    internal async Task SetOpen(bool open)
    {
        if (open) await Toggle();
        else await Close();
    }

    public async ValueTask DisposeAsync()
    {
        UnregisterPopup();
    }
}
