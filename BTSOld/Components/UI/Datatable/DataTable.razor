    // ── View-state persistence ────────────────────────────────────────────────

    // Session-storage key unique per user + table instance
    private string StorageKey => $"{CurrentUser.UserName}_{Title}_DataTable";

    /// <summary>Minimal serialisable snapshot of user-controlled view settings.</summary>
    private sealed record DataTableViewState(
        double FontSize,
        int PageSize,
        Dictionary<string, bool> ColVisibility,
        List<string> ColOrder,
        HashSet<string>? ExpandedGroups = null);  // null = not saved yet (use DefaultExpanded)

    /// <summary>
    /// Persists all current view settings (font size, page size, column visibility
    /// and order) to session storage in one atomic write.
    /// Call this after any user-driven view change.
    /// </summary>
    private void SaveViewState()
    {
        var state = new DataTableViewState(
            FontSize:       _fontSize,
            PageSize:       _pageSize,
            ColVisibility:  _ctx.AllOrdered.ToDictionary(c => c.Key, c => c.Visible),
            ColOrder:       _ctx.AllOrdered.Select(c => c.Key).ToList(),
            ExpandedGroups: GroupBy is IGroupRenderer<TItem> ? new HashSet<string>(_expandedGroups) : null);

        var json = System.Text.Json.JsonSerializer.Serialize(state);
        sStorage.SetComponentState(StorageKey, json, true);
    }

    private void OnFontSizeInput()
    {
        SaveViewState();
    }

    // ── Dispose ──────────────────────────────────────────────────────────────

    public void Dispose() { _debounce?.Stop(); _debounce?.Dispose(); }
