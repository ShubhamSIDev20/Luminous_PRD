@using BatteryTestingSystem.Components.UI.ContextMenu
@inject PopupService PopupService

@if (ContextMenu?.IsOpen == true)
{
    <!-- Overlay to close on click -->
    @* <div class="fixed inset-0 z-50" 
         style="z-index: @(_zIndex)"
         @oncontextmenu="@(() => ContextMenu.Close())"
         @oncontextmenu:preventDefault
         @onclick="@(() => ContextMenu.Close())"></div> *@
    <!-- Context Menu Content -->
    <div class="@GetClasses()"
        style="@GetPositionStyle()"
        @onclick:stopPropagation
        @onkeydown="HandleKeyDown"
        @attributes="AdditionalAttributes">
            @ChildContent
    </div>
}

@code {

    [CascadingParameter] public ContextMenu? ContextMenu { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string _popupId = Guid.NewGuid().ToString();
    private int _zIndex = 1000;
    private PopupInstance? _popupInstance;

    protected override void OnParametersSet()
    {
        if (ContextMenu?.IsOpen == true && _popupInstance == null)
        {
            _popupInstance = PopupService.RegisterPopup(_popupId, PopupType.Popover);
            _popupInstance.CanCloseWithEsc = true;
            _popupInstance.RequestClose = () => { ContextMenu?.Close(); return; };
            _zIndex = _popupInstance.ZIndex;
        }
        else if (ContextMenu?.IsOpen == false && _popupInstance != null)
        {
            PopupService.UnregisterPopup(_popupId);
            _popupInstance = null;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ContextMenu?.Close();
        }
    }

    private string GetClasses()
    {
        var baseClasses = "fixed z-50 min-w-[8rem] overflow-hidden rounded-md border bg-popover p-1 text-popover-foreground shadow-md animate-in fade-in-0 zoom-in-95";
        return CN.Merge(baseClasses, Class);
    }

    private string GetPositionStyle()
    {
        return $"left: {ContextMenu?.X ?? 0}px; top: {ContextMenu?.Y ?? 0}px; z-index: {_zIndex + 1};";
    }

    public void Dispose()
    {
        if (_popupInstance != null)
        {
            PopupService.UnregisterPopup(_popupId);
        }
    }
}
