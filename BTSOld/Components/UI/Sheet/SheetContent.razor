@namespace BatteryTestingSystem.Components.UI.Sheet

@if (ParentSheet?.IsOpen == true)
{
    <!-- Overlay -->
    <div  class="fixed inset-0 z-50 bg-black/80 animate-in fade-in-0"
            @onclick="HandleOverlayClick" style="z-index: @(_zIndex)">
        </div>
    
    <!-- Content -->
    <div class="@GetClasses()" @onclick:stopPropagation @attributes="AdditionalAttributes" style="z-index: @(_zIndex + 1)">
       
        @ChildContent
        
        <!-- Close Button -->
        <button class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none"
                @onclick="HandleClose">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            <span class="sr-only">Close</span>
        </button>
    </div>
}

@code {
    [CascadingParameter]
    private Sheet? ParentSheet { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public SheetSide Side { get; set; } = SheetSide.Right;

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
    private int _zIndex = 1000;

    private string GetClasses()
    {
        var baseClasses = "fixed z-50 gap-4 bg-background p-6 shadow-lg transition ease-in-out";
        
        var sideClasses = Side switch
        {
            SheetSide.Top => "inset-x-0 top-0 border-b animate-in slide-in-from-top",
            SheetSide.Bottom => "inset-x-0 bottom-0 border-t animate-in slide-in-from-bottom",
            SheetSide.Left => "inset-y-0 left-0 h-full w-3/4 border-r animate-in slide-in-from-left sm:max-w-sm",
            SheetSide.Right => "inset-y-0 right-0 h-full w-3/4 border-l animate-in slide-in-from-right sm:max-w-sm",
            _ => "inset-y-0 right-0 h-full w-3/4 border-l animate-in slide-in-from-right sm:max-w-sm"
        };

        var custom = Class ?? "";
        return $"{baseClasses} {sideClasses} {custom}".Trim();
    }

    private async Task HandleOverlayClick()
    {
        if (ParentSheet != null)
            await ParentSheet.Close();
    }

    private async Task HandleClose()
    {
        if (ParentSheet != null)
            await ParentSheet.Close();
    }
}
