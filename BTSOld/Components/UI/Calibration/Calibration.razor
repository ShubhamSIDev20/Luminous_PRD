    #region Calibration Calculations

    private void CalculateCalibrationValues()
    {
        if (!circuit.calibration.ActualLowInput.HasValue  || !circuit.calibration.ActualHighInput.HasValue ||
            !circuit.calibration.SystemLowInput.HasValue  || !circuit.calibration.SystemHighInput.HasValue)
        {
            AddMessage("Missing calibration data.", MessageType.Error);
            return;
        }
        float y1 = circuit.calibration.ActualLowInput.Value;
        float y2 = circuit.calibration.ActualHighInput.Value;
        float x1 = circuit.calibration.SystemLowInput.Value;
        float x2 = circuit.calibration.SystemHighInput.Value;
        circuit.calibration.Gain   = (y2 - y1) / (x2 - x1);
        circuit.calibration.Offset = y1 - (circuit.calibration.Gain.Value * x1);
        AddMessage($"Gain: {circuit.calibration.Gain:F6}, Offset: {circuit.calibration.Offset:F6}", MessageType.Success);
    }

    private void CalculateVoltageCalibrationValues()
    {
        if (!circuit.calibration.UserLowInput.HasValue   || !circuit.calibration.UserHighInput.HasValue ||
            !circuit.calibration.SystemLowInput.HasValue || !circuit.calibration.SystemHighInput.HasValue)
        {
            AddMessage("Missing voltage data.", MessageType.Error);
            return;
        }
        float y1 = circuit.calibration.UserLowInput.Value;
        float y2 = circuit.calibration.UserHighInput.Value;
        float x1 = circuit.calibration.SystemLowInput.Value;
        float x2 = circuit.calibration.SystemHighInput.Value;
        circuit.calibration.Gain   = (y2 - y1) / (x2 - x1);
        circuit.calibration.Offset = y1 - (circuit.calibration.Gain.Value * x1);
        AddMessage($"Voltage Gain: {circuit.calibration.Gain:F6}, Offset: {circuit.calibration.Offset:F6}", MessageType.Success);
    }

    private void CalculateTemperatureCalibrationValues()
    {
        if (!circuit.calibration.UserLowInput.HasValue   || !circuit.calibration.UserHighInput.HasValue ||
            !circuit.calibration.SystemLowInput.HasValue || !circuit.calibration.SystemHighInput.HasValue)
        {
            AddMessage("Missing temperature calibration data.", MessageType.Error);
            return;
        }
        float y1 = circuit.calibration.UserLowInput.Value;
        float y2 = circuit.calibration.UserHighInput.Value;
        float x1 = circuit.calibration.SystemLowInput.Value;
        float x2 = circuit.calibration.SystemHighInput.Value;
        circuit.calibration.Gain   = (y2 - y1) / (x2 - x1);
        circuit.calibration.Offset = y1 - (circuit.calibration.Gain.Value * x1);
        AddMessage($"Temp Gain: {circuit.calibration.Gain:F6}, Offset: {circuit.calibration.Offset:F6}", MessageType.Success);
    }

    #endregion

    #region Reset and Cancel

    private void ResetCalibration(bool force = false)
    {
        Task.Delay(1000).Wait();

        circuit?.StopCalibration(force);
        Step = CalibrationStep.Idle;
        circuit.calibration.IsCalibrationInPrcoess = false;
        circuit.calibration.UserLowInput    = null;
        circuit.calibration.UserHighInput   = null;
        circuit.calibration.ActualLowInput  = null;
        circuit.calibration.ActualHighInput = null;
        circuit.calibration.SystemLowInput  = null;
        circuit.calibration.SystemHighInput = null;
        circuit.calibration.Gain            = null;
        circuit.calibration.Offset          = null;
        // circuit.calibration.SelectedRange   = CalibrationRange.Full_Range;
        circuit.calibration.calibrationBuffer.Clear();
        IsError = false;
        AddMessage("Calibration reset.", MessageType.Info);
        InvokeAsync(StateHasChanged);
    }

    private void CancelCalibration()
    {
        switch (Step)
        {
            case CalibrationStep.LowActualConfirm:
                circuit?.CancelCalibration();
                Step = CalibrationStep.LowConfirm;
                break;
            case CalibrationStep.HighConfirm:
                circuit?.CancelCalibration();
                Step = CalibrationStep.LowActualConfirm;
                break;
            case CalibrationStep.HighActualConfirm:
                circuit?.CancelCalibration();
                Step = CalibrationStep.HighConfirm;
                break;
            case CalibrationStep.Complete:
                circuit?.CancelCalibration();
                Step = CalibrationStep.HighActualConfirm;
                break;
        }
    }

    private bool CancelButtonDisabled() =>
        Step == CalibrationStep.Idle || Step == CalibrationStep.LowConfirm;

    #endregion

    #region UI Helper Methods

    private void SetCalibrationType(CalibrationTypeMode mode)
    {
        if (circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)
        {
            AddMessage("Cannot change type during active process.", MessageType.Warning);
            return;
        }
        ResetCalibration();
        circuit.calibration.CalibrationMode = mode;
        AddMessage($"Type: {mode}", MessageType.Info);
    }

    private void SetMode(bool isCharge)
    {
        if (circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)
        {
            AddMessage("Cannot change mode during process.", MessageType.Warning);
            return;
        }
        circuit.calibration.IsCharge = isCharge;
        AddMessage($"Mode: {(isCharge ? "Charge" : "Discharge")}", MessageType.Info);
    }

    private void SetRange(CalibrationRange range)
    {
        if (circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)
        {
            AddMessage("Cannot change range during active process.", MessageType.Warning);
            return;
        }
        circuit.calibration.SelectedRange = range;
        var label = GetRangeButtonsOrdered().FirstOrDefault(r => r.Range == range).Label ?? range.ToString();
        AddMessage($"Range: {label}", MessageType.Info);
    }

    private void SetVerifyMode(bool isCharge)
    {
        if (circuit.calibration.IsVerifying || circuit.calibration.IsCalibrationInPrcoess)
        {
            AddMessage("Cannot change mode during process.", MessageType.Warning);
            return;
        }
        circuit.calibration.IsCharge = isCharge;
        ResetVerification();
        AddMessage($"Verify mode: {(isCharge ? "Charge" : "Discharge")}", MessageType.Info);
    }

    private void ResetVerification()
    {
        circuit.calibration.VerifyTestValue = null;
        circuit.calibration.IsVerifying     = false;
    }

    private string GetCalibrationTypeButtonClass(bool isSelected)
    {
        const string baseClass = "px-2 py-1.5 text-xs font-medium rounded flex items-center gap-1.5 transition-all";
        if (circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)
            return $"{baseClass} bg-muted text-muted-foreground cursor-not-allowed";
        return isSelected
            ? $"{baseClass} bg-primary text-primary-foreground shadow-sm hover:bg-primary/90"
            : $"{baseClass} bg-background text-foreground border border-border hover:bg-accent";
    }

    private string GetCalibrationModeButtonClass(bool isSelected, bool isDisabled)
    {
        const string baseClass = "flex-1 px-2 py-1 text-sm font-medium rounded flex items-center justify-center gap-1 transition-all";
        if (isDisabled)
            return $"{baseClass} bg-muted text-muted-foreground cursor-not-allowed";
        var ringClass = isSelected && Step != CalibrationStep.Idle ? "ring-1 ring-primary/50" : "";
        return isSelected
            ? $"{baseClass} bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 {ringClass}"
            : $"{baseClass} bg-background text-foreground border border-border hover:bg-accent";
    }

    private string GetToggleButtonClass(bool isSelected, bool isDisabled)
    {
        const string baseClass = "flex-1 px-2 py-1 text-sm font-medium rounded flex items-center justify-center gap-1 transition-all";
        if (isDisabled)
            return $"{baseClass} bg-muted text-muted-foreground cursor-not-allowed";
        return isSelected
            ? $"{baseClass} bg-primary text-primary-foreground shadow-sm hover:bg-primary/90"
            : $"{baseClass} bg-background text-foreground border border-border hover:bg-accent";
    }

    private string GetStepDisplayText()
    {
        if (circuit.calibration.IsCurrent)
        {
            return Step switch
            {
                CalibrationStep.Idle             => "Ready",
                CalibrationStep.LowConfirm       => "1/4",
                CalibrationStep.LowActualConfirm => "2/4",
                CalibrationStep.HighConfirm      => "3/4",
                CalibrationStep.HighActualConfirm => "4/4",
                CalibrationStep.Complete         => "Done",
                _ => "?"
            };
        }

        // Voltage and Temperature follow same 2-step display
        return Step switch
        {
            CalibrationStep.Idle        => "Ready",
            CalibrationStep.LowConfirm  => "1/2",
            CalibrationStep.HighConfirm => "2/2",
            CalibrationStep.Complete    => "Done",
            _ => "?"
        };
    }

    private string GetActionButtonText()
    {
        if (circuit.calibration.IsCurrent)
        {
            return Step switch
            {
                CalibrationStep.Idle              => "Start Calibration",
                CalibrationStep.LowConfirm        => "Confirm Low Ref",
                CalibrationStep.LowActualConfirm  => "Confirm Low Actual",
                CalibrationStep.HighConfirm       => "Confirm High Ref",
                CalibrationStep.HighActualConfirm => "Confirm High Actual",
                CalibrationStep.Complete          => "Transfer",
                _ => "Next"
            };
        }

        var typeLabel = circuit.calibration.IsTemperature ? "Temp" : "Voltage";
        return Step switch
        {
            CalibrationStep.Idle        => $"Start {typeLabel} Calibration",
            CalibrationStep.LowConfirm  => "Confirm Low",
            CalibrationStep.HighConfirm => "Confirm High",
            CalibrationStep.Complete    => "Transfer",
            _ => "Next"
        };
    }

    private bool IsActionButtonDisabled()
    {
        if (circuit == null || IsError) return true;

        if (circuit.calibration.IsCurrent)
        {
            var (rangeMin, rangeMax) = GetCurrentRangeBounds();
            return Step switch
            {
                CalibrationStep.Idle              => false,
                CalibrationStep.LowConfirm        => !IsCurrentInputValid(circuit.calibration.UserLowInput,  rangeMin, rangeMax),
                CalibrationStep.LowActualConfirm  => !circuit.calibration.ActualLowInput.HasValue,
                CalibrationStep.HighConfirm       => !IsCurrentInputValid(circuit.calibration.UserHighInput, rangeMin, rangeMax),
                CalibrationStep.HighActualConfirm => !circuit.calibration.ActualHighInput.HasValue,
                CalibrationStep.Complete          => false,
                _ => true
            };
        }

        // Voltage and Temperature
        return Step switch
        {
            CalibrationStep.Idle        => false,
            CalibrationStep.LowConfirm  => !circuit.calibration.UserLowInput.HasValue,
            CalibrationStep.HighConfirm => !circuit.calibration.UserHighInput.HasValue,
            CalibrationStep.Complete    => false,
            _ => true
        };
    }

    private string GetStepBadgeClass() => Step switch
    {
        CalibrationStep.Complete => "px-1.5 py-0.5 text-sm font-semibold rounded bg-green-100 text-green-800",
        CalibrationStep.Idle     => "px-1.5 py-0.5 text-sm font-semibold rounded bg-gray-100 text-gray-800",
        _ => "px-1.5 py-0.5 text-sm font-semibold rounded bg-blue-100 text-blue-800"
    };

    private int GetProgressPercentage() => Step switch
    {
        CalibrationStep.Idle              => 0,
        CalibrationStep.LowConfirm        => 20,
        CalibrationStep.LowActualConfirm  => 40,
        CalibrationStep.HighConfirm       => 60,
        CalibrationStep.HighActualConfirm => 80,
        CalibrationStep.Complete          => 100,
        _ => 0
    };

    #endregion

    #region Range Validation Helpers

    /// <summary>
    /// Returns the ordered list of range buttons for the UI.
    /// UI label order (low-to-high current): Full Range → Range1 → Range2 → Range3 → Range4.
    /// The user-facing Range1 is the smallest current window (backend Range4),
    /// and user-facing Range4 is the largest window (backend Range1).
    /// Wire bytes sent to hardware are the CalibrationRange enum values — unchanged.
    /// </summary>
    private static IEnumerable<(CalibrationRange Range, string Label)> GetRangeButtonsOrdered()
    {
        // UI label  → Backend enum value that owns that current window
        // Full Range: maxA/2 … maxA  (kept as-is, covers widest span)
        // Range1 (UI): 0.5 … maxA/8   → backend Range4 = 0x04
        // Range2 (UI): maxA/8 … maxA/4 → backend Range3 = 0x03
        // Range3 (UI): maxA/4 … maxA/2 → backend Range2 = 0x02
        // Range4 (UI): maxA/2 … maxA   → backend Range1 = 0x01
        yield return (CalibrationRange.Full_Range, "Full Range");
        yield return (CalibrationRange.Range4,     "Range1");   // smallest window → shown first
        yield return (CalibrationRange.Range3,     "Range2");
        yield return (CalibrationRange.Range2,     "Range3");
        yield return (CalibrationRange.Range1,     "Range4");   // largest window  → shown last
    }

    /// <summary>
    /// Returns the (low, high) physical current bounds for the selected range.
    /// Bounds use the backend CalibrationRange enum value — wire bytes are unchanged.
    /// The mapping is:
    ///   Full_Range        : 0.5 … maxA
    ///   Backend Range1 (UI Range4, 100%) : maxA/2 … maxA
    ///   Backend Range2 (UI Range3,  50%) : maxA/4 … maxA/2
    ///   Backend Range3 (UI Range2,  25%) : maxA/8 … maxA/4
    ///   Backend Range4 (UI Range1,12.5%) : 0.5   … maxA/8
    /// </summary>
    private (float minValue, float maxValue) GetCurrentRangeBounds()
    {
        float maxA = circuit?.Circuit?.CircuitMaxChargingCurrent ?? 51f;

        return circuit.calibration.SelectedRange switch
        {
            CalibrationRange.Full_Range => (0.5f,     maxA),
            CalibrationRange.Range1     => (maxA / 2, maxA),       // UI Range4 — largest window
            CalibrationRange.Range2     => (maxA / 4, maxA / 2),   // UI Range3
            CalibrationRange.Range3     => (maxA / 8, maxA / 4),   // UI Range2
            CalibrationRange.Range4     => (0.5f,     maxA / 8),   // UI Range1 — smallest window
            _                           => (0.5f,     maxA)
        };
    }

    private bool IsCurrentInputValid(float? value, float min, float max)
        => value.HasValue && value.Value >= 0 && value.Value >= min && value.Value <= max;

    #endregion

    private void AddMessage(string text, MessageType type)
    {
        messages.Add(new CalibrationMessage { Text = text, Type = type, Timestamp = DateTime.Now });
        if (messages.Count > 50)
            messages.RemoveAt(0);
        SessionStorage.SetComponentState(calId, messages);
    }

    private void ClearMessages() => messages.Clear();

    private string GetMessageClass(MessageType type) => type switch
    {
        MessageType.Success => "text-green-600 font-medium",
        MessageType.Error   => "text-red-600 font-medium",
        MessageType.Warning => "text-yellow-600 font-medium",
        MessageType.Info    => "text-blue-600 font-medium",
        _ => "text-foreground"
    };

    #region Verification

    private async Task HandleVerify()
    {
        if (circuit == null || !circuit.calibration.VerifyTestValue.HasValue)
        {
            AddMessage("Invalid verification parameters.", MessageType.Error);
            return;
        }

        if (!circuit.calibration.IsVerifying)
        {
            var readyResponse = await circuit.HWReadyToCalibrationAsync();
           
            if (!readyResponse.Success)
            {
                AddMessage($"Hardware not ready: {readyResponse.Message}", MessageType.Error);
                return;
            }

            await Task.Delay(1000);

            var getPreviousData = await circuit.PreviousCalibration();
            if (getPreviousData.Success && getPreviousData.Data != null)
            {
                circuit.calibration.CurrentCharge = getPreviousData.Data.CurrentCharge ?? new();
                circuit.calibration.CurrentDischarge = getPreviousData.Data.CurrentDischarge ?? new();
                circuit.calibration.VoltageCharge = getPreviousData.Data.VoltageCharge;
                circuit.calibration.VoltageDischarge = getPreviousData.Data.VoltageDischarge;
                circuit.calibration.TemperaturePoint = getPreviousData.Data.Temperature;
                AddMessage("Previous Data Received.", MessageType.Info);
                StateHasChanged();
            }

            CalibrationQueryId queryId;
            if (circuit.calibration.IsCurrent)
            {
                queryId = circuit.calibration.IsCharge
                    ? CalibrationQueryId.StartChargeVerifyCurrentcalibration
                    : CalibrationQueryId.StartDisChargeVerifyCurrentcalibration;
            }
            else
            {
                AddMessage("Voltage verification not implemented.", MessageType.Warning);
                return;
            }

            var response = await circuit.CalibrationPointPreset(queryId, circuit.calibration.VerifyTestValue.Value, null);
            if (!response.Success)
            {
                AddMessage($"Failed to start: {response.Message}", MessageType.Error);
                return;
            }

            circuit.calibration.IsVerifying = true;
            AddMessage($"Verifying at {circuit.calibration.VerifyTestValue.Value:F4}", MessageType.Info);
        }
        else
        {
            var response = await circuit.StopverifyCalibration();
            if (!response.Success)
            {
                AddMessage($"Failed to stop: {response.Message}", MessageType.Error);
                return;
            }

            var stopProcess = await circuit.StopCalibration();
            if (!stopProcess.Success)
            {
                AddMessage($"StopCalibrationProcess Failed: {stopProcess.Message}", MessageType.Warning);
                return;
            }

            circuit.calibration.IsVerifying = false;
            AddMessage("Verification stopped.", MessageType.Info);
        }

        StateHasChanged();
    }

    #endregion

}
