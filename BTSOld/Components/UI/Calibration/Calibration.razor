@using BatteryTestingSystem.Models.Enums
@using Microsoft.AspNetCore.Components.Rendering
@inject CircuitManager CM
@inject ServerSessionStorageService SessionStorage
@implements IDisposable

<!-- Main Content Area -->
<div class="flex-1 overflow-hidden bg-background">

    <div class="h-full flex flex-col p-3">
        <!-- Compact Header with Calibration Type -->
        <div class="flex items-center justify-between mb-2 pb-2 border-b border-border">
            <h1 class="text-base font-bold text-foreground truncate">
                Calibration - @(circuit?.Circuit.DeviceName ?? "Select a circuit")
            </h1>

            @if (circuit != null)
            {
                <div class="flex gap-2">
                    <button @onclick="() => SetCalibrationType(CalibrationTypeMode.Current)"
                    disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                    class="@GetCalibrationTypeButtonClass(circuit.calibration.CalibrationMode == CalibrationTypeMode.Current)">
                        <Blazicon Svg="Lucide.Zap" class="w-3.5 h-3.5" />
                        <span class="text-xs">Current</span>
                    </button>
                    <button @onclick="() => SetCalibrationType(CalibrationTypeMode.Voltage)"
                    disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                    class="@GetCalibrationTypeButtonClass(circuit.calibration.CalibrationMode == CalibrationTypeMode.Voltage)">
                        <Blazicon Svg="Lucide.Activity" class="w-3.5 h-3.5" />
                        <span class="text-xs">Voltage</span>
                    </button>
                    <button @onclick="() => SetCalibrationType(CalibrationTypeMode.Temperature)"
                    disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                    class="@GetCalibrationTypeButtonClass(circuit.calibration.CalibrationMode == CalibrationTypeMode.Temperature)">
                        <Blazicon Svg="Lucide.Thermometer" class="w-3.5 h-3.5" />
                        <span class="text-xs">Temperature</span>
                    </button>
                </div>
            }
        </div>

        @if (circuit != null)
        {
            <div class="flex-1 overflow-y-auto">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-3">

                    <!-- Left Column: Main Content -->
                    <div class="lg:col-span-9 space-y-2">

                        <!-- Row 1: Existing Calibration Data — shows only the selected mode's card -->
                        <div class="grid grid-cols-1 gap-2">
                            @if (circuit.calibration.IsCurrent)
                            {
                                var curPoint  = circuit.calibration.IsCharge
                                    ? circuit.calibration.CurrentChargeForSelectedRange
                                    : circuit.calibration.CurrentDischargeForSelectedRange;
                                var curLabel  = circuit.calibration.IsCharge ? "Current Charge" : "Current Discharge";
                                var curColor  = circuit.calibration.IsCharge ? "text-yellow-500" : "text-orange-500";
                                <div class="bg-card rounded border border-border p-2">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-1">
                                            <Blazicon Svg="Lucide.Zap" class="@($"w-3 h-3 {curColor}")" />
                                            <h3 class="text-xs font-semibold text-foreground">@curLabel</h3>
                                        </div>
                                        <div class="flex items-center gap-2 text-sm">
                                            <div class="text-center">
                                                <div class="text-muted-foreground">DateTime</div>
                                                <div class="font-mono">@(curPoint?.DateTime.ToString("MM/dd HH:mm:ss") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Gain</div>
                                                <div class="font-mono">@(curPoint?.Gain.ToString("F10") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Offset</div>
                                                <div class="font-mono">@(curPoint?.Offset.ToString("F4") ?? "N/A")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (circuit.calibration.IsTemperature)
                            {
                                <!-- Temperature stored calibration data -->
                                <div class="bg-card rounded border border-border p-2">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-1">
                                            <Blazicon Svg="Lucide.Thermometer" class="w-3 h-3 text-red-400" />
                                            <h3 class="text-xs font-semibold text-foreground">Temperature Calibration</h3>
                                        </div>
                                        <div class="flex items-center gap-2 text-sm">
                                            <div class="text-center">
                                                <div class="text-muted-foreground">DateTime</div>
                                                <div class="font-mono">@(circuit.calibration?.TemperaturePoint?.DateTime.ToString("MM/dd HH:mm:ss") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Gain</div>
                                                <div class="font-mono">@(circuit.calibration?.TemperaturePoint?.Gain.ToString("F10") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Offset</div>
                                                <div class="font-mono">@(circuit.calibration?.TemperaturePoint?.Offset.ToString("F4") ?? "N/A")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                var volPoint = circuit.calibration.IsCharge
                                    ? circuit.calibration.VoltageCharge
                                    : circuit.calibration.VoltageDischarge;
                                var volLabel = circuit.calibration.IsCharge ? "Voltage Charge" : "Voltage Discharge";
                                var volColor = circuit.calibration.IsCharge ? "text-blue-500" : "text-cyan-500";
                                <div class="bg-card rounded border border-border p-2">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-1">
                                            <Blazicon Svg="Lucide.Activity" class="@($"w-3 h-3 {volColor}")" />
                                            <h3 class="text-xs font-semibold text-foreground">@volLabel</h3>
                                        </div>
                                        <div class="flex items-center gap-2 text-sm">
                                            <div class="text-center">
                                                <div class="text-muted-foreground">DateTime</div>
                                                <div class="font-mono">@(volPoint?.DateTime.ToString("MM/dd HH:mm:ss") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Gain</div>
                                                <div class="font-mono">@(volPoint?.Gain.ToString("F10") ?? "N/A")</div>
                                            </div>
                                            <div class="text-center">
                                                <div class="text-muted-foreground">Offset</div>
                                                <div class="font-mono">@(volPoint?.Offset.ToString("F4") ?? "N/A")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Row 2: Live Parameters -->
                        <div class="bg-card rounded border border-border p-2">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                                <h3 class="text-xs font-semibold text-foreground">Live Parameters</h3>
                                <div class="flex items-center gap-3 text-sm">

                                    @if (circuit.calibration.IsCurrent)
                                    {
                                        <div class="flex flex-col items-center">
                                            <div class="text-muted-foreground mb-0.5">Current (A)</div>
                                            <div class="font-mono text-xs font-semibold text-primary">
                                                @circuit?.RealTime?.RealTimeRecord?.Current.ToString("F6")
                                                <span class="font-mono text-xs font-semibold text-primary">(@circuit?.RealTime.RealTimeRecord.CurrentInt)</span>
                                            </div>
                                        </div>
                                    }
                                    else if (circuit.calibration.IsTemperature)
                                    {
                                        <div class="flex flex-col items-center">
                                            <div class="text-muted-foreground mb-0.5">Temperature (°C)</div>
                                            <div class="font-mono text-xs font-semibold text-primary">
                                                @(circuit?.RealTime?.RealTimeRecord?.Temperature.ToString("F2") ?? "N/A")
                                                <span class="font-mono text-xs font-semibold text-primary">(@(circuit?.RealTime?.RealTimeRecord?.TemperatureInt ?? 0))</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex flex-col items-center">
                                            <div class="text-muted-foreground mb-0.5">Voltage (V)</div>
                                            <div class="font-mono text-xs font-semibold text-primary">
                                                @circuit?.RealTime?.RealTimeRecord?.Voltage.ToString("F6")
                                                <span class="font-mono text-xs font-semibold text-primary">(@circuit?.RealTime.RealTimeRecord.VoltageInt)</span>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>

                        <!-- Row 3: Calibration and Verification (Side by Side) -->
                        <div class="grid grid-cols-2 gap-2">

                            <!-- Calibration Process Panel -->
                            <div class="bg-card rounded border border-border p-2 @(circuit.calibration.IsVerifying ? "opacity-60 pointer-events-none" : "")">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <h3 class="text-xs font-semibold text-foreground">
                                            @(circuit.calibration.CalibrationMode.ToString()) Calibration
                                            @if (!circuit.calibration.IsTemperature)
                                            {
                                                <sub>@(circuit.calibration.IsCharge ? "Charge" : "DisCharge")</sub>
                                            }
                                        </h3>
                                        @if (circuit.calibration.IsVerifying)
                                        {
                                            <span class="px-1.5 py-0.5 text-[9px] font-medium rounded bg-yellow-100 text-yellow-800">
                                                Verification Active
                                            </span>
                                        }
                                    </div>
                                    <button @onclick="@(() => ResetCalibration(true))"
                                    class="px-2 py-0.5 text-sm font-medium text-red-700 bg-red-50 rounded hover:bg-red-100 border border-red-200">
                                        Reset
                                    </button>
                                </div>

                                <!-- Mode (Charge/Discharge) — hidden for Temperature -->
                                @if (!circuit.calibration.IsTemperature)
                                {
                                    <div class="grid grid-cols-2 gap-2 mb-2">
                                        <div>
                                            <label class="block text-sm font-medium text-foreground mb-1">Mode</label>
                                            <div class="flex gap-1">
                                                <button @onclick="() => SetMode(true)"
                                                disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                                                class="@GetCalibrationModeButtonClass(circuit.calibration.IsCharge, circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)">
                                                    <Blazicon Svg="Lucide.BatteryCharging" class="w-3 h-3" />
                                                    <span class="text-sm">Charge</span>
                                                </button>
                                                <button @onclick="() => SetMode(false)"
                                                disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                                                class="@GetCalibrationModeButtonClass(!circuit.calibration.IsCharge, circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)">
                                                    <Blazicon Svg="Lucide.Battery" class="w-3 h-3" />
                                                    <span class="text-sm">Discharge</span>
                                                </button>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-foreground mb-1">Status</label>
                                            <div class="p-1.5 bg-secondary/30 rounded border border-border flex items-center justify-center">
                                                <span class="@GetStepBadgeClass()">@GetStepDisplayText()</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Range Radio Buttons — Current only (Voltage has no range calibration) -->
                                    <!-- UI order: Full Range → Range1 (smallest) → Range2 → Range3 → Range4 (largest) -->
                                    <!-- Backend enum mapping: UI Range1=Backend Range4, UI Range2=Backend Range3,      -->
                                    <!--                       UI Range3=Backend Range2, UI Range4=Backend Range1       -->
                                    @if (circuit.calibration.IsCurrent)
                                    {
                                        <div class="mb-2">
                                            <label class="block text-sm font-medium text-foreground mb-1">Range</label>
                                            <div class="flex gap-3 flex-wrap">
                                                @foreach (var (range, label) in GetRangeButtonsOrdered())
                                                {
                                                    <label class="flex items-center gap-1.5 cursor-pointer select-none">
                                                        <input type="radio"
                                                        name="calRange_@Id"
                                                        disabled="@(circuit.calibration.IsCalibrationInPrcoess || circuit.calibration.IsVerifying)"
                                                        checked="@(circuit.calibration.SelectedRange == range)"
                                                        @onchange="() => SetRange(range)"
                                                        class="accent-primary" />
                                                        <span class="text-xs text-foreground">@label</span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <!-- Status row for Temperature (no Mode/Range) -->
                                    <div class="mb-2">
                                        <label class="block text-sm font-medium text-foreground mb-1">Status</label>
                                        <div class="p-1.5 bg-secondary/30 rounded border border-border flex items-center justify-center">
                                            <span class="@GetStepBadgeClass()">@GetStepDisplayText()</span>
                                        </div>
                                    </div>
                                }

                                <!-- Calibration Form -->
                                @if (circuit.calibration.IsCurrent)
                                {
                                    @RenderCurrentCalibrationFormAllVisible()
                                }
                                else if (circuit.calibration.IsTemperature)
                                {
                                    @RenderTemperatureCalibrationFormAllVisible()
                                }
                                else
                                {
                                    @RenderVoltageCalibrationFormAllVisible()
                                }

                                <!-- Action Button + Progress -->
                                <div class="grid grid-cols-3 gap-2 mt-2">
                                    <div class="col-span-2">
                                        <button @onclick="HandleNextStep"
                                        disabled="@IsActionButtonDisabled()"
                                        class="px-3 py-1.5 text-xs font-medium rounded transition-all flex items-center justify-center gap-2
                                                       @(IsActionButtonDisabled()
                                                           ? "bg-muted text-muted-foreground cursor-not-allowed"
                                                           : "bg-primary text-primary-foreground hover:bg-primary/90")">
                                            @if (IsReady)
                                            {
                                                <svg class="animate-spin h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                                </svg>
                                            }
                                            <span>@GetActionButtonText()</span>
                                        </button>
                                    </div>
                                    <div class="col-span-1">
                                        <button class="w-full px-3 py-1.5 text-xs font-medium rounded transition-all flex items-center justify-center gap-2
                                               @(CancelButtonDisabled()
                                                   ? "bg-muted text-muted-foreground cursor-not-allowed"
                                                   : "bg-secondary text-secondary-foreground hover:bg-secondary/80")"
                                        @onclick="CancelCalibration"
                                        disabled="@CancelButtonDisabled()">
                                            Cancel Calibration
                                        </button>
                                    </div>
                                    @if (circuit.calibration.IsCurrent && Step != CalibrationStep.Idle)
                                    {
                                        <div class="flex items-center">
                                            <div class="w-full">
                                                <div class="text-[9px] text-muted-foreground text-center mb-0.5">@GetProgressPercentage()%</div>
                                                <div class="w-full bg-secondary rounded-full h-1.5">
                                                    <div class="bg-primary h-1.5 rounded-full transition-all duration-300"
                                                    style="width: @GetProgressPercentage()%"></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Verification Panel — Current only; not available for Voltage or Temperature -->
                            @if (circuit.calibration.IsCurrent)
                            {
                                <div class="bg-card rounded border border-border p-2 @(circuit.calibration.IsCalibrationInPrcoess ? "opacity-60 pointer-events-none" : "")">
                                    <div class="flex items-center justify-between mb-2">
                                        <h3 class="text-xs font-semibold text-foreground">Verification</h3>
                                        @if (circuit.calibration.IsCalibrationInPrcoess)
                                        {
                                            <span class="px-1.5 py-0.5 text-[9px] font-medium rounded bg-yellow-100 text-yellow-800">
                                                Disabled
                                            </span>
                                        }
                                    </div>
                                    <!-- Test Value Input -->
                                    <div class="mb-2">
                                        <label class="block text-sm font-medium text-foreground mb-1">
                                            Test Current (A)
                                        </label>
                                        <input type="number"
                                        step="0.001"
                                        @bind="@circuit.calibration.VerifyTestValue"
                                        @bind:event="oninput"
                                        disabled="@circuit.calibration.IsVerifying"
                                        placeholder="Enter value"
                                        class="w-full px-2 py-1 text-xs border border-border rounded
                                                      bg-background text-foreground focus:outline-none focus:ring-1 focus:ring-primary
                                                      disabled:bg-muted disabled:text-muted-foreground" />
                                    </div>
                                    <!-- Verify Button -->
                                    <button @onclick="HandleVerify"
                                    disabled="@(!circuit.calibration.VerifyTestValue.HasValue)"
                                    class="px-3 py-1.5 text-xs font-medium rounded transition-all
                                                   @(circuit.calibration.IsVerifying
                                                       ? "bg-red-600 text-white hover:bg-red-700"
                                                       : !circuit.calibration.VerifyTestValue.HasValue
                                                           ? "bg-muted text-muted-foreground cursor-not-allowed"
                                                           : "bg-green-600 text-white hover:bg-green-700")">
                                        @(circuit.calibration.IsVerifying ? "Stop Verification" : "Start Verification")
                                    </button>
                                    @if (circuit.calibration.IsVerifying)
                                    {
                                        <div class="mt-2 p-1.5 bg-blue-50 border border-blue-200 rounded">
                                            <div class="flex items-center gap-1 text-blue-800">
                                                <Blazicon Svg="Lucide.Info" class="w-3 h-3" />
                                                <span class="text-[9px] font-medium">
                                                    Verifying at @circuit.calibration.VerifyTestValue.Value.ToString("F4")
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Voltage & Temperature: verification not available -->
                                <div class="bg-card rounded border border-border p-2 opacity-50">
                                    <h3 class="text-xs font-semibold text-foreground mb-1">Verification</h3>
                                    <p class="text-xs text-muted-foreground">
                                        Verification is only available for Current calibration.
                                    </p>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- Right Column: Messages -->
                    <div class="lg:col-span-3 min-h-[200px] lg:max-h-[500px]">
                        @if (messages.Any())
                        {
                            <div class="bg-card rounded border border-border p-2 h-full flex flex-col">
                                <div class="flex items-center justify-between mb-2">
                                    <h3 class="text-xs font-semibold text-foreground">Messages</h3>
                                    <button @onclick="ClearMessages" class="text-[9px] text-muted-foreground hover:text-foreground">Clear</button>
                                </div>
                                <div class="flex-1 overflow-y-auto space-y-1">
                                    @foreach (var msg in messages.OrderByDescending(m => m.Timestamp))
                                    {
                                        <div class="flex items-start gap-1 p-1.5 bg-secondary/30 rounded text-[9px]">
                                            <span class="text-muted-foreground font-mono shrink-0">@msg.Timestamp.ToString("HH:mm:ss")</span>
                                            <span class="@GetMessageClass(msg.Type) flex-1 leading-tight">@msg.Text</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="bg-card rounded border border-border p-4 h-full flex items-center justify-center">
                                <p class="text-xs text-muted-foreground">No messages yet</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="flex items-center justify-center h-64 bg-card rounded border border-border">
                <div class="text-center">
                    <Blazicon Svg="Lucide.CircleAlert" class="w-12 h-12 text-muted-foreground mx-auto mb-3" />
                    <p class="text-muted-foreground">No circuit selected</p>
                </div>
            </div>
        }

    </div>
</div>

@code {



    #region Fields and Properties

    [Parameter] public string Id { get; set; }

    private ICircuitCommandHandler? circuit;
    private CalibrationStep Step = CalibrationStep.Idle;
    private List<CalibrationMessage> messages = new();
    private string calId => $"{Id}_cal_messages";
    private bool IsError = false;
    private bool IsReady = false;

    // UI refresh throttle — only re-render Live Parameters at most once per interval
    private DateTime _lastRenderTime = DateTime.MinValue;
    private static readonly TimeSpan RenderInterval = TimeSpan.FromMilliseconds(200); // ~5 fps

    #endregion

    #region Lifecycle Methods

    protected override async Task OnInitializedAsync()
    {
        if (CM._devices.TryGetValue(Id, out var device))
        {
            circuit = device;
            circuit.RealTime.OnDataChanged += OnRealTimeChanged;
        }

        CM.HardwareManagerChanged += OnHardwareManagerChanged;

        var getUnSaved = SessionStorage.GetComponentState<List<CalibrationMessage>>(calId);
        if (getUnSaved != null)
            messages = getUnSaved;
    }

    private void OnHardwareManagerChanged()
    {
        if (circuit != null)
        {
            circuit.RealTime.OnDataChanged -= OnRealTimeChanged;
            circuit = null;
        }

        if (CM._devices.TryGetValue(Id, out var device))
        {
            circuit = device;
            circuit.RealTime.OnDataChanged += OnRealTimeChanged;
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnRealTimeChanged()
    {
        var errorId = circuit?.RealTime?.RealTimeRecord?.ErrorId ?? 0;

        // Error state changes are always immediate — never throttle these
        if (errorId != 0 && !IsError)
        {
            IsError = true;
            byte errorByte = (byte)errorId;
            if (CalibrationErrorExtensions.TryGetError(errorByte, out var error))
                AddMessage($"Error: {error.ToString()}", MessageType.Error);
            InvokeAsync(StateHasChanged);
            return;
        }
        else if (errorId == 0 && IsError)
        {
            IsError = false;
            InvokeAsync(StateHasChanged);
            return;
        }

        // Throttle routine live-data UI refreshes
        var now = DateTime.UtcNow;
        if (now - _lastRenderTime < RenderInterval)
            return;

        _lastRenderTime = now;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (circuit != null)
        {
            circuit.RealTime.OnDataChanged -= OnRealTimeChanged;
            ResetCalibration();
            circuit = null;
        }
        CM.HardwareManagerChanged -= OnHardwareManagerChanged;
    }

    #endregion

    #region Render Fragments — Current

    private RenderFragment RenderCurrentCalibrationFormAllVisible() => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "grid grid-cols-2 gap-2 mb-2");

        var (rangeMin, rangeMax) = GetCurrentRangeBounds();

        // Step 1: Low Reference
        RenderCalibrationInput(builder, seq: 2,
            label: $"1. Low Ref (A) [{rangeMin:F2}–{rangeMax:F2}]",
            isActive: Step == CalibrationStep.LowConfirm,
            isComplete: Step > CalibrationStep.LowConfirm,
            isDisabled: Step != CalibrationStep.LowConfirm,
            value: circuit.calibration.UserLowInput,
            placeholder: $"Min {rangeMin:F2} A",
            min: rangeMin, max: rangeMax,
            onInput: val => { circuit.calibration.UserLowInput = val < 0 ? 0 : val; StateHasChanged(); });

        // Step 2: Actual Low
        RenderActualInputWithAdc(builder, seq: 50,
            label: "2. Actual Low (A)",
            isActive: Step == CalibrationStep.LowActualConfirm,
            isComplete: Step > CalibrationStep.LowActualConfirm,
            isVisible: Step >= CalibrationStep.LowActualConfirm,
            value: circuit.calibration.ActualLowInput,
            adcValue: circuit.calibration.SystemLowInput,
            onInput: val => { circuit.calibration.ActualLowInput = val; StateHasChanged(); });

        // Step 3: High Reference
        RenderCalibrationInput(builder, seq: 100,
            label: $"3. High Ref (A) [{rangeMin:F2}–{rangeMax:F2}]",
            isActive: Step == CalibrationStep.HighConfirm,
            isComplete: Step > CalibrationStep.HighConfirm,
            isDisabled: Step != CalibrationStep.HighConfirm,
            value: circuit.calibration.UserHighInput,
            placeholder: $"Max {rangeMax:F2} A",
            min: rangeMin, max: rangeMax,
            onInput: val => { circuit.calibration.UserHighInput = val < 0 ? 0 : val; StateHasChanged(); });

        // Step 4: Actual High
        RenderActualInputWithAdc(builder, seq: 150,
            label: "4. Actual High (A)",
            isActive: Step == CalibrationStep.HighActualConfirm,
            isComplete: Step > CalibrationStep.HighActualConfirm,
