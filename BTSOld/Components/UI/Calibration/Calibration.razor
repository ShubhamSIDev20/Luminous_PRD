    #region Calibration Logic

    private async Task HandleNextStep()
    {
        if (circuit == null) return;

        switch (circuit.calibration.CalibrationMode)
        {
            case CalibrationTypeMode.Current:
                await HandleCurrentCalibrationStep();
                break;
            case CalibrationTypeMode.Temperature:
                await HandleTemperatureCalibrationStep();
                break;
            default:
                await HandleVoltageCalibrationStep();
                break;
        }
    }

    private async Task HandleCurrentCalibrationStep()
    {
        IsReady = true;
        StateHasChanged();

        try
        {
            switch (Step)
            {
                case CalibrationStep.Idle:
                    var readyResponse = await circuit.HWReadyToCalibrationAsync();
                    if (!readyResponse.Success)
                    {
                        AddMessage($"Hardware not ready: {readyResponse.Message}", MessageType.Error);
                        return;
                    }

                    await Task.Delay(1000);

                    var getPreviousData = await circuit.PreviousCalibration();
                    if (getPreviousData.Success && getPreviousData.Data != null)
                    {
                        circuit.calibration.CurrentCharge    = getPreviousData.Data.CurrentCharge    ?? new();
                        circuit.calibration.CurrentDischarge = getPreviousData.Data.CurrentDischarge ?? new();
                        circuit.calibration.VoltageCharge    = getPreviousData.Data.VoltageCharge;
                        circuit.calibration.VoltageDischarge = getPreviousData.Data.VoltageDischarge;
                        circuit.calibration.TemperaturePoint = getPreviousData.Data.Temperature;
                        AddMessage("Previous Data Received.", MessageType.Info);
                        StateHasChanged();
                    }
                    circuit.calibration.IsCalibrationInPrcoess = true;
                    Step = CalibrationStep.LowConfirm;
                    AddMessage("Calibration started.", MessageType.Info);
                    break;

                case CalibrationStep.LowConfirm:
                    if (!circuit.calibration.UserLowInput.HasValue)
                    {
                        AddMessage("Enter low reference current.", MessageType.Warning);
                        return;
                    }
                    var lowQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.CurrentChargeLowPoint
                        : CalibrationQueryId.CurrentDisChargeLowPoint;
                    var lowResponse = await circuit.CalibrationPointPreset(lowQueryId, circuit.calibration.UserLowInput.Value, circuit.calibration.SelectedRange);
                    if (!lowResponse.Success)
                    {
                        AddMessage($"Failed: {lowResponse.Message}", MessageType.Error);
                        circuit.calibration.IsCalibrationInPrcoess = false;
                        return;
                    }
                    Step = CalibrationStep.LowActualConfirm;
                    AddMessage("Low value sent. Enter actual current from multimeter.", MessageType.Success);
                    break;

                case CalibrationStep.LowActualConfirm:
                    if (!circuit.calibration.ActualLowInput.HasValue)
                    {
                        AddMessage("Enter actual low current from multimeter.", MessageType.Warning);
                        return;
                    }
                    var currentLowAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.CurrentInt) : 0.0;
                    circuit.calibration.SystemLowInput = (float)currentLowAdc;
                    Step = CalibrationStep.HighConfirm;
                    AddMessage($"Actual Low point confirmed. ADC {(float)currentLowAdc}", MessageType.Success);
                    break;

                case CalibrationStep.HighConfirm:
                    if (!circuit.calibration.UserHighInput.HasValue)
                    {
                        AddMessage("Enter high reference current.", MessageType.Warning);
                        return;
                    }
                    var highQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.CurrentChargeHighPoint
                        : CalibrationQueryId.CurrentDisChargeHighPoint;
                    var highResponse = await circuit.CalibrationPointPreset(highQueryId, circuit.calibration.UserHighInput.Value, circuit.calibration.SelectedRange);
                    if (!highResponse.Success)
                    {
                        AddMessage($"Failed: {highResponse.Message}", MessageType.Error);
                        return;
                    }
                    Step = CalibrationStep.HighActualConfirm;
                    AddMessage("High value sent. Enter actual current from multimeter.", MessageType.Success);
                    break;

                case CalibrationStep.HighActualConfirm:
                    if (!circuit.calibration.ActualHighInput.HasValue)
                    {
                        AddMessage("Enter actual high current from multimeter.", MessageType.Warning);
                        return;
                    }
                    var currentHighAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.CurrentInt) : 0.0;
                    circuit.calibration.SystemHighInput = (float)currentHighAdc;
                    Step = CalibrationStep.Complete;
                    AddMessage($"Actual high point confirmed.ADC {(float)currentHighAdc}", MessageType.Success);
                    break;

                case CalibrationStep.Complete:
                    CalculateCalibrationValues();
                    var gainOffsetQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.CurrentChargeGainOffset
                        : CalibrationQueryId.CurrentDisChargeGainOffset;
                    var saveResponse = await circuit.SetGainOffset(gainOffsetQueryId,
                        circuit.calibration.Gain ?? 0, circuit.calibration.Offset ?? 0, circuit.calibration.SelectedRange);
                    if (!saveResponse.Success)
                    {
                        AddMessage($"Failed to save: {saveResponse.Message}", MessageType.Error);
                        return;
                    }
                    AddMessage("Calibration completed!", MessageType.Success);
                    ResetCalibration();
                    break;
            }
        }
        catch (Exception ex)
        {
            AddMessage($"Error during calibration: {ex.Message}", MessageType.Error);
            circuit.calibration.IsCalibrationInPrcoess = false;
            Step = CalibrationStep.Idle;
        }
        finally
        {
            IsReady = false;
            StateHasChanged();
        }
    }

    private async Task HandleVoltageCalibrationStep()
    {
        IsReady = true;
        StateHasChanged();

        try
        {
            switch (Step)
            {
                case CalibrationStep.Idle:
                    var readyResponse = await circuit.HWReadyToCalibrationAsync();
                    if (!readyResponse.Success)
                    {
                        AddMessage($"Hardware not ready: {readyResponse.Message}", MessageType.Error);
                        return;
                    }

                    await Task.Delay(1000);

                    var getPreviousData = await circuit.PreviousCalibration();
                    if (getPreviousData.Success && getPreviousData.Data != null)
                    {
                        circuit.calibration.CurrentCharge    = getPreviousData.Data.CurrentCharge    ?? new();
                        circuit.calibration.CurrentDischarge = getPreviousData.Data.CurrentDischarge ?? new();
                        circuit.calibration.VoltageCharge    = getPreviousData.Data.VoltageCharge;
                        circuit.calibration.VoltageDischarge = getPreviousData.Data.VoltageDischarge;
                        circuit.calibration.TemperaturePoint = getPreviousData.Data.Temperature;
                        AddMessage("Previous Data Received.", MessageType.Info);
                        StateHasChanged();
                    }
                    circuit.calibration.IsCalibrationInPrcoess = true;
                    Step = CalibrationStep.LowConfirm;
                    AddMessage("Voltage calibration started.", MessageType.Info);
                    break;

                case CalibrationStep.LowConfirm:
                    if (!circuit.calibration.UserLowInput.HasValue)
                    {
                        AddMessage("Enter low reference voltage.", MessageType.Warning);
                        return;
                    }
                    var lowQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.VoltageChargeLowPoint
                        : CalibrationQueryId.VoltageDisChargeLowPoint;
                    var lowResponse = await circuit.CalibrationPointPreset(lowQueryId, circuit.calibration.UserLowInput.Value, null);
                    if (!lowResponse.Success)
                    {
                        AddMessage($"Failed: {lowResponse.Message}", MessageType.Error);
                        circuit.calibration.IsCalibrationInPrcoess = false;
                        return;
                    }

                    await Task.Delay(3000);

                    var voltageLowAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.VoltageInt) : 0.0;
                    circuit.calibration.SystemLowInput = (float)voltageLowAdc;
                    Step = CalibrationStep.HighConfirm;
                    AddMessage($"Low voltage set. ADC: {circuit.calibration.SystemLowInput:F2}", MessageType.Success);
                    break;

                case CalibrationStep.HighConfirm:
                    if (!circuit.calibration.UserHighInput.HasValue)
                    {
                        AddMessage("Enter high reference voltage.", MessageType.Warning);
                        return;
                    }
                    var highQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.VoltageChargeHighPoint
                        : CalibrationQueryId.VoltageDisChargeHighPoint;
                    var highResponse = await circuit.CalibrationPointPreset(highQueryId, circuit.calibration.UserHighInput.Value, null);
                    if (!highResponse.Success)
                    {
                        AddMessage($"Failed: {highResponse.Message}", MessageType.Error);
                        return;
                    }

                    await Task.Delay(3000);

                    var voltageHighAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.VoltageInt) : 0.0;
                    circuit.calibration.SystemHighInput = (float)voltageHighAdc;
                    Step = CalibrationStep.Complete;
                    AddMessage($"High voltage set. ADC: {circuit.calibration.SystemHighInput:F2}", MessageType.Success);
                    break;

                case CalibrationStep.Complete:
                    CalculateVoltageCalibrationValues();
                    var gainOffsetQueryId = circuit.calibration.IsCharge
                        ? CalibrationQueryId.VoltageChargeGainOffset
                        : CalibrationQueryId.VoltageDisChargeGainOffset;
                    var saveResponse = await circuit.SetGainOffset(gainOffsetQueryId,
                        circuit.calibration.Gain ?? 0, circuit.calibration.Offset ?? 0, null);
                    if (!saveResponse.Success)
                    {
                        AddMessage($"Failed to save: {saveResponse.Message}", MessageType.Error);
                        return;
                    }
                    AddMessage("Voltage calibration completed!", MessageType.Success);
                    ResetCalibration();
                    break;
            }
        }
        catch (Exception ex)
        {
            AddMessage($"Error during calibration: {ex.Message}", MessageType.Error);
            ResetCalibration();
        }
        finally
        {
            IsReady = false;
            StateHasChanged();
        }
    }

    /// <summary>Temperature calibration handler — uses TemperatureLowPoint / TemperatureHighPoint / TemperatureGainOffset.</summary>
    private async Task HandleTemperatureCalibrationStep()
    {
        IsReady = true;
        StateHasChanged();

        try
        {
            switch (Step)
            {
                case CalibrationStep.Idle:
                    var readyResponse = await circuit.HWReadyToCalibrationAsync();
                    if (!readyResponse.Success)
                    {
                        AddMessage($"Hardware not ready: {readyResponse.Message}", MessageType.Error);
                        return;
                    }

                    await Task.Delay(1000);

                    var getPreviousData = await circuit.PreviousCalibration();
                    if (getPreviousData.Success && getPreviousData.Data != null)
                    {
                        circuit.calibration.CurrentCharge    = getPreviousData.Data.CurrentCharge    ?? new();
                        circuit.calibration.CurrentDischarge = getPreviousData.Data.CurrentDischarge ?? new();
                        circuit.calibration.VoltageCharge    = getPreviousData.Data.VoltageCharge;
                        circuit.calibration.VoltageDischarge = getPreviousData.Data.VoltageDischarge;
                        circuit.calibration.TemperaturePoint = getPreviousData.Data.Temperature;
                        AddMessage("Previous Data Received.", MessageType.Info);
                        StateHasChanged();
                    }
                    circuit.calibration.IsCalibrationInPrcoess = true;
                    Step = CalibrationStep.LowConfirm;
                    AddMessage("Temperature calibration started.", MessageType.Info);
                    break;

                case CalibrationStep.LowConfirm:
                    if (!circuit.calibration.UserLowInput.HasValue)
                    {
                        AddMessage("Enter low reference temperature.", MessageType.Warning);
                        return;
                    }
                    var lowTempResponse = await circuit.CalibrationPointPreset(
                        CalibrationQueryId.TemperatureLowPoint,
                        circuit.calibration.UserLowInput.Value);
                    if (!lowTempResponse.Success)
                    {
                        AddMessage($"Failed to send low temperature point: {lowTempResponse.Message}", MessageType.Error);
                        circuit.calibration.IsCalibrationInPrcoess = false;
                        return;
                    }

                    await Task.Delay(3000);
                    var tempLowAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.TemperatureInt) : 0.0;
                    circuit.calibration.SystemLowInput = (float)tempLowAdc;
                    Step = CalibrationStep.HighConfirm;
                    AddMessage($"Low temperature sent. ADC: {circuit.calibration.SystemLowInput:F2}", MessageType.Success);
                    break;

                case CalibrationStep.HighConfirm:
                    if (!circuit.calibration.UserHighInput.HasValue)
                    {
                        AddMessage("Enter high reference temperature.", MessageType.Warning);
                        return;
                    }
                    var highTempResponse = await circuit.CalibrationPointPreset(
                        CalibrationQueryId.TemperatureHighPoint,
                        circuit.calibration.UserHighInput.Value);
                    if (!highTempResponse.Success)
                    {
                        AddMessage($"Failed to send high temperature point: {highTempResponse.Message}", MessageType.Error);
                        return;
                    }

                    await Task.Delay(3000);

                    var tempHighAdc = circuit.calibration.calibrationBuffer.Any()
                        ? circuit.calibration.calibrationBuffer.Average(e => e.TemperatureInt) : 0.0;
                    circuit.calibration.SystemHighInput = (float)tempHighAdc;
                    Step = CalibrationStep.Complete;
                    AddMessage($"High temperature sent. ADC: {circuit.calibration.SystemHighInput:F2}", MessageType.Success);
                    break;

                case CalibrationStep.Complete:
                    CalculateTemperatureCalibrationValues();
                    var tempSaveResponse = await circuit.SetGainOffset(
                        CalibrationQueryId.TemperatureGainOffset,
                        circuit.calibration.Gain ?? 0,
                        circuit.calibration.Offset ?? 0);
                    if (!tempSaveResponse.Success)
                    {
                        AddMessage($"Failed to save temperature calibration: {tempSaveResponse.Message}", MessageType.Error);
                        return;
                    }
                    AddMessage("Temperature calibration completed!", MessageType.Success);
                    ResetCalibration();
                    break;
            }

            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            AddMessage($"Error during temperature calibration: {ex.Message}", MessageType.Error);
            ResetCalibration();
        }
        finally
        {
            IsReady = false;
            StateHasChanged();
        }
    }

