@namespace BatteryTestingSystem.Components.UI.DropdownMenu
@implements IAsyncDisposable
@inject PopupService PopupService

<div id="@_elementId" class="@GetClasses()">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {

    private string _elementId = $"dropdown-{Guid.NewGuid():N}";
    [Parameter] public string? ParentId { get; set; }

    private PopupInstance? _popup;
    private int _zIndex = 1000;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string GetClasses()
    {
        var baseClasses = "relative inline-block";
        return string.IsNullOrWhiteSpace(Class) ? baseClasses : $"{baseClasses} {Class}";
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (Open && _popup == null)
            RegisterPopup();
        else if (!Open && _popup != null)
            UnregisterPopup();
    }

    private void RegisterPopup()
    {
        _popup = PopupService.RegisterPopup(_elementId, PopupType.Dropdown, ParentId);
        _popup.CanCloseWithEsc = true;
        _popup.RequestClose = async () => { await Close(); };

        _zIndex = _popup.ZIndex;
    }

    private void UnregisterPopup()
    {
        PopupService.UnregisterPopup(_elementId);
        _popup = null;
    }

    internal async Task Toggle()
    {
        if (Open)
        {
            await Close();
        }
        else
        {
            // Close all other popups via service
            PopupService.CloseAllExcept(_elementId);

            Open = true;
            await OpenChanged.InvokeAsync(true);
            StateHasChanged();
        }
    }

    internal async Task Close()
    {
        if (!Open) return;

        Open = false;
        await OpenChanged.InvokeAsync(false);

        UnregisterPopup();

        StateHasChanged();
    }

    // IPopupComponent implementation
    public async Task CloseAsync() => await Close();

    internal async Task SetOpen(bool open)
    {
        if (open) await Toggle();
        else await Close();
    }

    public async ValueTask DisposeAsync()
    {
        UnregisterPopup();
    }
}
