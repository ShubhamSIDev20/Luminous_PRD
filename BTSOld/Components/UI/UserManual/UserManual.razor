@inject IJSRuntime JS

<div class="flex h-full bg-background user-manual-root">

    <!-- Table of Contents (hidden when printing) -->
    <div class="w-64 shrink-0 border-r border-border overflow-y-auto p-2 no-print">
        <h2 class="px-2 py-2 text-sm font-semibold text-muted-foreground uppercase tracking-wide">Contents</h2>
        <nav class="flex flex-col gap-1">
            @foreach (var section in _sections)
            {
                <button @onclick="() => SelectSection(section.Id)"
                class="@GetTocItemClass(section.Id)">
                    @(section.Title)
                </button>
            }
        </nav>
    </div>

    <!-- Manual Content -->
    <div class="flex-1 flex flex-col overflow-hidden">

        <!-- Toolbar (hidden when printing) -->
        <div class="flex items-center justify-between px-4 py-2 border-b border-border no-print">
            <h1 class="text-base font-bold text-foreground">User Manual</h1>
            <div class="flex gap-2">
                <button @onclick="ShowAllForPrint" class="manual-toolbar-btn">
                    Export / Print
                </button>
            </div>
        </div>

        <!-- Scrollable section area -->
        <div class="flex-1 overflow-y-auto p-6 manual-print-area">
            @foreach (var section in _sections)
            {
                @if (_printMode || section.Id == _activeSectionId)
                {
                    <article class="manual-section mb-10" id="@($"section-{section.Id}")">
                        <h2 class="text-xl font-bold text-foreground mb-1">@(section.Title)</h2>
                        <p class="text-sm text-muted-foreground mb-4">@(section.Purpose)</p>

                        @if (section.KeyActions.Any())
                        {
                            <h3 class="text-sm font-semibold text-foreground mb-2">Key actions</h3>
                            <ol class="list-decimal list-inside text-sm text-foreground mb-4 space-y-1">
                                @foreach (var action in section.KeyActions)
                                {
                                    <li>@action</li>
                                }
                            </ol>
                        }

                        @if (section.RestrictedToRoles.Any())
                        {
                            <p class="text-xs italic text-muted-foreground mb-4">
                                Visible to: @string.Join(", ", section.RestrictedToRoles)
                            </p>
                        }

                        @if (section.ScreenshotPlaceholders.Any())
                        {
                            <h3 class="text-sm font-semibold text-foreground mb-2">Screenshots</h3>
                            <div class="flex flex-wrap gap-3">
                                @foreach (var shot in section.ScreenshotPlaceholders)
                                {
                                    <div class="manual-screenshot-placeholder">
                                        <span>@shot</span>
                                        <span class="text-xs text-muted-foreground">pending (BTS-5 / BTS-6)</span>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            }
        </div>
    </div>
</div>

<style>
    .manual-toolbar-btn {
        font-size: 0.8rem;
        padding: 0.35rem 0.75rem;
        border-radius: 0.375rem;
        border: 1px solid var(--border);
        background: var(--card);
        cursor: pointer;
    }

    .manual-toolbar-btn:hover {
        background: var(--accent);
    }

    .manual-toc-item {
        text-align: left;
        font-size: 0.85rem;
        padding: 0.5rem 0.6rem;
        border-radius: 0.375rem;
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--muted-foreground);
    }

    .manual-toc-item:hover {
        background: var(--accent);
        color: var(--accent-foreground);
    }

    .manual-toc-item-active {
        background: var(--primary);
        color: var(--primary-foreground);
    }

    .manual-screenshot-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        width: 220px;
        height: 140px;
        border: 1px dashed var(--border);
        border-radius: 0.375rem;
        color: var(--muted-foreground);
        font-size: 0.8rem;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        .user-manual-root {
            display: block !important;
        }

        .manual-print-area {
            overflow: visible !important;
            height: auto !important;
        }

        .manual-section {
            page-break-after: always;
        }
    }
</style>

@code {
    private string _activeSectionId = "getting-started";
    private bool _printMode = false;

    private record ManualSection(
        string Id,
        string Title,
        string Purpose,
        List<string> KeyActions,
        List<string> ScreenshotPlaceholders,
        List<string> RestrictedToRoles);

    private readonly List<ManualSection> _sections = new()
    {
        new ManualSection(
            "getting-started",
            "1. Introduction & Getting Started",
            "Logging in, understanding your role, and the basics of the window-manager shell (opening, closing and arranging windows via the taskbar).",
            new() { "Log in with your account", "Identify your role (Operator, Administrator, Supervisor, Maintenance)", "Open, close, minimize and maximize windows", "Use the taskbar to switch between open windows" },
            new() { "login-screen.png", "app-shell-overview.png" },
            new()),

        new ManualSection(
            "dashboard",
            "2. Dashboard & Circuit Monitoring",
            "The Display window shows live circuit status cards; drill into a circuit for its live register dashboard, and open Calibration from there when needed.",
            new() { "Read circuit status cards on the Display window", "Open a circuit's live BmsDashboard drill-down", "Open the Calibration window for a circuit" },
            new() { "dashboard-main.png", "circuit-live-dashboard.png", "calibration-window.png" },
            new()),

        new ManualSection(
            "circuits",
            "3. Device & Circuit Management",
            "The Circuits window lists all configured devices/circuits and their connection state.",
            new() { "View the list of devices and circuits", "Check device connection status" },
            new() { "circuits-list.png" },
            new()),

        new ManualSection(
            "battery",
            "4. Battery Management",
            "The Battery window manages battery records used by test programs and sessions.",
            new() { "View battery records", "Add or edit a battery entry" },
            new() { "battery-list.png" },
            new()),

        new ManualSection(
            "programs",
            "5. Program Management",
            "The Program menu covers authoring test programs, table files, registrations, error messages, and scheduling program runs.",
            new() { "Create/edit a program (ProgramList + ProgramEditor)", "Manage table files (TableFileManager)", "Configure registrations", "Configure error messages", "Schedule a program run (Scheduler)" },
            new() { "programs-list.png", "program-editor.png", "table-files.png", "registrations.png", "error-messages.png", "scheduler.png" },
            new()),

        new ManualSection(
            "reports",
            "6. Reports & Sessions",
            "The Report window lists past test sessions; opening a session shows its detailed BmsDashboard report view.",
            new() { "Browse the sessions list", "Open a session's detailed report view" },
            new() { "reports-list.png", "session-report-detail.png" },
            new()),

        new ManualSection(
            "administration",
            "7. Administration & Settings",
            "Settings pages for managing users, viewing live/audit logs, and discovering devices on the network. Restricted to elevated roles.",
            new() { "Manage user accounts and roles (Users)", "View live application logs (Live Logs)", "Discover devices on the network (Device Discovery)", "Review audit/application error logs" },
            new() { "users-settings.png", "live-logs.png", "device-discovery.png", "audit-logs.png" },
            new() { "Administrator", "Supervisor", "Maintenance" }),

        new ManualSection(
            "troubleshooting",
            "8. Troubleshooting",
            "What to do when access is denied or an unexpected error occurs, and how to use the notifications panel.",
            new() { "Understand the Access Denied page", "Understand the generic Error page", "Use the Notifications panel" },
            new() { "access-denied.png", "error-page.png", "notifications-panel.png" },
            new()),

        new ManualSection(
            "appendix",
            "9. Appendix — Role Permission Matrix",
            "Summary of which roles can see which windows and settings pages.",
            new() { "Operator+: Display, Circuits, Battery, Program suite, Reports, Notifications", "Administrator/Supervisor: Users", "Administrator/Maintenance: Live Logs, Device Discovery", "Administrator/Supervisor: Audit/Application Error Logs" },
            new(),
            new())
    };

    private void SelectSection(string id)
    {
        _printMode = false;
        _activeSectionId = id;
    }

    private string GetTocItemClass(string id)
        => id == _activeSectionId && !_printMode
            ? "manual-toc-item manual-toc-item-active"
            : "manual-toc-item";

    private async Task ShowAllForPrint()
    {
        _printMode = true;
        StateHasChanged();
        await Task.Delay(50);
        await JS.InvokeVoidAsync("window.print");
        _printMode = false;
    }
}
