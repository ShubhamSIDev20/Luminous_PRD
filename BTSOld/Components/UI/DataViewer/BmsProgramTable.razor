@* BmsProgramTable.razor *@
@namespace BatteryTestingSystem.Components.UI.DataViewer

<div class="bms-card bms-table-card flex flex-col h-full overflow-hidden">

    @* ── Header ────────────────────────────────────────────────────────── *@
    <div class="flex items-center gap-2 px-3 py-1.5 border-b border-[hsl(var(--border))] shrink-0 bg-[hsl(var(--card))]">
        <h2 class="text-[10px] font-semibold uppercase tracking-widest text-[hsl(var(--muted-foreground))] mr-auto">
            Program Table
            @if (!string.IsNullOrEmpty(Program?.ProgramName))
            {
                <span class="normal-case tracking-normal font-mono font-normal ml-1 text-[hsl(var(--foreground))]">— @Program.ProgramName</span>
            }
        </h2>

        @* Live toggle — only shown when topic is provided *@
        @if (ShowLiveToggle)
        {
            <button class="bms-live-btn @(IsLiveData ? "bms-live-btn--on" : "")"
                    title="@(IsLiveData ? "Live: ON — click to stop" : "Live: OFF — click to start")"
                    @onclick="OnLiveToggle">
                <span class="bms-live-dot @(IsLiveData ? "bms-live-dot--on" : "")"></span>
                <span>@(IsLiveData ? "Live" : "Live")</span>
            </button>
        }

        @* Battery details button *@
        <button class="bms-icon-btn" title="Battery Details" @onclick="OnBatteryDetails">
            <Blazicon Svg="Lucide.BatteryCharging" class="w-3.5 h-3.5" />

        </button>

        @* Fullscreen toggle *@
        <button class="bms-icon-btn" title="@(IsFullscreen ? "Restore" : "Fullscreen")" @onclick="OnFullscreenToggle">
            @if (IsFullscreen)
            {
                <Blazicon Svg="Lucide.Minimize" class="w-3.5 h-3.5" />
            }
            else
            {
                <Blazicon Svg="Lucide.Maximize" class="w-3.5 h-3.5" />
            }
        </button>
    </div>

    @* ── Table ─────────────────────────────────────────────────────────── *@
    <div class="flex-1 overflow-auto min-h-0">
        @if (Steps.Count == 0)
        {
            <div class="flex items-center justify-center h-16 text-[hsl(var(--muted-foreground))] text-xs">No program loaded</div>
        }
        else
        {
            <table class="bms-table w-full border-collapse text-xs">
                <thead class="sticky top-0 z-10 bg-[hsl(var(--grid-header))]">
                    <tr>
                        <th class="bms-th">Step</th>
                        <th class="bms-th">Label</th>
                        <th class="bms-th">Operator</th>
                        <th class="bms-th">Nominal Values</th>
                        <th class="bms-th">Limits</th>
                        <th class="bms-th">Actions</th>
                        <th class="bms-th">Registrations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var step in Steps)
                    {
                        // In live mode: highlight LiveStep. In normal mode: highlight SelectedStep.
                        var isActive = IsLiveData
                            ? LiveStep == step.StepNumber
                            : SelectedStep == step.StepNumber;

                        <tr class="@(isActive ? "bms-tr--selected" : "bms-tr") @(IsLiveData ? "" : "cursor-pointer")"
                            @onclick="() => { if (!IsLiveData) OnStepSelected.InvokeAsync(step.StepNumber); }">
                            <td class="bms-td">
                                <span class="font-mono text-[11px] text-[hsl(var(--primary))] @(isActive ? "font-bold" : "font-medium")">
                                    @if (isActive && IsLiveData)
                                    {
                                        <span class="bms-live-indicator">●</span><span> </span>
                                    }
                                    else if (isActive)
                                    {
                                        <span>▶ </span>
                                    }
                                    @step.StepNumber
                                </span>
                            </td>
                            <td class="bms-td">
                                <div class="text-[hsl(var(--foreground))] font-medium">@step.Label</div>
                                @if (!string.IsNullOrEmpty(step.Comment))
                                {
                                    <div class="text-[10px] text-[hsl(var(--muted-foreground))] mt-0.5">@step.Comment</div>
                                }
                            </td>
                            <td class="bms-td bms-mono">
                                @OperatorConstants.ToName((byte)step.OperatorCode)
                            </td>
                            @* <td class="bms-td">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var v in step.NominalValues)
                                    {
                                        <span class="bms-tag bms-tag--success">@v</span>
                                    }
                                </div>
                            </td>
                            <td class="bms-td">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var l in step.Limits)
                                    {
                                        <span class="bms-tag bms-tag--warning">@l</span>
                                    }
                                </div>
                            </td>
                            <td class="bms-td">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var a in step.Actions)
                                    {
                                        <span class="bms-tag bms-tag--muted">@a</span>
                                    }
                                </div>
                            </td> *@
                            <td class="bms-td">
                                @if (step.OperatorCode == OperatorConstants.PRODUCER && step.NominalValues.Count > 0)
                                {
                                    var progName = step.NominalValues[0];
                                    <div class="flex items-center gap-1.5">
                                        <span class="bms-tag bms-tag--success">@progName</span>
                                        @if (ProducerPrograms.Any(p => p.ProgramName == progName))
                                        {
                                            <button class="bms-icon-btn" style="width:18px;height:18px;" title="View sub-program: @progName"
                                                    @onclick="@(() => OpenProducerViewer(progName))"
                                                    @onclick:stopPropagation>
                                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (step.OperatorCode == OperatorConstants.TABLE && step.NominalValues.Count > 0)
                                {
                                    var fileName = step.NominalValues[0];
                                    <div class="flex items-center gap-1.5">
                                        <span class="bms-tag bms-tag--success">@fileName</span>
                                        @if (TableFileData.ContainsKey(fileName))
                                        {
                                            <button class="bms-icon-btn" style="width:18px;height:18px;" title="View table file: @fileName"
                                                    @onclick="@(() => OpenTableViewer(fileName))"
                                                    @onclick:stopPropagation>
                                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var v in step.NominalValues)
                                    {
                                        <span class="bms-tag bms-tag--success inline-block mb-1">@v</span>
                                    }
                                }
                            </td>

                            <td class="bms-td">
                                @foreach (var l in step.Limits)
                                {
                                    <span class="bms-tag bms-tag--warning inline-block mb-1">@l</span>
                                }
                            </td>

                            <td class="bms-td">
                                @foreach (var a in step.Actions)
                                {
                                    <span class="bms-tag bms-tag--muted inline-block mb-1">@a</span>
                                }
                            </td>
                             <td class="bms-td">
                                @foreach (var r in step.Registrations)
                                {
                                    <span class="bms-tag bms-tag--muted inline-block mb-1">@r</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* ── PRODUCER sub-program viewer dialog ──────────────────────────────── *@
@if (_showProducerDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
         @onclick="@(() => _showProducerDialog = false)">
        <div class="bg-[hsl(var(--card))] text-[hsl(var(--card-foreground))] border border-[hsl(var(--border))] rounded-lg shadow-2xl w-[740px] max-w-[95vw] max-h-[80vh] overflow-hidden flex flex-col"
             @onclick:stopPropagation>
            <div class="flex items-center justify-between px-4 py-3 border-b border-[hsl(var(--border))] shrink-0">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[hsl(var(--primary))]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                    </svg>
                    <h3 class="text-sm font-semibold">Sub-program</h3>
                    <span class="text-xs text-[hsl(var(--muted-foreground))] font-mono">— @_producerDialogName</span>
                </div>
                <button class="bms-icon-btn" @onclick="@(() => _showProducerDialog = false)">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="overflow-y-auto flex-1">
                @if (_producerDialogSteps.Count == 0)
                {
                    <div class="flex items-center justify-center h-16 text-[hsl(var(--muted-foreground))] text-xs">No steps available in session data</div>
                }
                else
                {
                    <table class="bms-table w-full border-collapse text-xs">
                        <thead class="sticky top-0 z-10 bg-[hsl(var(--grid-header))]">
                            <tr>
                                <th class="bms-th">Step</th>
                                <th class="bms-th">Label</th>
                                <th class="bms-th">Operator</th>
                                <th class="bms-th">Nominal Values</th>
                                <th class="bms-th">Limits</th>
                                <th class="bms-th">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _producerDialogSteps)
                            {
                                <tr class="bms-tr">
                                    <td class="bms-td font-mono text-[11px] text-[hsl(var(--primary))] font-medium">@s.StepNumber</td>
                                    <td class="bms-td">@s.Label</td>
                                    <td class="bms-td bms-mono">@OperatorConstants.ToName((byte)s.OperatorCode)</td>
                                    <td class="bms-td">@foreach (var v in s.NominalValues) { <span class="bms-tag bms-tag--success inline-block mb-1">@v</span> }</td>
                                    <td class="bms-td">@foreach (var l in s.Limits) { <span class="bms-tag bms-tag--warning inline-block mb-1">@l</span> }</td>
                                    <td class="bms-td">@foreach (var a in s.Actions) { <span class="bms-tag bms-tag--muted inline-block mb-1">@a</span> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

@* ── TABLE file viewer dialog ─────────────────────────────────────────── *@
@if (_showTableDialog)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
         @onclick="@(() => _showTableDialog = false)">
        <div class="bg-[hsl(var(--card))] text-[hsl(var(--card-foreground))] border border-[hsl(var(--border))] rounded-lg shadow-2xl w-[520px] max-w-[95vw] max-h-[80vh] overflow-hidden flex flex-col"
             @onclick:stopPropagation>
            <div class="flex items-center justify-between px-4 py-3 border-b border-[hsl(var(--border))] shrink-0">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-[hsl(var(--primary))]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="text-sm font-semibold">Table File</h3>
                    <span class="text-xs text-[hsl(var(--muted-foreground))] font-mono">— @_tableDialogName</span>
                </div>
                <button class="bms-icon-btn" @onclick="@(() => _showTableDialog = false)">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="overflow-y-auto flex-1 p-4">
                @if (_tableDialogLines.Length == 0)
                {
                    <div class="flex items-center justify-center h-16 text-[hsl(var(--muted-foreground))] text-xs">No table data in session</div>
                }
                else
                {
                    <pre class="text-xs font-mono text-[hsl(var(--foreground))] whitespace-pre-wrap leading-relaxed">@string.Join("\n", _tableDialogLines)</pre>
                }
            </div>
        </div>
    </div>
}

<style>
    .bms-card {
        background: hsl(var(--card));
        color: hsl(var(--card-foreground));
        border: 1px solid hsl(var(--border));
        border-radius: var(--radius);
        overflow: hidden;
    }

    .bms-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        border-radius: calc(var(--radius) - 2px);
        border: 1px solid hsl(var(--border));
        background: hsl(var(--background));
        color: hsl(var(--muted-foreground));
        cursor: pointer;
        transition: all 0.1s;
        flex-shrink: 0;
    }
    .bms-icon-btn:hover {
        background: hsl(var(--accent));
        color: hsl(var(--foreground));
    }

    /* Live toggle button */
    .bms-live-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        height: 24px;
        padding: 0 8px;
        border-radius: calc(var(--radius) - 2px);
        border: 1px solid hsl(var(--border));
        background: hsl(var(--background));
        color: hsl(var(--muted-foreground));
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: all 0.15s;
        flex-shrink: 0;
        font-family: inherit;
    }
    .bms-live-btn:hover {
        border-color: hsl(var(--success));
        color: hsl(var(--success));
    }
    .bms-live-btn--on {
        background: color-mix(in srgb, hsl(var(--success)) 12%, transparent);
        border-color: hsl(var(--success));
        color: hsl(var(--success));
    }

    .bms-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: hsl(var(--muted-foreground));
        flex-shrink: 0;
        transition: background 0.15s;
    }
    .bms-live-dot--on {
        background: hsl(var(--success));
        animation: bms-live-pulse 1.2s ease-in-out infinite;
    }

    /* Pulsing live step indicator */
    .bms-live-indicator {
        color: hsl(var(--success));
        animation: bms-live-pulse 1.2s ease-in-out infinite;
        display: inline-block;
    }

    @@keyframes bms-live-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.25; }
    }

    .bms-th {
        padding: 5px 8px;
        text-align: left;
        font-size: 10px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: hsl(var(--muted-foreground));
        border-bottom: 1px solid hsl(var(--grid-border));
        white-space: nowrap;
    }

    .bms-td {
        padding: 4px 8px;
        border-bottom: 1px solid hsl(var(--grid-border));
        vertical-align: middle;
    }

    .bms-tr {
        background: hsl(var(--grid-row));
        transition: background 0.1s;
    }
    .bms-tr:nth-child(even) {
        background: hsl(var(--grid-row-alt));
    }
    .bms-tr:hover {
        background: hsl(var(--grid-row-hover)) !important;
    }
    .bms-tr--selected {
        background: hsl(var(--grid-row-selected)) !important;
    }

    .bms-tag {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        border-radius: 3px;
        padding: 1px 5px;
        font-weight: 500;
        white-space: nowrap;
    }
    .bms-tag--success {
        background: color-mix(in srgb, hsl(var(--success)) 15%, transparent);
        color: hsl(var(--success));
    }
    .bms-tag--warning {
        background: color-mix(in srgb, hsl(var(--warning)) 15%, transparent);
        color: hsl(var(--warning));
    }
    .bms-tag--muted {
        background: hsl(var(--muted));
        color: hsl(var(--muted-foreground));
    }
</style>

@code {
    [Parameter] public List<StepModel> Steps { get; set; } = [];
    [Parameter] public int? SelectedStep { get; set; }
    [Parameter] public EventCallback<int?> OnStepSelected { get; set; }
    [Parameter] public bool IsFullscreen { get; set; }
    [Parameter] public EventCallback OnFullscreenToggle { get; set; }
    [Parameter] public EventCallback OnBatteryDetails { get; set; }
    [Parameter] public BatteryDTO Battery { get; set; } = new();
    [Parameter] public ProgramDTO Program { get; set; } = new();

    // Live data params
    [Parameter] public bool IsLiveData { get; set; }
    [Parameter] public int? LiveStep { get; set; }
    [Parameter] public bool ShowLiveToggle { get; set; }
    [Parameter] public EventCallback OnLiveToggle { get; set; }

    // Session-stored PRODUCER sub-programs and TABLE file data (offline mode)
    [Parameter] public List<ProgramDTO> ProducerPrograms { get; set; } = new();
    [Parameter] public Dictionary<string, string[]> TableFileData { get; set; } = new();

    // PRODUCER viewer dialog state
    private bool _showProducerDialog = false;
    private List<StepModel> _producerDialogSteps = new();
    private string _producerDialogName = string.Empty;

    // TABLE file viewer dialog state
    private bool _showTableDialog = false;
    private string[] _tableDialogLines = Array.Empty<string>();
    private string _tableDialogName = string.Empty;

    private void OpenProducerViewer(string programName)
    {
        var prog = ProducerPrograms.FirstOrDefault(p => p.ProgramName == programName);
        if (prog != null)
        {
            _producerDialogSteps = prog.ProgramStepModel ?? new();
            _producerDialogName = programName;
            _showProducerDialog = true;
        }
    }

    private void OpenTableViewer(string fileName)
    {
        if (TableFileData.TryGetValue(fileName, out var lines))
        {
            _tableDialogLines = lines;
            _tableDialogName = fileName;
            _showTableDialog = true;
        }
    }
}
