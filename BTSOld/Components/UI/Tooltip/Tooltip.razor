@namespace BatteryTestingSystem.Components.UI.Tooltip
@inject IJSRuntime JS
@implements IDisposable

<div class="inline-block"
     @ref="_ref"
     @onmouseenter="OnMouseEnter"
     @onmouseleave="OnMouseLeave"
     @onfocus="OnMouseEnter"
     @onblur="OnMouseLeave">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent  { get; set; }
    [Parameter] public int             DelayDuration { get; set; } = 200;

    internal bool    _isOpen { get; private set; }
    internal DOMRect _rect   { get; private set; } = new();

    private ElementReference _ref;

    // Incremented on every mouse-enter. OpenAsync captures the value at start;
    // if it has changed by the time JS returns, the mouse has left (and possibly
    // re-entered), so that cycle should not show the tooltip.
    private int _openGeneration;

    // Used only to cancel the Task.Delay so we don't wait unnecessarily.
    private CancellationTokenSource? _delayCts;

    private void OnMouseEnter()
    {
        // Cancel any pending delay from a previous enter.
        _delayCts?.Cancel();
        _delayCts?.Dispose();
        _delayCts = new CancellationTokenSource();

        _ = OpenAsync(++_openGeneration, _delayCts.Token);
    }

    private void OnMouseLeave()
    {
        // Abort any pending open delay immediately.
        _delayCts?.Cancel();
        _delayCts?.Dispose();
        _delayCts = null;

        // Bump the generation so any in-flight JS interop result is discarded.
        _openGeneration++;

        Close();
    }

    private async Task OpenAsync(int generation, CancellationToken delayCt)
    {
        // Wait out the open delay. If the mouse leaves, the token is cancelled
        // and we exit here without touching any state.
        try
        {
            if (DelayDuration > 0)
                await Task.Delay(DelayDuration, delayCt);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        // Mouse left during the delay — bail.
        if (generation != _openGeneration)
            return;

        try
        {
            // Register helper once. No cancellation token — JS interop cancellation
            // in Blazor aborts the call entirely, making the tooltip never show.
            await JS.InvokeVoidAsync("eval",
                "window._ttRect||(window._ttRect=function(e){" +
                "var r=e.getBoundingClientRect();" +
                "return{t:r.top,b:r.bottom,l:r.left,ri:r.right,w:r.width,h:r.height};})");

            // Re-read the rect on every open so position is always fresh.
            _rect = await JS.InvokeAsync<DOMRect>("_ttRect", _ref);
        }
        catch
        {
            // JS interop failure (component disposed, JS not ready, etc.) — bail.
            return;
        }

        // Mouse left while JS was running — discard the result.
        if (generation != _openGeneration)
            return;

        _isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _openGeneration++; // Invalidate any in-flight open.
        _delayCts?.Cancel();
        _delayCts?.Dispose();
    }

    internal record DOMRect(
        double t  = 0, double b  = 0,
        double l  = 0, double ri = 0,
        double w  = 0, double h  = 0);
}
