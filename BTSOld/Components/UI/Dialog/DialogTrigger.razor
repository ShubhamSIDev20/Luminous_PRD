@namespace BatteryTestingSystem.Components.UI.Dialog

@if (AsChild)
{
    <div @onclick="HandleClick" @onclick:stopPropagation="true" class="@Class">
        @ChildContent
    </div>
}
else
{
    <button @onclick="HandleClick" class="@Class">
        @ChildContent
    </button>
}

@code {
    [CascadingParameter] public Dialog? Dialog { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public bool AsChild { get; set; } = false;

    private async Task HandleClick()
    {
        if (Dialog != null)
        {
            await Dialog.IsOpen();
        }
    }
}
