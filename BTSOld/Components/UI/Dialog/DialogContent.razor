@namespace BatteryTestingSystem.Components.UI.Dialog
@inject IJSRuntime JS

@if (Dialog?.Open ?? false)
{
    <div class="fixed inset-0 z-50 bg-black/80 @(Dialog.Open ? "animate-in fade-in-0" : "animate-out fade-out-0")" @onclick="OnOverlayClick"></div>

    <div class="fixed left-[50%] top-[50%] z-50 grid w-[calc(100%-2rem)] translate-x-[-50%] translate-y-[-50%] gap-4 border bg-background p-4 shadow-lg duration-200 @GetSizeClass() @AnimationClass sm:p-6 sm:rounded-lg max-h-[90vh] overflow-y-auto @Class"
         @onclick:stopPropagation="true">
        @ChildContent

        <button @onclick="CloseDialog"
                class="absolute right-4 top-4 rounded-sm opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:pointer-events-none">
            <Blazicon Svg="Lucide.X" class="h-4 w-4" />
            <span class="sr-only">Close</span>
        </button>
    </div>
}

@code {
    [CascadingParameter] public Dialog? Dialog { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public DialogSize Size { get; set; } = DialogSize.Medium;

    private string GetSizeClass()
    {
        return Size switch
        {
            DialogSize.Small => "sm:max-w-lg",
            DialogSize.Medium => "sm:max-w-2xl",
            DialogSize.Large => "sm:max-w-4xl",
            DialogSize.XLarge => "sm:max-w-6xl",
            DialogSize.Full => "sm:max-w-[90vw]",
            DialogSize.FullScreen => "sm:max-w-[calc(100vw-4rem)] sm:h-[calc(100vh-4rem)]",
            _ => "sm:max-w-2xl"
        };
    }

    private string AnimationClass => Dialog?.Open ?? false
        ? "animate-in fade-in-0 zoom-in-95 slide-in-from-left-1/2 slide-in-from-top-[48%]"
        : "animate-out fade-out-0 zoom-out-95 slide-out-to-left-1/2 slide-out-to-top-[48%]";

    private async Task CloseDialog()
    {
        if (Dialog != null)
        {
            await Dialog.Close();
        }
    }

    private async Task OnOverlayClick()
    {
        // await CloseDialog();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialog?.Open ?? false)
        {
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden'");
        }
        else
        {
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow = ''");
        }
    }

    public enum DialogSize
    {
        Small,
        Medium,
        Large,
        XLarge,
        Full,
        FullScreen
    }
}
