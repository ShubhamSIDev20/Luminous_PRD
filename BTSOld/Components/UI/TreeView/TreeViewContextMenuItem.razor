@namespace BatteryTestingSystem.Components.UI.TreeView
@typeparam TItem

<button @onclick="HandleClick"
        class="w-full px-4 py-2 text-left text-sm hover:bg-muted flex items-center gap-3">
    @if (Icon != null)
    {
        <Blazicon Svg="@Icon" class="w-4 h-4" />
    }
    <span class="text-foreground">@Label</span>
</button>

@code {
    [Parameter] public string ActionId { get; set; }
    [Parameter] public string Label { get; set; }
    [Parameter] public SvgIcon? Icon { get; set; }
    [Parameter] public TItem Item { get; set; }
    [Parameter] public EventCallback<(string ActionId, TItem Item)> OnAction { get; set; }

    private async Task HandleClick()
    {
        await OnAction.InvokeAsync((ActionId, Item));
    }
}