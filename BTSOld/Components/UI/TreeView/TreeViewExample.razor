@page "/TreeViewExample"

<div class="flex min-h-0">
    <!-- Sidebar with TreeView -->
    <div class="w-64 border-r border-border overflow-y-auto bg-background">
        <div class="p-4">
            <h2 class="text-lg font-semibold text-foreground mb-4">Navigation</h2>

            <TreeView TItem="TreeNodeModel"
                      Items="@treeData"
                      @bind-SelectedNodeId="@selectedNodeId"
                      OnNodeClick="@HandleNodeClick"
                      OnNodeDoubleClick="@HandleNodeDoubleClick"
                      OnContextMenuAction="@HandleContextMenuAction">

                @* Custom Node Content *@
                <NodeContent Context="node">
                    @if (node.Icon != null)
                    {
                        <Blazicon Svg="@node.Icon" class="w-4 h-4 text-muted-foreground" />
                    }
                    <span class="flex-1 text-sm text-gray-700">@node.Label</span>
                </NodeContent>

                @* Custom Node Actions *@
                <NodeActions Context="node">
                    <button @onclick="() => EditNode(node)"
                            class="p-1 hover:bg-muted rounded"
                            title="Edit">
                        <Blazicon Svg="Lucide.Pencil" class="w-3 h-3 text-muted-foreground" />
                    </button>
                    <button @onclick="() => AddChild(node)"
                            class="p-1 hover:bg-muted rounded"
                            title="Add Child">
                        <Blazicon Svg="Lucide.Plus" class="w-3 h-3 text-muted-foreground" />
                    </button>
                </NodeActions>

                @* Custom Context Menu *@
                <ContextMenuItems Context="node">
                    <TreeViewContextMenuItem TItem="TreeNodeModel"
                                             ActionId="open"
                                             Label="Open"
                                             Icon="Lucide.FolderOpen"
                                             Item="@node"
                                             OnAction="@HandleContextMenuAction" />

                    <TreeViewContextMenuItem TItem="TreeNodeModel"
                                             ActionId="rename"
                                             Label="Rename"
                                             Icon="Lucide.Pencil"
                                             Item="@node"
                                             OnAction="@HandleContextMenuAction" />

                    <TreeViewContextMenuItem TItem="TreeNodeModel"
                                             ActionId="delete"
                                             Label="Delete"
                                             Icon="Lucide.Trash2"
                                             Item="@node"
                                             OnAction="@HandleContextMenuAction" />
                </ContextMenuItems>
            </TreeView>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex-1 overflow-y-auto bg-background">
        <div class="p-8">
            <h1 class="text-2xl font-bold text-foreground mb-4">Calibration</h1>

            <div class="bg-card p-6 rounded-lg shadow border border-border">
                <h2 class="text-xl font-semibold mb-3 text-foreground">Selected Item</h2>
                @if (!string.IsNullOrEmpty(selectedNodeId))
                {
                    <p class="text-muted-foreground mb-2">Selected Node ID: <strong class="text-foreground">@selectedNodeId</strong></p>
                }
                @if (!string.IsNullOrEmpty(lastAction))
                {
                    <div class="mt-4 p-4 bg-green-50 dark:bg-green-950/30 rounded-lg border border-green-200 dark:border-green-800">
                        <p class="text-sm text-green-800 dark:text-green-200">@lastAction</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<TreeNodeModel> treeData = new();
    private string? selectedNodeId;
    private string lastAction = "";

    protected override void OnInitialized()
    {
        treeData = new List<TreeNodeModel>
        {
            new TreeNodeModel
            {
                Id = "1",
                Label = "192.168.1.2",
                Icon = Lucide.Wifi,
                Children = new List<TreeNodeModel>
                {
                    new TreeNodeModel
                    {
                        Id = "1-1",
                        Label = "1-1",
                        Icon = Lucide.CircuitBoard,
                        Children = new List<TreeNodeModel>
                        {
                            new TreeNodeModel
                            {
                                Id = "1-1-1",
                                Label = "Current",
                                Icon = Lucide.PlugZap,
                            },
                            new TreeNodeModel
                            {
                                Id = "1-1-2",
                                Label = "Voltage",
                                Icon = Lucide.PlugZap
                            }
                        }
                    }
                }
            },
            new TreeNodeModel
            {
                Id = "2",
                Label = "192.168.1.3",
                Icon = Lucide.Wifi,
                Children = new List<TreeNodeModel>
                {
                    new TreeNodeModel
                    {
                        Id = "2-1",
                        Label = "2-1",
                        Icon = Lucide.CircuitBoard
                    }
                }
            }
        };
    }

    private void HandleNodeClick(TreeNodeModel node)
    {
        lastAction = $"Clicked: {node.Label}";
        Console.WriteLine($"Node clicked: {node.Label}");
    }

    private void HandleNodeDoubleClick(TreeNodeModel node)
    {
        lastAction = $"Double-clicked: {node.Label}";
        Console.WriteLine($"Node double-clicked: {node.Label}");
    }

    private void HandleContextMenuAction((string ActionId, TreeNodeModel Node) action)
    {
        lastAction = $"Context menu action '{action.ActionId}' on node: {action.Node.Label}";
        Console.WriteLine($"Context menu: {action.ActionId} on {action.Node.Label}");
    }

    private void EditNode(TreeNodeModel node)
    {
        lastAction = $"Edit action on: {node.Label}";
        Console.WriteLine($"Edit: {node.Label}");
    }

    private void AddChild(TreeNodeModel node)
    {
        lastAction = $"Add child to: {node.Label}";
        Console.WriteLine($"Add child to: {node.Label}");
    }
}