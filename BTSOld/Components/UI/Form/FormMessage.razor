@namespace BatteryTestingSystem.Components.UI.Form
@if (!string.IsNullOrEmpty(Message))
{
    <p class="@CssClass">@Message</p>
}

@code {
    [CascadingParameter]
    private FormFieldContext? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string CssClass => $"text-sm font-medium text-destructive {Class ?? ""}".Trim();

    private string? Message => Context?.ErrorMessage;
}