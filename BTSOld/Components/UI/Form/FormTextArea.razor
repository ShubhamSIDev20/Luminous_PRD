@typeparam TValue
@using Microsoft.AspNetCore.Components
@namespace BatteryTestingSystem.Components.UI.Form

<FormLabel>@Label</FormLabel>
<FormControl>
    <textarea id="@FieldId"
              class="@InputCss"
              rows="@Rows"
              @onchange="@HandleChange"
              placeholder="@Placeholder">@Value</textarea>
</FormControl>
@if (!string.IsNullOrEmpty(Description))
{
    <FormDescription Text="@Description" />
}
<FormMessage />

@code {
    [Parameter] public string FieldId { get; set; } = "";
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public int Rows { get; set; } = 4;

    private string InputCss => $"flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 {(IsInvalid ? "border-destructive" : "")}";

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            TValue convertedValue = (TValue)Convert.ChangeType(e.Value.ToString(), typeof(TValue))!;
            await ValueChanged.InvokeAsync(convertedValue);
        }
    }
}