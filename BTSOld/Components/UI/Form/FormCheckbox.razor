@typeparam TValue
@using Microsoft.AspNetCore.Components
@namespace BatteryTestingSystem.Components.UI.Form

<FormControl>
    <div class="flex items-center space-x-2">
        <input type="checkbox"
               id="@FieldId"
               class="@CheckboxCss"
               checked="@GetCheckedValue()"
               @onchange="@HandleChange" />
        <FormLabel Class="!mt-0 cursor-pointer">@Label</FormLabel>
    </div>
</FormControl>
@if (!string.IsNullOrEmpty(Description))
{
    <FormDescription Text="@Description" />
}
<FormMessage />

@code {
    [Parameter] public string FieldId { get; set; } = "";
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public bool IsInvalid { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Description { get; set; }

    private string CheckboxCss => $"h-4 w-4 rounded border border-primary ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 {(IsInvalid ? "border-destructive" : "")}";

    private bool GetCheckedValue()
    {
        if (Value is bool boolValue)
            return boolValue;
        return false;
    }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (e.Value != null)
        {
            bool checkedValue = (bool)e.Value;
            TValue convertedValue = (TValue)Convert.ChangeType(checkedValue, typeof(TValue))!;
            await ValueChanged.InvokeAsync(convertedValue);
        }
    }
}