@* ═══════════════════════════════════════════════
   PageHeader — Usage Examples
   ═══════════════════════════════════════════════ *@

@* 1. Minimal — title + description only *@
<PageHeader
    Title="Dashboard"
    Description="Welcome back! Here's what's happening today." />


@* 2. With icon + action button *@
<PageHeader
    Title="Users"
    Description="Manage your team members and permissions."
    Icon="Lucide.User">
    <Actions>
        <button class="btn btn-primary btn-sm">
            <span class="material-symbols-rounded text-[16px]">add</span>
            Add User
        </button>
    </Actions>
</PageHeader>


@* 3. With breadcrumbs + badge *@
<PageHeader
    Title="Invoice #1042"
    Description="Raised on 1 March 2026 · Due 31 March 2026"
    Icon="Lucide.Paperclip"
    BadgeText="Pending"
    BadgeVariant="warning"
    Breadcrumbs="@(new List<PageHeader.BreadcrumbItem>
    {
        new() { Label = "Home",     Href = "/" },
        new() { Label = "Billing",  Href = "/billing" },
        new() { Label = "Invoice #1042" },
    })" />


@* 4. With tabs *@
<PageHeader
    Title="Projects"
    Icon="Lucide.Folder"
    ActiveTab="active"
    OnTabChanged="HandleTabChange"
    Tabs="@(new List<PageHeader.TabItem>
    {
        new() { Key = "active",   Label = "Active",   Count = 12 },
        new() { Key = "archived", Label = "Archived",  Count = 4  },
        new() { Key = "drafts",   Label = "Drafts"               },
    })" />


@* 5. Full-featured *@
<PageHeader
    Title="Analytics"
    Description="Insights and trends across your workspace."
    Icon="Lucide.ChartBar"
    BadgeText="Beta"
    BadgeVariant="info"
    ShowMeta="true"
    LastUpdated="5 min ago"
    ItemCount="3280"
    Breadcrumbs="@(new List<PageHeader.BreadcrumbItem>
    {
        new() { Label = "Home",      Href = "/" },
        new() { Label = "Analytics"             },
    })"
    ActiveTab="overview"
    OnTabChanged="HandleTabChange"
    Tabs="@(new List<PageHeader.TabItem>
    {
        new() { Key = "overview",  Label = "Overview"  },
        new() { Key = "traffic",   Label = "Traffic"   },
        new() { Key = "revenue",   Label = "Revenue"   },
        new() { Key = "exports",   Label = "Exports"   },
    })">
    <Actions>
        <button class="btn btn-outline btn-sm gap-1">
            <span class="material-symbols-rounded text-[15px]">download</span>
            Export
        </button>
        <button class="btn btn-primary btn-sm gap-1">
            <span class="material-symbols-rounded text-[15px]">tune</span>
            Filter
        </button>
    </Actions>
    <MetaContent>
        <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
            <span class="material-symbols-rounded text-[14px]">trending_up</span>
            +12% this week
        </span>
    </MetaContent>
</PageHeader>

@code {
    private string _activeTab = "overview";

    private void HandleTabChange(string key)
    {
        _activeTab = key;
    }
}
