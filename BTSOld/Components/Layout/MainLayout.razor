@using BatteryTestingSystem.Components.Pages.Devices
@using BatteryTestingSystem.Components.Pages.Home
@using BatteryTestingSystem.Components.Pages.Programs
@using BatteryTestingSystem.Components.Pages.Batteries
@using BatteryTestingSystem.Components.Pages.Settings
@using BatteryTestingSystem.Components.Pages.Reports


@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager nav
@inject CircuitManager CM
@inject TabService tbService
@implements IDisposable

<AppLayout BrandName="BMS Monitor"
MenuItems="@_menuItems"
Notifications="@_notifications"
Errors="@_errors"
EventLogs="@_eventLogs"
ActiveCount="@(CM?._devices?.Where(e => e.Value?._tcpClient?.Connected == true).Count() ?? 0)"
TotalCount="@(CM?._devices.Count ?? 0)"
CurrentTheme="@_currentTheme"
OnNavigate="@HandleNavigate"
OnLogout="@HandleLogout"
OnThemeChange="@HandleThemeChange"
OnNotificationClick="@HandleNotificationClick">
    <div class="mx-auto px-4 py-1 h-full w-full">
        @Body
    </div>
</AppLayout>


@code
{

    private ThemeMode _currentTheme = ThemeMode.Light;
    #region Notifications
    private readonly HashSet<string> _subscribedDevices = new();
    private List<NotificationItem> _notifications = new();
    public int MaxNoti = 50;

    protected override async Task OnInitializedAsync()
    {

        try
        {

            SubscribeToDevices();

        }
        catch (Exception ex)
        {
            // Optional: log
            Console.Error.WriteLine(ex);
        }
        await Task.CompletedTask; // optional
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        { 
            var stored = await JS.InvokeAsync<List<NotificationItem>>(
               "BtsDb.getNotifications"
           );

            if (stored != null)
            {
                _notifications = stored
                    .Take(MaxNoti)
                    .ToList();
            }

            await JS.InvokeVoidAsync(
                "applySavedTheme",
                CurrentUser.UserName   // pass null or logged-in username
            );

        }
    }

    private void SubscribeToDevices()
    {
        foreach (var kv in CM._devices)
        {
            var deviceId = kv.Key;
            var device = kv.Value;

            if (_subscribedDevices.Contains(deviceId))
                continue;

            device.OnNotify += AddNotification;
            _subscribedDevices.Add(deviceId);
        }

        CM.HardwareManagerChanged -= HandleDeviceChange;

    }

    private void HandleDeviceRemoved(string deviceId)
    {
        if (_subscribedDevices.Remove(deviceId))
        {
            if (CM._devices.TryGetValue(deviceId, out var device))
            {
                device.OnNotify -= AddNotification;
            }
        }

        InvokeAsync(StateHasChanged);
    }

    public void HandleDeviceChange()
    {
        try
        {
            var currentDeviceIds = CM._devices.Keys.ToHashSet();

            foreach (var deviceId in _subscribedDevices.ToList())
            {
                if (!currentDeviceIds.Contains(deviceId))
                {
                    if (CM._devices.TryGetValue(deviceId, out var oldDevice))
                    {
                        oldDevice.OnNotify -= AddNotification;
                    }
                    _subscribedDevices.Remove(deviceId);
                }
            }

            foreach (var deviceId in currentDeviceIds)
            {
                if (!_subscribedDevices.Contains(deviceId))
                {
                    var device = CM._devices[deviceId];

                    device.OnNotify += AddNotification;
                    _subscribedDevices.Add(deviceId);
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"HandleDeviceChange error: {ex}");
        }

        InvokeAsync(StateHasChanged);
    }


    public async void AddNotification(NotificationItem notification)
    {
        try
        {
            var exist = _notifications.FirstOrDefault(e => e.Id == notification.Id);
            if (exist != null)
                return;

            _notifications.Insert(0, notification);

            if (_notifications.Count > MaxNoti)
            {
                _notifications.RemoveRange(MaxNoti, _notifications.Count - MaxNoti);
            }

            await SaveNotificationsToIndexedDb();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"AddNotification error: {ex}");
        }
    }

    private async Task SaveNotificationsToIndexedDb()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "BtsDb.saveNotifications",
                _notifications
            );

            // ServerSessionStorageService
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"SaveNotificationsToIndexedDb error: {ex}");
        }
    }

    #endregion 

    private List<NavMenuItem> _menuItems = new()
    {
        new NavMenuItem { 
            Title = "Display", 
            Url = "/", 
            Icon = Lucide.Fullscreen ,
            ComponentType = typeof(DashboardView),
            Unique = true            
        },
        new NavMenuItem
        {
            Title = "Circuits",
            Url = "/device/list",
            Icon = Lucide.Settings2,
            ComponentType = typeof(DeviceList),
            Unique = true,
        },
        new NavMenuItem
        {
            Title = "Battery",
            Url = "/battery/list",
            Icon = Lucide.BatteryFull,
            ComponentType = typeof(BatteriesList),
            Unique = true,
            // Dropdown = new List<NavMenuSubItem>
            // {
            //     new NavMenuSubItem { Title = "View Batteries", Url = "/battery" },
            //     new NavMenuSubItem { Title = "Add Battery", Url = "/battery/add" },
            //     new NavMenuSubItem { Title = "Configure", Url = "/battery/configure" }
            // }
        },
        new NavMenuItem
        {
            Title = "Program",
            Url = "/program/list",
            Icon = Lucide.Code,
            Dropdown = new List<NavMenuItem>
            {
                new NavMenuItem { Title = "Programs", Url = "/program/list" , 
                    Icon = Lucide.Code, 
                    ComponentType = typeof(ProgramList), Unique = true, keepAlive = true},
                new NavMenuItem { Title = "TableFiles", Url = "/program/tables" ,
                    Icon = Lucide.Files, 
                    ComponentType = typeof(TableFileManager) , Unique = true},
                new NavMenuItem { Title = "Registrations", Url = "/program/registration", 
                    Icon = Lucide.Stamp, 
                    ComponentType = typeof(Registrations), Unique = true },
                new NavMenuItem { Title = "ErrorMessages", Url = "/program/ErrorMessages",
                    Icon = Lucide.Signal, 
                    ComponentType = typeof(ErrorMsgConfig)},
                new NavMenuItem { Title = "Scheduler", Url = "/scheduler",
                    Icon = Lucide.CalendarClock,
                    ComponentType = typeof(SchedulerPage), Unique = true, keepAlive = false }

            }
        },
        new NavMenuItem { 
            Title = "Report", 
            Url = "/reports/sessions", 
            Icon = Lucide.List,
            ComponentType = typeof(Reports),
            Unique = true,
            keepAlive = true
        }
    };


    private List<ErrorItem> _errors = new();

    private List<EventLogItem> _eventLogs = new();


    private void HandleNavigate(NavMenuItem navigator)
    {
        Log.Information($"Navigate to: {navigator.Url}");
        if (navigator.ComponentType != null)
            tbService.AddTab(navigator);
       // nav.NavigateTo(navigator.Url);

    }

    private void HandleLogout()
    {
        Log.Information("Logout triggered");
        nav.NavigateTo($"/logout?id={CurrentUser.UserId}&user={CurrentUser.UserName}", true);
        // TODO: Add logout logic (clear tokens, redirect, etc.)
    }

    private async Task HandleThemeChange(ThemeMode theme)
    {
        Log.Information($"Theme changed to: {theme}");

        _currentTheme = theme;

        await JS.InvokeVoidAsync("setThemeOnBody", theme.ToString(), CurrentUser.UserName);

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNotificationClick(string id)
    {
        Log.Information($"Notification clicked: {id}");

        var note = _notifications.FirstOrDefault(n => n.Id == id);
        if (note != null)
            note.Read = true;

        await InvokeAsync(StateHasChanged);

        _ = RemoveNotificationAfterDelay(note ?? new NotificationItem(), TimeSpan.FromSeconds(60));

    }

    private async Task RemoveNotificationAfterDelay( NotificationItem note, TimeSpan delay)
    {
        try
        {
            await Task.Delay(delay);

            await InvokeAsync(async () =>
            {
                // It might already be removed
                if (!_notifications.Remove(note))
                    return;

                await SaveNotificationsToIndexedDb();
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to remove notification after delay");
        }
    }

    public void Dispose()
    {
        try
        {
            foreach (var deviceId in _subscribedDevices)
            {
                if (CM._devices.TryGetValue(deviceId, out var device))
                {
                    device.OnNotify -= AddNotification;
                }
            }

            _subscribedDevices.Clear();

            CM.HardwareManagerChanged -= HandleDeviceChange;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
        }
    }

}