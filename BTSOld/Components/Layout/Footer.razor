@namespace BatteryTestingSystem.Components.Layout


@if (!_isVisible)
{
    <Button Size="ButtonSize.Small"
            Variant="ButtonVariant.Outline"
            Class="fixed bottom-2 right-2 sm:bottom-4 sm:right-4 z-50 shadow-lg"
            OnClick="@(() => _isVisible = true)">
        <svg class="h-4 w-4 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
        </svg>
        <span class="hidden sm:inline">Show Status</span>
    </Button>
}
else
{
    <footer class="fixed bottom-0 left-0 right-0 z-40 border-t border-border bg-card">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 sm:gap-4 px-2 sm:px-4 py-2">

            @* Left: Error Summary *@
            <div class="flex items-center gap-2 sm:gap-4 w-full sm:w-auto overflow-x-auto">
                @if (Errors != null && Errors.Any())
                {
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <svg class="h-4 w-4 text-destructive flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-xs sm:text-sm text-muted-foreground whitespace-nowrap">
                            @Errors.Count @(Errors.Count == 1 ? "Error" : "Errors")
                        </span>
                        <div class="hidden md:flex items-center gap-2">
                            @foreach (var error in Errors.Take(4))
                            {
                                <Badge Variant="@(error.Severity == "error" ? BadgeVariant.Destructive : BadgeVariant.Secondary)"
                                       Class="text-xs whitespace-nowrap">
                                    @error.Message
                                </Badge>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-xs sm:text-sm text-green-500 whitespace-nowrap">System Normal</span>
                    </div>
                }
            </div>

            @* Center: Event Logs Drawer *@
            <Sheet Open="_eventLogsOpen">
                <SheetTrigger>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="flex-shrink-0">
                        <span class="hidden sm:inline">Event Logs</span>
                        <span class="sm:hidden">Logs</span>
                        <Badge Class="ml-2" Variant="BadgeVariant.Secondary">
                            @(EventLogs?.Count ?? 0)
                        </Badge>
                    </Button>
                </SheetTrigger>
                <SheetContent Side="SheetSide.Bottom" Class="h-[70vh] sm:h-[60vh]">
                    <SheetHeader>
                        <SheetTitle>Event Logs</SheetTitle>
                    </SheetHeader>
                    <ScrollArea Class="h-[calc(100%-3rem)] mt-4">
                        <div class="space-y-2 pr-4">
                            @if (EventLogs != null)
                            {
                                @foreach (var log in EventLogs)
                                {
                                    <div class="@GetLogClasses(log.Type)">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs sm:text-sm font-medium break-words">@log.Message</p>
                                                <p class="text-xs text-muted-foreground mt-1">
                                                    @log.Timestamp.ToString("g")
                                                </p>
                                            </div>
                                            <Badge Variant="@GetLogBadgeVariant(log.Type)"
                                                   Class="flex-shrink-0 text-xs">
                                                @log.Type
                                            </Badge>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </ScrollArea>
                </SheetContent>
            </Sheet>

            @* Right: Live Status *@
            <div class="flex items-center gap-2 sm:gap-4 w-full sm:w-auto justify-between sm:justify-end">
                <div class="flex items-center gap-2 sm:gap-4">
                    <div class="flex items-center gap-2">
                        <div class="h-2 w-2 bg-green-500 rounded-full animate-pulse"></div>
                        <span class="text-xs sm:text-sm text-muted-foreground">Live</span>
                    </div>
                    <span class="text-xs sm:text-sm text-muted-foreground whitespace-nowrap">
                        @ActiveCount/@TotalCount
                    </span>
                </div>
                <Button Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Small"
                        OnClick="@(() => _isVisible = false)"
                        Class="flex-shrink-0">
                    <span class="hidden sm:inline">Hide</span>
                    <svg class="h-4 w-4 sm:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
                    </svg>
                </Button>
            </div>
        </div>
    </footer>
}

@code {
    [Parameter]
    public List<ErrorItem>? Errors { get; set; }

    [Parameter]
    public List<EventLogItem>? EventLogs { get; set; }

    [Parameter]
    public int ActiveCount { get; set; }

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigate { get; set; }

    private bool _isVisible = true;
    private bool _eventLogsOpen = false;

    private string GetLogClasses(string type)
    {
        var baseClasses = "p-2 sm:p-3 rounded border";
        return type switch
        {
            "error" => $"{baseClasses} border-destructive/50 bg-destructive/10",
            "warning" => $"{baseClasses} border-yellow-500/50 bg-yellow-500/10",
            _ => $"{baseClasses} border-border bg-card"
        };
    }

    private BadgeVariant GetLogBadgeVariant(string type)
    {
        return type switch
        {
            "error" => BadgeVariant.Destructive,
            "warning" => BadgeVariant.Secondary,
            _ => BadgeVariant.Outline
        };
    }
}