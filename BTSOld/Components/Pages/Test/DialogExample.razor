@page "/dialog-example"
@attribute [Authorize]

<div class="p-8 space-y-8">
    <h1 class="text-3xl font-bold mb-8">Dialog Size Examples</h1>

    <!-- Small Dialog -->
    <div class="space-y-2">
        <h3 class="text-xl font-semibold">Small Dialog (max-w-sm)</h3>
        <Dialog @bind-Open="isSmallOpen">
            <DialogTrigger AsChild="true">
                <button class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                    Open Small Dialog
                </button>
            </DialogTrigger>
            
            <DialogContent Size="DialogSize.Small">
                <DialogHeader>
                    <DialogTitle>Confirm Action</DialogTitle>
                    <DialogDescription>Are you sure you want to proceed?</DialogDescription>
                </DialogHeader>
                
                <div class="py-4">
                    <p class="text-sm">This is a small dialog used for simple confirmations or quick messages.</p>
                </div>
                
                <DialogFooter>
                    <button @onclick="() => isSmallOpen = false" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                        Cancel
                    </button>
                    <button @onclick="() => isSmallOpen = false" class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                        Confirm
                    </button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>

    <!-- Medium Dialog (Default) -->
    <div class="space-y-2">
        <h3 class="text-xl font-semibold">Medium Dialog (max-w-lg - Default)</h3>
        <Dialog @bind-Open="isMediumOpen">
            <DialogTrigger AsChild="true">
                <button class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
                    Open Medium Dialog
                </button>
            </DialogTrigger>
            
            <DialogContent>
                <DialogHeader>
                    <DialogTitle>Edit Step Configuration</DialogTitle>
                    <DialogDescription>Update the step details below. Changes will be saved automatically.</DialogDescription>
                </DialogHeader>
                
                <div class="grid gap-4 py-4">
                    <div>
                        <label class="text-sm font-medium block mb-1">Step Number</label>
                        <input @bind="mediumStep.StepNumber" type="number" class="w-full px-3 py-2 border rounded" />
                    </div>
                    <div>
                        <label class="text-sm font-medium block mb-1">Operator Code</label>
                        <input @bind="mediumStep.OperatorCode" type="number" class="w-full px-3 py-2 border rounded" />
                    </div>
                    <div>
                        <label class="text-sm font-medium block mb-1">Label</label>
                        <input @bind="mediumStep.Label" class="w-full px-3 py-2 border rounded" />
                    </div>
                    <div>
                        <label class="text-sm font-medium block mb-1">Comment</label>
                        <textarea @bind="mediumStep.Comment" rows="3" class="w-full px-3 py-2 border rounded"></textarea>
                    </div>
                </div>
                
                <DialogFooter>
                    <button @onclick="() => isMediumOpen = false" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                        Cancel
                    </button>
                    <button @onclick="SaveMediumChanges" class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
                        Save Changes
                    </button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>

    <!-- Large Dialog -->
    <div class="space-y-2">
        <h3 class="text-xl font-semibold">Large Dialog (max-w-2xl)</h3>
        <Dialog @bind-Open="isLargeOpen">
            <DialogTrigger AsChild="true">
                <button class="px-4 py-2 bg-purple-500 text-white rounded hover:bg-purple-600">
                    Open Large Dialog
                </button>
            </DialogTrigger>
            
            <DialogContent Size="DialogSize.Large">
                <DialogHeader>
                    <DialogTitle>Complete Step Configuration</DialogTitle>
                    <DialogDescription>Configure all step parameters including nominal values, limits, actions, and registrations.</DialogDescription>
                </DialogHeader>
                
                <div class="grid gap-4 py-4 max-h-[60vh] overflow-y-auto">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="text-sm font-medium block mb-1">Step Number</label>
                            <input @bind="largeStep.StepNumber" type="number" class="w-full px-3 py-2 border rounded" />
                        </div>
                        <div>
                            <label class="text-sm font-medium block mb-1">Operator Code</label>
                            <input @bind="largeStep.OperatorCode" type="number" class="w-full px-3 py-2 border rounded" />
                        </div>
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Label</label>
                        <input @bind="largeStep.Label" class="w-full px-3 py-2 border rounded" />
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Comment</label>
                        <textarea @bind="largeStep.Comment" rows="3" class="w-full px-3 py-2 border rounded"></textarea>
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Nominal Values</label>
                        <div class="space-y-2">
                            @foreach (var value in largeStep.NominalValues)
                            {
                                <div class="flex gap-2">
                                    <input value="@value" class="flex-1 px-3 py-2 border rounded" readonly />
                                    <button class="px-3 py-2 bg-red-500 text-white rounded hover:bg-red-600">Remove</button>
                                </div>
                            }
                            <button class="px-3 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">+ Add Nominal Value</button>
                        </div>
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Limits</label>
                        <div class="space-y-2">
                            @foreach (var limit in largeStep.Limits)
                            {
                                <div class="flex gap-2">
                                    <input value="@limit" class="flex-1 px-3 py-2 border rounded" readonly />
                                    <button class="px-3 py-2 bg-red-500 text-white rounded hover:bg-red-600">Remove</button>
                                </div>
                            }
                            <button class="px-3 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">+ Add Limit</button>
                        </div>
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Actions</label>
                        <div class="space-y-2">
                            @foreach (var action in largeStep.Action)
                            {
                                <div class="flex gap-2">
                                    <input value="@action" class="flex-1 px-3 py-2 border rounded" readonly />
                                    <button class="px-3 py-2 bg-red-500 text-white rounded hover:bg-red-600">Remove</button>
                                </div>
                            }
                            <button class="px-3 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">+ Add Action</button>
                        </div>
                    </div>
                    
                    <div>
                        <label class="text-sm font-medium block mb-1">Registrations</label>
                        <div class="space-y-2">
                            @foreach (var reg in largeStep.Registrations)
                            {
                                <div class="flex gap-2">
                                    <input value="@reg" class="flex-1 px-3 py-2 border rounded" readonly />
                                    <button class="px-3 py-2 bg-red-500 text-white rounded hover:bg-red-600">Remove</button>
                                </div>
                            }
                            <button class="px-3 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">+ Add Registration</button>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-2">
                        <input type="checkbox" @bind="largeStep.IsStepVaild" id="stepValid" class="w-4 h-4" />
                        <label for="stepValid" class="text-sm font-medium">Step is Valid</label>
                    </div>
                </div>
                
                <DialogFooter>
                    <button @onclick="() => isLargeOpen = false" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                        Cancel
                    </button>
                    <button @onclick="SaveLargeChanges" class="px-4 py-2 bg-purple-500 text-white rounded hover:bg-purple-600">
                        Save All Changes
                    </button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>

    <!-- Extra Large Dialog -->
    <div class="space-y-2">
        <h3 class="text-xl font-semibold">Extra Large Dialog (max-w-4xl)</h3>
        <Dialog @bind-Open="isXLargeOpen">
            <DialogTrigger AsChild="true">
                <button class="px-4 py-2 bg-orange-500 text-white rounded hover:bg-orange-600">
                    Open Extra Large Dialog
                </button>
            </DialogTrigger>
            
            <DialogContent Size="DialogSize.XLarge">
                <DialogHeader>
                    <DialogTitle>Step Configuration Manager</DialogTitle>
                    <DialogDescription>Manage multiple steps and their complete configurations in a wide layout.</DialogDescription>
                </DialogHeader>
                
                <div class="py-4">
                    <div class="grid grid-cols-3 gap-6 max-h-[70vh] overflow-y-auto">
                        <div class="col-span-1 border-r pr-4">
                            <h4 class="font-semibold mb-3">Basic Info</h4>
                            <div class="space-y-3">
                                <div>
                                    <label class="text-sm font-medium block mb-1">Step Number</label>
                                    <input value="1" class="w-full px-3 py-2 border rounded text-sm" />
                                </div>
                                <div>
                                    <label class="text-sm font-medium block mb-1">Operator Code</label>
                                    <input value="10" class="w-full px-3 py-2 border rounded text-sm" />
                                </div>
                                <div>
                                    <label class="text-sm font-medium block mb-1">Label</label>
                                    <input value="Test Step" class="w-full px-3 py-2 border rounded text-sm" />
                                </div>
                                <div>
                                    <label class="text-sm font-medium block mb-1">Comment</label>
                                    <textarea rows="4" class="w-full px-3 py-2 border rounded text-sm">Sample comment text</textarea>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-span-1 border-r pr-4">
                            <h4 class="font-semibold mb-3">Values & Limits</h4>
                            <div class="space-y-4">
                                <div>
                                    <label class="text-sm font-medium block mb-2">Nominal Values</label>
                                    <div class="space-y-1">
                                        <div class="text-xs bg-gray-100 px-2 py-1 rounded">Value: 100.5</div>
                                        <div class="text-xs bg-gray-100 px-2 py-1 rounded">Value: 200.3</div>
                                        <div class="text-xs bg-gray-100 px-2 py-1 rounded">Value: 300.1</div>
                                    </div>
                                </div>
                                <div>
                                    <label class="text-sm font-medium block mb-2">Limits</label>
                                    <div class="space-y-1">
                                        <div class="text-xs bg-gray-100 px-2 py-1 rounded">Min: 50.0</div>
                                        <div class="text-xs bg-gray-100 px-2 py-1 rounded">Max: 500.0</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-span-1">
                            <h4 class="font-semibold mb-3">Actions & Registrations</h4>
                            <div class="space-y-4">
                                <div>
                                    <label class="text-sm font-medium block mb-2">Actions</label>
                                    <div class="space-y-1">
                                        <div class="text-xs bg-blue-100 px-2 py-1 rounded">Action: Start</div>
                                        <div class="text-xs bg-blue-100 px-2 py-1 rounded">Action: Measure</div>
                                        <div class="text-xs bg-blue-100 px-2 py-1 rounded">Action: Stop</div>
                                    </div>
                                </div>
                                <div>
                                    <label class="text-sm font-medium block mb-2">Registrations</label>
                                    <div class="space-y-1">
                                        <div class="text-xs bg-green-100 px-2 py-1 rounded">Reg: LOG_001</div>
                                        <div class="text-xs bg-green-100 px-2 py-1 rounded">Reg: LOG_002</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <DialogFooter>
                    <button @onclick="() => isXLargeOpen = false" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                        Cancel
                    </button>
                    <button class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                        Export Configuration
                    </button>
                    <button @onclick="() => isXLargeOpen = false" class="px-4 py-2 bg-orange-500 text-white rounded hover:bg-orange-600">
                        Save Configuration
                    </button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>

    <!-- Full Width Dialog -->
    <div class="space-y-2">
        <h3 class="text-xl font-semibold">Full Width Dialog (max-w-6xl)</h3>
        <Dialog @bind-Open="isFullOpen">
            <DialogTrigger AsChild="true">
                <button class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">
                    Open Full Width Dialog
                </button>
            </DialogTrigger>
            
            <DialogContent Size="DialogSize.FullScreen">
                <DialogHeader>
                    <DialogTitle>Step Configuration Dashboard</DialogTitle>
                    <DialogDescription>Full width view for managing multiple step configurations with detailed analytics.</DialogDescription>
                </DialogHeader>
                
                <div class="py-4">
                    <div class="grid grid-cols-4 gap-4 max-h-[75vh] overflow-y-auto">
                        <div class="border rounded p-3">
                            <h5 class="font-medium text-sm mb-2">Step 1</h5>
                            <div class="text-xs space-y-1">
                                <div>Operator: 10</div>
                                <div>Label: Init</div>
                                <div class="text-green-600">Valid ✓</div>
                            </div>
                        </div>
                        <div class="border rounded p-3">
                            <h5 class="font-medium text-sm mb-2">Step 2</h5>
                            <div class="text-xs space-y-1">
                                <div>Operator: 20</div>
                                <div>Label: Process</div>
                                <div class="text-green-600">Valid ✓</div>
                            </div>
                        </div>
                        <div class="border rounded p-3">
                            <h5 class="font-medium text-sm mb-2">Step 3</h5>
                            <div class="text-xs space-y-1">
                                <div>Operator: 30</div>
                                <div>Label: Validate</div>
                                <div class="text-red-600">Invalid ✗</div>
                            </div>
                        </div>
                        <div class="border rounded p-3">
                            <h5 class="font-medium text-sm mb-2">Step 4</h5>
                            <div class="text-xs space-y-1">
                                <div>Operator: 40</div>
                                <div>Label: Finalize</div>
                                <div class="text-green-600">Valid ✓</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-4 border-t pt-4">
                        <h5 class="font-medium mb-3">Configuration Summary</h5>
                        <div class="grid grid-cols-3 gap-4 text-sm">
                            <div class="bg-blue-50 p-3 rounded">
                                <div class="font-medium">Total Steps</div>
                                <div class="text-2xl font-bold text-blue-600">4</div>
                            </div>
                            <div class="bg-green-50 p-3 rounded">
                                <div class="font-medium">Valid Steps</div>
                                <div class="text-2xl font-bold text-green-600">3</div>
                            </div>
                            <div class="bg-red-50 p-3 rounded">
                                <div class="font-medium">Invalid Steps</div>
                                <div class="text-2xl font-bold text-red-600">1</div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <DialogFooter>
                    <button @onclick="() => isFullOpen = false" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                        Close
                    </button>
                    <button class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600">
                        Generate Report
                    </button>
                    <button class="px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600">
                        Validate All
                    </button>
                    <button @onclick="() => isFullOpen = false" class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600">
                        Save Dashboard
                    </button>
                </DialogFooter>
            </DialogContent>
        </Dialog>
    </div>
</div>

@code {
    private bool isSmallOpen = false;
    private bool isMediumOpen = false;
    private bool isLargeOpen = false;
    private bool isXLargeOpen = false;
    private bool isFullOpen = false;

    private StepModel mediumStep = new StepModel 
    { 
        StepNumber = 1, 
        OperatorCode = 10,
        Label = "Test Step", 
        Comment = "Sample comment for medium dialog" 
    };

    private StepModel largeStep = new StepModel 
    { 
        StepNumber = 2, 
        OperatorCode = 20,
        Label = "Large Step Configuration", 
        Comment = "This step demonstrates all available configuration options",
        NominalValues = new List<string> { "100.5", "200.3", "300.1" },
        Limits = new List<string> { "Min: 50.0", "Max: 500.0" },
        Action = new List<string> { "Start", "Measure", "Stop" },
        Registrations = new List<string> { "LOG_001", "LOG_002" },
        IsStepVaild = true
    };

    private async Task SaveMediumChanges()
    {
        // Save logic
        isMediumOpen = false;
    }

    private async Task SaveLargeChanges()
    {
        // Save logic
        isLargeOpen = false;
    }

    public class StepModel
    {
        public int StepNumber { get; set; }
        public byte OperatorCode { get; set; }
        public string Label { get; set; } = string.Empty;
        public string Comment { get; set; } = string.Empty;
        public List<string> NominalValues { get; set; } = new();
        public List<string> Limits { get; set; } = new();
        public List<string> Action { get; set; } = new();
        public List<string> Registrations { get; set; } = new();
        public bool IsStepVaild { get; set; } = false;
    }
}
