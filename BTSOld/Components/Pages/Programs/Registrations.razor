@page "/program/registration"
@attribute [Authorize]
@attribute [StreamRendering]

@using BatteryTestingSystem.Components.UI.Dashboard
@using BatteryTestingSystem.Components.UI.PageHeader
@using BatteryTestingSystem.Components.UI.Card

@inject IProgramServices PService
@inject ToastService Toast

<PageTitle>Registration Settings</PageTitle>

<div class="flex flex-col h-full overflow-hidden">

    <!-- ── Page Header ── -->
    <div class="shrink-0 px-6 pt-6">
        <PageHeader Title="Program Settings"
                    Description="Configure registration standards and unit selections"
                    Icon="Lucide.PawPrint">
            <Actions>
                <Button Variant="ButtonVariant.Default"
                        Size="ButtonSize.Small"
                        OnClick="AddNewStandard">
                    <Blazicon Svg="Lucide.Plus" class="h-3.5 w-3.5 mr-1.5" />
                    Add New
                </Button>
            </Actions>
        </PageHeader>
    </div>

    <!-- ── Main Content ── -->
    <div class="flex-1 overflow-auto px-6 pb-6 space-y-5">

        <!-- ── Registration Selector Card ── -->
        <Card class="p-5">
            <div class="flex items-end gap-3">
                <div class="flex-1 space-y-1.5">
                    <label class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                        Registration Standard
                    </label>
                    <div class="flex items-center gap-2">
                        <DropdownMenu @bind-Open="dropdownOpen">
                            <DropdownMenuTrigger>
                                <Button Variant="ButtonVariant.Outline"
                                        Class="min-w-[220px] justify-between"
                                        StopPropagation="true"
                                        OnClick="@(() => dropdownOpen = !dropdownOpen)">
                                    <span>@(SelectedStandard?.StandardName ?? "Select a standard…")</span>
                                    <Blazicon Svg="Lucide.ChevronDown" class="h-3.5 w-3.5 ml-2 opacity-50" />
                                </Button>
                            </DropdownMenuTrigger>
                            <DropdownMenuContent>
                                @foreach (var standard in Standards)
                                {
                                    <DropdownMenuItem OnClick="@(() => SelectStandard(standard))">
                                        <div class="flex flex-col">
                                            <span class="font-medium">@standard.StandardName</span>
                                            @if (!string.IsNullOrEmpty(standard.Description))
                                            {
                                                <span class="text-xs text-muted-foreground">@standard.Description</span>
                                            }
                                        </div>
                                    </DropdownMenuItem>
                                }
                            </DropdownMenuContent>
                        </DropdownMenu>

                        @if (SelectedStandard != null &&
                             SelectedStandard.StandardName != "Select..." &&
                             SelectedStandard.StandardName != "STANDARD" &&
                             SelectedStandard.StandardName != "SIMPLE")
                        {
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                    OnClick="@(() => { isEditMode = true; isAddDialogOpen = true; })"
                                    title="Edit registration">
                                <Blazicon Svg="Lucide.Pencil" class="h-3.5 w-3.5 text-muted-foreground" />
                            </Button>
                            <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                    OnClick="ShowDeleteConfirm"
                                    title="Delete registration">
                                <Blazicon Svg="Lucide.Trash2" class="h-3.5 w-3.5 text-destructive" />
                            </Button>
                        }
                    </div>
                </div>

                @if (SelectedStandard != null)
                {
                    <div class="flex-1 space-y-1.5">
                        <label class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                            Description
                        </label>
                        <input type="text"
                               class="w-full h-9 px-3 text-sm bg-background border border-input rounded-md
                                      text-foreground placeholder:text-muted-foreground/50
                                      focus:outline-none focus:ring-1 focus:ring-ring focus:border-ring transition-colors"
                               placeholder="Enter description…"
                               @bind="SelectedStandard.Description"
                               @bind:event="oninput" />
                    </div>
                }
            </div>
        </Card>

        @if (SelectedStandard != null)
        {
            <!-- ── Unit Transfer Panel ── -->
            <div class="grid grid-cols-[1fr_auto_1fr] gap-4 items-start">

                <!-- Available Units -->
                <Card class="overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-muted/30">
                        <div class="flex items-center gap-2">
                            <div class="flex h-6 w-6 items-center justify-center rounded bg-muted text-muted-foreground">
                                <Blazicon Svg="Lucide.Database" class="h-3 w-3" />
                            </div>
                            <span class="text-sm font-semibold text-foreground">Available Units</span>
                        </div>
                        <span class="text-xs text-muted-foreground bg-muted px-2 py-0.5 rounded-full">
                            @LeftUnits.Count
                        </span>
                    </div>
                    <ScrollArea class="h-64">
                        <div class="p-2 space-y-0.5">
                            @if (LeftUnits.Count == 0)
                            {
                                <div class="flex flex-col items-center justify-center py-10 text-muted-foreground/60">
                                    <Blazicon Svg="Lucide.CircleCheck" class="h-8 w-8 mb-2 text-green-500/50" />
                                    <p class="text-xs">All units selected</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var unit in LeftUnits)
                                {
                                    <div class="flex items-center gap-2 px-3 py-2 rounded-md cursor-pointer select-none
                                                transition-colors text-sm font-medium
                                                @(SelectedLeft == unit
                                                    ? "bg-primary text-primary-foreground"
                                                    : "hover:bg-accent text-foreground")"
                                         @onclick="() => SelectedLeft = unit">
                                        <Blazicon Svg="Lucide.Gauge" class="h-3.5 w-3.5 opacity-60 shrink-0" />
                                        @unit
                                    </div>
                                }
                            }
                        </div>
                    </ScrollArea>
                </Card>

                <!-- Transfer Buttons -->
                <div class="flex flex-col gap-1.5 mt-10">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                            Disabled="@(SelectedLeft is null)" OnClick="MoveToRight"
                            title="Move to selected" class="h-8 w-8">
                        <Blazicon Svg="Lucide.ChevronRight" class="h-4 w-4" />
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                            Disabled="@(SelectedRight is null)" OnClick="MoveToLeft"
                            title="Remove from selected" class="h-8 w-8">
                        <Blazicon Svg="Lucide.ChevronLeft" class="h-4 w-4" />
                    </Button>
                    <div class="h-px bg-border my-1"></div>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                            Disabled="@(LeftUnits.Count == 0)" OnClick="MoveAllToRight"
                            title="Move all" class="h-8 w-8">
                        <Blazicon Svg="Lucide.ChevronsRight" class="h-4 w-4" />
                    </Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                            Disabled="@(RightUnits.Count == 0)" OnClick="MoveAllToLeft"
                            title="Remove all" class="h-8 w-8">
                        <Blazicon Svg="Lucide.ChevronsLeft" class="h-4 w-4" />
                    </Button>
                </div>

                <!-- Selected Units -->
                <Card class="overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-primary/5">
                        <div class="flex items-center gap-2">
                            <div class="flex h-6 w-6 items-center justify-center rounded bg-primary/10 text-primary">
                                <Blazicon Svg="Lucide.ListChecks" class="h-3 w-3" />
                            </div>
                            <span class="text-sm font-semibold text-foreground">Selected Units</span>
                        </div>
                        <span class="text-xs text-primary bg-primary/10 px-2 py-0.5 rounded-full font-medium">
                            @RightUnits.Count
                        </span>
                    </div>
                    <ScrollArea class="h-64">
                        <div class="p-2 space-y-0.5">
                            @if (RightUnits.Count == 0)
                            {
                                <div class="flex flex-col items-center justify-center py-10 text-muted-foreground/60">
                                    <Blazicon Svg="Lucide.ListX" class="h-8 w-8 mb-2" />
                                    <p class="text-xs">No units selected</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var unit in RightUnits)
                                {
                                    <div class="flex items-center gap-2 px-3 py-2 rounded-md cursor-pointer select-none
                                                transition-colors text-sm font-medium
                                                @(SelectedRight == unit
                                                    ? "bg-primary text-primary-foreground"
                                                    : "hover:bg-accent text-foreground")"
                                         @onclick="() => SelectedRight = unit">
                                        <Blazicon Svg="Lucide.Check" class="h-3.5 w-3.5 opacity-60 shrink-0" />
                                        @unit
                                    </div>
                                }
                            }
                        </div>
                    </ScrollArea>
                </Card>
            </div>

            <!-- ── Action Buttons ── -->
            <div class="flex justify-end gap-2 pt-1">
                <Button Variant="ButtonVariant.Outline" OnClick="CancelChanges">
                    Cancel
                </Button>
                <Button Variant="ButtonVariant.Default" OnClick="SaveStandard">
                    <Blazicon Svg="Lucide.Save" class="h-4 w-4 mr-2" />
                    Update Changes
                </Button>
            </div>
        }
        else
        {
            <!-- ── Empty State ── -->
            <div class="flex flex-col items-center justify-center py-20 text-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-muted mb-4">
                    <Blazicon Svg="Lucide.Settings" class="h-8 w-8 text-muted-foreground/50" />
                </div>
                <p class="text-sm font-medium text-foreground mb-1">No standard selected</p>
                <p class="text-xs text-muted-foreground">Choose a registration standard above to configure its units</p>
            </div>
        }
    </div>
</div>

    <!-- ── Create / Edit Dialog ── -->
    <Dialog @bind-Open="@isAddDialogOpen">
        <DialogContent>
            <EditForm Model="@EditStandard" OnValidSubmit="@CreateStandard">
                <DataAnnotationsValidator />
                <DialogHeader>
                    <DialogTitle>@(isEditMode ? "Edit Registration" : "Add New Registration")</DialogTitle>
                    <DialogDescription>
                        @(isEditMode ? "Update registration details below." : "Create a new registration standard.")
                    </DialogDescription>
                </DialogHeader>
                <div class="space-y-4 py-4">
                    <FormField TValue="string" For="@(() => EditStandard.StandardName)" Context="field">
                        <FormInputText TValue="string" FieldId="@field.FieldId"
                                       Value="@field.Value" ValueChanged="@field.ValueChanged"
                                       IsInvalid="@field.IsInvalid"
                                       Label="Registration Name" Placeholder="Enter registration name" />
                    </FormField>
                    <FormField TValue="string" For="@(() => EditStandard.Description)" Context="field">
                        <FormTextArea TValue="string" FieldId="@field.FieldId"
                                      Value="@field.Value" ValueChanged="@field.ValueChanged"
                                      IsInvalid="@field.IsInvalid"
                                      Label="Description" Placeholder="Enter description" Rows="3" />
                    </FormField>
                </div>
                <DialogFooter>
                    <Button Variant="ButtonVariant.Outline" OnClick="@(() => isAddDialogOpen = false)">Cancel</Button>
                    <Button Type="submit">@(isEditMode ? "Update Registration" : "Create Registration")</Button>
                </DialogFooter>
            </EditForm>
        </DialogContent>
    </Dialog>

    <ConfirmDialog IsOpen="@isConfirmDialogOpen"
                   IsOpenChanged="@(v => isConfirmDialogOpen = v)"
                   Title="@confirmTitle"
                   Message="@confirmMessage"
                   OnConfirm="@_confirmAction" />

@code
{
    private bool dropdownOpen;
    private RegistrationStandardsDTO? EditStandard { get; set; } = new();
    private RegistrationStandardsDTO? SelectedStandard { get; set; } = new();
    private List<RegistrationStandardsDTO> Standards { get; set; } = new();
    private List<string> LeftUnits = new();
    private List<string> RightUnits = new();
    private string? SelectedLeft;
    private string? SelectedRight;
    private bool isAddDialogOpen;
    private bool isEditMode;

    protected override async Task OnInitializedAsync()
    {
        await LoadStandards();
    }

    private async Task LoadStandards()
    {
        var GetStandards = await PService.GetRegistrationStandardAsync();
        if (GetStandards.Success)
        {
            Standards = GetStandards.Data.ToList();
            await RStandards.GetStandardsAsync(true);
        }
        SelectStandard(Standards.FirstOrDefault());
    }

    private void SelectStandard(RegistrationStandardsDTO standard = null)
    {
        SelectedStandard = standard;
        dropdownOpen = false;
        RightUnits = SelectedStandard?.UnitList?.ToList() ?? new List<string>();
        LeftUnits = OperatorConstants.ValidUnits
            .Except(RightUnits)
            .Where(e => !OperatorConstants.TimeUnits.Contains(e))
            .ToList();
        SelectedLeft = null;
        SelectedRight = null;
    }

    private void MoveToRight()
    {
        if (SelectedLeft is not null) { LeftUnits.Remove(SelectedLeft); RightUnits.Add(SelectedLeft); SelectedLeft = null; }
    }
    private void MoveToLeft()
    {
        if (SelectedRight is not null) { RightUnits.Remove(SelectedRight); LeftUnits.Add(SelectedRight); SelectedRight = null; }
    }
    private void MoveAllToRight() { RightUnits.AddRange(LeftUnits); LeftUnits.Clear(); SelectedLeft = null; }
    private void MoveAllToLeft() { LeftUnits.AddRange(RightUnits); RightUnits.Clear(); SelectedRight = null; }

    private async Task SaveStandard()
    {
        if (SelectedStandard == null) return;
        SelectedStandard.UnitList = RightUnits.ToList();
        if (SelectedStandard.UnitList.Count == 0) { Toast.Error("Error: At least one unit must be selected."); return; }
        var Update = await PService.UpdateRegistrationStandardAsync(SelectedStandard);
        if (!Update.Success) Toast.Error($"Error saving standard: {Update.Message}");
        else { await RStandards.GetStandardsAsync(true); Toast.Success("Registration saved successfully."); }
    }

    private void CancelChanges() { if (SelectedStandard != null) SelectStandard(SelectedStandard); }

    private void AddNewStandard()
    {
        EditStandard = new RegistrationStandardsDTO();
        SelectStandard();
        isEditMode = false;
        isAddDialogOpen = true;
    }

    private async void CreateStandard()
    {
        if (EditStandard == null) return;
        EditStandard.UnitList = new List<string> { "A", "V", "C", "W" };
        var Save = await PService.CreateRegistrationStandardAsync(EditStandard);
        if (!Save.Success) { Toast.Error($"Error saving standard: {Save.Message}"); return; }
        else Toast.Success("Registration saved successfully.");
        Standards.Add(EditStandard);
        SelectStandard(EditStandard);
        isAddDialogOpen = false;
    }

    #region Confirm Dialog
    private bool isConfirmDialogOpen;
    private string confirmTitle = string.Empty;
    private string confirmMessage = string.Empty;
    private Func<Task>? _confirmAction;

    private void ShowDeleteConfirm()
    {
        confirmTitle = $"Delete Registration {SelectedStandard?.StandardName}";
        confirmMessage = "Are you sure you want to delete this standard? This action cannot be undone.";
        _confirmAction = async () =>
        {
            if (SelectedStandard == null || SelectedStandard.Id == 0) return;
            var Delete = await PService.RemoveRegistrationStandardAsync(SelectedStandard.Id);
            if (!Delete.Success) Toast.Error($"Error in Remove Registration: {Delete.Message}");
            else { Standards.Remove(SelectedStandard); Toast.Success("Registration removed successfully."); }
            SelectStandard();
            await Task.CompletedTask;
        };
        isConfirmDialogOpen = true;
    }

    private void ShowEditConfirm()
    {
        confirmTitle = $"Edit Standard {SelectedStandard?.StandardName}";
        confirmMessage = "Are you sure you want to edit this standard?";
        _confirmAction = async () =>
        {
            if (SelectedStandard == null || SelectedStandard.Id == 0) return;
            SelectedStandard.UnitList = RightUnits.ToList();
            if (SelectedStandard.UnitList.Count == 0) { Toast.Warning("Error: At least one unit must be selected."); return; }
            var Delete = await PService.UpdateRegistrationStandardAsync(SelectedStandard);
            if (!Delete.Success) Toast.Error($"Error Update Registration: {Delete.Message}");
            else { await LoadStandards(); Toast.Success("Registration updated successfully."); }
            SelectStandard();
            await Task.CompletedTask;
        };
        isConfirmDialogOpen = true;
    }
    #endregion
}
