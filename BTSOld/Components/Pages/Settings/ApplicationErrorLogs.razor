@page "/settings/auditLogs"
@attribute [Authorize]
@attribute [StreamRendering]
@inject ToastService Toast
@implements IDisposable

<div class="h-full bg-background text-foreground p-6 flex flex-col">

    <!-- Page Header -->
    <div class="flex mb-4">
        <PageHeader Title="Audit Logs" Description="All user actions and system events" />
    </div>

    <!-- Scrollable Table -->
    <div class="flex-1 overflow-y-auto">
        <DataTable TItem="AuditLog"
                   Title="Audit Records"
                   Subtitle="Track all user actions and system events"
                   Data="@Logs"
                   Search="true"
                   ExcelExport="true"
                   ExcelFileName="audit-logs"
                   ExcelSheetName="AuditLogs"
                   PdfExport="true"
                   PdfFileName="audit-logs"
                   ExportHeaderText="Audit Log Report"
                   ExportFooterText="@($"Exported: {DateTime.Now:yyyy-MM-dd HH:mm}")">

            <Columns>
                <!-- Timestamp -->
                <ColumnDef TItem="AuditLog" Key="timestamp" Header="Timestamp"
                           SearchSelector="@(c => c.Timestamp.ToString("yyyy-MM-dd HH:mm:ss"))"
                           ExcelValueSelector="@(c => c.Timestamp.ToString())">
                    <CellTemplate Context="c">
                        @c.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                    </CellTemplate>
                </ColumnDef>

                <!-- User -->
                <ColumnDef TItem="AuditLog" Key="user" Header="User"
                           SearchSelector="@(c => c.User)"
                           ExcelValueSelector="@(c => c.User)">
                    <CellTemplate Context="c">
                        @c.User
                    </CellTemplate>
                </ColumnDef>

                <!-- Action -->
                <ColumnDef TItem="AuditLog" Key="action" Header="Action"
                           SearchSelector="@(c => c.Action)"
                           ExcelValueSelector="@(c => c.Action)">
                    <CellTemplate Context="c">
                        @c.Action
                    </CellTemplate>
                </ColumnDef>

                <!-- Module / Entity -->
                <ColumnDef TItem="AuditLog" Key="module" Header="Module / Entity"
                           SearchSelector="@(c => c.Module)"
                           ExcelValueSelector="@(c => c.Module)">
                    <CellTemplate Context="c">
                        @c.Module
                    </CellTemplate>
                </ColumnDef>

                <!-- Entity ID / Reference -->
                <ColumnDef TItem="AuditLog" Key="entityId" Header="Entity ID"
                           SearchSelector="@(c => c.EntityId)"
                           ExcelValueSelector="@(c => c.EntityId)">
                    <CellTemplate Context="c">
                        @c.EntityId
                    </CellTemplate>
                </ColumnDef>


                <!-- Status -->
                <ColumnDef TItem="AuditLog" Key="status" Header="Status"
                           SearchSelector="@(c => c.Status)"
                           ExcelValueSelector="@(c => c.Status)">
                    <CellTemplate Context="c">
                        @c.Status
                    </CellTemplate>
                </ColumnDef>

                <!-- IP Address -->
                <ColumnDef TItem="AuditLog" Key="ip" Header="IP Address"
                           SearchSelector="@(c => c.IPAddress)"
                           ExcelValueSelector="@(c => c.IPAddress)">
                    <CellTemplate Context="c">
                        @c.IPAddress
                    </CellTemplate>
                </ColumnDef>

                <!-- Details -->
                <ColumnDef TItem="AuditLog" Key="details" Header="Details"
                           SearchSelector="@(c => c.Details)"
                           ExcelValueSelector="@(c => c.Details)">
                    <CellTemplate Context="c">
                        @c.Details
                    </CellTemplate>
                </ColumnDef>

            </Columns>
        </DataTable>
    </div>

</div>

@code {
    private List<AuditLog> Logs = new();

    protected override void OnInitialized()
    {
        // Dummy data for testing

        // Dummy audit log data
        Logs = new List<AuditLog>
        {
            // Device / Circuit
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-10), User="jdoe", Module="DeviceModule", EntityId="Device01-Circuit1", Action="Start", Status="Success", Details="Circuit started successfully" },
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-5), User="asmith", Module="DeviceModule", EntityId="Device02-Circuit3", Action="Error Reported", Status="Error", Details="Overvoltage detected" },
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-2), User="jdoe", Module="DeviceModule", EntityId="Device01-Circuit1", Action="Upload DBC File", Status="Success", Details="File uploaded: circuit1.dbc" },

            // User actions
            new AuditLog { Timestamp = DateTime.Now.AddHours(-1), User="jdoe", Module="UserModule", EntityId="User-jdoe", Action="Login", Status="Success", Details="Login from IP 192.168.1.12" },
            new AuditLog { Timestamp = DateTime.Now.AddHours(-2), User="asmith", Module="UserModule", EntityId="User-asmith", Action="Password Change", Status="Success", Details="Password updated successfully" },
            new AuditLog { Timestamp = DateTime.Now.AddHours(-3), User="jdoe", Module="UserModule", EntityId="User-jdoe", Action="Page Visit", Status="Success", Details="Visited /settings/auditLogs" },

            // Battery actions
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-15), User="jdoe", Module="BatteryModule", EntityId="Battery12", Action="Add", Status="Success", Details="Added new battery type Li-Ion" },
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-8), User="asmith", Module="BatteryModule", EntityId="Battery15", Action="Upload DBC File", Status="Success", Details="Uploaded dbc file battery15.dbc" },
            new AuditLog { Timestamp = DateTime.Now.AddMinutes(-3), User="jdoe", Module="BatteryModule", EntityId="Battery12", Action="Update", Status="Success", Details="Modified battery capacity settings" },

            // Program actions
            new AuditLog { Timestamp = DateTime.Now.AddHours(-3), User="admin", Module="ProgramModule", EntityId="Program101", Action="Create", Status="Success", Details="Program created for Device01" },
            new AuditLog { Timestamp = DateTime.Now.AddHours(-2), User="jdoe", Module="ProgramModule", EntityId="Program102", Action="Update", Status="Success", Details="Updated voltage settings" },
            new AuditLog { Timestamp = DateTime.Now.AddHours(-1), User="asmith", Module="ProgramModule", EntityId="Program103", Action="Delete", Status="Success", Details="Removed obsolete program" }
        };
    }

    public void Dispose()
    {
        // Dispose resources if needed
    }

    public class AuditLog
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string User { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string Module { get; set; } = string.Empty;
        public string EntityId { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string IPAddress { get; set; } = string.Empty;
        public string Details { get; set; } = string.Empty;
    }
}