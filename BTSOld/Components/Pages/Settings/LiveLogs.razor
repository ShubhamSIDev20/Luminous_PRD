@page "/settings/live-logs"
@using Serilog.Events
@implements IDisposable

<div class="h-full bg-background text-foreground p-6 flex flex-col">

    <!-- HEADER -->
    <div class="flex items-center justify-between mb-4">
        <h1 class="text-xl font-semibold text-primary flex items-center gap-2">
            <Blazicon Svg="Lucide.Activity" class="h-5 w-5" />
            Live Application Logs
        </h1>

        <div class="flex items-center gap-2">

            <!-- Pause / Resume -->
            <button @onclick="TogglePause"
                    class="px-3 py-1.5 rounded text-sm flex items-center gap-2 transition-colors
                           @(isPaused
                                ? "bg-success text-success-foreground"
                                : "bg-warning text-warning-foreground")">
                <Blazicon Svg="@(isPaused ? Lucide.Play : Lucide.Pause)" class="h-4 w-4" />
                @(isPaused ? "Resume" : "Pause")
            </button>

            <!-- Log Level Select -->
            <Select Value="@InMemoryLogStore.LevelSwitch.MinimumLevel.ToString()"
                    ValueChanged="OnLogLevelChanged">
                <SelectTrigger class="w-[150px] bg-muted text-foreground">
                    <SelectValue />
                </SelectTrigger>
                <SelectContent>
                    <SelectItem value="Verbose">Verbose</SelectItem>
                    <SelectItem value="Debug">Debug</SelectItem>
                    <SelectItem value="Information">Information</SelectItem>
                    <SelectItem value="Warning">Warning</SelectItem>
                    <SelectItem value="Error">Error</SelectItem>
                    <SelectItem value="Fatal">Fatal</SelectItem>
                </SelectContent>
            </Select>

            <!-- Clear -->
            <button @onclick="ClearLogs"
                    class="px-3 py-1.5 rounded text-sm flex items-center gap-2
                           bg-muted text-muted-foreground hover:bg-muted/80">
                <Blazicon Svg="Lucide.Trash2" class="h-4 w-4" />
                Clear
            </button>
        </div>
    </div>

    <!-- LOG VIEW -->
    <div class="flex-1 overflow-y-auto bg-surface rounded-lg p-4
                font-mono text-sm shadow-inner space-y-2">

        @if (!logs.Any())
        {
            <div class="text-muted-foreground italic flex items-center gap-2">
                <Blazicon Svg="Lucide.Clock" class="h-4 w-4" />
                Waiting for logs...
            </div>
        }
        else
        {
            @foreach (var log in logs.OrderByDescending(x => x.Timestamp))
            {
                <div class="@GetLogClass(log)">

                    <div class="flex items-start gap-3">

                        <!-- Time -->
                        <span class="text-xs text-muted-foreground w-[70px]">
                            @log.Timestamp.ToString("HH:mm:ss")
                        </span>

                        <!-- Level -->
                        <span class="@GetLevelBadgeClass(log.Level)">
                            @log.Level
                        </span>

                        <!-- Message -->
                        <span class="flex-1">
                            @log.Message
                        </span>
                    </div>

                    <!-- Properties -->
                    @if (log.Properties.Any())
                    {
                        <div class="ml-[85px] mt-1 text-xs text-muted-foreground flex flex-wrap gap-x-3">
                            @foreach (var prop in log.Properties)
                            {
                                <span>
                                    <span class="opacity-70">@prop.Key</span>=@prop.Value
                                </span>
                            }
                        </div>
                    }

                    <!-- Exception -->
                    @if (!string.IsNullOrWhiteSpace(log.Exception))
                    {
                        <pre class="ml-[85px] mt-2 text-xs bg-danger/10 text-danger
                                     rounded p-2 whitespace-pre-wrap">
                            @log.Exception
                                    </pre>
                    }
                </div>
            }
        }
    </div>

    <!-- FOOTER -->
    <div class="mt-3 text-xs text-muted-foreground flex items-center gap-4">
        <span>@logs.Count logs</span>
        <span>Max: 500</span>
        <span class="@(isPaused ? "text-warning" : "text-success")">
            @(isPaused ? "Paused" : "Auto-refresh: 1s")
        </span>
    </div>
</div>

@code {

    private List<UiLogEntry> logs = new();
    private Timer? timer;
    private bool isPaused;
    private int lastCount;

    protected override void OnInitialized()
    {
        logs = InMemoryLogStore.Logs.ToList();
        lastCount = logs.Count;

        timer = new Timer(async _ => await RefreshLogs(),
            null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task RefreshLogs()
    {
        if (isPaused) return;

        var current = InMemoryLogStore.Logs.ToList();
        if (current.Count != lastCount)
        {
            logs = current;
            lastCount = current.Count;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnLogLevelChanged(string value)
    {
        if (Enum.TryParse<LogEventLevel>(value, out var level))
            InMemoryLogStore.LevelSwitch.MinimumLevel = level;
    }

    private void TogglePause() => isPaused = !isPaused;

    private void ClearLogs()
    {
        logs.Clear();
        while (InMemoryLogStore.Logs.TryDequeue(out _)) { }
        lastCount = 0;
    }

    private string GetLogClass(UiLogEntry log)
    {
        const string baseClass =
            "px-3 py-2 rounded border-l-4 bg-muted/30";

        return log.Level switch
        {
            LogEventLevel.Verbose => $"{baseClass} border-muted",
            LogEventLevel.Debug => $"{baseClass} border-info",
            LogEventLevel.Information => $"{baseClass} border-success",
            LogEventLevel.Warning => $"{baseClass} border-warning",
            LogEventLevel.Error => $"{baseClass} border-danger",
            LogEventLevel.Fatal => $"{baseClass} border-danger",
            _ => baseClass
        };
    }

    private string GetLevelBadgeClass(LogEventLevel level)
    {
        const string baseClass =
            "px-2 py-0.5 rounded text-xs font-semibold uppercase";

        return level switch
        {
            LogEventLevel.Verbose => $"{baseClass} bg-muted text-muted-foreground",
            LogEventLevel.Debug => $"{baseClass} bg-info text-info-foreground",
            LogEventLevel.Information => $"{baseClass} bg-success text-success-foreground",
            LogEventLevel.Warning => $"{baseClass} bg-warning text-warning-foreground",
            LogEventLevel.Error => $"{baseClass} bg-danger text-danger-foreground",
            LogEventLevel.Fatal => $"{baseClass} bg-danger text-danger-foreground",
            _ => baseClass
        };
    }

    public void Dispose() => timer?.Dispose();
}
